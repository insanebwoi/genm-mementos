---
// ═══════════════════════════════════════════════════════════
// GEN M SWAG — FLOATING HERO MERCHANDISE COMPOSITION
// Featuring: White T-Shirt, Diary, Embroidered Cap, Water Bottle, Cross Bag, Keychain
// ═══════════════════════════════════════════════════════════
---

<div class="hero-composition-stage" aria-label="GEN M Official Merchandise Showcase">
  <div class="composition-container">
    
    <!-- 1. Centerpiece: Official White T-Shirt -->
    <div class="stage-item item-tshirt">
      <div class="product-card-hero featured-card">
        <img
          src="/products/white_tshirt.jpg"
          alt="GEN M Official White T-Shirt"
          class="hero-img-tshirt"
          width="320"
          height="320"
          loading="eager"
        />
        <div class="card-pill-tag">
          <span class="pill-dot"></span>
          <span>White T-Shirt • Signature</span>
        </div>
      </div>
    </div>

    <!-- 2. Top-Left Floating: Hardcover Diary -->
    <div class="stage-item item-diary">
      <div class="product-card-hero">
        <img
          src="/products/diary.jpg"
          alt="GEN M Hardcover Diary"
          class="hero-img-thumb"
          width="160"
          height="160"
          loading="eager"
        />
        <span class="floating-caption">Diary</span>
      </div>
    </div>

    <!-- 3. Top-Right Floating: Embroidered Cap -->
    <div class="stage-item item-cap">
      <div class="product-card-hero">
        <img
          src="/products/cap.jpg"
          alt="GEN M Embroidered Cap"
          class="hero-img-thumb"
          width="160"
          height="160"
          loading="eager"
        />
        <span class="floating-caption">Embroidered Cap</span>
      </div>
    </div>

    <!-- 4. Mid-Right Floating: Sage Water Bottle -->
    <div class="stage-item item-bottle">
      <div class="product-card-hero">
        <img
          src="/products/water_bottle.jpg"
          alt="GEN M Insulated Water Bottle"
          class="hero-img-thumb"
          width="150"
          height="150"
          loading="eager"
        />
        <span class="floating-caption">Water Bottle</span>
      </div>
    </div>

    <!-- 5. Bottom-Left Floating: Cross Bag -->
    <div class="stage-item item-crossbag">
      <div class="product-card-hero">
        <img
          src="/products/cross_bag.jpg"
          alt="GEN M Cross Bag"
          class="hero-img-thumb"
          width="170"
          height="170"
          loading="eager"
        />
        <span class="floating-caption">Cross Bag</span>
      </div>
    </div>

    <!-- 6. Bottom-Right Floating: Enamel Keychain -->
    <div class="stage-item item-keychain">
      <div class="product-card-hero">
        <img
          src="/products/keychain.jpg"
          alt="GEN M Enamel Keychain"
          class="hero-img-thumb"
          width="140"
          height="140"
          loading="eager"
        />
        <span class="floating-caption">Keychain</span>
      </div>
    </div>

    <!-- Decorative Connected Trajectory Lines -->
    <svg class="composition-orbits" viewBox="0 0 600 520" fill="none" aria-hidden="true">
      <ellipse cx="300" cy="270" rx="240" ry="190" stroke="rgba(89, 97, 180, 0.12)" stroke-width="1.5" stroke-dasharray="6 8" />
      <path d="M 120 160 C 200 120, 380 130, 480 180" stroke="rgba(129, 167, 115, 0.25)" stroke-width="1.5" stroke-dasharray="4 6" />
      <path d="M 140 400 C 240 440, 380 430, 470 380" stroke="rgba(89, 97, 180, 0.2)" stroke-width="1.5" stroke-dasharray="4 6" />
    </svg>

  </div>
</div>

<style>
  .hero-composition-stage {
    width: 100%;
    max-width: 620px;
    height: 520px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
  }

  .composition-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .composition-orbits {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* ─── Shared Card Style ─── */
  .stage-item {
    position: absolute;
    z-index: 5;
    transition: transform 0.3s var(--ease-editorial);
  }

  .product-card-hero {
    background: #ffffff;
    border-radius: 24px;
    padding: 8px;
    box-shadow: 0 16px 36px rgba(35, 40, 99, 0.1), 0 4px 12px rgba(35, 40, 99, 0.04);
    border: 1px solid rgba(89, 97, 180, 0.14);
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .stage-item:hover {
    z-index: 20;
    transform: scale(1.05) !important;
  }

  .floating-caption {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-blue-violet-dark);
    margin: 4px 0 2px;
    letter-spacing: -0.01em;
  }

  /* ─── 1. Featured Center T-Shirt ─── */
  .item-tshirt {
    z-index: 10;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: floatCenter 6.5s ease-in-out infinite;
  }

  .featured-card {
    border-radius: 28px;
    padding: 12px;
    box-shadow: 0 24px 60px rgba(35, 40, 99, 0.16), 0 6px 16px rgba(35, 40, 99, 0.06);
    border: 1.5px solid rgba(89, 97, 180, 0.22);
  }

  .hero-img-tshirt {
    width: 250px;
    height: 250px;
    object-fit: contain;
    border-radius: 20px;
    background: #fafafc;
  }

  .card-pill-tag {
    position: absolute;
    bottom: -12px;
    background: var(--color-blue-violet-dark);
    color: #ffffff;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 4px 14px rgba(35, 40, 99, 0.3);
    white-space: nowrap;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-sage-vibrant);
  }

  /* ─── 2. Diary (Top Left) ─── */
  .item-diary {
    top: 15px;
    left: 15px;
    animation: floatTopLeft 5.4s ease-in-out infinite 0.4s;
  }

  /* ─── 3. Cap (Top Right) ─── */
  .item-cap {
    top: 20px;
    right: 25px;
    animation: floatTopRight 6s ease-in-out infinite 0.8s;
  }

  /* ─── 4. Water Bottle (Mid Right) ─── */
  .item-bottle {
    bottom: 110px;
    right: -10px;
    animation: floatMidRight 5.8s ease-in-out infinite 1.2s;
  }

  /* ─── 5. Cross Bag (Bottom Left) ─── */
  .item-crossbag {
    bottom: 15px;
    left: 20px;
    animation: floatBottomLeft 6.2s ease-in-out infinite 0.6s;
  }

  /* ─── 6. Keychain (Bottom Center-Right) ─── */
  .item-keychain {
    bottom: 10px;
    left: 54%;
    animation: floatBottomRight 5.2s ease-in-out infinite 1.5s;
  }

  .hero-img-thumb {
    width: 105px;
    height: 105px;
    object-fit: contain;
    border-radius: 16px;
    background: #fafafc;
  }

  /* ─── Float Keyframes ─── */
  @keyframes floatCenter {
    0%, 100% {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    50% {
      transform: translate(-50%, -56%) rotate(0.5deg);
    }
  }

  @keyframes floatTopLeft {
    0%, 100% {
      transform: translateY(0px) rotate(-3deg);
    }
    50% {
      transform: translateY(-8px) rotate(-1.5deg);
    }
  }

  @keyframes floatTopRight {
    0%, 100% {
      transform: translateY(0px) rotate(2deg);
    }
    50% {
      transform: translateY(-9px) rotate(4deg);
    }
  }

  @keyframes floatMidRight {
    0%, 100% {
      transform: translateY(0px) rotate(-1deg);
    }
    50% {
      transform: translateY(-7px) rotate(1deg);
    }
  }

  @keyframes floatBottomLeft {
    0%, 100% {
      transform: translateY(0px) rotate(2.5deg);
    }
    50% {
      transform: translateY(-8px) rotate(1deg);
    }
  }

  @keyframes floatBottomRight {
    0%, 100% {
      transform: translateY(0px) rotate(-2deg);
    }
    50% {
      transform: translateY(-6px) rotate(0deg);
    }
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .hero-composition-stage {
      height: 380px;
      max-width: 360px;
    }
    .hero-img-tshirt {
      width: 170px;
      height: 170px;
    }
    .hero-img-thumb {
      width: 75px;
      height: 75px;
    }
    .item-diary {
      top: 5px;
      left: 5px;
    }
    .item-cap {
      top: 10px;
      right: 5px;
    }
    .item-bottle {
      display: none;
    }
    .item-crossbag {
      bottom: 5px;
      left: 10px;
    }
    .item-keychain {
      bottom: 5px;
      left: 60%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-item {
      animation: none !important;
    }
  }
</style>
