</style>

<script>
  import { PRODUCTS } from '../data/products';

  function initLightSpotlight() {
    const tabs = document.querySelectorAll('.light-tab');
    const chips = document.querySelectorAll('.light-scrub-chip');
    const titleEl = document.getElementById('spotlight-title');
    const descEl = document.getElementById('spotlight-desc');
    const sloganEl = document.getElementById('spotlight-slogan');
    const catTagEl = document.getElementById('spotlight-cat-tag');
    const numTagEl = document.getElementById('spotlight-num-tag');
    const boldNumEl = document.getElementById('spotlight-bold-number');
    const sidewaysTagEl = document.getElementById('spotlight-sideways-tag');
    const kickerEl = document.getElementById('spotlight-kicker');
    const imgEl = document.getElementById('spotlight-img') as HTMLImageElement;
    const specsEl = document.getElementById('spotlight-specs');
    const modalBtn = document.getElementById('spotlight-view-modal-btn');
    const whatsappBtn = document.getElementById('spotlight-whatsapp-btn') as HTMLAnchorElement;
    const counterEl = document.getElementById('spotlight-active-counter');
    const pedestalTrigger = document.getElementById('spotlight-pedestal');

    if (!chips.length) return;

    function activateProduct(productId: string) {
      const productIndex = PRODUCTS.findIndex((p) => p.id === productId);
      if (productIndex === -1) return;

      const product = PRODUCTS[productIndex];
      const numStr = String(productIndex + 1).padStart(2, '0');

      // Update active chip state
      chips.forEach((c) => {
        const matches = c.getAttribute('data-spotlight-id') === productId;
        c.classList.toggle('is-active', matches);
        c.setAttribute('aria-selected', matches ? 'true' : 'false');
      });

      // Smooth image transition
      if (imgEl) {
        imgEl.style.opacity = '0';
        imgEl.style.transform = 'translateY(12px) scale(0.95)';
        
        setTimeout(() => {
          imgEl.src = product.image;
          imgEl.alt = product.name;
          imgEl.style.opacity = '1';
          imgEl.style.transform = 'translateY(0) scale(1)';
        }, 160);
      }

      // Update text details
      if (titleEl) titleEl.textContent = product.name;
      if (descEl) descEl.textContent = product.description || product.shortDesc;
      if (catTagEl) catTagEl.textContent = product.category;
      if (numTagEl) numTagEl.textContent = `#${numStr} // 13`;
      if (boldNumEl) boldNumEl.textContent = `ITEM #${numStr}`;
      if (sidewaysTagEl) sidewaysTagEl.textContent = `${product.name.toUpperCase()} • ARTIFACT #${numStr}`;
      if (counterEl) counterEl.textContent = `ARTIFACT #${numStr} OF 13`;
      if (kickerEl) kickerEl.textContent = product.category.toUpperCase();

      if (sloganEl) {
        if (product.slogan) {
          sloganEl.textContent = `“${product.slogan}”`;
          sloganEl.style.display = 'block';
        } else {
          sloganEl.style.display = 'none';
        }
      }

      if (specsEl && product.specs) {
        specsEl.innerHTML = product.specs
          .map(
            (s: any) =>
              `<div class="light-spec-card"><span class="spec-k">${s.label}</span><span class="spec-v">${s.value}</span></div>`
          )
          .join('');
      }

      if (modalBtn) {
        modalBtn.setAttribute('data-product-id', product.id);
      }

      if (pedestalTrigger) {
        pedestalTrigger.setAttribute('data-product-id', product.id);
      }

      if (whatsappBtn) {
        const msg = encodeURIComponent(
          `Hello MSM Kerala, I would like to enquire about ordering the official GEN M ${product.name} (Artifact #${numStr}).`
        );
        whatsappBtn.href = `https://wa.me/919495123456?text=${msg}`;
      }
    }

    // Attach click listeners to scrub chips
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.getAttribute('data-spotlight-id');
        if (id) activateProduct(id);
      });
    });

    // Category Tabs filter the scrub reel dock & activate first item
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');
        tabs.forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');

        let firstVisibleId: string | null = null;

        chips.forEach((chip) => {
          const chipCat = chip.getAttribute('data-category');
          if (filter === 'all' || chipCat === filter) {
            (chip as HTMLElement).style.display = 'flex';
            if (!firstVisibleId) {
              firstVisibleId = chip.getAttribute('data-spotlight-id');
            }
          } else {
            (chip as HTMLElement).style.display = 'none';
          }
        });

        if (firstVisibleId) {
          activateProduct(firstVisibleId);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initLightSpotlight);
</script>
