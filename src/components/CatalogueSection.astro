---
import { PRODUCTS, CATEGORIES } from '../data/products';

// Helper to get formatted 2-digit index (01/13 .. 13/13)
function getGlobalIndex(productId: string): string {
  const index = PRODUCTS.findIndex((p) => p.id === productId);
  return String(index + 1).padStart(2, '0');
}
---

<!-- ═══════════════════════════════════════════════════════════
     SHOWCASE GALLERY — APPLE & NIKE INTERACTIVE SHOWCASE
     ═══════════════════════════════════════════════════════════ -->
<section class="section-showcase" id="catalogue">
  
  <!-- Subtle Ambient Glow Orbs -->
  <div class="showcase-glow-backdrop" aria-hidden="true">
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
    <div class="glow-orb orb-3"></div>
  </div>

  <div class="showcase-shell">

    <!-- ─── Editorial Header (Apple Keynote & Nike Exhibition Style) ─── -->
    <header class="showcase-hero-header">
      <div class="showcase-eyebrow-pill">
        <span class="eyebrow-spark">✦</span>
        <span>THE OFFICIAL ARCHIVE • 13 PIECES</span>
        <span class="eyebrow-spark">✦</span>
      </div>

      <h2 class="showcase-main-title">
        The 13 Artifacts of Purpose.
      </h2>

      <p class="showcase-lead-text">
        Not an ordinary store. An exhibition of craft. Each piece in the GEN M collection was engineered from the ground up — selecting tailored weights, authentic materials, and architectural silhouettes designed to endure.
      </p>

      <!-- Apple-Grade Segmented Pill Switcher Dock -->
      <nav class="showcase-segmented-nav" aria-label="Filter artifacts by category">
        <button
          type="button"
          class="mogo-filter-tab showcase-tab is-active"
          data-filter="all"
        >
          <span class="tab-label">All 13 Pieces</span>
          <span class="tab-count">13</span>
        </button>

        <button
          type="button"
          class="mogo-filter-tab showcase-tab"
          data-filter="everyday-essentials"
        >
          <span class="tab-label">Everyday Essentials</span>
          <span class="tab-count">04</span>
        </button>

        <button
          type="button"
          class="mogo-filter-tab showcase-tab"
          data-filter="drinkware"
        >
          <span class="tab-label">Drinkware</span>
          <span class="tab-count">03</span>
        </button>

        <button
          type="button"
          class="mogo-filter-tab showcase-tab"
          data-filter="wear-and-carry"
        >
          <span class="tab-label">Wear & Carry</span>
          <span class="tab-count">03</span>
        </button>

        <button
          type="button"
          class="mogo-filter-tab showcase-tab"
          data-filter="lifestyle-accessories"
        >
          <span class="tab-label">Lifestyle</span>
          <span class="tab-count">03</span>
        </button>
      </nav>
    </header>

    <!-- ─── Interactive Apple Keynote Spotlight Deck ─── -->
    <div class="spotlight-interactive-stage" id="spotlight-deck">
      <div class="spotlight-meta-header">
        <span class="spotlight-kicker">INTERACTIVE SHOWCASE // SELECT ANY PIECE</span>
        <span class="spotlight-indicator-tag" id="spotlight-active-counter">ARTIFACT #01 OF 13</span>
      </div>

      <div class="spotlight-featurette-card" id="spotlight-card">
        <!-- Spotlight Visual Pedestal (Animated Floating Stage) -->
        <div class="spotlight-pedestal-col" id="spotlight-pedestal" data-product-id="diary">
          <div class="spotlight-halo-aura" id="spotlight-halo" aria-hidden="true"></div>
          
          <!-- Rotating Typographic Seal -->
          <div class="spotlight-seal-badge" aria-hidden="true">
            <svg class="seal-svg" viewBox="0 0 100 100">
              <path id="spotlightSealPath" d="M 50,50 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none" />
              <text class="seal-text">
                <textPath href="#spotlightSealPath">★ MSM KERALA • GEN M 2026 • OFFICIAL ARTIFACT ★</textPath>
              </text>
            </svg>
            <span class="seal-star">✦</span>
          </div>

          <div class="spotlight-img-wrap">
            <img
              src="/products/diary.jpg"
              alt="Spotlight product"
              id="spotlight-img"
              class="spotlight-product-img"
              width="500"
              height="500"
            />
          </div>

          <!-- Floating Inspection Cue -->
          <div class="spotlight-inspect-chip" id="spotlight-inspect-trigger">
            <span>Click to Inspect Full Details</span>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        </div>

        <!-- Spotlight Editorial Info Column -->
        <div class="spotlight-info-col">
          <div class="spotlight-tag-row">
            <span class="spotlight-badge-cat" id="spotlight-cat-tag">Everyday Essentials</span>
            <span class="spotlight-badge-num" id="spotlight-num-tag">#01 // 13</span>
          </div>

          <h3 class="spotlight-product-name" id="spotlight-title">Diary</h3>
          <p class="spotlight-product-slogan" id="spotlight-slogan" style="display: none;"></p>
          <p class="spotlight-product-desc" id="spotlight-desc">
            A thoughtfully crafted daily planner and notebook designed for reflective thoughts, lecture notes, and purposeful goal setting. Features acid-free ruled pages, bookmark ribbon, and lay-flat binding.
          </p>

          <!-- Specifications Pill Bar -->
          <div class="spotlight-specs-grid" id="spotlight-specs">
            <div class="spotlight-spec-pill">
              <span class="spec-k">Binding:</span>
              <span class="spec-v">Hardcover Case Bound</span>
            </div>
            <div class="spotlight-spec-pill">
              <span class="spec-k">Paper:</span>
              <span class="spec-v">80 GSM Ivory Ruled</span>
            </div>
            <div class="spotlight-spec-pill">
              <span class="spec-k">Size:</span>
              <span class="spec-v">A5 (148 × 210 mm)</span>
            </div>
          </div>

          <!-- Dual Action Buttons -->
          <div class="spotlight-actions-row">
            <button
              type="button"
              class="btn-spotlight-modal"
              id="spotlight-view-modal-btn"
              data-product-id="diary"
            >
              <span>Explore Specifications</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>

            <a
              href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20ordering%20the%20official%20GEN%20M%20Diary."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-spotlight-whatsapp"
              id="spotlight-whatsapp-btn"
              aria-label="Enquire on WhatsApp"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.588-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.071.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z" />
              </svg>
              <span>Enquire via WhatsApp</span>
            </a>
          </div>

        </div>
      </div>

      <!-- Interactive 13-Piece Scrub Reel Dock (Apple Watch Style) -->
      <div class="spotlight-scrub-reel" role="tablist" aria-label="13 Official Pieces quick selector" id="spotlight-scrub-reel">
        {PRODUCTS.map((p, idx) => {
          const num = String(idx + 1).padStart(2, '0');
          const isFirst = idx === 0;

          return (
            <button
              type="button"
              class={`scrub-item-chip ${isFirst ? 'is-active' : ''}`}
              data-spotlight-id={p.id}
              data-category={p.categorySlug}
              role="tab"
              aria-selected={isFirst ? 'true' : 'false'}
            >
              <img src={p.image} alt={p.name} class="scrub-item-thumb" width="40" height="40" loading="lazy" />
              <div class="scrub-item-meta">
                <span class="scrub-num">#{num}</span>
                <span class="scrub-name">{p.name}</span>
              </div>
            </button>
          );
        })}
      </div>
    </div>

  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════
     SHOWCASE GALLERY STYLING — APPLE & NIKE EDITORIAL ARCHIVE
     ═══════════════════════════════════════════════════════════ */
  .section-showcase {
    position: relative;
    width: 100%;
    padding: clamp(80px, 9vw, 130px) 24px clamp(90px, 10vw, 140px);
    background: #0b1536; /* Deep GEN M midnight royal blue stage */
    color: #ffffff;
    overflow: hidden;
  }

  /* Ambient Backdrop Glows */
  .showcase-glow-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.18;
    animation: auraPulse 12s infinite alternate ease-in-out;
  }

  .orb-1 {
    width: 650px;
    height: 650px;
    top: 5%;
    left: -10%;
    background: radial-gradient(circle, #174ee8 0%, transparent 70%);
  }

  .orb-2 {
    width: 750px;
    height: 750px;
    top: 45%;
    right: -15%;
    background: radial-gradient(circle, #174ee8 0%, transparent 70%);
    animation-delay: -4s;
  }

  .orb-3 {
    width: 550px;
    height: 550px;
    bottom: 5%;
    left: 20%;
    background: radial-gradient(circle, #E7EEAC 0%, transparent 70%);
    animation-delay: -8s;
  }

  @keyframes auraPulse {
    0% { transform: scale(0.95) translate(0, 0); opacity: 0.15; }
    50% { transform: scale(1.1) translate(20px, -20px); opacity: 0.28; }
    100% { transform: scale(1.02) translate(-15px, 15px); opacity: 0.2; }
  }

  .showcase-shell {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    z-index: 1;
  }

  /* ─── Hero Header ─── */
  .showcase-hero-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto clamp(40px, 6vw, 64px);
  }

  .showcase-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 7px 18px;
    border-radius: 9999px;
    font-family: 'Space Grotesk', monospace;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #E7EEAC;
    text-transform: uppercase;
    margin-bottom: 20px;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .eyebrow-spark {
    color: #E7EEAC;
    font-size: 0.8rem;
  }

  .showcase-main-title {
    font-family: 'Space Grotesk', 'Poppins', sans-serif;
    font-size: clamp(2.5rem, 5.2vw, 4.4rem);
    font-weight: 900;
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin: 0 0 18px;
  }

  .showcase-lead-text {
    font-family: 'Poppins', -apple-system, sans-serif;
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.6;
    color: #94a3b8;
    max-width: 720px;
    margin: 0 auto clamp(32px, 4vw, 44px);
  }

  /* ─── Segmented Pill Switcher Dock (Apple Style) ─── */
  .showcase-segmented-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px;
    background: rgba(15, 23, 42, 0.85);
    border: 1.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    backdrop-filter: blur(20px);
    box-shadow: 
      0 12px 30px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .showcase-segmented-nav::-webkit-scrollbar {
    display: none;
  }

  .showcase-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    padding: 10px 18px;
    border-radius: 9999px;
    color: #94a3b8;
    font-family: 'Poppins', sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .showcase-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .showcase-tab.is-active {
    background: #E7EEAC;
    color: #090e1a;
    box-shadow: 0 4px 16px rgba(231, 238, 172, 0.4);
  }

  .showcase-tab .tab-count {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    color: currentColor;
  }

  .showcase-tab.is-active .tab-count {
    background: rgba(9, 14, 26, 0.16);
  }

  /* ═══════════════════════════════════════════════════════════
     INTERACTIVE APPLE KEYNOTE SPOTLIGHT DECK
     ═══════════════════════════════════════════════════════════ */
  .spotlight-interactive-stage {
    background: linear-gradient(135deg, rgba(23, 78, 232, 0.15) 0%, rgba(11, 21, 54, 0.95) 100%);
    border: 2px solid rgba(231, 238, 172, 0.3);
    border-radius: 36px;
    padding: clamp(24px, 4vw, 44px);
    backdrop-filter: blur(20px);
    box-shadow: 
      0 24px 60px rgba(0, 0, 0, 0.6),
      0 0 40px rgba(23, 78, 232, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }

  .spotlight-meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: 'Space Grotesk', monospace;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .spotlight-kicker {
    color: #E7EEAC;
  }

  .spotlight-indicator-tag {
    color: #E7EEAC;
    background: rgba(231, 238, 172, 0.12);
    padding: 4px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(231, 238, 172, 0.3);
  }

  /* Spotlight Featurette Split */
  .spotlight-featurette-card {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  .spotlight-pedestal-col {
    position: relative;
    width: 100%;
    aspect-ratio: 1.05;
    background: radial-gradient(circle, rgba(23, 78, 232, 0.35) 0%, rgba(11, 21, 54, 0.7) 100%);
    border: 1.5px solid rgba(231, 238, 172, 0.2);
    border-radius: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .spotlight-pedestal-col:hover {
    border-color: #E7EEAC;
    transform: scale(1.01);
  }

  .spotlight-halo-aura {
    position: absolute;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(23, 78, 232, 0.6) 0%, rgba(231, 238, 172, 0.2) 55%, transparent 70%);
    filter: blur(36px);
    animation: auraPulse 6s infinite alternate ease-in-out;
  }

  /* Rotating Seal on Spotlight */
  .spotlight-seal-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 84px;
    height: 84px;
    z-index: 3;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .seal-svg {
    width: 100%;
    height: 100%;
    animation: rotatingSeal 20s linear infinite;
  }

  @keyframes rotatingSeal {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .seal-text {
    font-family: 'Space Grotesk', monospace;
    font-size: 10.5px;
    font-weight: 800;
    fill: #E7EEAC;
    letter-spacing: 0.15em;
  }

  .seal-star {
    position: absolute;
    color: #E7EEAC;
    font-size: 0.85rem;
  }

  .spotlight-img-wrap {
    position: relative;
    width: 88%;
    height: 88%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .spotlight-product-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 20px 32px rgba(0, 0, 0, 0.55));
    animation: appleLevitate 5s ease-in-out infinite;
    transition: opacity 0.25s ease, transform 0.3s ease;
  }

  @keyframes appleLevitate {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-14px) rotate(1deg);
    }
  }

  .spotlight-inspect-chip {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 9999px;
    padding: 6px 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    color: #ffffff;
    z-index: 3;
    backdrop-filter: blur(10px);
    transition: all 0.2s ease;
  }

  .spotlight-pedestal-col:hover .spotlight-inspect-chip {
    background: #E7EEAC;
    color: #090e1a;
    border-color: #E7EEAC;
  }

  /* Spotlight Info Col */
  .spotlight-info-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .spotlight-tag-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .spotlight-badge-cat {
    font-family: 'Poppins', sans-serif;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: 9999px;
    background: #E7EEAC;
    color: #090e1a;
  }

  .spotlight-badge-num {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.8rem;
    font-weight: 800;
    color: #94a3b8;
  }

  .spotlight-product-name {
    font-family: 'Space Grotesk', 'Poppins', sans-serif;
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0 0 8px;
  }

  .spotlight-product-slogan {
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #E7EEAC;
    margin: 0 0 12px;
  }

  .spotlight-product-desc {
    font-family: 'Poppins', sans-serif;
    font-size: 1.06rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 0 24px;
    max-width: 580px;
  }

  .spotlight-specs-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
  }

  .spotlight-spec-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 6px 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Space Grotesk', monospace;
    font-size: 0.78rem;
  }

  .spotlight-spec-pill .spec-k {
    color: #64748b;
  }

  .spotlight-spec-pill .spec-v {
    color: #cbd5e1;
    font-weight: 700;
  }

  .spotlight-actions-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-spotlight-modal {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #174ee8;
    color: #ffffff;
    border: 2px solid #174ee8;
    border-radius: 14px;
    padding: 13px 24px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.92rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 6px 18px rgba(23, 78, 232, 0.35);
  }

  .btn-spotlight-modal:hover {
    background: #ffffff;
    color: #174ee8;
    border-color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 255, 255, 0.35);
  }

  .btn-spotlight-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #E7EEAC;
    color: #0f172a;
    border: 2px solid #E7EEAC;
    text-decoration: none;
    border-radius: 14px;
    padding: 13px 22px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.92rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(231, 238, 172, 0.35);
    transition: all 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .btn-spotlight-whatsapp:hover {
    transform: translateY(-2px);
    background: #f4f8cb;
    border-color: #f4f8cb;
    box-shadow: 0 8px 24px rgba(231, 238, 172, 0.5);
  }

  /* ─── 13-Piece Scrub Reel Dock ─── */
  .spotlight-scrub-reel {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow-x: auto;
    padding: 12px 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .scrub-item-chip {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 6px 14px;
    color: #94a3b8;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .scrub-item-chip:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .scrub-item-chip.is-active {
    background: #E7EEAC;
    color: #090e1a;
    border-color: #E7EEAC;
    box-shadow: 0 4px 14px rgba(231, 238, 172, 0.4);
  }

  .scrub-item-thumb {
    width: 34px;
    height: 34px;
    object-fit: contain;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.2);
    padding: 2px;
  }

  .scrub-item-meta {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .scrub-num {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.65rem;
    font-weight: 800;
    opacity: 0.8;
  }

  .scrub-name {
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
  }

  /* ═══════════════════════════════════════════════════════════
     RESPONSIVE BREAKPOINTS
     ═══════════════════════════════════════════════════════════ */
  @media (max-width: 960px) {
    .spotlight-featurette-card {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 640px) {
    .section-showcase {
      padding: 60px 16px 80px;
    }

    .spotlight-interactive-stage {
      padding: 20px 16px;
      border-radius: 24px;
    }

    .showcase-segmented-nav {
      justify-content: flex-start;
      border-radius: 18px;
      width: 100%;
    }

    .showcase-tab {
      padding: 8px 14px;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  import { PRODUCTS } from '../data/products';

  function initSpotlightDeck() {
    const tabs = document.querySelectorAll('.showcase-tab');
    const chips = document.querySelectorAll('.scrub-item-chip');
    const titleEl = document.getElementById('spotlight-title');
    const descEl = document.getElementById('spotlight-desc');
    const sloganEl = document.getElementById('spotlight-slogan');
    const catTagEl = document.getElementById('spotlight-cat-tag');
    const numTagEl = document.getElementById('spotlight-num-tag');
    const imgEl = document.getElementById('spotlight-img') as HTMLImageElement;
    const specsEl = document.getElementById('spotlight-specs');
    const modalBtn = document.getElementById('spotlight-view-modal-btn');
    const whatsappBtn = document.getElementById('spotlight-whatsapp-btn') as HTMLAnchorElement;
    const counterEl = document.getElementById('spotlight-active-counter');
    const pedestalTrigger = document.getElementById('spotlight-pedestal');

    if (!chips.length) return;

    function activateProduct(productId: string) {
      const productIndex = PRODUCTS.findIndex((p) => p.id === productId);
      if (productIndex === -1) return;

      const product = PRODUCTS[productIndex];
      const numStr = String(productIndex + 1).padStart(2, '0');

      // Update active chip state
      chips.forEach((c) => {
        const matches = c.getAttribute('data-spotlight-id') === productId;
        c.classList.toggle('is-active', matches);
        c.setAttribute('aria-selected', matches ? 'true' : 'false');
      });

      // Smooth image transition
      if (imgEl) {
        imgEl.style.opacity = '0';
        imgEl.style.transform = 'translateY(12px) scale(0.95)';
        
        setTimeout(() => {
          imgEl.src = product.image;
          imgEl.alt = product.name;
          imgEl.style.opacity = '1';
          imgEl.style.transform = 'translateY(0) scale(1)';
        }, 160);
      }

      // Update text details
      if (titleEl) titleEl.textContent = product.name;
      if (descEl) descEl.textContent = product.description || product.shortDesc;
      if (catTagEl) catTagEl.textContent = product.category;
      if (numTagEl) numTagEl.textContent = `#${numStr} // 13`;
      if (counterEl) counterEl.textContent = `ARTIFACT #${numStr} OF 13`;

      if (sloganEl) {
        if (product.slogan) {
          sloganEl.textContent = `“${product.slogan}”`;
          sloganEl.style.display = 'block';
        } else {
          sloganEl.style.display = 'none';
        }
      }

      if (specsEl && product.specs) {
        specsEl.innerHTML = product.specs
          .map(
            (s: any) =>
              `<div class="spotlight-spec-pill"><span class="spec-k">${s.label}:</span><span class="spec-v">${s.value}</span></div>`
          )
          .join('');
      }

      if (modalBtn) {
        modalBtn.setAttribute('data-product-id', product.id);
      }

      if (pedestalTrigger) {
        pedestalTrigger.setAttribute('data-product-id', product.id);
      }

      if (whatsappBtn) {
        const msg = encodeURIComponent(
          `Hello MSM Kerala, I would like to enquire about ordering the official GEN M ${product.name} (Artifact #${numStr}).`
        );
        whatsappBtn.href = `https://wa.me/919495123456?text=${msg}`;
      }
    }

    // Attach click listeners to scrub chips
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.getAttribute('data-spotlight-id');
        if (id) activateProduct(id);
      });
    });

    // Category Tabs filter the scrub reel dock & activate first item
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');
        tabs.forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');

        let firstVisibleId: string | null = null;

        chips.forEach((chip) => {
          const chipCat = chip.getAttribute('data-category');
          if (filter === 'all' || chipCat === filter) {
            (chip as HTMLElement).style.display = 'flex';
            if (!firstVisibleId) {
              firstVisibleId = chip.getAttribute('data-spotlight-id');
            }
          } else {
            (chip as HTMLElement).style.display = 'none';
          }
        });

        if (firstVisibleId) {
          activateProduct(firstVisibleId);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initSpotlightDeck);
</script>
