---
import { PRODUCTS, CATEGORIES } from '../data/products';

// Chapter definitions for Apple/Nike-style editorial storytelling
const CHAPTERS = [
  {
    num: '01',
    slug: 'everyday-essentials',
    title: 'Everyday Essentials',
    subtitle: 'Tactile artifacts engineered for study, daily reflection, and purposeful campus presence.',
    badge: '04 ARTIFACTS',
  },
  {
    num: '02',
    slug: 'drinkware',
    title: 'Drinkware',
    subtitle: 'Minimalist vessels sculpted from fluted crystal, insulated steel, and glazed ceramic.',
    badge: '03 ARTIFACTS',
  },
  {
    num: '03',
    slug: 'wear-and-carry',
    title: 'Wear & Carry',
    subtitle: 'Signature apparel, headwear, and modular utility gear bearing the GEN M movement.',
    badge: '03 ARTIFACTS',
  },
  {
    num: '04',
    slug: 'lifestyle-accessories',
    title: 'Lifestyle Accessories',
    subtitle: 'Sculptural desk, vehicle, and ambient accents communicating understated elegance.',
    badge: '03 ARTIFACTS',
  },
];

// Helper to get formatted 2-digit index (01/13 .. 13/13)
function getGlobalIndex(productId: string): string {
  const index = PRODUCTS.findIndex((p) => p.id === productId);
  return String(index + 1).padStart(2, '0');
}
---

<!-- ═══════════════════════════════════════════════════════════
     SHOWCASE GALLERY — APPLE & NIKE EDITORIAL ARCHIVE
     ═══════════════════════════════════════════════════════════ -->
<section class="section-showcase" id="catalogue">
  
  <!-- Subtle Ambient Glow Orbs -->
  <div class="showcase-glow-backdrop" aria-hidden="true">
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
    <div class="glow-orb orb-3"></div>
  </div>

  <div class="showcase-shell">

    <!-- ─── Editorial Header (Apple Keynote & Nike Exhibition Style) ─── -->
    <header class="showcase-hero-header">
      <div class="showcase-eyebrow-pill">
        <span class="eyebrow-spark">✦</span>
        <span>THE OFFICIAL ARCHIVE • 13 PIECES</span>
        <span class="eyebrow-spark">✦</span>
      </div>

      <h2 class="showcase-main-title">
        The 13 Artifacts of Purpose.
      </h2>

      <p class="showcase-lead-text">
        Every piece in the GEN M collection was engineered from the ground up — selecting tailored weights, authentic materials, and architectural silhouettes designed to endure far beyond the event.
      </p>

      <!-- Apple-Grade Segmented Pill Switcher Dock -->
      <nav class="showcase-segmented-nav" aria-label="Filter artifacts by category">
        <button
          type="button"
          class="mogo-filter-tab showcase-tab is-active"
          data-filter="all"
        >
          <span class="tab-label">All 13 Pieces</span>
          <span class="tab-count">13</span>
        </button>

        <button
          type="button"
          class="mogo-filter-tab showcase-tab"
          data-filter="everyday-essentials"
        >
          <span class="tab-label">Everyday Essentials</span>
          <span class="tab-count">04</span>
        </button>

        <button
          type="button"
          class="mogo-filter-tab showcase-tab"
          data-filter="drinkware"
        >
          <span class="tab-label">Drinkware</span>
          <span class="tab-count">03</span>
        </button>

        <button
          type="button"
          class="mogo-filter-tab showcase-tab"
          data-filter="wear-and-carry"
        >
          <span class="tab-label">Wear & Carry</span>
          <span class="tab-count">03</span>
        </button>

        <button
          type="button"
          class="mogo-filter-tab showcase-tab"
          data-filter="lifestyle-accessories"
        >
          <span class="tab-label">Lifestyle</span>
          <span class="tab-count">03</span>
        </button>
      </nav>
    </header>

    <!-- ─── Editorial Showcase Chapters ─── -->
    <div class="showcase-chapters-stream">
      {CHAPTERS.map((chapter) => {
        const chapterProducts = PRODUCTS.filter((p) => p.categorySlug === chapter.slug);

        return (
          <section
            class="category-block-group showcase-chapter-block"
            id={chapter.slug}
            data-group={chapter.slug}
          >
            <!-- Chapter Billboard Intro -->
            <div class="chapter-billboard">
              <div class="chapter-meta-line">
                <span class="chapter-index">CHAPTER {chapter.num}</span>
                <span class="chapter-divider">/</span>
                <span class="chapter-badge">{chapter.badge}</span>
              </div>

              <div class="chapter-headline-row">
                <h3 class="chapter-title">{chapter.title}</h3>
                <p class="chapter-subtext">{chapter.subtitle}</p>
              </div>
            </div>

            <!-- Showcase Artifacts Grid -->
            <div class="showcase-artifacts-grid">
              {chapterProducts.map((product) => {
                const globalNum = getGlobalIndex(product.id);
                const isSignature = product.isFeatured;

                return (
                  <article
                    class={`showcase-card ${isSignature ? 'is-flagship-piece' : ''}`}
                    data-category={product.categorySlug}
                    data-product-id={product.id}
                  >
                    <!-- Card Top Header: Numbering & Status Tag -->
                    <div class="card-status-bar">
                      <span class="card-num-stamp">#{globalNum} <span class="num-of">/ 13</span></span>
                      {isSignature ? (
                        <span class="card-pill-tag tag-flagship">★ FLAGSHIP DROP</span>
                      ) : (
                        <span class="card-pill-tag tag-standard">{product.category}</span>
                      )}
                    </div>

                    <!-- Sculptural Product Stage (Pedestal with Ambient Studio Glow) -->
                    <div class="card-pedestal-stage" data-product-id={product.id}>
                      <div class="pedestal-glow" aria-hidden="true"></div>
                      <img
                        src={product.image}
                        alt={product.name}
                        class="pedestal-product-img"
                        width="460"
                        height="460"
                        loading="lazy"
                      />

                      <!-- Interactive Quick Glance Pill Cue -->
                      <div class="pedestal-quick-cue">
                        <span>Quick Glance</span>
                        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </div>
                    </div>

                    <!-- Editorial Content Box -->
                    <div class="card-editorial-body">
                      
                      <!-- Title & Slogan Accent -->
                      <div class="card-title-group">
                        <h4 class="card-title">{product.name}</h4>
                        {product.slogan && (
                          <span class="card-slogan-inline">“{product.slogan}”</span>
                        )}
                      </div>

                      <p class="card-narrative">{product.shortDesc}</p>

                      <!-- Apple-Style Key Specs Strip -->
                      {product.specs && product.specs.length > 0 && (
                        <div class="card-specs-strip">
                          {product.specs.slice(0, 2).map((spec) => (
                            <div class="spec-capsule">
                              <span class="spec-k">{spec.label}:</span>
                              <span class="spec-v">{spec.value}</span>
                            </div>
                          ))}
                        </div>
                      )}

                      <!-- Sleek Showcase Action Bar -->
                      <div class="card-action-bar">
                        <button
                          type="button"
                          class="btn-showcase-inspect"
                          data-product-id={product.id}
                          aria-label={`Inspect ${product.name} details`}
                        >
                          <span>Explore Specs</span>
                          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </button>

                        <a
                          href={`https://wa.me/919495123456?text=${encodeURIComponent(`Hello MSM Kerala, I would like to enquire about ordering the official GEN M ${product.name} (Artifact #${globalNum}).`)}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-showcase-whatsapp"
                          aria-label={`Enquire about ${product.name} on WhatsApp`}
                        >
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.588-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.071.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z" />
                          </svg>
                          <span>Enquire</span>
                        </a>
                      </div>

                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>

  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════
     SHOWCASE GALLERY STYLING — APPLE × NIKE ARCHITECTURAL FINISH
     ═══════════════════════════════════════════════════════════ */
  .section-showcase {
    position: relative;
    width: 100%;
    padding: clamp(80px, 9vw, 130px) 24px clamp(90px, 10vw, 140px);
    background: #090e1a; /* Deep obsidian gallery space */
    color: #ffffff;
    overflow: hidden;
  }

  /* Ambient Backdrop Glows */
  .showcase-glow-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.18;
  }

  .orb-1 {
    width: 600px;
    height: 600px;
    top: 5%;
    left: -10%;
    background: radial-gradient(circle, #174ee8 0%, transparent 70%);
  }

  .orb-2 {
    width: 700px;
    height: 700px;
    top: 40%;
    right: -15%;
    background: radial-gradient(circle, #38bdf8 0%, transparent 70%);
  }

  .orb-3 {
    width: 500px;
    height: 500px;
    bottom: 5%;
    left: 20%;
    background: radial-gradient(circle, #E7EEAC 0%, transparent 70%);
  }

  .showcase-shell {
    position: relative;
    max-width: 1380px;
    margin: 0 auto;
    z-index: 1;
  }

  /* ─── Hero Header ─── */
  .showcase-hero-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto clamp(50px, 7vw, 84px);
  }

  .showcase-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 7px 18px;
    border-radius: 9999px;
    font-family: 'Space Grotesk', monospace;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #E7EEAC;
    text-transform: uppercase;
    margin-bottom: 20px;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .eyebrow-spark {
    color: #38bdf8;
    font-size: 0.8rem;
  }

  .showcase-main-title {
    font-family: 'Space Grotesk', 'Poppins', sans-serif;
    font-size: clamp(2.5rem, 5.2vw, 4.4rem);
    font-weight: 900;
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin: 0 0 18px;
  }

  .showcase-lead-text {
    font-family: 'Poppins', -apple-system, sans-serif;
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.6;
    color: #94a3b8;
    max-width: 720px;
    margin: 0 auto clamp(36px, 5vw, 48px);
  }

  /* ─── Segmented Pill Switcher Dock (Apple Style) ─── */
  .showcase-segmented-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px;
    background: rgba(15, 23, 42, 0.75);
    border: 1.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    backdrop-filter: blur(20px);
    box-shadow: 
      0 12px 30px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .showcase-segmented-nav::-webkit-scrollbar {
    display: none;
  }

  .showcase-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    padding: 10px 18px;
    border-radius: 9999px;
    color: #94a3b8;
    font-family: 'Poppins', sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .showcase-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .showcase-tab.is-active {
    background: #E7EEAC;
    color: #090e1a;
    box-shadow: 0 4px 16px rgba(231, 238, 172, 0.4);
  }

  .showcase-tab .tab-count {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    color: currentColor;
    transition: background 0.2s ease;
  }

  .showcase-tab.is-active .tab-count {
    background: rgba(9, 14, 26, 0.15);
  }

  /* ─── Chapters Stream ─── */
  .showcase-chapters-stream {
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 8vw, 100px);
  }

  .showcase-chapter-block {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 42px);
  }

  /* Chapter Billboard */
  .chapter-billboard {
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .chapter-meta-line {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Space Grotesk', monospace;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .chapter-index {
    color: #E7EEAC;
  }

  .chapter-divider {
    color: rgba(255, 255, 255, 0.3);
  }

  .chapter-badge {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    padding: 3px 10px;
    border-radius: 6px;
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  .chapter-headline-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .chapter-title {
    font-family: 'Space Grotesk', 'Poppins', sans-serif;
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .chapter-subtext {
    font-family: 'Poppins', sans-serif;
    font-size: 0.96rem;
    color: #94a3b8;
    max-width: 520px;
    margin: 0;
    line-height: 1.5;
  }

  /* ─── Showcase Artifacts Grid ─── */
  .showcase-artifacts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: clamp(24px, 3.2vw, 36px);
  }

  /* ─── The Showcase Card (Apple Industrial × Nike SNKRS) ─── */
  .showcase-card {
    position: relative;
    background: rgba(15, 23, 42, 0.65);
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    border-radius: 28px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(14px);
    box-shadow: 
      0 12px 32px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 0.28s ease,
                box-shadow 0.28s ease;
    overflow: hidden;
  }

  .showcase-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 
      0 20px 48px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(56, 189, 248, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  /* Flagship Piece Emphasis */
  .showcase-card.is-flagship-piece {
    border-color: rgba(231, 238, 172, 0.45);
    background: linear-gradient(180deg, rgba(23, 78, 232, 0.18) 0%, rgba(15, 23, 42, 0.75) 100%);
  }

  .showcase-card.is-flagship-piece:hover {
    border-color: #E7EEAC;
    box-shadow: 
      0 20px 48px rgba(0, 0, 0, 0.55),
      0 0 36px rgba(231, 238, 172, 0.25);
  }

  /* Card Status Bar */
  .card-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
    z-index: 2;
  }

  .card-num-stamp {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #ffffff;
  }

  .card-num-stamp .num-of {
    color: #64748b;
    font-weight: 600;
  }

  .card-pill-tag {
    font-family: 'Poppins', sans-serif;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 4px 11px;
    border-radius: 9999px;
  }

  .card-pill-tag.tag-flagship {
    background: #E7EEAC;
    color: #090e1a;
    box-shadow: 0 2px 8px rgba(231, 238, 172, 0.35);
  }

  .card-pill-tag.tag-standard {
    background: rgba(255, 255, 255, 0.08);
    color: #94a3b8;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* ─── Sculptural Product Pedestal ─── */
  .card-pedestal-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1.05;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    margin-bottom: 20px;
    cursor: pointer;
    overflow: hidden;
  }

  .pedestal-glow {
    position: absolute;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.18) 0%, transparent 70%);
    filter: blur(24px);
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .showcase-card:hover .pedestal-glow {
    transform: scale(1.3);
    opacity: 0.35;
  }

  .showcase-card.is-flagship-piece .pedestal-glow {
    background: radial-gradient(circle, rgba(231, 238, 172, 0.25) 0%, transparent 70%);
  }

  .pedestal-product-img {
    width: 86%;
    height: 86%;
    object-fit: contain;
    z-index: 1;
    filter: drop-shadow(0 14px 24px rgba(0, 0, 0, 0.45));
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .showcase-card:hover .pedestal-product-img {
    transform: translateY(-6px) scale(1.06);
  }

  /* Interactive Quick Glance Cue */
  .pedestal-quick-cue {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 9999px;
    padding: 4px 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    color: #e2e8f0;
    z-index: 2;
    backdrop-filter: blur(8px);
    opacity: 0.75;
    transition: all 0.2s ease;
  }

  .showcase-card:hover .pedestal-quick-cue {
    opacity: 1;
    background: #E7EEAC;
    color: #090e1a;
    border-color: #E7EEAC;
  }

  /* ─── Editorial Body ─── */
  .card-editorial-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title-group {
    margin-bottom: 8px;
  }

  .card-title {
    font-family: 'Space Grotesk', 'Poppins', sans-serif;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 4px;
    transition: color 0.2s ease;
  }

  .showcase-card:hover .card-title {
    color: #E7EEAC;
  }

  .card-slogan-inline {
    font-family: 'Poppins', sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    color: #38bdf8;
    display: block;
    margin-bottom: 4px;
  }

  .card-narrative {
    font-family: 'Poppins', sans-serif;
    font-size: 0.88rem;
    line-height: 1.5;
    color: #94a3b8;
    margin: 0 0 16px;
    flex-grow: 1;
  }

  /* Apple-Style Key Specs Strip */
  .card-specs-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .spec-capsule {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    padding: 3px 9px;
    border-radius: 6px;
    font-family: 'Space Grotesk', monospace;
    font-size: 0.7rem;
  }

  .spec-k {
    color: #64748b;
    font-weight: 600;
  }

  .spec-v {
    color: #cbd5e1;
    font-weight: 700;
  }

  /* ─── Showcase Action Bar ─── */
  .card-action-bar {
    display: flex;
    align-items: center;
    gap: 10px;
