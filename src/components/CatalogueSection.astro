<style>
  /* ═══════════════════════════════════════════════════════════
     LIGHT THEME LIFESTYLE SHOWCASE — PAUCEK STUDIO INSPIRATION
     Palette:
     - Warm Sand / Cream Background: #F3EFE6
     - Deep Forest Pine Block: #264639
     - Crisp Optical White: #FFFFFF
     - Sage / Lime Accent: #E7EEAC / #7E9F6E
     - Deep Slate Text: #16241D
     ═══════════════════════════════════════════════════════════ */
  .section-showcase-light {
    position: relative;
    width: 100%;
    padding: clamp(70px, 8vw, 120px) 24px clamp(80px, 9vw, 130px);
    background-color: #F3EFE6; /* Warm organic sand/cream as in attached design */
    color: #16241D;
    overflow: hidden;
  }

  /* Topographic Contour Watermark Background */
  .topographic-wave-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .topo-svg {
    position: absolute;
    pointer-events: none;
    width: 480px;
    height: 480px;
    opacity: 0.75;
  }

  .topo-top-left {
    top: -60px;
    left: -60px;
  }

  .topo-bottom-right {
    bottom: -80px;
    right: -60px;
  }

  .showcase-shell {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
    z-index: 1;
  }

  /* ─── Light Editorial Header ─── */
  .showcase-light-header {
    text-align: center;
    max-width: 840px;
    margin: 0 auto clamp(36px, 5vw, 56px);
  }

  .light-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(38, 70, 57, 0.08);
    border: 1.5px solid rgba(38, 70, 57, 0.16);
    padding: 6px 18px;
    border-radius: 9999px;
    font-family: 'Space Grotesk', monospace;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #264639;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #264639;
  }

  .showcase-light-title {
    font-family: 'Space Grotesk', 'Poppins', sans-serif;
    font-size: clamp(2.4rem, 4.8vw, 4rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #16241D;
    margin: 0 0 16px;
  }

  .showcase-light-desc {
    font-family: 'Poppins', -apple-system, sans-serif;
    font-size: clamp(0.98rem, 1.3vw, 1.15rem);
    line-height: 1.6;
    color: #4A5F53;
    max-width: 680px;
    margin: 0 auto clamp(28px, 4vw, 40px);
  }

  /* ─── Light Segmented Navigation Dock ─── */
  .light-segmented-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px;
    background: #EAE5D9;
    border: 1.5px solid #DDD7CA;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(38, 70, 57, 0.06);
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .light-segmented-nav::-webkit-scrollbar {
    display: none;
  }

  .light-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    padding: 10px 18px;
    border-radius: 9999px;
    color: #4D6356;
    font-family: 'Poppins', sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .light-tab:hover {
    color: #16241D;
    background: rgba(255, 255, 255, 0.5);
  }

  .light-tab.is-active {
    background: #264639; /* Deep Forest Pine */
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(38, 70, 57, 0.25);
  }

  .light-tab .tab-count {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.2);
    color: currentColor;
  }

  .light-tab.is-active .tab-count {
    background: #E7EEAC;
    color: #16241D;
  }

  /* ═══════════════════════════════════════════════════════════
     BENTO SHOWCASE STAGE (INSPIRED BY PAUCEK STUDIO DESIGN)
     ═══════════════════════════════════════════════════════════ */
  .light-showcase-stage {
    background: #FAF8F4;
    border: 2px solid #E3DDD0;
    border-radius: 36px;
    padding: clamp(24px, 4vw, 44px);
    box-shadow: 
      0 20px 48px rgba(38, 70, 57, 0.08),
      0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .stage-top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    margin-bottom: 28px;
    border-bottom: 1.5px solid #EAE5D9;
    font-family: 'Space Grotesk', monospace;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .stage-brand-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #264639;
  }

  .brand-badge-icon {
    color: #7E9F6E;
  }

  .stage-counter-pill {
    color: #264639;
    background: #EAE5D9;
    border: 1px solid #DDD7CA;
    padding: 4px 12px;
    border-radius: 9999px;
  }

  /* Bento Feature Split */
  .bento-feature-split {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: stretch;
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  /* ─── Left: Deep Forest Pine Pedestal Card ─── */
  .bento-pedestal-card {
    position: relative;
    background: #264639; /* Deep Forest Green as in reference image */
    border-radius: 32px;
    padding: clamp(24px, 3.5vw, 36px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #ffffff;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 16px 36px rgba(38, 70, 57, 0.22);
    transition: transform 0.28s ease, box-shadow 0.28s ease;
  }

  .bento-pedestal-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 48px rgba(38, 70, 57, 0.3);
  }

  .pedestal-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 2;
  }

  .pedestal-cat-name {
    font-family: 'Poppins', sans-serif;
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    background: rgba(255, 255, 255, 0.14);
    padding: 5px 14px;
    border-radius: 9999px;
    color: #E7EEAC;
  }

  .pedestal-item-num {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.8rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Rotating Seal Stamp */
  .pedestal-seal-stamp {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 82px;
    height: 82px;
    z-index: 3;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .seal-svg {
    width: 100%;
    height: 100%;
    animation: rotatingSeal 20s linear infinite;
  }

  @keyframes rotatingSeal {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .seal-text {
    font-family: 'Space Grotesk', monospace;
    font-size: 10.5px;
    font-weight: 800;
    fill: #E7EEAC;
    letter-spacing: 0.14em;
  }

  .seal-center-star {
    position: absolute;
    color: #E7EEAC;
    font-size: 0.85rem;
  }

  /* Product Floating Image */
  .pedestal-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 2;
  }

  .pedestal-floating-img {
    width: 88%;
    height: 88%;
    object-fit: contain;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.35));
    animation: appleLevitate 5s ease-in-out infinite;
    transition: opacity 0.25s ease, transform 0.3s ease;
  }

  @keyframes appleLevitate {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  .pedestal-bottom-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
