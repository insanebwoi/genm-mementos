---
// ═══════════════════════════════════════════════════════════
// GEN M 2026 — BESPOKE EDITORIAL HERO ILLUSTRATION
// Floating Smartphone, Open Book, Compass, Connected Nodes, Crescent
// ═══════════════════════════════════════════════════════════
---

<div class="hero-illustration-wrapper" aria-hidden="true">
  <svg
    class="hero-illustration-svg"
    viewBox="0 0 660 560"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Shadows -->
      <filter id="phoneShadow" x="-20%" y="-15%" width="145%" height="140%">
        <feDropShadow dx="12" dy="24" stdDeviation="22" flood-color="#232863" flood-opacity="0.14" />
        <feDropShadow dx="4" dy="8" stdDeviation="8" flood-color="#5961b4" flood-opacity="0.08" />
      </filter>

      <filter id="objectShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="4" dy="10" stdDeviation="10" flood-color="#232863" flood-opacity="0.1" />
      </filter>

      <!-- Gradients -->
      <linearGradient id="phoneBorderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ffffff" />
        <stop offset="50%" stop-color="#edf0f8" />
        <stop offset="100%" stop-color="#dce1ee" />
      </linearGradient>

      <linearGradient id="screenBgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ffffff" />
        <stop offset="100%" stop-color="#f5f7fc" />
      </linearGradient>

      <linearGradient id="confluenceWaveGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#5961B4" />
        <stop offset="60%" stop-color="#7078B8" />
        <stop offset="100%" stop-color="#81A773" />
      </linearGradient>

      <linearGradient id="sageAccentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#93C467" />
        <stop offset="100%" stop-color="#81A773" />
      </linearGradient>

      <linearGradient id="blueVioletGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#5961B4" />
        <stop offset="100%" stop-color="#232863" />
      </linearGradient>

      <linearGradient id="crescentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#81A773" />
        <stop offset="50%" stop-color="#93C467" />
        <stop offset="100%" stop-color="#E7EEAC" />
      </linearGradient>

      <linearGradient id="bookPageGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#ffffff" />
        <stop offset="100%" stop-color="#f0f3fa" />
      </linearGradient>
    </defs>

    <!-- ─── 1. DELICATE CURVED CONNECTING PATHS ─── -->
    <g class="connecting-paths" opacity="0.8">
      <!-- Path: Book -> Phone -->
      <path
        d="M 160 150 C 200 130, 230 160, 280 180"
        stroke="#5961B4"
        stroke-width="1.5"
        stroke-dasharray="4 6"
        stroke-opacity="0.35"
        class="pulse-path"
      />
      <!-- Path: Compass -> Phone -->
      <path
        d="M 175 390 C 210 380, 235 340, 270 310"
        stroke="#81A773"
        stroke-width="1.5"
        stroke-dasharray="4 6"
        stroke-opacity="0.45"
        class="pulse-path"
      />
      <!-- Path: Phone -> Crescent (Top Right) -->
      <path
        d="M 430 190 C 470 170, 480 130, 500 110"
        stroke="#5961B4"
        stroke-width="1.5"
        stroke-dasharray="4 6"
        stroke-opacity="0.35"
        class="pulse-path"
      />
      <!-- Path: Phone -> Connected Nodes (Mid Right) -->
      <path
        d="M 450 310 C 480 320, 500 300, 520 290"
        stroke="#81A773"
        stroke-width="1.5"
        stroke-dasharray="4 6"
        stroke-opacity="0.45"
        class="pulse-path"
      />
      <!-- Background Ambient Geometric Ring -->
      <ellipse
        cx="340"
        cy="290"
        rx="230"
        ry="190"
        stroke="rgba(89, 97, 180, 0.08)"
        stroke-width="1.2"
        stroke-dasharray="8 8"
      />
    </g>

    <!-- ─── 2. FLOATING OBJECT: MINIMAL OPEN BOOK (Knowledge) ─── -->
    <g class="float-item float-book" transform="translate(75, 95)" filter="url(#objectShadow)">
      <!-- Left Page -->
      <path
        d="M 68 55 C 50 48, 26 50, 10 56 C 8 57, 6 59, 6 62 L 6 98 C 22 93, 48 91, 68 98 Z"
        fill="url(#bookPageGrad)"
        stroke="#5961B4"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <!-- Right Page -->
      <path
        d="M 68 55 C 86 48, 110 50, 126 56 C 128 57, 130 59, 130 62 L 130 98 C 114 93, 88 91, 68 98 Z"
        fill="#ffffff"
        stroke="#5961B4"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <!-- Spine & Bookmark Ribbon -->
      <path d="M 68 55 L 68 104" stroke="#232863" stroke-width="2" stroke-linecap="round" />
      <path d="M 68 55 C 72 65, 74 78, 80 84 L 75 83 L 73 90 Z" fill="#81A773" />
      <!-- Editorial Page Lines -->
      <line x1="22" y1="68" x2="52" y2="65" stroke="rgba(89, 97, 180, 0.25)" stroke-width="1.5" stroke-linecap="round" />
      <line x1="22" y1="77" x2="48" y2="74" stroke="rgba(89, 97, 180, 0.25)" stroke-width="1.5" stroke-linecap="round" />
      <line x1="84" y1="65" x2="114" y2="68" stroke="rgba(89, 97, 180, 0.25)" stroke-width="1.5" stroke-linecap="round" />
      <line x1="84" y1="74" x2="110" y2="77" stroke="rgba(89, 97, 180, 0.25)" stroke-width="1.5" stroke-linecap="round" />
      <!-- Small Spark of Knowledge -->
      <circle cx="120" cy="42" r="3" fill="#81A773" />
      <path d="M 120 34 L 120 50 M 112 42 L 128 42" stroke="#81A773" stroke-width="1.2" stroke-linecap="round" opacity="0.7" />
    </g>

    <!-- ─── 3. FLOATING OBJECT: PRECISION COMPASS (Direction & Purpose) ─── -->
    <g class="float-item float-compass" transform="translate(85, 330)" filter="url(#objectShadow)">
      <!-- Outer Dial -->
      <circle cx="55" cy="55" r="46" fill="#ffffff" stroke="#5961B4" stroke-width="1.8" />
      <circle cx="55" cy="55" r="40" fill="#f8fafc" stroke="rgba(89, 97, 180, 0.2)" stroke-width="1" stroke-dasharray="2 3" />
      <!-- Cardinal Ticks -->
      <line x1="55" y1="18" x2="55" y2="24" stroke="#5961B4" stroke-width="2" stroke-linecap="round" />
      <line x1="55" y1="86" x2="55" y2="92" stroke="#81A773" stroke-width="1.5" stroke-linecap="round" />
      <line x1="18" y1="55" x2="24" y2="55" stroke="rgba(89, 97, 180, 0.5)" stroke-width="1.5" stroke-linecap="round" />
      <line x1="86" y1="55" x2="92" y2="55" stroke="rgba(89, 97, 180, 0.5)" stroke-width="1.5" stroke-linecap="round" />
      <!-- Cardinal "N" Label -->
      <text x="55" y="32" font-family="'Space Grotesk Variable', sans-serif" font-size="9" font-weight="700" fill="#5961B4" text-anchor="middle">N</text>
      <!-- Purpose Needle (Angled toward Purpose) -->
      <g class="compass-needle" transform="rotate(-28 55 55)">
        <!-- North Arrow (Blue-Violet) -->
        <polygon points="55,22 61,55 55,51" fill="#5961B4" />
        <polygon points="55,22 49,55 55,51" fill="#232863" />
        <!-- South Arrow (Sage Green) -->
        <polygon points="55,88 61,55 55,59" fill="#81A773" />
        <polygon points="55,88 49,55 55,59" fill="#93C467" />
        <!-- Center Pivot -->
        <circle cx="55" cy="55" r="4.5" fill="#ffffff" stroke="#232863" stroke-width="2" />
        <circle cx="55" cy="55" r="2" fill="#5961B4" />
      </g>
    </g>

    <!-- ─── 4. FLOATING OBJECT: ABSTRACT CRESCENT (Faith) ─── -->
    <g class="float-item float-crescent" transform="translate(470, 50)" filter="url(#objectShadow)">
      <!-- Pure geometric double-arc crescent -->
      <path
        d="M 50 15 
           C 74 15, 92 34, 92 58 
           C 92 82, 74 101, 50 101 
           C 40 101, 31 97, 24 91 
           C 42 88, 56 74, 56 58 
           C 56 42, 42 28, 24 25 
           C 31 19, 40 15, 50 15 Z"
        fill="url(#crescentGrad)"
        stroke="#ffffff"
        stroke-width="1.8"
      />
      <!-- Small celestial accent node -->
      <circle cx="48" cy="58" r="3.5" fill="#5961B4" />
    </g>

    <!-- ─── 5. FLOATING OBJECT: CONNECTED NODES (Community & Generation) ─── -->
    <g class="float-item float-nodes" transform="translate(480, 240)" filter="url(#objectShadow)">
      <!-- Connecting Network Lines -->
      <line x1="30" y1="35" x2="80" y2="25" stroke="#5961B4" stroke-width="1.8" stroke-linecap="round" />
      <line x1="80" y1="25" x2="105" y2="70" stroke="#81A773" stroke-width="1.8" stroke-linecap="round" />
      <line x1="30" y1="35" x2="55" y2="85" stroke="#81A773" stroke-width="1.8" stroke-linecap="round" />
      <line x1="55" y1="85" x2="105" y2="70" stroke="#5961B4" stroke-width="1.8" stroke-linecap="round" />
      <!-- Central Node -->
      <circle cx="30" cy="35" r="12" fill="#ffffff" stroke="#5961B4" stroke-width="2.5" />
      <circle cx="30" cy="35" r="5" fill="#5961B4" />
      <!-- Node 2 (Top Right) -->
      <circle cx="80" cy="25" r="9" fill="#ffffff" stroke="#81A773" stroke-width="2" />
      <circle cx="80" cy="25" r="4" fill="#81A773" />
      <!-- Node 3 (Bottom Right) -->
      <circle cx="105" cy="70" r="14" fill="#ffffff" stroke="#5961B4" stroke-width="2.5" />
      <circle cx="105" cy="70" r="6" fill="#232863" />
      <!-- Node 4 (Bottom Left) -->
      <circle cx="55" cy="85" r="10" fill="#ffffff" stroke="#81A773" stroke-width="2" />
      <circle cx="55" cy="85" r="4" fill="#93C467" />
    </g>

    <!-- ─── 6. FLOATING GEN M GEOMETRIC FRAGMENTS ─── -->
    <g class="fragments" opacity="0.85">
      <!-- Top Left Pill -->
      <rect x="180" y="70" width="28" height="12" rx="6" fill="#E7EEAC" transform="rotate(-15 180 70)" />
      <!-- Mid-Left Small Dot -->
      <circle cx="110" cy="250" r="5" fill="#81A773" />
      <!-- Bottom Center Dot -->
      <circle cx="310" cy="510" r="4" fill="#5961B4" opacity="0.6" />
      <!-- Right Floating Ring -->
      <circle cx="550" cy="410" r="10" fill="none" stroke="#5961B4" stroke-width="2" stroke-dasharray="3 3" />
      <!-- Upper Floating Pill -->
      <rect x="420" y="40" width="34" height="14" rx="7" fill="#81A773" opacity="0.75" />
    </g>

    <!-- ─── 7. MAIN VISUAL: FLOATING SMARTPHONE AT EDITORIAL ANGLE ─── -->
    <g class="float-item float-phone" transform="translate(230, 45)" filter="url(#phoneShadow)">
      <!-- Outer Phone Body / Chassis (Angled -5 degrees) -->
      <g transform="rotate(-5 125 240)">
        <!-- External Chassis (Depth effect) -->
        <rect
          x="0"
          y="0"
          width="246"
          height="464"
          rx="40"
          fill="url(#phoneBorderGrad)"
          stroke="rgba(35, 40, 99, 0.16)"
          stroke-width="1.8"
        />

        <!-- Screen Frame -->
        <rect
          x="7"
          y="7"
          width="232"
          height="450"
          rx="34"
          fill="url(#screenBgGrad)"
        />

        <!-- Subtle Screen Inner Rim Stroke -->
        <rect
          x="7"
          y="7"
          width="232"
          height="450"
          rx="34"
          fill="none"
          stroke="rgba(89, 97, 180, 0.12)"
          stroke-width="1"
        />

        <!-- Dynamic Notch Island -->
        <rect x="88" y="16" width="70" height="18" rx="9" fill="#161824" />
        <circle cx="142" cy="25" r="3" fill="#232863" />

        <!-- ── Clean Abstract GEN M UI Elements on Screen ── -->
        
        <!-- Status Bar -->
        <text x="32" y="29" font-family="'Inter', sans-serif" font-size="10" font-weight="600" fill="#161824" opacity="0.75">09:14</text>
        <g transform="translate(186, 21)" fill="#161824" opacity="0.7">
          <path d="M 0 8 L 3 8 L 3 10 L 0 10 Z M 5 6 L 8 6 L 8 10 L 5 10 Z M 10 3 L 13 3 L 13 10 L 10 10 Z" />
          <rect x="18" y="1" width="16" height="8" rx="2" fill="none" stroke="#161824" stroke-width="1" />
          <rect x="20" y="3" width="10" height="4" rx="1" fill="#161824" />
        </g>

        <!-- Top Header Lockup Inside UI -->
        <g transform="translate(24, 52)">
          <rect x="0" y="0" width="76" height="24" rx="12" fill="#5961B4" />
          <text x="38" y="16" font-family="'Space Grotesk Variable', sans-serif" font-size="9" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="0.05em">GEN M</text>
          
          <rect x="84" y="0" width="60" height="24" rx="12" fill="#E7EEAC" />
          <text x="114" y="16" font-family="'Space Grotesk Variable', sans-serif" font-size="9" font-weight="700" fill="#232863" text-anchor="middle">2026</text>
        </g>

        <!-- Main Card: Abstract Confluence Wave Artwork -->
        <g transform="translate(24, 90)">
          <!-- Card Backdrop -->
          <rect x="0" y="0" width="198" height="180" rx="22" fill="#ffffff" stroke="rgba(89, 97, 180, 0.12)" stroke-width="1" />
          
          <!-- Abstract Confluence Wave Curves -->
          <path
            d="M 16 130 C 50 60, 90 150, 130 90 C 150 60, 170 80, 182 65"
            stroke="url(#confluenceWaveGrad)"
            stroke-width="5"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M 16 145 C 60 90, 100 160, 145 110 C 165 90, 175 100, 182 85"
            stroke="rgba(129, 167, 115, 0.45)"
            stroke-width="3"
            stroke-linecap="round"
            fill="none"
          />

          <!-- Floating Micro-node on Wave -->
          <circle cx="130" cy="90" r="5" fill="#81A773" stroke="#ffffff" stroke-width="2" />

          <!-- Card Header Text -->
          <text x="20" y="32" font-family="'Space Grotesk Variable', sans-serif" font-size="10" font-weight="700" fill="#5961B4" letter-spacing="0.08em">GENERATIONAL CONFLUENCE</text>
          <text x="20" y="50" font-family="'Poppins', sans-serif" font-size="13" font-weight="700" fill="#161824">Kerala Student Movement</text>
          
          <!-- Bottom Metadata Pill -->
          <g transform="translate(20, 142)">
            <rect x="0" y="0" width="158" height="22" rx="11" fill="#f1f3f9" />
            <circle cx="10" cy="11" r="3" fill="#81A773" />
            <text x="20" y="15" font-family="'Inter', sans-serif" font-size="8.5" font-weight="600" fill="#232863">Kozhikode • 13–15 Nov</text>
          </g>
        </g>

        <!-- Two Purpose Pills inside UI -->
        <!-- Pill 1: Rooted in Deen -->
        <g transform="translate(24, 286)">
          <rect x="0" y="0" width="198" height="42" rx="14" fill="#ffffff" stroke="rgba(129, 167, 115, 0.3)" stroke-width="1.2" />
          <circle cx="22" cy="21" r="7" fill="#81A773" />
          <circle cx="22" cy="21" r="3" fill="#ffffff" />
          <text x="38" y="24" font-family="'Space Grotesk Variable', sans-serif" font-size="10.5" font-weight="700" fill="#161824">Rooted in Deen</text>
          <path d="M 174 21 L 180 21 M 177 18 L 180 21 L 177 24" stroke="#81A773" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </g>

        <!-- Pill 2: Driven by Purpose -->
        <g transform="translate(24, 338)">
          <rect x="0" y="0" width="198" height="42" rx="14" fill="#ffffff" stroke="rgba(89, 97, 180, 0.3)" stroke-width="1.2" />
          <circle cx="22" cy="21" r="7" fill="#5961B4" />
          <polygon points="22,17 25,23 19,23" fill="#ffffff" />
          <text x="38" y="24" font-family="'Space Grotesk Variable', sans-serif" font-size="10.5" font-weight="700" fill="#161824">Driven by Purpose</text>
          <path d="M 174 21 L 180 21 M 177 18 L 180 21 L 177 24" stroke="#5961B4" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </g>

        <!-- Abstract Rhythm Bar at Bottom -->
        <g transform="translate(48, 396)">
          <rect x="0" y="4" width="12" height="12" rx="2" fill="#5961B4" opacity="0.6" />
          <rect x="18" y="0" width="12" height="16" rx="2" fill="#5961B4" />
          <rect x="36" y="6" width="12" height="10" rx="2" fill="#81A773" />
          <rect x="54" y="2" width="12" height="14" rx="2" fill="#5961B4" />
          <rect x="72" y="8" width="12" height="8" rx="2" fill="#81A773" opacity="0.8" />
          <rect x="90" y="1" width="12" height="15" rx="2" fill="#5961B4" />
          <rect x="108" y="5" width="12" height="11" rx="2" fill="#232863" />
          <rect x="126" y="3" width="12" height="13" rx="2" fill="#81A773" />
        </g>

        <!-- Home Indicator Bar -->
        <rect x="88" y="432" width="70" height="4" rx="2" fill="#161824" opacity="0.3" />
      </g>
    </g>
  </svg>
</div>

<style>
  .hero-illustration-wrapper {
    width: 100%;
    max-width: 620px;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    user-select: none;
    pointer-events: none;
  }

  .hero-illustration-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ─── Smooth Floating Animations ─── */
  .float-phone {
    animation: floatPhone 6s ease-in-out infinite;
    transform-origin: 350px 280px;
  }

  .float-book {
    animation: floatBook 5.2s ease-in-out infinite 0.6s;
    transform-origin: 140px 140px;
  }

  .float-compass {
    animation: floatCompass 5.8s ease-in-out infinite 1.2s;
    transform-origin: 140px 385px;
  }

  .float-crescent {
    animation: floatCrescent 6.4s ease-in-out infinite 0.3s;
    transform-origin: 520px 100px;
  }

  .float-nodes {
    animation: floatNodes 5.5s ease-in-out infinite 0.9s;
    transform-origin: 540px 290px;
  }

  .compass-needle {
    animation: needleWobble 7s ease-in-out infinite;
    transform-origin: 55px 55px;
  }

  .pulse-path {
    animation: dashPulse 4s ease-in-out infinite alternate;
  }

  /* ─── Keyframe Declarations ─── */
  @keyframes floatPhone {
    0%, 100% {
      transform: translate(230px, 45px);
    }
    50% {
      transform: translate(230px, 32px);
    }
  }

  @keyframes floatBook {
    0%, 100% {
      transform: translate(75px, 95px) rotate(0deg);
    }
    50% {
      transform: translate(75px, 83px) rotate(-1.5deg);
    }
  }

  @keyframes floatCompass {
    0%, 100% {
      transform: translate(85px, 330px) rotate(0deg);
    }
    50% {
      transform: translate(85px, 318px) rotate(1.8deg);
    }
  }

  @keyframes floatCrescent {
    0%, 100% {
      transform: translate(470px, 50px) rotate(0deg);
    }
    50% {
      transform: translate(470px, 40px) rotate(-2deg);
    }
  }

  @keyframes floatNodes {
    0%, 100% {
      transform: translate(480px, 240px) scale(1);
    }
    50% {
      transform: translate(480px, 228px) scale(1.02);
    }
  }

  @keyframes needleWobble {
    0%, 100% {
      transform: rotate(-28deg);
    }
    25% {
      transform: rotate(-24deg);
    }
    60% {
      transform: rotate(-33deg);
    }
    85% {
      transform: rotate(-26deg);
    }
  }

  @keyframes dashPulse {
    0% {
      stroke-opacity: 0.25;
    }
    100% {
      stroke-opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float-phone,
    .float-book,
    .float-compass,
    .float-crescent,
    .float-nodes,
    .compass-needle,
    .pulse-path {
      animation: none !important;
    }
  }
</style>
