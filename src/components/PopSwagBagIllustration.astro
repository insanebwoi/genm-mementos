---
// ═══════════════════════════════════════════════════════════
// GEN M SWAG — SIGNATURE MOGO-STYLE POP-ART SWAG BAG
// Cartoon gloved hand holding angled striped tote bursting with GEN M merch!
// ═══════════════════════════════════════════════════════════
---

<div class="pop-swag-stage" aria-label="GEN M Swag Bag Illustration">
  <svg
    class="pop-swag-svg"
    viewBox="0 0 680 620"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Shadow Filters -->
      <filter id="mogoShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="10" dy="18" stdDeviation="14" flood-color="#0a1d60" flood-opacity="0.4" />
      </filter>

      <!-- Diagonal Stripe Pattern for the Tote Bag Front Panel -->
      <pattern id="cyanStripesPattern" width="28" height="28" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
        <rect width="14" height="28" fill="#ffffff" />
        <rect x="14" width="14" height="28" fill="#38bdf8" />
      </pattern>

      <!-- Donut Gold Gradient -->
      <linearGradient id="donutGlaze" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#fcd34d" />
        <stop offset="100%" stop-color="#f59e0b" />
      </linearGradient>

      <!-- Cup Gradient -->
      <linearGradient id="cupYellow" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#fde047" />
        <stop offset="100%" stop-color="#eab308" />
      </linearGradient>
    </defs>

    <!-- ─── 1. FLOATING CHARMS & CONFETTI ─── -->
    <g class="floating-charms">
      <!-- Golden Glazed Donut (Top Right, matching screenshot) -->
      <g class="float-item charm-donut" transform="translate(540, 80)">
        <circle cx="28" cy="28" r="26" fill="url(#donutGlaze)" stroke="#0f172a" stroke-width="4" />
        <circle cx="28" cy="28" r="9" fill="#174ee8" stroke="#0f172a" stroke-width="3.5" />
        <!-- Sprinkles -->
        <rect x="16" y="16" width="8" height="3.5" rx="1.5" fill="#ffffff" transform="rotate(30 16 16)" />
        <rect x="36" y="18" width="7" height="3.5" rx="1.5" fill="#38bdf8" transform="rotate(-40 36 18)" />
        <rect x="22" y="40" width="8" height="3.5" rx="1.5" fill="#f43f5e" transform="rotate(20 22 40)" />
        <rect x="38" y="36" width="7" height="3.5" rx="1.5" fill="#ffffff" transform="rotate(-15 38 36)" />
      </g>

      <!-- Floating Chips & Pellets around composition -->
      <g class="float-item charm-chip-1" transform="translate(585, 185)">
        <ellipse cx="10" cy="16" rx="12" ry="6" fill="#f97316" stroke="#0f172a" stroke-width="3" transform="rotate(-30 10 16)" />
      </g>

      <g class="float-item charm-chip-2" transform="translate(600, 115)">
        <ellipse cx="6" cy="8" rx="7" ry="4" fill="#ffffff" stroke="#0f172a" stroke-width="2.5" transform="rotate(25 6 8)" />
      </g>

      <g class="float-item charm-chip-3" transform="translate(290, 205)">
        <ellipse cx="10" cy="18" rx="14" ry="7" fill="#f97316" stroke="#0f172a" stroke-width="3" transform="rotate(45 10 18)" />
      </g>

      <g class="float-item charm-chip-4" transform="translate(275, 400)">
        <ellipse cx="16" cy="12" rx="16" ry="8" fill="#fbbf24" stroke="#0f172a" stroke-width="3" transform="rotate(15 16 12)" />
      </g>

      <g class="float-item charm-chip-5" transform="translate(390, 420)">
        <ellipse cx="8" cy="14" rx="11" ry="6" fill="#f97316" stroke="#0f172a" stroke-width="3" transform="rotate(-40 8 14)" />
      </g>
    </g>

    <!-- ─── 2. MAIN SWAG RIG (ANGLED COMPOSITION) ─── -->
    <g class="main-swag-rig" filter="url(#mogoShadow)">

      <!-- 2A. CARTOON SLEEVE & GLOVE EXTENDING FROM TOP -->
      <g class="arm-glove-assembly">
        <!-- Light Blue Sleeve coming from top ceiling -->
        <path
          d="M 345 -10 
             C 345 50, 360 90, 385 125 
             L 412 118 
             C 390 80, 375 40, 372 -10 Z"
          fill="#38bdf8"
          stroke="#0f172a"
          stroke-width="5"
          stroke-linejoin="round"
        />

        <!-- White Glove Cuff -->
        <path
          d="M 374 112 
             C 368 126, 395 146, 420 134 
             C 430 126, 422 114, 406 110 Z"
          fill="#ffffff"
          stroke="#0f172a"
          stroke-width="4.5"
        />

        <!-- White Cartoon Glove (Grip Pose) -->
        <g class="glove-hand">
          <path
            d="M 375 128 
               C 358 135, 348 158, 364 174 
               C 378 186, 396 182, 406 170 
               C 424 180, 448 166, 440 144 
               C 434 133, 418 124, 404 128 Z"
            fill="#ffffff"
            stroke="#0f172a"
            stroke-width="5"
            stroke-linejoin="round"
          />
          <!-- 3 Iconic Comic Creases on Glove -->
          <path d="M 384 148 C 392 155, 400 155, 408 148" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none" />
          <path d="M 392 158 C 398 164, 405 164, 412 157" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none" />
          <path d="M 403 167 C 409 171, 415 169, 419 163" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none" />
        </g>
      </g>

      <!-- 2B. TOTE BAG HANDLES -->
      <path
        d="M 378 165 
           C 355 205, 350 250, 368 285 
           L 384 278 
           C 368 248, 372 205, 392 168 Z"
        fill="#ffffff"
        stroke="#0f172a"
        stroke-width="4.5"
      />
      <path
        d="M 416 160 
           C 438 195, 465 225, 498 248 
           L 508 232 
           C 478 210, 452 178, 430 154 Z"
        fill="#ffffff"
        stroke="#0f172a"
        stroke-width="4.5"
      />

      <!-- 2C. ITEMS BURSTING OUT OF THE BAG MOUTH (BEHIND BAG FRONT) -->
      <g class="bursting-items-stage">

        <!-- Retro Orange Screen Robot Mascot with Waving Arm -->
        <g class="retro-robot" transform="translate(485, 125) rotate(16)">
          <!-- Body -->
          <rect x="0" y="0" width="62" height="74" rx="14" fill="#ea580c" stroke="#0f172a" stroke-width="4.5" />
          <!-- Screen Face -->
          <rect x="8" y="10" width="46" height="46" rx="9" fill="#38bdf8" stroke="#0f172a" stroke-width="3.5" />
          <!-- Waving Cartoon Arm -->
          <path d="M 58 18 C 82 8, 92 -8, 88 -20" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round" fill="none" />
          <circle cx="89" cy="-22" r="9" fill="#ffffff" stroke="#0f172a" stroke-width="3.5" />
          <!-- Eyes on screen -->
          <circle cx="22" cy="30" r="4" fill="#ffffff" />
          <circle cx="38" cy="30" r="4" fill="#ffffff" />
          <path d="M 26 42 Q 30 46 34 42" stroke="#ffffff" stroke-width="2.5" fill="none" stroke-linecap="round" />
        </g>

        <!-- Cool Cyan Character Mascot (Taking Selfie in Bag) -->
        <g class="selfie-mascot" transform="translate(425, 175)">
          <!-- Cyan Blob Body -->
          <ellipse cx="60" cy="70" rx="46" ry="54" fill="#38bdf8" stroke="#0f172a" stroke-width="5" />
          
          <!-- Cap (Deep Blue with Yellow Visor) -->
          <g class="mascot-cap" transform="translate(18, -4)">
            <path
              d="M 12 40 C 10 12, 70 8, 80 38 Z"
              fill="#232863"
              stroke="#0f172a"
              stroke-width="4.5"
            />
            <path
              d="M 10 40 C -2 44, -14 52, -6 60 C 12 60, 48 46, 54 42 Z"
              fill="#fed700"
              stroke="#0f172a"
              stroke-width="4"
            />
            <text x="48" y="32" font-family="'Space Grotesk Variable', sans-serif" font-size="8" font-weight="900" fill="#ffffff" text-anchor="middle">GEN M</text>
          </g>

          <!-- White DJ Headphones -->
          <circle cx="16" cy="65" r="13" fill="#ffffff" stroke="#0f172a" stroke-width="4" />
          <path d="M 16 52 C 22 26, 85 24, 94 48" stroke="#ffffff" stroke-width="4.5" stroke-linecap="round" fill="none" />
          <circle cx="94" cy="65" r="13" fill="#ffffff" stroke="#0f172a" stroke-width="4" />

          <!-- Cool Gold Sunglasses -->
          <g class="sunglasses" transform="translate(32, 45)">
            <polygon points="0,6 22,4 24,22 2,26" fill="#f59e0b" stroke="#0f172a" stroke-width="3.5" />
            <line x1="22" y1="8" x2="36" y2="8" stroke="#0f172a" stroke-width="4" stroke-linecap="round" />
            <polygon points="36,4 58,6 56,26 34,22" fill="#f59e0b" stroke="#0f172a" stroke-width="3.5" />
            <!-- Lens Reflections -->
            <line x1="4" y1="11" x2="18" y2="9" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
            <line x1="40" y1="9" x2="54" y2="11" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
          </g>

          <!-- Smug Smile -->
          <path d="M 54 78 C 60 84, 70 82, 74 76" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none" />

          <!-- Hand Holding White Phone -->
          <g transform="translate(6, 70) rotate(-18)">
            <rect x="0" y="0" width="24" height="42" rx="6" fill="#ffffff" stroke="#0f172a" stroke-width="3.5" />
            <rect x="3" y="5" width="18" height="32" rx="4" fill="#38bdf8" />
            <circle cx="3" cy="20" r="9" fill="#ffffff" stroke="#0f172a" stroke-width="3" />
          </g>
        </g>

        <!-- Yellow Coffee Cup with Straw & Lid -->
        <g class="pop-coffee-cup" transform="translate(370, 275) rotate(-24)">
          <!-- Lid Rim -->
          <ellipse cx="30" cy="14" rx="28" ry="10" fill="#f97316" stroke="#0f172a" stroke-width="4" />
          <ellipse cx="30" cy="10" rx="22" ry="7" fill="#ea580c" stroke="#0f172a" stroke-width="3" />
          <!-- Angled Straw -->
          <line x1="30" y1="10" x2="30" y2="-22" stroke="#0f172a" stroke-width="5.5" stroke-linecap="round" />
          <line x1="30" y1="-22" x2="46" y2="-36" stroke="#0f172a" stroke-width="5.5" stroke-linecap="round" />
          <!-- Cup Body (Yellow) -->
          <path
            d="M 6 14 L 14 82 C 14 88, 46 88, 46 82 L 54 14 Z"
            fill="url(#cupYellow)"
            stroke="#0f172a"
            stroke-width="4"
          />
          <!-- Cup Sleeve / Band -->
          <path d="M 9 38 L 12 58 L 48 58 L 51 38 Z" fill="#232863" stroke="#0f172a" stroke-width="3" />
          <text x="30" y="51" font-family="'Space Grotesk Variable', sans-serif" font-size="8" font-weight="900" fill="#ffffff" text-anchor="middle">GEN M</text>
        </g>

        <!-- Folded Merch Fabric / White T-shirt Over Rim -->
        <g class="folded-apparel" transform="translate(325, 340) rotate(-20)">
          <!-- Orange Folded Layer -->
          <path
            d="M 0 0 C 20 -15, 60 -10, 75 10 L 65 40 C 45 25, 15 20, -5 30 Z"
            fill="#f97316"
            stroke="#0f172a"
            stroke-width="4"
            stroke-linejoin="round"
          />
          <!-- Yellow Folded Layer -->
          <path
            d="M 10 22 C 28 8, 65 14, 80 30 L 70 54 C 55 40, 25 35, 5 44 Z"
            fill="#fed700"
            stroke="#0f172a"
            stroke-width="4"
            stroke-linejoin="round"
          />
        </g>

      </g> <!-- end bursting-items-stage -->


      <!-- 2D. THE GIANT ANGLED TOTE BAG (FRONT & SIDE FACES) -->
      <g class="tote-bag-geometry" transform="translate(390, 245) rotate(-18)">
        
        <!-- Bag Interior Dark Opening -->
        <polygon
          points="0,30 160,-30 250,15 90,80"
          fill="#172554"
          stroke="#0f172a"
          stroke-width="5"
          stroke-linejoin="round"
        />

        <!-- Side Depth / Left Gusset -->
        <polygon
          points="0,30 90,80 65,300 -25,240"
          fill="#e2e8f0"
          stroke="#0f172a"
          stroke-width="5"
          stroke-linejoin="round"
        />
        <!-- Gusset Shadow Crease -->
        <polygon
          points="10,55 90,80 65,300 0,265"
          fill="rgba(15, 23, 42, 0.08)"
        />

        <!-- Bag Main Front Face (Pure White Body) -->
        <polygon
          points="90,80 250,15 225,235 65,300"
          fill="#ffffff"
          stroke="#0f172a"
          stroke-width="5.5"
          stroke-linejoin="round"
        />

        <!-- Centered Inset Diagonal Striped Panel (The Iconic MOGO Tote Pattern!) -->
        <polygon
          points="110,95 230,45 210,215 90,265"
          fill="url(#cyanStripesPattern)"
          stroke="#0f172a"
          stroke-width="4"
          stroke-linejoin="round"
        />

        <!-- Bottom Gusset Corner Line -->
        <path d="M 65 300 L 52 276" stroke="#0f172a" stroke-width="4" stroke-linecap="round" />
      </g>

    </g> <!-- end main-swag-rig -->

  </svg>
</div>

<style>
  .pop-swag-stage {
    width: 100%;
    max-width: 640px;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    user-select: none;
  }

  .pop-swag-svg {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 20px 30px rgba(10, 29, 96, 0.35));
  }

  /* ─── Playful Bobbing Float Animation on Charms ─── */
  .float-item {
    animation: charmBob 3.5s ease-in-out infinite alternate;
  }

  .charm-donut {
    animation-delay: 0s;
    transform-origin: center;
  }

  .charm-chip-1 {
    animation-delay: 0.5s;
  }

  .charm-chip-2 {
    animation-delay: 1.1s;
  }

  .charm-chip-3 {
    animation-delay: 1.7s;
  }

  .charm-chip-4 {
    animation-delay: 0.8s;
  }

  .charm-chip-5 {
    animation-delay: 1.4s;
  }

  @keyframes charmBob {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    100% {
      transform: translateY(-10px) rotate(4deg);
    }
  }

  /* ─── Gentle Hover Float on Entire Bag Rig ─── */
  .main-swag-rig {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: 390px 120px;
  }

  .pop-swag-stage:hover .main-swag-rig {
    transform: translateY(-8px) rotate(1.2deg);
  }
</style>
