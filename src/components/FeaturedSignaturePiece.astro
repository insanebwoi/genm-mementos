---
import { PRODUCTS } from '../data/products';

interface Props {
  productId?: string;
}

const { productId = 'white-tshirt' } = Astro.props;
const product = PRODUCTS.find((p) => p.id === productId) || PRODUCTS.find((p) => p.id === 'white-tshirt')!;
---

<section class="story-signature-section" id="featured-piece" aria-label="Signature Piece Story">
  
  <!-- ═══════════════════════════════════════════════════════════
       1. SUBTLE MINIMALIST MARQUEE BAND (CLEAN TICKER)
       ═══════════════════════════════════════════════════════════ -->
  <div class="story-ticker" aria-hidden="true">
    <div class="story-ticker-track">
      <span>ROOTED IN DEEN. DRIVEN BY PURPOSE.</span>
      <span class="ticker-bullet">✦</span>
      <span>13 OFFICIAL MERCHANDISE PIECES</span>
      <span class="ticker-bullet">✦</span>
      <span>MSM KERALA • GEN M 2026</span>
      <span class="ticker-bullet">✦</span>
      <span>KOZHIKODE • 13–15 NOVEMBER 2026</span>
      <span class="ticker-bullet">✦</span>
      <span>ROOTED IN DEEN. DRIVEN BY PURPOSE.</span>
      <span class="ticker-bullet">✦</span>
      <span>13 OFFICIAL MERCHANDISE PIECES</span>
      <span class="ticker-bullet">✦</span>
      <span>MSM KERALA • GEN M 2026</span>
      <span class="ticker-bullet">✦</span>
      <span>KOZHIKODE • 13–15 NOVEMBER 2026</span>
      <span class="ticker-bullet">✦</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       2. STORY PROGRESS LINEAR SCROLL INDICATOR
       ═══════════════════════════════════════════════════════════ -->
  <div class="story-progress-wrapper" aria-hidden="true">
    <div class="story-progress-bar" id="storyProgressBar"></div>
  </div>

  <div class="story-shell">

    <!-- ═══════════════════════════════════════════════════════════
         3. CHAPTER HEADER (EDITORIAL LOOKBOOK STYLE)
         ═══════════════════════════════════════════════════════════ -->
    <header class="story-header">
      <div class="story-kicker-row">
        <span class="story-chapter-badge">SIGNATURE PIECE 01</span>
        <span class="story-kicker-dot">•</span>
        <span class="story-category-tag">WEAR & CARRY • ITEM #10</span>
      </div>

      <div class="story-title-row">
        <h2 class="story-title">White T-Shirt</h2>
        <span class="story-year-badge">MSM GEN M // 2026</span>
      </div>

      <p class="story-lead">
        The defining statement piece of the GEN M movement. Engineered in Kerala for those who walk with conviction.
      </p>
    </header>

    <!-- ═══════════════════════════════════════════════════════════
         4. STORY SHOWCASE: STUDIO GARMENT CANVAS WITH HOTSPOTS
         ═══════════════════════════════════════════════════════════ -->
    <div class="story-stage-grid">
      
      <!-- Center Visual Studio Pedestal with Interactive Hotspots -->
      <div class="story-visual-canvas" id="storyVisualCanvas">
        <div class="studio-ambient-circle" aria-hidden="true"></div>

        <!-- Garment Image -->
        <div class="studio-img-wrap">
          <img
            src={product.image}
            alt="Official GEN M White T-Shirt"
            class="studio-tee-img"
            width="640"
            height="640"
            loading="lazy"
            id="storyGarmentImg"
          />

          <!-- Interactive Hotspot 1: Collar -->
          <div class="story-hotspot hotspot-collar" data-target="step-craft" style="top: 18%; left: 50%;">
            <button type="button" class="hotspot-pulse-btn" aria-label="Inspect 1-inch ribbed collar">
              <span class="hotspot-ring"></span>
              <span class="hotspot-dot"></span>
            </button>
            <div class="hotspot-tooltip">
              <span class="tt-step">01 // COLLAR</span>
              <span class="tt-desc">1-Inch Ribbed Neck Drape</span>
            </div>
          </div>

          <!-- Interactive Hotspot 2: Chest Slogan -->
          <div class="story-hotspot hotspot-chest" data-target="step-slogan" style="top: 36%; left: 49%;">
            <button type="button" class="hotspot-pulse-btn" aria-label="Inspect official slogan print">
              <span class="hotspot-ring"></span>
              <span class="hotspot-dot"></span>
            </button>
            <div class="hotspot-tooltip">
              <span class="tt-step">02 // EMBLEM</span>
              <span class="tt-desc">Silkscreen: “Rooted in Deen”</span>
            </div>
          </div>

          <!-- Interactive Hotspot 3: Drop Shoulder -->
          <div class="story-hotspot hotspot-shoulder" data-target="step-fit" style="top: 28%; left: 24%;">
            <button type="button" class="hotspot-pulse-btn" aria-label="Inspect drop shoulder silhouette">
              <span class="hotspot-ring"></span>
              <span class="hotspot-dot"></span>
            </button>
            <div class="hotspot-tooltip">
              <span class="tt-step">03 // SILHOUETTE</span>
              <span class="tt-desc">Relaxed Drop-Shoulder</span>
            </div>
          </div>

          <!-- Interactive Hotspot 4: Bio-Washed Cotton Hem -->
          <div class="story-hotspot hotspot-hem" data-target="step-cotton" style="top: 80%; left: 62%;">
            <button type="button" class="hotspot-pulse-btn" aria-label="Inspect 240 GSM organic cotton">
              <span class="hotspot-ring"></span>
              <span class="hotspot-dot"></span>
            </button>
            <div class="hotspot-tooltip">
              <span class="tt-step">04 // FABRIC</span>
              <span class="tt-desc">240 GSM Bio-Washed Cotton</span>
            </div>
          </div>
        </div>

        <!-- Quick View Prompt Pill -->
        <button
          type="button"
          class="studio-inspect-prompt"
          data-product-id="white-tshirt"
          aria-label="Open detailed inspection modal for White T-Shirt"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <span>Click to Inspect Garment Details</span>
        </button>

      </div>

      <!-- Right Column: Clean Story Mode Timeline Cards -->
      <div class="story-narrative-col">
        
        <!-- Story Step 1: The Motto & Purpose -->
        <article class="story-card" id="step-slogan">
          <div class="card-num-row">
            <span class="card-step-index">01</span>
            <span class="card-step-name">THE STATEMENT</span>
          </div>
          <h3 class="card-headline">“Rooted in Deen. Driven by Purpose.”</h3>
          <p class="card-body">
            More than apparel, this tee is a wearable identity for thousands of students and delegates congregating in Kozhikode. It reflects deep faith anchoring every ambition.
          </p>
        </article>

        <!-- Story Step 2: The 240 GSM Fabric -->
        <article class="story-card" id="step-cotton">
          <div class="card-num-row">
            <span class="card-step-index">02</span>
            <span class="card-step-name">THE MATERIAL</span>
          </div>
          <h3 class="card-headline">240 GSM Bio-Washed Combed Cotton</h3>
          <p class="card-body">
            Specially woven from 100% organic long-staple combed yarns. Pre-shrunk and bio-treated to deliver a luxuriously soft hand-feel that retains structure through countless wears.
          </p>
        </article>

        <!-- Story Step 3: The Silhouette & Cut -->
        <article class="story-card" id="step-fit">
          <div class="card-num-row">
            <span class="card-step-index">03</span>
            <span class="card-step-name">THE SILHOUETTE</span>
          </div>
          <h3 class="card-headline">Oversized Drop-Shoulder Cut</h3>
          <p class="card-body">
            Tailored in a contemporary streetwear silhouette featuring an unstructured drop-shoulder, clean drape, and a dense 1-inch ribbed neckline.
          </p>
        </article>

      </div>

    </div>

    <!-- ═══════════════════════════════════════════════════════════
         5. CLEAN SPECIFICATIONS BAR
         ═══════════════════════════════════════════════════════════ -->
    <div class="story-specs-bar">
      <div class="spec-cell">
        <span class="spec-label">FABRIC</span>
        <span class="spec-value">240 GSM Combed Cotton</span>
      </div>
      <div class="spec-divider"></div>
      <div class="spec-cell">
        <span class="spec-label">CUT</span>
        <span class="spec-value">Oversized Drop-Shoulder</span>
      </div>
      <div class="spec-divider"></div>
      <div class="spec-cell">
        <span class="spec-label">COLOR</span>
        <span class="spec-value">Crisp Optical White</span>
      </div>
      <div class="spec-divider"></div>
      <div class="spec-cell">
        <span class="spec-label">CONFLUENCE</span>
        <span class="spec-value">Kozhikode • Nov 2026</span>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         6. REFINED ACTION ROW
         ═══════════════════════════════════════════════════════════ -->
    <div class="story-actions-footer">
      <div class="actions-left">
        <button
          type="button"
          class="btn-story-quickview"
          data-product-id="white-tshirt"
        >
          <span>Quick View Details</span>
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <a
          href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20ordering%20the%20official%20GEN%20M%20White%20T-Shirt."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-story-whatsapp"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.588-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.071.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z" />
          </svg>
          <span>Enquire on WhatsApp</span>
        </a>
      </div>

      <div class="actions-right">
        <a href="#catalogue" class="link-catalogue-peek">
          <span>Discover 12 other pieces</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M 8 3 L 8 13 M 4 9 L 8 13 L 12 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>

  </div>

</section>

<style>
  /* ═══════════════════════════════════════════════════════════
     STORY MODE SIGNATURE PIECE: CLEAN, LIGHTWEIGHT & EDITORIAL
     ═══════════════════════════════════════════════════════════ */
  .story-signature-section {
    position: relative;
    width: 100%;
    background: #ffffff;
    color: #0f172a;
    padding: 0 0 clamp(60px, 8vw, 110px);
    overflow: hidden;
  }

  /* 1. Minimal Clean Marquee Ticker */
  .story-ticker {
    width: 100%;
    background: #fafbfc;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    padding: 12px 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .story-ticker-track {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    font-family: 'Poppins', -apple-system, sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #475569;
    animation: storyTickerSlide 32s linear infinite;
    will-change: transform;
  }

  .ticker-bullet {
    color: #174ee8;
    font-size: 0.75rem;
  }

  @keyframes storyTickerSlide {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* 2. Linear Story Progress Bar */
  .story-progress-wrapper {
    width: 100%;
    height: 3px;
    background: #f1f5f9;
  }

  .story-progress-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #174ee8, #38bdf8);
    transition: width 0.1s linear;
  }

  /* 3. Container Shell */
  .story-shell {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 76px) 24px 0;
  }

  /* Header Section */
  .story-header {
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .story-kicker-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .story-chapter-badge {
    font-family: 'Poppins', sans-serif;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #174ee8;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    padding: 4px 10px;
    border-radius: 6px;
  }

  .story-kicker-dot {
    color: #94a3b8;
    font-size: 0.8rem;
  }

  .story-category-tag {
    font-family: 'Poppins', sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #64748b;
  }

  .story-title-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .story-title {
    font-family: 'Poppins', -apple-system, sans-serif;
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #0f172a;
    line-height: 1.05;
    margin: 0;
  }

  .story-year-badge {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.08em;
  }

  .story-lead {
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    line-height: 1.6;
    color: #475569;
    max-width: 620px;
    margin: 0;
  }

  /* ═══════════════════════════════════════════════════════════
     4. STUDIO VISUAL CANVAS & NARRATIVE GRID
     ═══════════════════════════════════════════════════════════ */
  .story-stage-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  /* Studio Visual Canvas */
  .story-visual-canvas {
    position: relative;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 28px;
    padding: clamp(32px, 5vw, 56px) 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 480px;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    transition: border-color 0.25s ease;
  }

  .story-visual-canvas:hover {
    border-color: #cbd5e1;
  }

  .studio-ambient-circle {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(23, 78, 232, 0.08) 0%, rgba(248, 250, 252, 0) 70%);
    pointer-events: none;
  }

  .studio-img-wrap {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .studio-tee-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 16px 32px rgba(15, 23, 42, 0.12));
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .story-visual-canvas:hover .studio-tee-img {
    transform: translateY(-4px) scale(1.02);
  }

  /* Interactive Hotspots */
  .story-hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 4;
  }

  .hotspot-pulse-btn {
    position: relative;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .hotspot-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #174ee8;
    border: 2px solid #ffffff;
    box-shadow: 0 0 0 2px #174ee8;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .hotspot-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 1.5px solid #174ee8;
    opacity: 0.7;
    animation: hotspotPulse 2.4s infinite cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes hotspotPulse {
    0% { transform: scale(0.6); opacity: 0.9; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  .hotspot-pulse-btn:hover .hotspot-dot,
  .story-hotspot.is-active .hotspot-dot {
    transform: scale(1.3);
    background: #0f172a;
    box-shadow: 0 0 0 3px #0f172a;
  }

  /* Tooltip */
  .hotspot-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: #0f172a;
    color: #ffffff;
    padding: 6px 12px;
    border-radius: 8px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    z-index: 10;
  }

  .hotspot-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: #0f172a;
  }

  .story-hotspot:hover .hotspot-tooltip,
  .story-hotspot.is-active .hotspot-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .tt-step {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #93c5fd;
    letter-spacing: 0.08em;
  }

  .tt-desc {
    font-family: 'Poppins', sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    color: #ffffff;
  }

  /* Click to Inspect Prompt Pill */
  .studio-inspect-prompt {
    position: absolute;
    bottom: 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    font-family: 'Poppins', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 9999px;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    transition: all 0.2s ease;
  }

  .studio-inspect-prompt:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.15);
  }

  /* ═══════════════════════════════════════════════════════════
     RIGHT COLUMN: CLEAN STORY MODE NARRATIVE CARDS
     ═══════════════════════════════════════════════════════════ */
  .story-narrative-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .story-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 24px 28px;
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    position: relative;
  }

  .story-card::before {
    content: '';
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 0;
    width: 3px;
    background: transparent;
    border-radius: 0 4px 4px 0;
    transition: background 0.25s ease;
  }

  .story-card:hover,
  .story-card.is-highlighted {
    border-color: #cbd5e1;
    background: #fafbfc;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.04);
    transform: translateX(4px);
  }

  .story-card:hover::before,
  .story-card.is-highlighted::before {
    background: #174ee8;
  }

  .card-num-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .card-step-index {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.75rem;
    font-weight: 800;
    color: #174ee8;
  }

  .card-step-name {
    font-family: 'Poppins', sans-serif;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #94a3b8;
  }

  .card-headline {
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 8px;
    line-height: 1.35;
  }

  .card-body {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #64748b;
    margin: 0;
  }

  /* ═══════════════════════════════════════════════════════════
     5. MINIMALIST SPECIFICATIONS BAR
     ═══════════════════════════════════════════════════════════ */
  .story-specs-bar {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 18px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .spec-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-label {
    font-family: 'Space Grotesk', monospace;
