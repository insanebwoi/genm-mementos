---
import { PRODUCTS } from '../data/products';

interface Props {
  productId?: string;
}

const { productId = 'white-tshirt' } = Astro.props;
const product = PRODUCTS.find((p) => p.id === productId) || PRODUCTS.find((p) => p.id === 'white-tshirt')!;
---

<section class="chromatic-signature-section" id="featured-piece" aria-label="Official Signature Piece Showcase">
  
  <!-- ═══════════════════════════════════════════════════════════
       1. CHROMATIC MARQUEE TICKER (SUNSHINE & ROYAL BLUE)
       ═══════════════════════════════════════════════════════════ -->
  <div class="chroma-ticker-wrapper" aria-hidden="true">
    <div class="chroma-ticker-track">
      <span class="ticker-highlight">SIGNATURE DROP 01</span>
      <span class="ticker-star">★</span>
      <span class="ticker-item">ROOTED IN DEEN. DRIVEN BY PURPOSE.</span>
      <span class="ticker-star">★</span>
      <span class="ticker-item">13 OFFICIAL MERCHANDISE PIECES</span>
      <span class="ticker-star">★</span>
      <span class="ticker-item">MSM KERALA • GEN M 2026</span>
      <span class="ticker-star">★</span>
      <span class="ticker-item">KOZHIKODE • 13–15 NOV 2026</span>
      <span class="ticker-star">★</span>
      <span class="ticker-highlight">SIGNATURE DROP 01</span>
      <span class="ticker-star">★</span>
      <span class="ticker-item">ROOTED IN DEEN. DRIVEN BY PURPOSE.</span>
      <span class="ticker-star">★</span>
      <span class="ticker-item">13 OFFICIAL MERCHANDISE PIECES</span>
      <span class="ticker-star">★</span>
      <span class="ticker-item">MSM KERALA • GEN M 2026</span>
      <span class="ticker-star">★</span>
      <span class="ticker-item">KOZHIKODE • 13–15 NOV 2026</span>
      <span class="ticker-star">★</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       2. CHROMATIC CAPSULE SHOWCASE (BOLD, COLORFUL & FRESH)
       ═══════════════════════════════════════════════════════════ -->
  <div class="chroma-shell">
    <div class="chroma-capsule-deck">
      
      <!-- LEFT: Sculpted Visual Chromatic Stage -->
      <div class="chroma-stage-col">
        <div class="chroma-stage-card" data-product-id="white-tshirt">
          
          <!-- Animated Morphing Liquid Aura in Background -->
          <div class="chroma-liquid-aurora" aria-hidden="true">
            <div class="liquid-fluid-orb orb-yellow"></div>
            <div class="liquid-fluid-orb orb-cyan"></div>
            <div class="liquid-fluid-orb orb-blue"></div>
          </div>

          <!-- Rotating Circular Typographic Stamp -->
          <div class="chroma-stamp-badge" aria-hidden="true">
            <svg class="stamp-svg" viewBox="0 0 160 160">
              <path
                id="stampCirclePath"
                d="M 80, 80 m -62, 0 a 62,62 0 1,1 124,0 a 62,62 0 1,1 -124,0"
                fill="none"
              />
              <text class="stamp-text">
                <textPath href="#stampCirclePath" startOffset="0%">
                  MSM KERALA ★ GEN M 2026 ★ SIGNATURE PIECE 01 ★
                </textPath>
              </text>
            </svg>
            <div class="stamp-center-icon">★</div>
          </div>

          <!-- Garment Centerpiece Presentation -->
          <div class="chroma-garment-wrap">
            <img
              src={product.image}
              alt="Official GEN M White T-Shirt"
              class="chroma-tee-img"
              width="460"
              height="460"
              loading="lazy"
            />
          </div>

          <!-- Corner Badges -->
          <div class="chroma-badge-pill-gsm">
            <span class="pill-dot"></span>
            <span>240 GSM HEAVYWEIGHT</span>
          </div>

          <!-- Interactive Hover Cue -->
          <div class="chroma-inspect-cue">
            <span>Click to View Full Details</span>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

        </div>
      </div>

      <!-- RIGHT: Vibrant High-Fashion Streetwear Info Board -->
      <div class="chroma-info-col">
        
        <!-- Header Tag Ribbon -->
        <div class="chroma-tag-ribbon">
          <span class="tag-chip tag-yellow">SIGNATURE PIECE 01</span>
          <span class="tag-chip tag-blue">WEAR & CARRY • ITEM #10</span>
          <span class="tag-chip tag-cyan">GEN M 2026</span>
        </div>

        <!-- Big Display Headline with Chromatic Pop Highlight -->
        <h2 class="chroma-headline">
          <span class="headline-light">Official</span>
          <span class="headline-hero">White T-Shirt</span>
          <span class="headline-accent-pill">#FLAGSHIP</span>
        </h2>

        <!-- High-Contrast 3D Action Buttons -->
        <div class="chroma-cta-cluster">
          <button
            type="button"
            class="btn-chroma-dark"
            data-product-id="white-tshirt"
          >
            <span class="btn-sparkle">✦</span>
            <span>Quick View Details</span>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <a
            href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20ordering%20the%20official%20GEN%20M%20White%20T-Shirt."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-chroma-whatsapp"
            aria-label="Enquire about White T-Shirt on WhatsApp"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.588-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.071.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z" />
            </svg>
            <span>Enquire on WhatsApp</span>
          </a>
        </div>

      </div>

    </div>
  </div>

</section>

<style>
  /* ═══════════════════════════════════════════════════════════
     CHROMATIC CAPSULE DROP STYLING — VIBRANT & STREETWEAR LUXE
     ═══════════════════════════════════════════════════════════ */
  .chromatic-signature-section {
    position: relative;
    width: 100%;
    background: #ffffff;
    padding-bottom: clamp(40px, 6vw, 80px);
    overflow: hidden;
  }

  /* 1. Chromatic Marquee Ticker */
  .chroma-ticker-wrapper {
    width: 100%;
    background: #E7EEAC;
    border-top: 3px solid #0f172a;
    border-bottom: 3px solid #0f172a;
    padding: 12px 0;
    overflow: hidden;
    white-space: nowrap;
    box-shadow: 0 4px 0 rgba(15, 23, 42, 0.1);
  }

  .chroma-ticker-track {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    animation: chromaScroll 28s linear infinite;
    will-change: transform;
  }

  .ticker-highlight {
    font-family: 'Neoverse', 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    background: #0f172a;
    color: #E7EEAC;
    padding: 3px 10px;
    border-radius: 6px;
  }

  .ticker-item {
    font-family: 'Neoverse', 'Poppins', sans-serif;
    font-size: clamp(0.85rem, 1.1vw, 0.98rem);
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #0f172a;
  }

  .ticker-star {
    font-size: 1.1rem;
    color: #174ee8;
  }

  @keyframes chromaScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* 2. Main Shell & Capsule Deck */
  .chroma-shell {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(32px, 5vw, 60px) 20px 0;
  }

  .chroma-capsule-deck {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(32px, 5vw, 60px);
    align-items: center;
  }

  /* ═══════════════════════════════════════════════════════════
     LEFT: SCULPTED CHROMATIC STAGE
     ═══════════════════════════════════════════════════════════ */
  .chroma-stage-col {
    display: flex;
    justify-content: center;
  }

  .chroma-stage-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 0.95;
    background: linear-gradient(145deg, #174ee8 0%, #1e40af 100%);
    border: 3.5px solid #0f172a;
    border-radius: 36px;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
      12px 14px 0 #0f172a,
      0 30px 60px rgba(23, 78, 232, 0.25);
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease;
  }

  .chroma-stage-card:hover {
    transform: translateY(-4px) scale(1.01);
    box-shadow: 
      16px 18px 0 #0f172a,
      0 35px 70px rgba(23, 78, 232, 0.35);
  }

  /* Liquid Aurora Background */
  .chroma-liquid-aurora {
    position: absolute;
    inset: -20%;
    width: 140%;
    height: 140%;
    pointer-events: none;
    filter: blur(28px);
    opacity: 0.75;
    z-index: 1;
  }

  .liquid-fluid-orb {
    position: absolute;
    border-radius: 50%;
    will-change: transform, border-radius;
  }

  .orb-yellow {
    width: 240px;
    height: 240px;
    top: 15%;
    right: 15%;
    background: radial-gradient(circle, rgba(231, 238, 172, 0.85) 0%, transparent 70%);
    animation: orbFloat1 10s infinite ease-in-out alternate;
  }

  .orb-cyan {
    width: 220px;
    height: 220px;
    bottom: 10%;
    left: 10%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.75) 0%, transparent 70%);
    animation: orbFloat2 12s infinite ease-in-out alternate;
  }

  .orb-blue {
    width: 280px;
    height: 280px;
    top: 40%;
    left: 30%;
    background: radial-gradient(circle, rgba(23, 78, 232, 0.9) 0%, transparent 70%);
    animation: orbFloat3 8s infinite ease-in-out alternate;
  }

  @keyframes orbFloat1 {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-30px, 25px) scale(1.15); }
  }

  @keyframes orbFloat2 {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(25px, -30px) scale(1.1); }
  }

  @keyframes orbFloat3 {
    0% { transform: translate(0, 0) scale(0.95); }
    100% { transform: translate(15px, 20px) scale(1.08); }
  }

  /* Rotating Circular Typographic Stamp */
  .chroma-stamp-badge {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 90px;
    height: 90px;
    z-index: 4;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stamp-svg {
    width: 100%;
    height: 100%;
    animation: stampRotate 18s linear infinite;
    transform-origin: center center;
  }

  .stamp-text {
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    fill: #E7EEAC;
    text-transform: uppercase;
  }

  .stamp-center-icon {
    position: absolute;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #E7EEAC;
    color: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 900;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.3);
  }

  @keyframes stampRotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Garment Presentation */
  .chroma-garment-wrap {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .chroma-tee-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 16px 32px rgba(15, 23, 42, 0.35));
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .chroma-stage-card:hover .chroma-tee-img {
    transform: scale(1.06) translateY(-4px);
  }

  /* GSM Pill */
  .chroma-badge-pill-gsm {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: #0f172a;
    color: #ffffff;
    border: 2px solid #E7EEAC;
    border-radius: 9999px;
    padding: 6px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Space Grotesk', monospace;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    z-index: 3;
    box-shadow: 2px 3px 0 #0f172a;
  }

  .pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #E7EEAC;
    box-shadow: 0 0 8px #E7EEAC;
  }

  /* Inspect Cue */
  .chroma-inspect-cue {
    position: absolute;
    bottom: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.95);
    color: #0f172a;
    border: 2px solid #0f172a;
    border-radius: 9999px;
    padding: 6px 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    z-index: 3;
    box-shadow: 2px 3px 0 #0f172a;
    transition: all 0.2s ease;
  }

  .chroma-stage-card:hover .chroma-inspect-cue {
    background: #E7EEAC;
    transform: translateY(-2px);
  }

  /* ═══════════════════════════════════════════════════════════
     RIGHT: VIBRANT EDITORIAL INFO BOARD
     ═══════════════════════════════════════════════════════════ */
  .chroma-info-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .chroma-tag-ribbon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .tag-chip {
    font-family: 'Poppins', sans-serif;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 5px 12px;
    border-radius: 8px;
    border: 2px solid #0f172a;
    box-shadow: 2px 2px 0 #0f172a;
  }

  .tag-chip.tag-yellow {
    background: #E7EEAC;
    color: #0f172a;
  }

  .tag-chip.tag-blue {
    background: #dbeafe;
    color: #174ee8;
  }

  .tag-chip.tag-cyan {
    background: #cffafe;
    color: #0891b2;
  }

  /* Headline */
  .chroma-headline {
    font-family: 'Space Grotesk', 'Poppins', -apple-system, sans-serif;
    font-size: clamp(2.4rem, 4.4vw, 3.8rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #0f172a;
    margin: 0 0 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .headline-light {
    color: #64748b;
    font-weight: 700;
  }

  .headline-hero {
    color: #0f172a;
  }

  .headline-accent-pill {
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    background: #174ee8;
    color: #ffffff;
    border: 2px solid #0f172a;
    padding: 4px 14px;
    border-radius: 9999px;
    box-shadow: 3px 3px 0 #0f172a;
    transform: rotate(-3deg);
  }

  /* Action Buttons Row */
  .chroma-cta-cluster {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    width: 100%;
  }

  .btn-chroma-dark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #0f172a;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 14px 26px;
    border-radius: 9999px;
    border: 2.5px solid #0f172a;
    cursor: pointer;
    box-shadow: 4px 5px 0 #174ee8;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .btn-chroma-dark:hover {
    background: #174ee8;
    border-color: #174ee8;
    transform: translateY(-2px);
    box-shadow: 4px 7px 0 #0f172a;
  }

  .btn-sparkle {
    color: #E7EEAC;
    font-size: 1.1rem;
    line-height: 1;
  }

  .btn-chroma-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25D366;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 14px 26px;
    border-radius: 9999px;
    border: 2.5px solid #0f172a;
    text-decoration: none;
    box-shadow: 4px 5px 0 #0f172a;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .btn-chroma-whatsapp:hover {
    background: #1eb956;
    transform: translateY(-2px);
    box-shadow: 4px 7px 0 #0f172a;
  }

  /* ═══════════════════════════════════════════════════════════
     RESPONSIVE MEDIA QUERIES
     ═══════════════════════════════════════════════════════════ */
  @media (max-width: 960px) {
    .chroma-capsule-deck {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .chroma-stage-card {
      max-width: 420px;
    }

    .chroma-specs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .chroma-shell {
      padding: 24px 14px 0;
    }

    .chroma-stage-card {
      max-width: 100%;
      aspect-ratio: 1;
      padding: 16px;
      border-radius: 24px;
      box-shadow: 8px 10px 0 #0f172a;
    }

    .chroma-stamp-badge {
      width: 72px;
      height: 72px;
      top: 12px;
      right: 12px;
    }

    .stamp-text {
      font-size: 9px;
    }

    .chroma-badge-pill-gsm {
      font-size: 0.66rem;
      padding: 4px 10px;
      bottom: 12px;
      left: 12px;
    }

    .chroma-inspect-cue {
      font-size: 0.66rem;
      padding: 4px 10px;
      bottom: 12px;
      right: 12px;
    }

    .chroma-headline {
      font-size: 2.2rem;
    }

    .chroma-specs-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .chroma-spec-tile {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 10px 14px;
    }

    .spec-sub {
      display: none;
    }

    .chroma-cta-cluster {
      flex-direction: column;
      width: 100%;
    }

    .btn-chroma-dark,
    .btn-chroma-whatsapp {
      width: 100%;
      justify-content: center;
      padding: 12px 20px;
    }
  }
</style>
