---
import { PRODUCTS } from '../data/products';

interface Props {
  productId?: string;
}

const { productId = 'white-tshirt' } = Astro.props;
const product = PRODUCTS.find((p) => p.id === productId) || PRODUCTS.find((p) => p.id === 'white-tshirt')!;
---

<section class="pop-signature-section" id="featured-piece" aria-label="Signature Piece Showcase">
  
  <!-- ═══════════════════════════════════════════════════════════
       1. VIBRANT SUNSHINE YELLOW MARQUEE TICKER BAND
       ═══════════════════════════════════════════════════════════ -->
  <div class="pop-ticker-wrapper" aria-hidden="true">
    <div class="pop-ticker-track">
      <span class="ticker-text">ROOTED IN DEEN. DRIVEN BY PURPOSE.</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">13 OFFICIAL MERCHANDISE PIECES</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">MSM KERALA • GEN M 2026</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">KOZHIKODE • 13-14-15 NOVEMBER 2026</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">ROOTED IN DEEN. DRIVEN BY PURPOSE.</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">13 OFFICIAL MERCHANDISE PIECES</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">MSM KERALA • GEN M 2026</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">KOZHIKODE • 13-14-15 NOVEMBER 2026</span>
      <span class="ticker-star">★</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       2. VIBRANT WINDING TEXT RIBBON WITH LINEAR SCROLL PARALLAX
       ═══════════════════════════════════════════════════════════ -->
  <div class="pop-ribbon-stage" aria-hidden="true">
    <svg class="pop-ribbon-svg" viewBox="0 0 1440 980" fill="none" preserveAspectRatio="none">
      <defs>
        <!-- Smooth S-curve path routed through whitespace so text is never obscured -->
        <path
          id="popWindingPath"
          d="M -40,920 C 180,840 320,700 480,640 C 680,570 940,630 1140,490 C 1280,380 1350,180 1480,30"
        />
        
        <!-- Multi-stop Vibrant Blue to Cyan Gradient -->
        <linearGradient id="popRibbonGrad" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#1d4ed8" />
          <stop offset="50%" stop-color="#174ee8" />
          <stop offset="100%" stop-color="#0284c7" />
        </linearGradient>
      </defs>

      <!-- 3D Pop Shadow Stroke -->
      <use
        href="#popWindingPath"
        class="ribbon-shadow"
        stroke="#0f172a"
        stroke-width="58"
        stroke-linecap="round"
      />

      <!-- Main Vibrant Colored Band -->
      <use
        href="#popWindingPath"
        class="ribbon-band"
        stroke="url(#popRibbonGrad)"
        stroke-width="50"
        stroke-linecap="round"
      />

      <!-- Neon Lime Stitch Line -->
      <use
        href="#popWindingPath"
        class="ribbon-neon-stitch"
        stroke="#E7EEAC"
        stroke-width="3"
        stroke-dasharray="14 10"
        stroke-linecap="round"
      />

      <!-- Running Linear Scroll Text (Always Upright & Legible) -->
      <text class="ribbon-text-content" dy="5">
        <textPath
          id="popRibbonText"
          href="#popWindingPath"
          startOffset="0%"
          method="align"
          spacing="auto"
        >
          ROOTED IN DEEN • DRIVEN BY PURPOSE • 13 OFFICIAL PIECES • MSM KERALA • GEN M 2026 • KOZHIKODE • ROOTED IN DEEN • DRIVEN BY PURPOSE • 13 OFFICIAL PIECES • MSM KERALA • GEN M 2026 • KOZHIKODE • ROOTED IN DEEN • DRIVEN BY PURPOSE • 13 OFFICIAL PIECES • MSM KERALA • GEN M 2026 •
        </textPath>
      </text>
    </svg>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       3. COLORFUL EDITORIAL POP CONTENT
       ═══════════════════════════════════════════════════════════ -->
  <div class="pop-shell">
    
    <!-- Top Grid: Left Editorial Narrative | Right: 3D Isometric Pop Stage -->
    <div class="pop-main-grid">
      
      <!-- Left Narrative Column -->
      <div class="pop-text-col">
        
        <!-- Colorful Eyebrow Badges -->
        <div class="pop-kicker-cluster">
          <span class="kicker-pill yellow">
            <span class="kicker-star">★</span> SIGNATURE PIECE 01
          </span>
          <span class="kicker-pill blue">
            WEAR & CARRY • ITEM #10
          </span>
        </div>

        <!-- High-Impact Display Headline with Tilted Highlighter Badge -->
        <h2 class="pop-headline">
          The <span class="pop-sticker-pill lime rotate-left">#SECRET</span><br />
          to purposeful<br />
          streetwear?
        </h2>

        <!-- Slogan Banner Box with Bold Pop Art Border -->
        <div class="pop-slogan-card">
          <span class="slogan-tag">OFFICIAL SLOGAN</span>
          <blockquote class="slogan-text">
            “Rooted in Deen. Driven by Purpose.”
          </blockquote>
        </div>

        <!-- Editorial Description with Vibrant Accents -->
        <p class="pop-description">
          The defining piece of the <strong class="hl-blue">GEN M collection</strong>. Cut in an oversized, relaxed streetwear silhouette from <strong class="hl-dark">240 GSM organic combed cotton</strong>. Features the official emblem and slogan across the chest.
        </p>

        <!-- Colorful Specification Chips Grid -->
        <div class="pop-spec-grid">
          <div class="spec-card fabric">
            <span class="sc-label">FABRIC</span>
            <span class="sc-val">240 GSM Combed Cotton</span>
          </div>
          <div class="spec-card cut">
            <span class="sc-label">CUT</span>
            <span class="sc-val">Oversized Drop-Shoulder</span>
          </div>
          <div class="spec-card color">
            <span class="sc-label">COLOR</span>
            <span class="sc-val">Crisp White</span>
          </div>
        </div>

        <!-- Tactile 3D Action Buttons -->
        <div class="pop-cta-row">
          <button
            type="button"
            class="btn-pop-dark-pill"
            data-product-id="white-tshirt"
          >
            <span class="btn-sparkle">✦</span>
            <span>Quick View Details</span>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <a
            href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20ordering%20the%20official%20GEN%20M%20White%20T-Shirt."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-pop-green-pill"
            aria-label="Enquire about White T-Shirt on WhatsApp"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.588-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.071.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z" />
            </svg>
            <span>Enquire on WhatsApp</span>
          </a>
        </div>

      </div>

      <!-- Right Column: 3D Isometric Pop Showcase Pedestal -->
      <div class="pop-visual-col" id="popVisualCol">
        
        <div class="pop-isometric-stage" id="popIsometricStage">
          
          <!-- Top Console Control Bar -->
          <div class="stage-console-header">
            <div class="console-dots">
              <span class="ctrl-dot red"></span>
              <span class="ctrl-dot yellow"></span>
              <span class="ctrl-dot green"></span>
            </div>
            <span class="console-title">MSM // GEN M 2026 FLAGSHIP</span>
            <span class="console-gsm-badge">240 GSM</span>
          </div>

          <!-- Product Screen Frame -->
          <div class="stage-screen-box">
            
            <!-- Top Floating Sticker: 100% Cotton -->
            <div class="floating-badge top-left">
              <span class="badge-icon">✦</span>
              <span>100% ORGANIC COMBED COTTON</span>
            </div>

            <!-- T-Shirt Image with Ambient Radial Glow -->
            <div class="garment-showcase-wrap">
              <div class="ambient-glow" aria-hidden="true"></div>
              <img
                src={product.image}
                alt="Official GEN M White T-Shirt"
                class="garment-img"
                width="540"
                height="540"
                loading="lazy"
                id="popGarmentImg"
              />
            </div>

            <!-- Interactive Screen Inspection Prompt -->
            <button
              type="button"
              class="stage-inspect-overlay"
              data-product-id="white-tshirt"
              aria-label="Inspect White T-Shirt in 360 detailed modal"
            >
              <div class="inspect-play-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
              <span class="inspect-text">Quick View Details</span>
            </button>

            <!-- Bottom Floating Sticker: Official Print -->
            <div class="floating-badge bottom-right">
              <span class="badge-icon">★</span>
              <span>OFFICIAL EMBLEM PRINT</span>
            </div>

          </div>

          <!-- Console Footer Bar -->
          <div class="stage-console-footer">
            <div class="cf-item">
              <span class="cf-k">FIT</span>
              <span class="cf-v">Drop-Shoulder</span>
            </div>
            <div class="cf-divider"></div>
            <div class="cf-item">
              <span class="cf-k">RIB</span>
              <span class="cf-v">1-inch Collar</span>
            </div>
            <div class="cf-divider"></div>
            <div class="cf-item">
              <span class="cf-k">EVENT</span>
              <span class="cf-v">Kozhikode 2026</span>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- ═══════════════════════════════════════════════════════════
         4. LOWER PUNCHLINE BRIDGE (MATCHING "BRING ON #THEMAGIC")
         ═══════════════════════════════════════════════════════════ -->
    <div class="pop-lower-bridge">
      
      <!-- Left Punchline with Tilted Sticker -->
      <div class="lower-headline-box">
        <h3 class="lower-title">
          Bring<br />
          on <span class="pop-sticker-pill lime rotate-right">#THEMAGIC</span>
        </h3>
        <p class="lower-desc">
          Official GEN M statement piece crafted for student leaders and state delegates across Kerala.
        </p>
        <div class="lower-buttons">
          <a
            href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20ordering%20the%20official%20GEN%20M%20White%20T-Shirt."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-pop-dark-pill"
          >
            <span>Order On WhatsApp</span>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          <button
            type="button"
            class="btn-pop-white-pill"
            data-product-id="white-tshirt"
          >
            <span>View Full Specs</span>
          </button>
        </div>
      </div>

      <!-- Right Curved Transition Card leading to Catalogue -->
      <div class="lower-curved-card">
        <div class="lcc-header">
          <span class="lcc-eyebrow">MSM MERCHANDISE SUITE</span>
          <h4 class="lcc-title">13 Official Pieces Awaiting</h4>
        </div>
        <p class="lcc-body">
          Explore the full curated merchandise collection: bags, drinkware, caps, notebooks, and lifestyle essentials.
        </p>
        <div class="lcc-footer">
          <a href="#catalogue" class="lcc-link">
            <span>Explore All 13 Pieces Below</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M 8 3 L 8 13 M 4 9 L 8 13 L 12 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>

</section>

<style>
  /* ═══════════════════════════════════════════════════════════
     COLORFUL POP ART STYLING — VIBRANT, ENERGETIC & EDITORIAL
     ═══════════════════════════════════════════════════════════ */
  .pop-signature-section {
    position: relative;
    width: 100%;
    background: #ffffff;
    color: #0f172a;
    overflow: hidden;
    padding-bottom: clamp(60px, 8vw, 110px);
  }

  /* 1. Vibrant Sunshine Yellow Marquee Ticker */
  .pop-ticker-wrapper {
    width: 100%;
    background: #E7EEAC;
    border-top: 3px solid #0f172a;
    border-bottom: 3px solid #0f172a;
    padding: 13px 0;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
    z-index: 5;
    box-shadow: 0 4px 0 rgba(15, 23, 42, 0.1);
  }

  .pop-ticker-track {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    animation: tickerScroll 26s linear infinite;
    will-change: transform;
  }

  .ticker-text {
    font-family: 'Neoverse', 'Poppins', -apple-system, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.05rem);
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #0f172a;
  }

  .ticker-star {
    font-size: 1.15rem;
    color: #174ee8;
    line-height: 1;
  }

  @keyframes tickerScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* 2. Winding Serpentine Ribbon with Scroll Parallax */
  .pop-ribbon-stage {
    position: absolute;
    top: 60px;
    left: 0;
    width: 100%;
    height: calc(100% - 60px);
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .pop-ribbon-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .ribbon-shadow {
    opacity: 0.2;
    transform: translate(6px, 10px);
  }

  .ribbon-band {
    opacity: 0.98;
    filter: drop-shadow(0 8px 16px rgba(23, 78, 232, 0.3));
  }

  .ribbon-neon-stitch {
    opacity: 0.9;
  }

  .ribbon-text-content {
    fill: #ffffff;
    font-family: 'Poppins', 'Space Grotesk', sans-serif;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    user-select: none;
    will-change: transform;
  }

  /* 3. Main Container Shell */
  .pop-shell {
    position: relative;
    z-index: 3;
    max-width: 1260px;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 76px) 24px 0;
  }

  /* Top Main Grid */
  .pop-main-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
    margin-bottom: clamp(56px, 7vw, 100px);
  }

  /* Left Editorial Narrative */
  .pop-text-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Eyebrow Kicker Pills */
  .pop-kicker-cluster {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .kicker-pill {
    font-family: 'Poppins', sans-serif;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 6px 14px;
    border-radius: 9999px;
    border: 2px solid #0f172a;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 2px 3px 0 #0f172a;
  }

  .kicker-pill.yellow {
    background: #E7EEAC;
    color: #0f172a;
  }

  .kicker-pill.blue {
    background: #dbeafe;
    color: #1e40af;
  }

  .kicker-star {
    color: #174ee8;
    font-size: 0.85rem;
  }

  /* Display Headline */
  .pop-headline {
    font-family: 'Space Grotesk', 'Poppins', -apple-system, sans-serif;
    font-size: clamp(2.8rem, 5.2vw, 4.6rem);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: #0f172a;
    margin: 0 0 24px;
  }

  /* Tilted Highlighter Sticker Pills */
  .pop-sticker-pill {
    display: inline-block;
    padding: 0 16px;
    margin: 0 4px;
    border-radius: 14px;
    border: 3px solid #0f172a;
    font-family: 'Space Grotesk', 'Poppins', sans-serif;
    font-weight: 900;
    letter-spacing: -0.02em;
    box-shadow: 4px 5px 0 #0f172a;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: center center;
    vertical-align: middle;
  }

  .pop-sticker-pill.lime {
    background: #E7EEAC;
    color: #0f172a;
  }

  .pop-sticker-pill.rotate-left {
    transform: rotate(-3.5deg);
  }

  .pop-sticker-pill.rotate-right {
    transform: rotate(2.8deg);
  }

  .pop-sticker-pill:hover {
    transform: rotate(0deg) scale(1.05);
  }

  /* Slogan Callout Box */
  .pop-slogan-card {
    background: #eff6ff;
    border: 2.5px solid #174ee8;
    border-left: 6px solid #174ee8;
    border-radius: 0 16px 16px 0;
    padding: 14px 20px;
    margin-bottom: 22px;
    max-width: 520px;
    box-shadow: 4px 5px 0 rgba(23, 78, 232, 0.15);
  }

  .slogan-tag {
    font-family: 'Poppins', sans-serif;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #174ee8;
    display: block;
    margin-bottom: 4px;
  }

  .slogan-text {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    font-weight: 800;
    color: #1e3a8a;
    margin: 0;
    line-height: 1.35;
  }

  /* Description Body */
  .pop-description {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.68;
    color: #475569;
    margin: 0 0 24px;
    max-width: 530px;
  }

  .hl-blue {
    color: #174ee8;
    font-weight: 800;
  }

  .hl-dark {
    color: #0f172a;
    font-weight: 800;
  }

  /* Specification Chips Grid */
  .pop-spec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 28px;
    width: 100%;
    max-width: 530px;
  }

  .spec-card {
    background: #ffffff;
    border: 2px solid #0f172a;
    border-radius: 14px;
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    box-shadow: 3px 3px 0 #0f172a;
    transition: transform 0.15s ease;
  }

  .spec-card:hover {
    transform: translateY(-2px);
  }

  .spec-card.fabric { border-top: 5px solid #174ee8; }
  .spec-card.cut { border-top: 5px solid #0284c7; }
  .spec-card.color { border-top: 5px solid #10b981; }

  .sc-label {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.06em;
  }

  .sc-val {
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 800;
    color: #0f172a;
  }

  /* Tactile Action Buttons */
  .pop-cta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-pop-dark-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #0f172a;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 13px 26px;
    border-radius: 9999px;
    border: 2px solid #0f172a;
    cursor: pointer;
    box-shadow: 4px 4px 0 #174ee8;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .btn-pop-dark-pill:hover {
    background: #174ee8;
    border-color: #174ee8;
    transform: translateY(-2px);
    box-shadow: 4px 6px 0 #0f172a;
  }

  .btn-sparkle {
    color: #E7EEAC;
    font-size: 1.1rem;
    line-height: 1;
  }

  .btn-pop-green-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25D366;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 13px 26px;
    border-radius: 9999px;
    border: 2px solid #0f172a;
    text-decoration: none;
    box-shadow: 4px 4px 0 #0f172a;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .btn-pop-green-pill:hover {
    background: #1eb956;
    transform: translateY(-2px);
    box-shadow: 4px 6px 0 #0f172a;
  }

  /* ═══════════════════════════════════════════════════════════
     RIGHT COLUMN: 3D ISOMETRIC POP SHOWCASE PEDESTAL
     ═══════════════════════════════════════════════════════════ */
  .pop-visual-col {
    perspective: 1200px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 4;
  }

  .pop-isometric-stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    background: #ffffff;
    border: 3.5px solid #0f172a;
