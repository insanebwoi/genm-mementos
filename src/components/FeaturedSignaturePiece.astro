<script>
  // ═══════════════════════════════════════════════════════════
  // LINEAR SCROLL PARALLAX SCRIPT
  // ═══════════════════════════════════════════════════════════
  function setupPopScrollParallax() {
    const section = document.getElementById('featured-piece');
    const ribbonText = document.getElementById('popRibbonText');
    const stage = document.getElementById('popIsometricStage');
    const col = document.getElementById('popVisualCol');

    if (!section || !ribbonText) return;

    let ticking = false;

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          const rect = section.getBoundingClientRect();
          const vh = window.innerHeight;

          if (rect.top <= vh && rect.bottom >= 0) {
            const travel = vh + rect.height;
            const progress = (vh - rect.top) / travel;

            // Shift text dynamically along the curve
            const offset = -25 + progress * 55;
            ribbonText.setAttribute('startOffset', `${offset}%`);

            // Subtle parallax depth on 3D isometric card
            if (stage && window.innerWidth > 768) {
              const parallaxY = (progress - 0.5) * -36;
              stage.style.setProperty('--parallax-y', `${parallaxY}px`);
            }
          }

          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // 3D Pointer reaction
    if (col && stage && window.innerWidth > 768) {
      col.addEventListener('mousemove', (e) => {
        const rect = col.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;

        stage.style.transform = `
          rotateY(${x * 12 - 4}deg) 
          rotateX(${-y * 10 + 3}deg) 
          translateY(var(--parallax-y, 0px))
        `;
      });

      col.addEventListener('mouseleave', () => {
        stage.style.transform = `
          rotateY(-6deg) 
          rotateX(4deg) 
          translateY(var(--parallax-y, 0px))
        `;
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPopScrollParallax);
  } else {
    setupPopScrollParallax();
  }
  document.addEventListener('astro:page-load', setupPopScrollParallax);
</script>
