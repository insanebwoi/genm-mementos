---
import { PRODUCTS } from '../data/products';

interface Props {
  productId?: string;
}

const { productId = 'white-tshirt' } = Astro.props;
const product = PRODUCTS.find((p) => p.id === productId) || PRODUCTS.find((p) => p.id === 'white-tshirt')!;
---

<section class="pop-signature-section" id="featured-piece" aria-label="Official Signature Piece">
  
  <!-- ═══════════════════════════════════════════════════════════
       1. VIBRANT SUNSHINE YELLOW SLOGAN MARQUEE
       ═══════════════════════════════════════════════════════════ -->
  <div class="pop-ticker-wrapper" aria-hidden="true">
    <div class="pop-ticker-track">
      <span class="ticker-text">ROOTED IN DEEN. DRIVEN BY PURPOSE.</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">13 OFFICIAL MERCHANDISE PIECES</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">MSM KERALA • GEN M 2026</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">KOZHIKODE • 13–15 NOV 2026</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">ROOTED IN DEEN. DRIVEN BY PURPOSE.</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">13 OFFICIAL MERCHANDISE PIECES</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">MSM KERALA • GEN M 2026</span>
      <span class="ticker-star">★</span>
      <span class="ticker-text">KOZHIKODE • 13–15 NOV 2026</span>
      <span class="ticker-star">★</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       2. BRIEF, HIGH-IMPACT SIGNATURE CARD (10% PURE CORE)
       ═══════════════════════════════════════════════════════════ -->
  <div class="pop-signature-shell">
    <div class="pop-signature-card">
      
      <!-- Top Colorful Kicker Row -->
      <div class="card-header-row">
        <div class="kicker-badge-pair">
          <span class="pill-signature">★ SIGNATURE PIECE 01</span>
          <span class="pill-category">WEAR & CARRY • ITEM #10</span>
        </div>
        <span class="edition-tag">GEN M 2026</span>
      </div>

      <!-- Main Responsive Grid -->
      <div class="card-content-grid">
        
        <!-- Left Visual: Garment Showcase with Ambient Glow -->
        <div class="garment-visual-wrap">
          <div class="garment-stage-box" data-product-id="white-tshirt">
            <!-- Liquid (Fluid) Design Animation Backdrop -->
            <div class="liquid-fluid-stage" aria-hidden="true">
              <div class="liquid-blob liquid-blob-primary"></div>
              <div class="liquid-blob liquid-blob-secondary"></div>
              <div class="liquid-blob liquid-blob-accent"></div>
              <div class="liquid-glass-refraction"></div>
            </div>
            <img
              src={product.image}
              alt="Official GEN M White T-Shirt"
              class="garment-img"
              width="440"
              height="440"
              loading="lazy"
            />
            <span class="corner-spec-chip">240 GSM</span>
            <span class="hover-inspect-cue">Click to View Details ↗</span>
          </div>
        </div>

        <!-- Right Info: Pure Punchy Essentials -->
        <div class="garment-info-wrap">
          
          <h2 class="garment-title">
            White <span class="title-sticker-badge">#T-SHIRT</span>
          </h2>

          <!-- Official Slogan Callout -->
          <div class="slogan-callout">
            <span class="slogan-label">OFFICIAL SLOGAN</span>
            <blockquote class="slogan-quote">
              “Rooted in Deen. Driven by Purpose.”
            </blockquote>
          </div>

          <!-- 3 Essential Specs (One-liner chips) -->
          <div class="compact-specs-row">
            <div class="spec-pill">
              <span class="sp-k">Fabric</span>
              <span class="sp-v">240 GSM Combed Cotton</span>
            </div>
            <div class="spec-pill">
              <span class="sp-k">Cut</span>
              <span class="sp-v">Drop-Shoulder Oversized</span>
            </div>
            <div class="spec-pill">
              <span class="sp-k">Color</span>
              <span class="sp-v">Crisp White</span>
            </div>
          </div>

          <!-- Dual Tactile Action Buttons -->
          <div class="action-buttons-row">
            <button
              type="button"
              class="btn-action-dark"
              data-product-id="white-tshirt"
            >
              <span class="btn-star">✦</span>
              <span>Quick View Details</span>
            </button>

            <a
              href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20ordering%20the%20official%20GEN%20M%20White%20T-Shirt."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-action-whatsapp"
              aria-label="Enquire about White T-Shirt on WhatsApp"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.588-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.071.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z" />
              </svg>
              <span>Enquire on WhatsApp</span>
            </a>
          </div>

        </div>

      </div>

    </div>
  </div>

</section>

<style>
  /* ═══════════════════════════════════════════════════════════
     COMPACT, BRIEF & COLORFUL POP ART STYLING
     ═══════════════════════════════════════════════════════════ */
  .pop-signature-section {
    position: relative;
    width: 100%;
    background: #ffffff;
    padding-bottom: clamp(32px, 5vw, 64px);
    overflow: hidden;
  }

  /* 1. Slogan Marquee Ticker */
  .pop-ticker-wrapper {
    width: 100%;
    background: #E7EEAC;
    border-top: 3px solid #0f172a;
    border-bottom: 3px solid #0f172a;
    padding: 10px 0;
    overflow: hidden;
    white-space: nowrap;
    box-shadow: 0 3px 0 rgba(15, 23, 42, 0.08);
  }

  .pop-ticker-track {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    animation: tickerFlow 24s linear infinite;
    will-change: transform;
  }

  .ticker-text {
    font-family: 'Neoverse', 'Poppins', sans-serif;
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #0f172a;
  }

  .ticker-star {
    font-size: 1rem;
    color: #174ee8;
  }

  @keyframes tickerFlow {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* 2. Container Shell */
  .pop-signature-shell {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 44px) 16px 0;
  }

  /* Pop Signature Card */
  .pop-signature-card {
    background: #f8fafc;
    border: 3px solid #0f172a;
    border-radius: 28px;
    padding: clamp(20px, 3.5vw, 36px);
    box-shadow: 
      8px 10px 0 #0f172a,
      0 20px 40px rgba(23, 78, 232, 0.08);
  }

  /* Header Row */
  .card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
    border-bottom: 2px dashed #cbd5e1;
    padding-bottom: 14px;
  }

  .kicker-badge-pair {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pill-signature {
    background: #E7EEAC;
    color: #0f172a;
    font-family: 'Poppins', sans-serif;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: 9999px;
    border: 2px solid #0f172a;
    box-shadow: 2px 2px 0 #0f172a;
  }

  .pill-category {
    background: #dbeafe;
    color: #174ee8;
    font-family: 'Poppins', sans-serif;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 4px 12px;
    border-radius: 9999px;
    border: 1.5px solid #174ee8;
  }

  .edition-tag {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.74rem;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.06em;
  }

  /* Grid Layout */
  .card-content-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(24px, 4vw, 44px);
    align-items: center;
  }

  /* Left Garment Visual */
  .garment-visual-wrap {
    display: flex;
    justify-content: center;
  }

  .garment-stage-box {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1;
    background: #ffffff;
    border: 3px solid #0f172a;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-shadow: 4px 5px 0 #0f172a;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
  }

  .garment-stage-box:hover {
    transform: translateY(-3px);
    box-shadow: 6px 8px 0 #0f172a;
  }

  /* ═══════════════════════════════════════════════════════════
     LIQUID (FLUID) DESIGN ANIMATION
     ═══════════════════════════════════════════════════════════ */
  .liquid-fluid-stage {
    position: absolute;
    inset: -15%;
    width: 130%;
    height: 130%;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
    filter: blur(16px);
    opacity: 0.88;
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  .garment-stage-box:hover .liquid-fluid-stage {
    opacity: 1;
    filter: blur(12px);
  }

  .liquid-blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform, border-radius;
  }

  /* Blob 1: Deep Electric Royal Blue Fluid */
  .liquid-blob-primary {
    width: 280px;
    height: 280px;
    top: 10%;
    left: 10%;
    background: radial-gradient(circle, rgba(23, 78, 232, 0.45) 0%, rgba(23, 78, 232, 0.05) 75%);
    animation: liquidMorph1 12s infinite ease-in-out alternate;
  }

  /* Blob 2: Sunshine Pale Yellow Fluid */
  .liquid-blob-secondary {
    width: 240px;
    height: 240px;
    bottom: 8%;
    right: 8%;
    background: radial-gradient(circle, rgba(231, 238, 172, 0.65) 0%, rgba(231, 238, 172, 0.05) 70%);
    animation: liquidMorph2 15s infinite ease-in-out alternate;
  }

  /* Blob 3: Pop Cyan Fluid Accent */
  .liquid-blob-accent {
    width: 190px;
    height: 190px;
    top: 25%;
    right: 15%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.45) 0%, rgba(56, 189, 248, 0.05) 70%);
    animation: liquidMorph3 10s infinite ease-in-out alternate;
  }

  .liquid-glass-refraction {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.35) 0%, transparent 60%);
    mix-blend-mode: overlay;
  }

  @keyframes liquidMorph1 {
    0% {
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
      transform: translate(0, 0) rotate(0deg) scale(1);
    }
    33% {
      border-radius: 40% 60% 70% 30% / 40% 70% 30% 60%;
      transform: translate(18px, -15px) rotate(120deg) scale(1.08);
    }
    66% {
      border-radius: 70% 30% 50% 50% / 30% 40% 60% 70%;
      transform: translate(-15px, 20px) rotate(240deg) scale(0.94);
    }
    100% {
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
      transform: translate(0, 0) rotate(360deg) scale(1);
    }
  }

  @keyframes liquidMorph2 {
    0% {
      border-radius: 40% 60% 60% 40% / 60% 40% 60% 40%;
      transform: translate(0, 0) rotate(0deg) scale(1);
    }
    50% {
      border-radius: 60% 40% 30% 70% / 50% 60% 40% 50%;
      transform: translate(-20px, -20px) rotate(-180deg) scale(1.12);
    }
    100% {
      border-radius: 40% 60% 60% 40% / 60% 40% 60% 40%;
      transform: translate(0, 0) rotate(-360deg) scale(1);
    }
  }

  @keyframes liquidMorph3 {
    0% {
      border-radius: 50% 50% 40% 60% / 40% 60% 50% 50%;
      transform: scale(0.95);
    }
    50% {
      border-radius: 60% 40% 60% 40% / 60% 30% 70% 40%;
      transform: translate(15px, 15px) scale(1.1);
    }
    100% {
      border-radius: 50% 50% 40% 60% / 40% 60% 50% 50%;
      transform: scale(0.95);
    }
  }

  .garment-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
    z-index: 2;
  }

  .garment-stage-box:hover .garment-img {
    transform: scale(1.05);
  }

  .corner-spec-chip {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #E7EEAC;
    border: 1.5px solid #0f172a;
    color: #0f172a;
    font-family: 'Space Grotesk', monospace;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
    z-index: 3;
  }

  .hover-inspect-cue {
    position: absolute;
    bottom: 12px;
    background: rgba(15, 23, 42, 0.9);
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 9999px;
    z-index: 3;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .garment-stage-box:hover .hover-inspect-cue {
    opacity: 1;
    background: #174ee8;
  }

  /* Right Info Column */
  .garment-info-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .garment-title {
    font-family: 'Space Grotesk', 'Poppins', sans-serif;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #0f172a;
    line-height: 1.05;
    margin: 0 0 16px;
  }

  .title-sticker-badge {
    display: inline-block;
    background: #E7EEAC;
    color: #0f172a;
    border: 2.5px solid #0f172a;
    border-radius: 12px;
    padding: 0 12px;
    box-shadow: 3px 3px 0 #0f172a;
    transform: rotate(2deg);
    vertical-align: middle;
  }

  /* Slogan Callout */
  .slogan-callout {
    width: 100%;
    background: #eff6ff;
    border-left: 5px solid #174ee8;
    border-radius: 0 14px 14px 0;
    padding: 12px 18px;
    margin-bottom: 20px;
    box-shadow: 2px 3px 0 rgba(23, 78, 232, 0.1);
  }

  .slogan-label {
    font-family: 'Poppins', sans-serif;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #174ee8;
    display: block;
    margin-bottom: 3px;
  }

  .slogan-quote {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    font-weight: 800;
    color: #1e3a8a;
    margin: 0;
    line-height: 1.35;
  }

  /* Compact Specs Row */
  .compact-specs-row {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 24px;
  }

  .spec-pill {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sp-k {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
  }

  .sp-v {
    font-family: 'Poppins', sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
  }

  /* Action Buttons Row */
  .action-buttons-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    width: 100%;
  }

  .btn-action-dark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0f172a;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 9999px;
    border: 2px solid #0f172a;
    cursor: pointer;
    box-shadow: 3px 3px 0 #174ee8;
    transition: all 0.15s ease;
  }

  .btn-action-dark:hover {
    background: #174ee8;
    border-color: #174ee8;
    transform: translateY(-2px);
    box-shadow: 3px 5px 0 #0f172a;
  }

  .btn-star {
    color: #E7EEAC;
    font-size: 1rem;
    line-height: 1;
  }

  .btn-action-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #25D366;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 9999px;
    border: 2px solid #0f172a;
    text-decoration: none;
    box-shadow: 3px 3px 0 #0f172a;
    transition: all 0.15s ease;
  }

  .btn-action-whatsapp:hover {
    background: #1eb956;
    transform: translateY(-2px);
    box-shadow: 3px 5px 0 #0f172a;
  }

  /* ═══════════════════════════════════════════════════════════
     RESPONSIVE MEDIA QUERIES (PERFECT FOR MOBILE)
     ═══════════════════════════════════════════════════════════ */
  @media (max-width: 820px) {
    .card-content-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .garment-stage-box {
      max-width: 320px;
    }

    .compact-specs-row {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  @media (max-width: 580px) {
    .pop-signature-shell {
      padding: 16px 12px 0;
    }

    .pop-signature-card {
      padding: 18px 14px;
      border-radius: 20px;
      box-shadow: 5px 6px 0 #0f172a;
    }

    .card-header-row {
      margin-bottom: 14px;
      padding-bottom: 10px;
    }

    .pill-signature,
    .pill-category {
      font-size: 0.68rem;
      padding: 3px 9px;
    }

    .garment-stage-box {
      max-width: 260px;
      padding: 14px;
      border-radius: 16px;
    }

    .garment-title {
      font-size: 2rem;
      margin-bottom: 12px;
    }

    .slogan-callout {
      padding: 10px 14px;
      margin-bottom: 14px;
    }

    .slogan-quote {
      font-size: 0.95rem;
    }

    .compact-specs-row {
      grid-template-columns: 1fr;
      gap: 6px;
      margin-bottom: 18px;
    }

    .spec-pill {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 6px 10px;
    }

    .action-buttons-row {
      flex-direction: column;
      gap: 8px;
    }

    .btn-action-dark,
    .btn-action-whatsapp {
      width: 100%;
      justify-content: center;
      font-size: 0.86rem;
      padding: 11px 18px;
    }
  }
</style>
