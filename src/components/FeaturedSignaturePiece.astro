<script>
  // ═══════════════════════════════════════════════════════════
  // LIGHTWEIGHT STORY MODE SCROLL & HOTSPOT CONTROLLER
  // ═══════════════════════════════════════════════════════════
  function setupStoryMode() {
    const section = document.getElementById('featured-piece');
    const progressBar = document.getElementById('storyProgressBar');
    const hotspots = document.querySelectorAll('.story-hotspot');
    const cards = document.querySelectorAll('.story-card');

    if (!section || !progressBar) return;

    let ticking = false;

    // Linear scroll progress listener
    function onStoryScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          const rect = section.getBoundingClientRect();
          const vh = window.innerHeight;

          if (rect.top <= vh && rect.bottom >= 0) {
            const travel = vh + rect.height;
            const progress = Math.min(Math.max((vh - rect.top) / travel, 0), 1);
            progressBar.style.width = `${progress * 100}%`;
          }

          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onStoryScroll, { passive: true });
    onStoryScroll();

    // Hotspot interaction: highlight matching narrative card
    hotspots.forEach((hs) => {
      const targetId = hs.getAttribute('data-target');
      const targetCard = targetId ? document.getElementById(targetId) : null;

      hs.addEventListener('mouseenter', () => {
        hotspots.forEach((h) => h.classList.remove('is-active'));
        cards.forEach((c) => c.classList.remove('is-highlighted'));
        hs.classList.add('is-active');
        if (targetCard) targetCard.classList.add('is-highlighted');
      });

      hs.addEventListener('mouseleave', () => {
        hs.classList.remove('is-active');
        if (targetCard) targetCard.classList.remove('is-highlighted');
      });

      hs.addEventListener('click', (e) => {
        e.stopPropagation();
        if (targetCard) {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          targetCard.classList.add('is-highlighted');
          setTimeout(() => targetCard.classList.remove('is-highlighted'), 2000);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupStoryMode);
  } else {
    setupStoryMode();
  }
  document.addEventListener('astro:page-load', setupStoryMode);
</script>
