---
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/HeaderNav.astro';
import HeroProductComposition from '../components/HeroProductComposition.astro';
import ProductDetailModal from '../components/ProductDetailModal.astro';
import { PRODUCTS, CATEGORIES } from '../data/products';

const featuredTshirt = PRODUCTS.find((p) => p.id === 'white-tshirt')!;
---

<Layout
  title="GEN M Swag • Official 13 Merchandise Collection — MSM Kerala"
  description="Explore the official 13 merchandise products of the GEN M Swag collection by MSM Kerala: White T-Shirt, Diary, Cap, Water Bottle, Cross Bag, and curated essentials. Wear the Identity."
>
  <main class="page-container">

    <!-- ═══════════════════════════════════════════════════════════
         HERO SECTION — LARGE ROUNDED LIGHT-GREY PANEL
         ═══════════════════════════════════════════════════════════ -->
    <section class="hero-wrapper" aria-label="GEN M Swag Hero">
      <div class="hero-panel">
        
        <!-- Minimal Floating Navigation Bar Inside Hero -->
        <HeaderNav />

        <!-- Main Hero Grid Composition -->
        <div class="hero-content-grid">
          
          <!-- Left: Editorial Headline & Copy -->
          <div class="hero-copy-column">
            
            <!-- Eyebrow Pill -->
            <div class="hero-eyebrow">
              <span class="eyebrow-dot"></span>
              <span class="eyebrow-text">THE GEN M SWAG COLLECTION</span>
            </div>

            <!-- Headline -->
            <h1 class="hero-main-headline">
              Wear the<br />
              Identity.
            </h1>

            <!-- Supporting Text -->
            <p class="hero-supporting-copy">
              From everyday essentials to meaningful keepsakes, discover the merchandise made for the GEN M generation.
            </p>

            <!-- Actions Row -->
            <div class="hero-actions-row">
              <a href="#catalogue" class="btn-primary-action">
                <span>Explore the Collection</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>

              <a href="#categories" class="btn-secondary-action">
                <span>Discover the Products</span>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M 8 3 L 8 13 M 4 9 L 8 13 L 12 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>

            <!-- Collection Highlights Pill -->
            <div class="hero-meta-bar">
              <span class="meta-tag highlight">13 EXCLUSIVE ITEMS</span>
              <span class="meta-divider">•</span>
              <span class="meta-tag">4 CATEGORIES</span>
              <span class="meta-divider">•</span>
              <span class="meta-tag">OFFICIAL MSM KERALA MERCHANDISE</span>
            </div>

          </div>

          <!-- Right: Floating Product Composition -->
          <div class="hero-illustration-column">
            <HeroProductComposition />
          </div>

        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════
         PRODUCT CATEGORIES OVERVIEW
         ═══════════════════════════════════════════════════════════ -->
    <section class="section-categories" id="categories">
      <div class="categories-container">
        
        <div class="section-head-center">
          <span class="section-eyebrow">FOUR CURATED CATEGORIES</span>
          <h2 class="section-heading-lg">
            Built for everyday purpose.
          </h2>
          <p class="section-lead-copy">
            Explore 13 distinct pieces thoughtfully crafted for student life, study routines, and community identity.
          </p>
        </div>

        <div class="categories-grid">
          {CATEGORIES.map((cat, idx) => (
            <a href={`#${cat.slug}`} class="category-card">
              <div class="cat-top">
                <span class="cat-num">0{idx + 1}</span>
                <span class="cat-arrow">→</span>
              </div>
              <h3 class="cat-name">{cat.name}</h3>
              <p class="cat-desc">{cat.desc}</p>
              <div class="cat-pill-badge">
                <span>View Products</span>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════
         FEATURED PRODUCT PRESENTATION: WHITE T-SHIRT
         ═══════════════════════════════════════════════════════════ -->
    <section class="section-featured-tshirt" id="featured-tee">
      <div class="featured-container">
        
        <div class="featured-tee-card">
          
          <div class="featured-tee-grid">
            
            <!-- Left: Featured T-Shirt Image -->
            <div class="featured-tee-visual">
              <div class="featured-tee-image-wrap">
                <img
                  src={featuredTshirt.image}
                  alt="Official GEN M White T-Shirt"
                  class="featured-tee-img"
                  width="480"
                  height="480"
                  loading="lazy"
                />
                <span class="signature-tag">SIGNATURE PIECE</span>
              </div>
            </div>

            <!-- Right: Slogan & Details -->
            <div class="featured-tee-info">
              
              <div class="featured-eyebrow-wrap">
                <span class="eyebrow-dot"></span>
                <span class="featured-eyebrow">FEATURED APPAREL</span>
              </div>

              <h2 class="featured-tee-title">
                {featuredTshirt.name}
              </h2>

              <!-- Official Slogan Banner -->
              <div class="slogan-callout-box">
                <span class="slogan-label">OFFICIAL SLOGAN</span>
                <blockquote class="slogan-text">
                  “Rooted in Deen. Driven by Purpose.”
                </blockquote>
              </div>

              <p class="featured-tee-desc">
                {featuredTshirt.description}
              </p>

              <div class="featured-specs-row">
                <div class="spec-pill">
                  <span class="spec-label">Fabric</span>
                  <span class="spec-value">240 GSM Combed Cotton</span>
                </div>
                <div class="spec-pill">
                  <span class="spec-label">Cut</span>
                  <span class="spec-value">Oversized Drop-Shoulder</span>
                </div>
                <div class="spec-pill">
                  <span class="spec-label">Color</span>
                  <span class="spec-value">Crisp White</span>
                </div>
              </div>

              <div class="featured-actions">
                <button
                  type="button"
                  class="btn-featured-view"
                  data-product-id="white-tshirt"
                >
                  <span>View Product Details</span>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>

                <a
                  href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20ordering%20the%20official%20GEN%20M%20White%20T-Shirt."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-featured-enquire"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.588-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.071.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z" />
                  </svg>
                  <span>Enquire on WhatsApp</span>
                </a>
              </div>

            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════
         PRODUCT CATALOGUE SECTION (ALL 13 PRODUCTS IN 4 GROUPS)
         ═══════════════════════════════════════════════════════════ -->
    <section class="section-catalogue" id="catalogue">
      <div class="catalogue-container">
        
        <!-- Header -->
        <div class="section-head-center">
          <span class="section-eyebrow">THE COMPLETE CATALOGUE</span>
          <h2 class="section-heading-lg">Find Your Swag.</h2>
          <p class="section-lead-copy">
            Explore the GEN M collection, from everyday essentials to signature merchandise.
          </p>
        </div>

        <!-- Filter Tabs -->
        <div class="catalogue-filter-bar">
          <button type="button" class="filter-tab is-active" data-filter="all">All Products (13)</button>
          <button type="button" class="filter-tab" data-filter="everyday-essentials">Everyday Essentials (4)</button>
          <button type="button" class="filter-tab" data-filter="drinkware">Drinkware (3)</button>
          <button type="button" class="filter-tab" data-filter="wear-and-carry">Wear & Carry (3)</button>
          <button type="button" class="filter-tab" data-filter="lifestyle-accessories">Lifestyle Accessories (3)</button>
        </div>

        <!-- Group 1: Everyday Essentials (Diary, Pen, Keychain, Bag Tag) -->
        <div class="category-block-group" id="everyday-essentials" data-group="everyday-essentials">
          <div class="category-group-header">
            <div class="group-title-wrap">
              <span class="group-num">CATEGORY 01</span>
              <h3 class="group-title">Everyday Essentials</h3>
            </div>
            <span class="group-count">4 Products</span>
          </div>

          <div class="products-grid">
            {PRODUCTS.filter((p) => p.categorySlug === 'everyday-essentials').map((product) => (
              <div class="product-card" data-category={product.categorySlug}>
                <div class="product-card-visual">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="product-image"
                    width="320"
                    height="320"
                    loading="lazy"
                  />
                  <span class="product-category-tag">{product.category}</span>
                </div>
                <div class="product-card-body">
                  <h4 class="product-name">{product.name}</h4>
                  <p class="product-desc">{product.shortDesc}</p>
                  <div class="product-actions-bar">
                    <button
                      type="button"
                      class="btn-view-product"
                      data-product-id={product.id}
                    >
                      <span>View Product</span>
                      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="btn-enquire-card"
                      data-product-id={product.id}
                      aria-label={`Enquire about ${product.name}`}
                    >
                      Enquire
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Group 2: Drinkware (Glass Set, Water Bottle, Coffee Mug) -->
        <div class="category-block-group" id="drinkware" data-group="drinkware">
          <div class="category-group-header">
            <div class="group-title-wrap">
              <span class="group-num">CATEGORY 02</span>
              <h3 class="group-title">Drinkware</h3>
            </div>
            <span class="group-count">3 Products</span>
          </div>

          <div class="products-grid">
            {PRODUCTS.filter((p) => p.categorySlug === 'drinkware').map((product) => (
              <div class="product-card" data-category={product.categorySlug}>
                <div class="product-card-visual">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="product-image"
                    width="320"
                    height="320"
                    loading="lazy"
                  />
                  <span class="product-category-tag">{product.category}</span>
                </div>
                <div class="product-card-body">
                  <h4 class="product-name">{product.name}</h4>
                  <p class="product-desc">{product.shortDesc}</p>
                  <div class="product-actions-bar">
                    <button
                      type="button"
                      class="btn-view-product"
                      data-product-id={product.id}
                    >
                      <span>View Product</span>
                      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="btn-enquire-card"
                      data-product-id={product.id}
                      aria-label={`Enquire about ${product.name}`}
                    >
                      Enquire
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Group 3: Wear & Carry (Cross Bag, Embroidered Cap, White T-Shirt) -->
        <div class="category-block-group" id="wear-and-carry" data-group="wear-and-carry">
          <div class="category-group-header">
            <div class="group-title-wrap">
              <span class="group-num">CATEGORY 03</span>
              <h3 class="group-title">Wear & Carry</h3>
            </div>
            <span class="group-count">3 Products</span>
          </div>

          <div class="products-grid">
            {PRODUCTS.filter((p) => p.categorySlug === 'wear-and-carry').map((product) => (
              <div class={`product-card ${product.isFeatured ? 'is-featured-border' : ''}`} data-category={product.categorySlug}>
                <div class="product-card-visual">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="product-image"
                    width="320"
                    height="320"
                    loading="lazy"
                  />
                  <span class="product-category-tag">{product.category}</span>
                  {product.isFeatured && (
                    <span class="featured-badge-pill">Signature Slogan</span>
                  )}
                </div>
                <div class="product-card-body">
                  <h4 class="product-name">{product.name}</h4>
                  <p class="product-desc">{product.shortDesc}</p>
                  <div class="product-actions-bar">
                    <button
                      type="button"
                      class="btn-view-product"
                      data-product-id={product.id}
                    >
                      <span>View Product</span>
                      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="btn-enquire-card"
                      data-product-id={product.id}
                      aria-label={`Enquire about ${product.name}`}
                    >
                      Enquire
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Group 4: Lifestyle Accessories (Mobile Stand, Tissue, Car Perfume) -->
        <div class="category-block-group" id="lifestyle-accessories" data-group="lifestyle-accessories">
          <div class="category-group-header">
            <div class="group-title-wrap">
              <span class="group-num">CATEGORY 04</span>
              <h3 class="group-title">Lifestyle Accessories</h3>
            </div>
            <span class="group-count">3 Products</span>
          </div>

          <div class="products-grid">
            {PRODUCTS.filter((p) => p.categorySlug === 'lifestyle-accessories').map((product) => (
              <div class="product-card" data-category={product.categorySlug}>
                <div class="product-card-visual">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="product-image"
                    width="320"
                    height="320"
                    loading="lazy"
                  />
                  <span class="product-category-tag">{product.category}</span>
                </div>
                <div class="product-card-body">
                  <h4 class="product-name">{product.name}</h4>
                  <p class="product-desc">{product.shortDesc}</p>
                  <div class="product-actions-bar">
                    <button
                      type="button"
                      class="btn-view-product"
                      data-product-id={product.id}
                    >
                      <span>View Product</span>
                      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="btn-enquire-card"
                      data-product-id={product.id}
                      aria-label={`Enquire about ${product.name}`}
                    >
                      Enquire
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════
         FINAL CALL TO ACTION
         ═══════════════════════════════════════════════════════════ -->
    <section class="section-final-cta">
      <div class="final-cta-container">
        <div class="final-cta-panel">
          
          <span class="final-cta-eyebrow">MSM KERALA MERCHANDISE</span>

          <h2 class="final-cta-headline">
            Your Swag.<br />
            Your Identity.
          </h2>

          <p class="final-cta-subtext">
            Explore the GEN M collection and find your favourite pieces.
          </p>

          <div class="final-cta-actions">
            <a href="#catalogue" class="btn-cta-explore">
              <span>Explore All Merchandise</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>

          <!-- Decorative Geometry -->
          <div class="cta-bg-geometry" aria-hidden="true">
            <span class="geo-circle-1"></span>
            <span class="geo-circle-2"></span>
          </div>

        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════
         FOOTER
         ═══════════════════════════════════════════════════════════ -->
    <footer class="swag-footer">
      <div class="footer-container">
        
        <div class="footer-top-grid">
          
          <!-- Logo & Attribution -->
          <div class="footer-info-col">
            <a href="/" class="footer-brand-link" aria-label="GEN M Swag">
              <img src="/blogo.png" alt="GEN M Logo" class="footer-logo-img" width="114" height="55" loading="lazy" />
            </a>
            <p class="footer-desc">
              The official merchandise collection for the GEN M generation. Designed and coordinated by MSM Kerala.
            </p>
            <p class="footer-slogan">
              “Rooted in Deen. Driven by Purpose.”
            </p>
          </div>

          <!-- Product Categories Links -->
          <div class="footer-nav-col">
            <span class="footer-head">PRODUCT CATEGORIES</span>
            <ul class="footer-list">
              <li><a href="#everyday-essentials" class="footer-link">Everyday Essentials (4)</a></li>
              <li><a href="#drinkware" class="footer-link">Drinkware (3)</a></li>
              <li><a href="#wear-and-carry" class="footer-link">Wear & Carry (3)</a></li>
              <li><a href="#lifestyle-accessories" class="footer-link">Lifestyle Accessories (3)</a></li>
            </ul>
          </div>

          <!-- Ordering & Support -->
          <div class="footer-contact-col">
            <span class="footer-head">ORDERING & ENQUIRY</span>
            <p class="footer-contact-desc">
              Official merchandise ordering is handled directly through the MSM Kerala coordination desk.
            </p>
            <a
              href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20GEN%20M%20Swag%20merchandise."
              target="_blank"
              rel="noopener noreferrer"
              class="footer-whatsapp-link"
            >
              <span>Connect on WhatsApp</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>

        </div>

        <div class="footer-bottom-bar">
          <p class="footer-copy-text">
            © 2026 GEN M • Muslim Students Movement (MSM Kerala). 13 Official Merchandise Pieces.
          </p>
          <a href="#site-header" class="footer-scroll-top">
            <span>Back to top</span>
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M 8 13 L 8 3 M 4 7 L 8 3 L 12 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>

      </div>
    </footer>

    <!-- Interactive Product Detail & WhatsApp Enquiry Modal -->
    <ProductDetailModal />

  </main>
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════
     GEN M SWAG — PREMIUM EDITORIAL MERCHANDISE STYLING
     ═══════════════════════════════════════════════════════════ */

  .page-container {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-main);
  }

  /* ─── Hero Section ─── */
  .hero-wrapper {
    width: 100%;
    padding: 12px 16px 24px;
    display: flex;
    justify-content: center;
  }

  .hero-panel {
    width: 100%;
    max-width: var(--max-width);
    background-color: var(--color-bg-hero);
    border-radius: var(--radius-panel);
    overflow: hidden;
    position: relative;
    border: 1px solid var(--color-border-subtle);
    padding-bottom: clamp(40px, 6vh, 64px);
  }

  .hero-content-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    max-width: 1360px;
    margin: 0 auto;
    padding: clamp(24px, 4vh, 48px) clamp(24px, 4vw, 56px) 0;
  }

  .hero-copy-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    z-index: 5;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: #ffffff;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(89, 97, 180, 0.14);
    box-shadow: 0 2px 8px rgba(35, 40, 99, 0.04);
    margin-bottom: clamp(16px, 2.5vh, 24px);
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-sage);
  }

  .eyebrow-text {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-blue-violet-dark);
  }

  .hero-main-headline {
    font-family: var(--font-heading);
    font-size: clamp(2.8rem, 6.4vw, 5.8rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--color-text-primary);
    margin-bottom: clamp(16px, 2.5vh, 24px);
  }

  .hero-supporting-copy {
    font-size: clamp(1.02rem, 1.35vw, 1.2rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 520px;
