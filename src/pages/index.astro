---
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/HeaderNav.astro';
import PopSwagBagIllustration from '../components/PopSwagBagIllustration.astro';
import ProductDetailModal from '../components/ProductDetailModal.astro';
import { PRODUCTS, CATEGORIES } from '../data/products';

const featuredTshirt = PRODUCTS.find((p) => p.id === 'white-tshirt')!;
---

<Layout
  title="GEN M Swag • Every Swag Matters — MSM Kerala 2026"
  description="Explore the official 13 merchandise products of GEN M Swag by MSM Kerala: White T-Shirt, Diary, Cap, Water Bottle, Cross Bag, and curated essentials. Rooted in Deen. Driven by Purpose."
>
  <main class="mogo-page-canvas">

    <!-- ═══════════════════════════════════════════════════════════
         MOGO ALL-IN-ONE SINGLE SCREEN HERO
         Contains:
         - Top Navigation
         - "EVERY SWAG MATTERS" Headline + Buttons
         - Cartoon Swag Bag Illustration
         - "Brand Defining Swag" + Dual Arch Ribbon Pipeline
         All fitted perfectly within the initial 100vh screen!
         ═══════════════════════════════════════════════════════════ -->
    <section class="mogo-single-screen-hero" id="hero-stage" aria-label="GEN M Swag Hero Showcase">
      
      <!-- 1. Top Navigation Bar -->
      <HeaderNav />

      <!-- 2. Hero Middle Stage (Left: Editorial Copy & 3D CTA | Right: Pop-Art Bag) -->
      <div class="hero-stage-middle">
        <div class="hero-stage-container">
          
          <!-- Left: Editorial Column -->
          <div class="mogo-copy-col">
            
            <!-- Eyebrow Tag (matches "ADVERTISING AGENCY") -->
            <div class="mogo-eyebrow-tag">
              <span>OFFICIAL MERCHANDISE • 13 PIECES</span>
            </div>

            <!-- Massive Display Headline (matches "EVERY PIXEL MATTERS") -->
            <h1 class="mogo-main-headline">
              <span class="headline-line-1">EVERY SWAG</span>
              <span class="headline-line-2">MATTERS</span>
            </h1>

            <!-- Concise Supporting Slogan Copy -->
            <p class="mogo-lead-paragraph">
              Rooted in Deen. Driven by Purpose. Discover the official 13-piece merchandise collection crafted exclusively for the GEN M generation.
            </p>

            <!-- Dual Action Row (Glass Pill + 3D Yellow Button) -->
            <div class="mogo-actions-cluster">
              
              <!-- Glass Pill Dual Controls (matches [▶ Showreel] [★ Portfolio]) -->
              <div class="mogo-glass-pill-row">
                <a href="/lookbook" class="mogo-pill-btn" aria-label="View Lookbook">
                  <span class="pill-icon-circle icon-play">
                    <svg width="10" height="10" viewBox="0 0 16 16" fill="currentColor">
                      <polygon points="5,3 13,8 5,13" />
                    </svg>
                  </span>
                  <span class="pill-label">Lookbook</span>
                </a>

                <a href="#catalogue" class="mogo-pill-btn" aria-label="Browse 13 Swag Catalogue">
                  <span class="pill-icon-circle icon-star">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="12,2 15,9 22,9 17,14 19,21 12,17 5,21 7,14 2,9 9,9" />
                    </svg>
                  </span>
                  <span class="pill-label">Catalogue (13)</span>
                </a>
              </div>

              <!-- Tactile 3D Sunshine Yellow Button (matches [Get started!]) -->
              <a href="#catalogue" class="btn-3d-yellow-cta">
                <span>Get Swag!</span>
              </a>

            </div>

          </div>

          <!-- Right: The Pop-Art Cartoon Swag Bag Illustration -->
          <div class="mogo-illustration-col">
            <PopSwagBagIllustration />
          </div>

        </div>
      </div>

      <!-- 3. Bottom Dock: "Brand Defining Swag" Dual-Arch Ribbon Pipeline (Inside 100vh) -->
      <div class="hero-stage-bottom-dock">
        <div class="dock-container">
          
          <!-- Center Title (matches "Brand Defining Ideas") -->
          <div class="dock-header">
            <h2 class="dock-headline">Brand Defining Swag</h2>
          </div>

          <!-- The Looping Ribbon Pathway Infographic -->
          <div class="dock-ribbon-wrap">
            
            <!-- Ribbon SVG Tracks with Dual Arch & Node Pins -->
            <svg
              class="dock-ribbon-svg"
              viewBox="0 0 1100 170"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              preserveAspectRatio="xMidYMid meet"
            >
              <defs>
                <linearGradient id="dockRibbonYellow" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#fed700" />
                  <stop offset="50%" stop-color="#facc15" />
                  <stop offset="100%" stop-color="#fed700" />
                </linearGradient>
                <linearGradient id="dockRibbonCyan" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#38bdf8" />
                  <stop offset="50%" stop-color="#0284c7" />
                  <stop offset="100%" stop-color="#38bdf8" />
                </linearGradient>
                <filter id="dockRibbonGlow" x="-10%" y="-10%" width="120%" height="120%">
                  <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#0a1d60" flood-opacity="0.3" />
                </filter>
              </defs>

              <!-- ─── DUAL ARCH RIBBON: Yellow Outer / Cyan Inner ─── -->
              <!-- Outer Yellow Band -->
              <path
                d="M 100 145 
                   C 140 50, 220 15, 320 15 
                   C 430 15, 470 135, 550 135 
                   C 630 135, 670 15, 780 15 
                   C 880 15, 960 50, 1000 145"
                stroke="url(#dockRibbonYellow)"
                stroke-width="15"
                stroke-linecap="round"
                fill="none"
                filter="url(#dockRibbonGlow)"
              />

              <!-- Inner Cyan Band -->
              <path
                d="M 100 160 
                   C 140 65, 220 30, 320 30 
                   C 430 30, 470 150, 550 150 
                   C 630 150, 670 30, 780 30 
                   C 880 30, 960 65, 1000 160"
                stroke="url(#dockRibbonCyan)"
                stroke-width="14"
                stroke-linecap="round"
                fill="none"
              />

              <!-- Node Pins on the Arches -->
              <!-- Node 1: Left (Everyday Essentials) -->
              <g class="dock-svg-node" transform="translate(160, 90)">
                <circle cx="0" cy="0" r="10" fill="#174ee8" stroke="#38bdf8" stroke-width="3.5" />
                <circle cx="0" cy="0" r="4" fill="#fed700" />
              </g>

              <!-- Node 2: Peak 1 (Drinkware) -->
              <g class="dock-svg-node" transform="translate(320, 15)">
                <circle cx="0" cy="0" r="10" fill="#174ee8" stroke="#fed700" stroke-width="3.5" />
                <circle cx="0" cy="0" r="4" fill="#ffffff" />
              </g>

              <!-- Node 3: Peak 2 (Wear & Carry) -->
              <g class="dock-svg-node" transform="translate(780, 15)">
                <circle cx="0" cy="0" r="10" fill="#174ee8" stroke="#fed700" stroke-width="3.5" />
                <circle cx="0" cy="0" r="4" fill="#ffffff" />
              </g>

              <!-- Node 4: Right (Lifestyle) -->
              <g class="dock-svg-node" transform="translate(940, 90)">
                <circle cx="0" cy="0" r="10" fill="#174ee8" stroke="#38bdf8" stroke-width="3.5" />
                <circle cx="0" cy="0" r="4" fill="#fed700" />
              </g>
            </svg>

            <!-- 4 Interactive Category Station Pills overlaying the bottom ribbon -->
            <div class="dock-stations-row">
              
              <a href="#everyday-essentials" class="dock-station-pill" data-filter="everyday-essentials">
                <span class="station-badge">01</span>
                <div class="station-meta">
                  <strong class="station-name">Everyday Essentials</strong>
                  <span class="station-sub">Diary • Pen • Keychain • Tag</span>
                </div>
              </a>

              <a href="#drinkware" class="dock-station-pill" data-filter="drinkware">
                <span class="station-badge">02</span>
                <div class="station-meta">
                  <strong class="station-name">Drinkware</strong>
                  <span class="station-sub">Glass Set • Bottle • Mug</span>
                </div>
              </a>

              <a href="#wear-and-carry" class="dock-station-pill" data-filter="wear-and-carry">
                <span class="station-badge">03</span>
                <div class="station-meta">
                  <strong class="station-name">Wear & Carry</strong>
                  <span class="station-sub">Cross Bag • Cap • White Tee</span>
                </div>
              </a>

              <a href="#lifestyle-accessories" class="dock-station-pill" data-filter="lifestyle-accessories">
                <span class="station-badge">04</span>
                <div class="station-meta">
                  <strong class="station-name">Lifestyle</strong>
                  <span class="station-sub">Stand • Tissue • Perfume</span>
                </div>
              </a>

            </div>

          </div>

        </div>
      </div>

    </section>


    <!-- ═══════════════════════════════════════════════════════════
         MARQUEE TICKER — VIBRANT SUNSHINE YELLOW SLOGAN BAND
         ═══════════════════════════════════════════════════════════ -->
    <div class="mogo-ticker-wrapper" aria-hidden="true">
      <div class="mogo-ticker-track">
        <span class="ticker-text">ROOTED IN DEEN. DRIVEN BY PURPOSE.</span>
        <span class="ticker-star">★</span>
        <span class="ticker-text">13 OFFICIAL MERCHANDISE PIECES</span>
        <span class="ticker-star">★</span>
        <span class="ticker-text">MSM KERALA • GEN M 2026</span>
        <span class="ticker-star">★</span>
        <span class="ticker-text">KOZHIKODE • 13-14-15 NOVEMBER 2026</span>
        <span class="ticker-star">★</span>
        <span class="ticker-text">ROOTED IN DEEN. DRIVEN BY PURPOSE.</span>
        <span class="ticker-star">★</span>
        <span class="ticker-text">13 OFFICIAL MERCHANDISE PIECES</span>
        <span class="ticker-star">★</span>
        <span class="ticker-text">MSM KERALA • GEN M 2026</span>
        <span class="ticker-star">★</span>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         FEATURED PRODUCT PRESENTATION: WHITE T-SHIRT
         ═══════════════════════════════════════════════════════════ -->
    <section class="section-featured-tee" id="featured-tee">
      <div class="featured-tee-shell">
        
        <div class="featured-tee-pop-card">
          
          <div class="featured-tee-grid">
            
            <!-- Left: Featured T-Shirt Image with Comic Frame -->
            <div class="featured-tee-visual-col">
              <div class="featured-tee-image-box">
                <img
                  src={featuredTshirt.image}
                  alt="Official GEN M White T-Shirt"
                  class="featured-tee-img"
                  width="500"
                  height="500"
                  loading="lazy"
                />
                <span class="pop-badge-signature">SIGNATURE PIECE 01</span>
              </div>
            </div>

            <!-- Right: Slogan & Details -->
            <div class="featured-tee-info-col">
              
              <div class="featured-pill-meta">
                <span class="meta-dot"></span>
                <span class="meta-category">WEAR & CARRY • ITEM #10</span>
              </div>

              <h2 class="featured-tee-title">
                {featuredTshirt.name}
              </h2>

              <!-- Official Slogan Callout Box -->
              <div class="slogan-badge-box">
                <span class="slogan-badge-tag">OFFICIAL SLOGAN</span>
                <blockquote class="slogan-badge-quote">
                  “Rooted in Deen. Driven by Purpose.”
                </blockquote>
              </div>

              <p class="featured-tee-copy">
                {featuredTshirt.description}
              </p>

              <!-- Pop Specification Pills -->
              <div class="featured-specs-row">
                <div class="pop-spec-chip">
                  <span class="spec-k">Fabric</span>
                  <span class="spec-v">240 GSM Combed Cotton</span>
                </div>
                <div class="pop-spec-chip">
                  <span class="spec-k">Cut</span>
                  <span class="spec-v">Oversized Drop-Shoulder</span>
                </div>
                <div class="pop-spec-chip">
                  <span class="spec-k">Color</span>
                  <span class="spec-v">Crisp White</span>
                </div>
              </div>

              <!-- Action Row -->
              <div class="featured-actions-row">
                <button
                  type="button"
                  class="btn-featured-quickview"
                  data-product-id="white-tshirt"
                >
                  <span>Quick View Details</span>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>

                <a
                  href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20ordering%20the%20official%20GEN%20M%20White%20T-Shirt."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-featured-whatsapp"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.588-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.071.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z" />
                  </svg>
                  <span>Enquire on WhatsApp</span>
                </a>
              </div>

            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════
         CATALOGUE SECTION — ALL 13 OFFICIAL PRODUCTS
         ═══════════════════════════════════════════════════════════ -->
    <section class="section-catalogue" id="catalogue">
      <div class="catalogue-shell">
        
        <!-- Header -->
        <div class="catalogue-header-center">
          <span class="catalogue-eyebrow">THE COMPLETE COLLECTION</span>
          <h2 class="catalogue-title">The 13 Official Pieces</h2>
          <p class="catalogue-subtitle">
            Explore the full merchandise range created exclusively for GEN M Kerala 2026.
          </p>
        </div>

        <!-- Filter Tabs -->
        <div class="catalogue-filter-bar">
          <button type="button" class="mogo-filter-tab is-active" data-filter="all">All 13 Items</button>
          <button type="button" class="mogo-filter-tab" data-filter="everyday-essentials">Everyday Essentials (4)</button>
          <button type="button" class="mogo-filter-tab" data-filter="drinkware">Drinkware (3)</button>
          <button type="button" class="mogo-filter-tab" data-filter="wear-and-carry">Wear & Carry (3)</button>
          <button type="button" class="mogo-filter-tab" data-filter="lifestyle-accessories">Lifestyle Accessories (3)</button>
        </div>

        <!-- ─── Category Group 1: Everyday Essentials ─── -->
        <div class="category-block-group" id="everyday-essentials" data-group="everyday-essentials">
          <div class="category-block-head">
            <div class="head-info">
              <span class="head-num">CHAPTER 01</span>
              <h3 class="head-name">Everyday Essentials</h3>
            </div>
            <span class="head-pill">4 Products</span>
          </div>

          <div class="products-grid">
            {PRODUCTS.filter((p) => p.categorySlug === 'everyday-essentials').map((product) => (
              <div class="pop-product-card" data-category={product.categorySlug}>
                <div class="product-visual-stage">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="product-img"
                    width="340"
                    height="340"
                    loading="lazy"
                  />
                  <span class="pop-category-badge">{product.category}</span>
                </div>
                <div class="product-info-box">
                  <h4 class="product-title">{product.name}</h4>
                  <p class="product-short-desc">{product.shortDesc}</p>
                  <div class="product-cta-pair">
                    <button
                      type="button"
                      class="btn-pop-details"
                      data-product-id={product.id}
                    >
                      <span>View Details</span>
                    </button>
                    <button
                      type="button"
                      class="btn-pop-enquire"
                      data-product-id={product.id}
                      aria-label={`Enquire about ${product.name}`}
                    >
                      Enquire
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ─── Category Group 2: Drinkware ─── -->
        <div class="category-block-group" id="drinkware" data-group="drinkware">
          <div class="category-block-head">
            <div class="head-info">
              <span class="head-num">CHAPTER 02</span>
              <h3 class="head-name">Drinkware</h3>
            </div>
            <span class="head-pill">3 Products</span>
          </div>

          <div class="products-grid">
            {PRODUCTS.filter((p) => p.categorySlug === 'drinkware').map((product) => (
              <div class="pop-product-card" data-category={product.categorySlug}>
                <div class="product-visual-stage">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="product-img"
                    width="340"
                    height="340"
                    loading="lazy"
                  />
                  <span class="pop-category-badge">{product.category}</span>
                </div>
                <div class="product-info-box">
                  <h4 class="product-title">{product.name}</h4>
                  <p class="product-short-desc">{product.shortDesc}</p>
                  <div class="product-cta-pair">
                    <button
                      type="button"
                      class="btn-pop-details"
                      data-product-id={product.id}
                    >
                      <span>View Details</span>
                    </button>
                    <button
                      type="button"
                      class="btn-pop-enquire"
                      data-product-id={product.id}
                      aria-label={`Enquire about ${product.name}`}
                    >
                      Enquire
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ─── Category Group 3: Wear & Carry ─── -->
        <div class="category-block-group" id="wear-and-carry" data-group="wear-and-carry">
          <div class="category-block-head">
            <div class="head-info">
              <span class="head-num">CHAPTER 03</span>
              <h3 class="head-name">Wear & Carry</h3>
            </div>
            <span class="head-pill">3 Products</span>
          </div>

          <div class="products-grid">
            {PRODUCTS.filter((p) => p.categorySlug === 'wear-and-carry').map((product) => (
              <div class={`pop-product-card ${product.isFeatured ? 'is-signature' : ''}`} data-category={product.categorySlug}>
                <div class="product-visual-stage">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="product-img"
                    width="340"
                    height="340"
                    loading="lazy"
                  />
                  <span class="pop-category-badge">{product.category}</span>
                  {product.isFeatured && (
                    <span class="pop-star-pill">Signature Slogan</span>
                  )}
                </div>
                <div class="product-info-box">
                  <h4 class="product-title">{product.name}</h4>
                  <p class="product-short-desc">{product.shortDesc}</p>
                  <div class="product-cta-pair">
                    <button
                      type="button"
                      class="btn-pop-details"
                      data-product-id={product.id}
                    >
                      <span>View Details</span>
                    </button>
                    <button
                      type="button"
                      class="btn-pop-enquire"
                      data-product-id={product.id}
                      aria-label={`Enquire about ${product.name}`}
                    >
                      Enquire
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ─── Category Group 4: Lifestyle Accessories ─── -->
        <div class="category-block-group" id="lifestyle-accessories" data-group="lifestyle-accessories">
          <div class="category-block-head">
            <div class="head-info">
              <span class="head-num">CHAPTER 04</span>
              <h3 class="head-name">Lifestyle Accessories</h3>
            </div>
            <span class="head-pill">3 Products</span>
          </div>

          <div class="products-grid">
            {PRODUCTS.filter((p) => p.categorySlug === 'lifestyle-accessories').map((product) => (
              <div class="pop-product-card" data-category={product.categorySlug}>
                <div class="product-visual-stage">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="product-img"
                    width="340"
                    height="340"
                    loading="lazy"
                  />
                  <span class="pop-category-badge">{product.category}</span>
                </div>
                <div class="product-info-box">
                  <h4 class="product-title">{product.name}</h4>
                  <p class="product-short-desc">{product.shortDesc}</p>
                  <div class="product-cta-pair">
                    <button
                      type="button"
                      class="btn-pop-details"
                      data-product-id={product.id}
                    >
                      <span>View Details</span>
                    </button>
                    <button
                      type="button"
                      class="btn-pop-enquire"
                      data-product-id={product.id}
                      aria-label={`Enquire about ${product.name}`}
                    >
                      Enquire
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════
         FINAL CALL TO ACTION BANNER
         ═══════════════════════════════════════════════════════════ -->
    <section class="mogo-final-cta-section">
      <div class="final-cta-shell">
        <div class="final-cta-box">
          <span class="cta-pill-eyebrow">MSM KERALA MERCHANDISE DESK</span>
          <h2 class="cta-headline">Every Swag Tells a Story.</h2>
          <p class="cta-desc">
            Connect directly with our coordination team for individual student keepsakes or bulk campus orders.
          </p>
          <div class="cta-buttons-wrap">
            <a
              href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20ordering%20the%20GEN%20M%20merchandise."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-3d-yellow-cta"
            >
              <span>Enquire on WhatsApp</span>
            </a>
            <a href="#catalogue" class="btn-ghost-white-cta">
              <span>Review All 13 Items</span>
            </a>
          </div>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════
         FOOTER
         ═══════════════════════════════════════════════════════════ -->
    <footer class="mogo-footer">
      <div class="footer-shell">
        <div class="footer-top-grid">
          
          <!-- Brand Column -->
          <div class="footer-brand-col">
            <div class="footer-logo-lockup">
              <span class="footer-logo-text">GEN M</span>
              <span class="footer-yellow-bar"></span>
            </div>
            <p class="footer-tagline">
              “Rooted in Deen. Driven by Purpose.”
            </p>
            <p class="footer-about">
              Official merchandise collection for the Generational Student Confluence 2026. Organised by MSM Kerala in Kozhikode, 13–15 November 2026.
            </p>
          </div>

          <!-- Category Navigation -->
          <div class="footer-nav-col">
            <span class="footer-title">THE 13 ITEMS</span>
            <ul class="footer-links">
              <li><a href="#everyday-essentials">01. Everyday Essentials (4)</a></li>
