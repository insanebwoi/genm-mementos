<script>
  function initCatalogueFilters() {
    const filterTabs = document.querySelectorAll('.mogo-filter-tab');
    const categoryGroups = document.querySelectorAll('.category-block-group');

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');
        filterTabs.forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');

        categoryGroups.forEach((group) => {
          const groupName = group.getAttribute('data-group');
          if (filter === 'all' || filter === groupName) {
            (group as HTMLElement).style.display = 'block';
          } else {
            (group as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Also support dock station pill clicks filtering catalogue & smooth scrolling
    const dockPills = document.querySelectorAll('.dock-station-pill');
    dockPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const filter = pill.getAttribute('data-filter');
        const targetTab = document.querySelector(`.mogo-filter-tab[data-filter="${filter}"]`) as HTMLElement;
        if (targetTab) {
          targetTab.click();
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCatalogueFilters);
</script>