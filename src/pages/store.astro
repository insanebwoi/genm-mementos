---
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/HeaderNav.astro';
import PopSwagBagIllustration from '../components/PopSwagBagIllustration.astro';
import FeaturedSignaturePiece from '../components/FeaturedSignaturePiece.astro';
import CatalogueSection from '../components/CatalogueSection.astro';
import ProductDetailModal from '../components/ProductDetailModal.astro';
import { PRODUCTS, CATEGORIES } from '../data/products';
---

<Layout
  title="GEN M Swag • Every Swag Matters — MSM Kerala 2026"
  description="Explore the official 13 merchandise products of GEN M Swag by MSM Kerala: White T-Shirt, Diary, Cap, Water Bottle, Cross Bag, and curated essentials. Rooted in Deen. Driven by Purpose."
>
  <main class="mogo-page-canvas">

    <!-- ═══════════════════════════════════════════════════════════
         MOGO ALL-IN-ONE SINGLE SCREEN HERO
         Contains:
         - Top Navigation
         - "EVERY SWAG MATTERS" Headline + Buttons
         - Cartoon Swag Bag Illustration
         - "Brand Defining Swag" + Dual Arch Ribbon Pipeline
         All fitted perfectly within the initial 100vh screen!
         ═══════════════════════════════════════════════════════════ -->
    <section class="mogo-single-screen-hero" id="hero-stage" aria-label="GEN M Swag Hero Showcase">
      
      <!-- 1. Top Navigation Bar -->
      <HeaderNav />

      <!-- 2. Hero Middle Stage (Left: Editorial Copy & 3D CTA | Right: Pop-Art Bag) -->
      <div class="hero-stage-middle">
        <div class="hero-stage-container">
          
          <!-- Left: Editorial Column -->
          <div class="mogo-copy-col">
            
            <!-- Eyebrow Tag (matches "ADVERTISING AGENCY") -->
            <div class="mogo-eyebrow-tag">
              <span>OFFICIAL MERCHANDISE •  </span>
            </div>

            <!-- Massive Display Headline (matches "EVERY PIXEL MATTERS") -->
            <h1 class="mogo-main-headline">
              <span class="headline-line-1">EVERY SWAG</span>
              <span class="headline-line-2">MATTERS</span>
            </h1>

            <!-- Concise Supporting Slogan Copy -->
            <p class="mogo-lead-paragraph">
              Rooted in Deen. Driven by Purpose. Discover the official   merchandise collection crafted exclusively for the MSM GEN M.
            </p>

            <!-- Dual Action Row (Glass Pill + 3D Yellow Button) -->
            <div class="mogo-actions-cluster">
              
              <!-- Glass Pill Dual Controls (matches [▶ Showreel] [★ Portfolio]) -->
              <div class="mogo-glass-pill-row">
                <a href="/lookbook" class="mogo-pill-btn" aria-label="View Lookbook">
                  <span class="pill-icon-circle icon-play">
                    <svg width="10" height="10" viewBox="0 0 16 16" fill="currentColor">
                      <polygon points="5,3 13,8 5,13" />
                    </svg>
                  </span>
                  <span class="pill-label">Lookbook</span>
                </a>

                <a href="#catalogue" class="mogo-pill-btn" aria-label="Browse 13 Swag Catalogue">
                  <span class="pill-icon-circle icon-star">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="12,2 15,9 22,9 17,14 19,21 12,17 5,21 7,14 2,9 9,9" />
                    </svg>
                  </span>
                  <span class="pill-label">Catalogue (13)</span>
                </a>
              </div>

              <!-- Tactile 3D Sunshine Yellow Button (matches [Get started!]) -->
              <a href="#catalogue" class="btn-3d-yellow-cta">
                <span>Get Swag!</span>
              </a>

            </div>

          </div>

          <!-- Right: The Pop-Art Cartoon Swag Bag Illustration -->
          <div class="mogo-illustration-col">
            <PopSwagBagIllustration />
          </div>

        </div>
      </div>

      <!-- 3. Bottom Dock: "Brand Defining Swag" Dual-Arch Ribbon Pipeline (Inside 100vh) -->
      <div class="hero-stage-bottom-dock">
        <div class="dock-container">
          
          <!-- Center Title (matches "Brand Defining Ideas") -->
          <div class="dock-header">
            <h2 class="dock-headline">Brand Defining Swag</h2>
          </div>

          <!-- The Looping Ribbon Pathway Infographic -->
          <div class="dock-ribbon-wrap">
            
            <!-- Ribbon SVG Tracks with Dual Arch & Node Pins -->
            <svg
              class="dock-ribbon-svg"
              viewBox="0 0 1100 170"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              preserveAspectRatio="xMidYMid meet"
            >
              <defs>
                <linearGradient id="dockRibbonForest" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#264639" />
                  <stop offset="50%" stop-color="#3D6855" />
                  <stop offset="100%" stop-color="#264639" />
                </linearGradient>
                <linearGradient id="dockRibbonSage" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#81A773" />
                  <stop offset="50%" stop-color="#E7EEAC" />
                  <stop offset="100%" stop-color="#81A773" />
                </linearGradient>
                <filter id="dockRibbonGlow" x="-10%" y="-10%" width="120%" height="120%">
                  <feDropShadow dx="0" dy="6" stdDeviation="5" flood-color="#16241D" flood-opacity="0.12" />
                </filter>
              </defs>

              <!-- ─── DUAL ARCH RIBBON: Forest Outer / Sage Inner ─── -->
              <!-- Outer Forest Band -->
              <path
                d="M 100 145 
                   C 140 50, 220 15, 320 15 
                   C 430 15, 470 135, 550 135 
                   C 630 135, 670 15, 780 15 
                   C 880 15, 960 50, 1000 145"
                stroke="url(#dockRibbonForest)"
                stroke-width="15"
                stroke-linecap="round"
                fill="none"
                filter="url(#dockRibbonGlow)"
              />

              <!-- Inner Sage Band -->
              <path
                d="M 100 160 
                   C 140 65, 220 30, 320 30 
                   C 430 30, 470 150, 550 150 
                   C 630 150, 670 30, 780 30 
                   C 880 30, 960 65, 1000 160"
                stroke="url(#dockRibbonSage)"
                stroke-width="14"
                stroke-linecap="round"
                fill="none"
              />

              <!-- Node Pins on the Arches -->
              <!-- Node 1: Left (Everyday Essentials) -->
              <g class="dock-svg-node" transform="translate(160, 90)">
                <circle cx="0" cy="0" r="10" fill="#264639" stroke="#E7EEAC" stroke-width="3" />
                <circle cx="0" cy="0" r="4" fill="#ffffff" />
              </g>

              <!-- Node 2: Peak 1 (Drinkware) -->
              <g class="dock-svg-node" transform="translate(320, 15)">
                <circle cx="0" cy="0" r="10" fill="#264639" stroke="#E7EEAC" stroke-width="3" />
                <circle cx="0" cy="0" r="4" fill="#ffffff" />
              </g>

              <!-- Node 3: Peak 2 (Wear & Carry) -->
              <g class="dock-svg-node" transform="translate(780, 15)">
                <circle cx="0" cy="0" r="10" fill="#264639" stroke="#E7EEAC" stroke-width="3" />
                <circle cx="0" cy="0" r="4" fill="#ffffff" />
              </g>

              <!-- Node 4: Right (Lifestyle) -->
              <g class="dock-svg-node" transform="translate(940, 90)">
                <circle cx="0" cy="0" r="10" fill="#264639" stroke="#E7EEAC" stroke-width="3" />
                <circle cx="0" cy="0" r="4" fill="#ffffff" />
              </g>
            </svg>

            <!-- 4 Interactive Category Station Pills overlaying the bottom ribbon -->
            <div class="dock-stations-row">
              
              <a href="#everyday-essentials" class="dock-station-pill" data-filter="everyday-essentials">
                <span class="station-badge">01</span>
                <div class="station-meta">
                  <strong class="station-name">Everyday Essentials</strong>
                  <span class="station-sub">Diary • Pen • Keychain • Tag</span>
                </div>
              </a>

              <a href="#drinkware" class="dock-station-pill" data-filter="drinkware">
                <span class="station-badge">02</span>
                <div class="station-meta">
                  <strong class="station-name">Drinkware</strong>
                  <span class="station-sub">Glass Set • Bottle • Mug</span>
                </div>
              </a>

              <a href="#wear-and-carry" class="dock-station-pill" data-filter="wear-and-carry">
                <span class="station-badge">03</span>
                <div class="station-meta">
                  <strong class="station-name">Wear & Carry</strong>
                  <span class="station-sub">Cross Bag • Cap • White Tee</span>
                </div>
              </a>

              <a href="#lifestyle-accessories" class="dock-station-pill" data-filter="lifestyle-accessories">
                <span class="station-badge">04</span>
                <div class="station-meta">
                  <strong class="station-name">Lifestyle</strong>
                  <span class="station-sub">Stand • Tissue • Perfume</span>
                </div>
              </a>

            </div>

          </div>

        </div>
      </div>

    </section>



    <!-- ═══════════════════════════════════════════════════════════
         FEATURED SIGNATURE PIECE (LAVENDER AESTHETIC & PARALLAX)
         ═══════════════════════════════════════════════════════════ -->
    <FeaturedSignaturePiece />

    <!-- ═══════════════════════════════════════════════════════════
         CATALOGUE SECTION — ALL 13 OFFICIAL PIECES
         ═══════════════════════════════════════════════════════════ -->
    <CatalogueSection />



    <!-- ═══════════════════════════════════════════════════════════
         FINAL CALL TO ACTION BANNER
         ═══════════════════════════════════════════════════════════ -->
    <section class="mogo-final-cta-section">
      <div class="final-cta-shell">
        <div class="final-cta-box">
          <span class="cta-pill-eyebrow">MSM KERALA MERCHANDISE DESK</span>
          <h2 class="cta-headline">Every Swag Tells a Story.</h2>
          <p class="cta-desc">
            Connect directly with our coordination team for individual student keepsakes or bulk campus orders.
          </p>
          <div class="cta-buttons-wrap">
            <a
              href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20ordering%20the%20GEN%20M%20merchandise."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-3d-yellow-cta"
            >
              <span>Enquire on WhatsApp</span>
            </a>
            <a href="#catalogue" class="btn-ghost-white-cta">
              <span>Review All 13 Items</span>
            </a>
          </div>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════
         FOOTER
         ═══════════════════════════════════════════════════════════ -->
    <footer class="mogo-footer">
      <div class="footer-shell">
        <div class="footer-top-grid">
          
          <!-- Brand Column -->
          <div class="footer-brand-col">
            <div class="footer-logo-lockup">
              <span class="footer-logo-text">GEN M</span>
              <span class="footer-yellow-bar"></span>
            </div>
            <p class="footer-tagline">
              “Rooted in Deen. Driven by Purpose.”
            </p>
            <p class="footer-about">
              Official merchandise collection for the Generational Student Confluence 2026. Organised by MSM Kerala in Kozhikode, 13–15 November 2026.
            </p>
          </div>

          <!-- Category Navigation -->
          <div class="footer-nav-col">
            <span class="footer-title">THE 13 ITEMS</span>
            <ul class="footer-links">
              <li><a href="#everyday-essentials">01. Everyday Essentials (4)</a></li>
              <li><a href="#drinkware">02. Drinkware (3)</a></li>
              <li><a href="#wear-and-carry">03. Wear & Carry (3)</a></li>
              <li><a href="#lifestyle-accessories">04. Lifestyle Accessories (3)</a></li>
            </ul>
          </div>

          <!-- Desk & Coordination -->
          <div class="footer-contact-col">
            <span class="footer-title">COORDINATION DESK</span>
            <p class="footer-desk-desc">
              Direct enquiries for campus units, state delegates, and individual students across Kerala.
            </p>
            <a
              href="https://wa.me/919495123456?text=Hello%20MSM%20Kerala%2C%20I%20would%20like%20to%20enquire%20about%20GEN%20M%20Swag%20merchandise."
              target="_blank"
              rel="noopener noreferrer"
              class="footer-wa-pill"
            >
              <span>WhatsApp Coordination Desk</span>
            </a>
          </div>

        </div>

        <div class="footer-bottom-line">
          <p>© 2026 GEN M • Muslim Students Movement (MSM Kerala). 13 Official Merchandise Pieces.</p>
          <div class="footer-bottom-actions">
            <a href="/dashboard" class="footer-admin-link">Staff Login & Operations Dashboard →</a>
            <a href="#site-header" class="footer-top-link">Back to top ↑</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Interactive Product Detail & WhatsApp Enquiry Modal -->
    <ProductDetailModal />

  </main>
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════
     PAUCEK STUDIO LIGHT THEME DESIGN SYSTEM
     Canvas: #F4EFE6 (Warm Sand)
     Accents: #264639 (Deep Forest Pine), #E7EEAC (Sage Cream), #81A773 (Sage)
     ═══════════════════════════════════════════════════════════ */

  .mogo-page-canvas {
    width: 100%;
    min-height: 100vh;
    background-color: #F4EFE6;
    color: #16241D;
    overflow-x: hidden;
  }

  /* ═══════════════════════════════════════════════════════════
     ALL-IN-ONE SINGLE SCREEN HERO CONTAINER
     Fitted within 100vh on Desktop so everything is visible together!
     ═══════════════════════════════════════════════════════════ */
  .mogo-single-screen-hero {
    width: 100%;
    min-height: 100vh;
    background-color: #F4EFE6;
    background-image: 
      radial-gradient(circle at 85% 15%, rgba(38, 70, 57, 0.06) 0%, transparent 45%),
      radial-gradient(circle at 15% 75%, rgba(129, 167, 115, 0.08) 0%, transparent 55%);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    box-sizing: border-box;
    padding-bottom: 12px;
  }

  @media (min-width: 1025px) {
    .mogo-single-screen-hero {
      height: 100vh;
      max-height: 100vh;
      overflow: hidden;
    }
  }

  /* ─── Hero Middle Stage (Content Row) ─── */
  .hero-stage-middle {
    flex: 1;
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .hero-stage-container {
    max-width: 1360px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(20px, 3.5vw, 48px);
    align-items: center;
    position: relative;
    z-index: 10;
  }

  /* ─── Hero Copy Column ─── */
  .mogo-copy-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(10px, 1.4vw, 18px);
    z-index: 2;
  }

  /* Eyebrow Tag */
  .mogo-eyebrow-tag {
    display: inline-block;
    font-family: 'Neoverse', 'Poppins', sans-serif;
    font-size: clamp(0.72rem, 1vw, 0.86rem);
    font-weight: 800;
    letter-spacing: 0.16em;
    color: #264639;
    background: #E7EEAC;
    padding: 4px 12px;
    border-radius: 9999px;
    border: 1.5px solid #264639;
    text-transform: uppercase;
  }

  /* Massive Display Headline */
  .mogo-main-headline {
    font-family: 'Neoverse', 'Poppins', 'Space Grotesk Variable', sans-serif;
    font-size: clamp(2.6rem, 5vw, 5.2rem);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.04em;
    color: #16241D;
    text-transform: uppercase;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .headline-line-1 {
    display: block;
    margin-right: 0.2em;
    color: #16241D;
  }

  .headline-line-2 {
    display: block;
    color: #264639;
  }

  /* Supporting Paragraph */
  .mogo-lead-paragraph {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.95rem, 1.25vw, 1.15rem);
    line-height: 1.5;
    color: #4A6354;
    max-width: 480px;
    margin: 0;
  }

  /* Actions Cluster: Glass Pill + 3D Yellow Button together */
  .mogo-actions-cluster {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 2px;
  }

  /* ─── Glass Pill Controls (matches [▶ Showreel] [★ Portfolio]) ─── */
  .mogo-glass-pill-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1.5px solid #E2DCCF;
    border-radius: 9999px;
    padding: 5px 6px;
    box-shadow: 0 4px 16px rgba(38, 70, 57, 0.08);
  }

  .mogo-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 9999px;
    color: #16241D;
    text-decoration: none;
    font-family: 'Neoverse', 'Poppins', sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .mogo-pill-btn:hover {
    background: rgba(38, 70, 57, 0.08);
    transform: translateY(-1px);
  }

  .pill-icon-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #264639;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 5px rgba(38, 70, 57, 0.2);
  }

  .pill-icon-circle.icon-play {
    color: #E7EEAC;
  }

  .pill-icon-circle.icon-star {
    color: #E7EEAC;
  }

  /* ─── Tactile 3D Sunshine Yellow Button (matches [Get started!]) ─── */
  .btn-3d-yellow-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #E7EEAC;
    color: #16241D;
    font-family: 'Neoverse', 'Poppins', sans-serif;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    font-weight: 800;
    padding: 13px 28px;
    border-radius: 12px;
    text-decoration: none;
    border: 2px solid #264639;
    box-shadow: 0 5px 0 #264639, 0 10px 20px rgba(38, 70, 57, 0.15);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-3d-yellow-cta:hover {
    transform: translateY(2px);
    box-shadow: 0 3px 0 #264639, 0 6px 12px rgba(38, 70, 57, 0.15);
  }

  .btn-3d-yellow-cta:active {
    transform: translateY(5px);
    box-shadow: 0 0 0 #264639;
  }

  /* ─── Hero Illustration Column ─── */
  .mogo-illustration-col {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-height: clamp(280px, 42vh, 440px);
  }


  /* ═══════════════════════════════════════════════════════════
     BOTTOM DOCK: "Brand Defining Swag" (Inside 100vh Hero)
     Dual arch yellow/cyan ribbon connecting 4 categories
     ═══════════════════════════════════════════════════════════ */
  .hero-stage-bottom-dock {
    width: 100%;
    padding: 4px 24px 8px;
    box-sizing: border-box;
    position: relative;
    z-index: 15;
  }

  .dock-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dock-header {
    text-align: center;
    margin-bottom: 2px;
  }

  .dock-headline {
    font-family: 'Neoverse', 'Poppins', sans-serif;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #16241D;
    margin: 0;
  }

  .dock-ribbon-wrap {
    position: relative;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dock-ribbon-svg {
    width: 100%;
    max-height: clamp(70px, 12vh, 120px);
    height: auto;
    display: block;
    margin-bottom: -16px;
  }

  /* 4 Interactive Category Station Pills overlaying ribbon */
  .dock-stations-row {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    position: relative;
    z-index: 5;
  }

  .dock-station-pill {
    background: #FFFFFF;
    border: 1.5px solid #E2DCCF;
    border-radius: 14px;
    padding: 8px 12px;
    text-decoration: none;
    color: #16241D;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(38, 70, 57, 0.06);
  }

  .dock-station-pill:hover {
    background: #F4EFE6;
    transform: translateY(-2px);
    border-color: #264639;
    box-shadow: 0 8px 20px rgba(38, 70, 57, 0.12);
  }

  .station-badge {
    background: #264639;
    color: #E7EEAC;
    font-family: 'Neoverse', 'Poppins', sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 7px;
    border-radius: 6px;
    line-height: 1;
    flex-shrink: 0;
  }

  .station-meta {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    line-height: 1.2;
  }

  .station-name {
    font-family: 'Neoverse', 'Poppins', sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    color: #16241D;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }

  .station-sub {
    font-size: 0.68rem;
    color: #4D6356;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }


  /* ═══════════════════════════════════════════════════════════
     MARQUEE TICKER — SUNSHINE YELLOW
     ═══════════════════════════════════════════════════════════ */



  /* ═══════════════════════════════════════════════════════════
     FINAL CALL TO ACTION
     ═══════════════════════════════════════════════════════════ */
  .mogo-final-cta-section {
    width: 100%;
    padding: clamp(60px, 8vw, 100px) 24px;
    background: #F4EFE6;
    color: #16241D;
  }

  .final-cta-shell {
    max-width: 1100px;
    margin: 0 auto;
  }

  .final-cta-box {
    background: #264639;
    color: #ffffff;
    border: 3.5px solid #16241D;
    border-radius: 36px;
    padding: clamp(40px, 6vw, 72px) clamp(24px, 4vw, 48px);
    text-align: center;
    box-shadow: 12px 14px 0 #16241D;
  }

  .cta-pill-eyebrow {
    display: inline-block;
    font-family: 'Neoverse', 'Poppins', sans-serif;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #E7EEAC;
    margin-bottom: 12px;
  }

  .cta-headline {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.4rem, 4.5vw, 4.2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    color: #ffffff;
  }

  .cta-desc {
