    // ─────────────────────────────────────────────────────────────
    // FINANCIALS & REVENUE TAB
    // ─────────────────────────────────────────────────────────────
    async function loadFinancialData() {
      try {
        const resp = await fetch(`${API_BASE}/api/financials`, {
          headers: { 'Authorization': `Bearer ${authToken}` }
        });

        if (resp.ok) {
          const data = await resp.json();
          
          // Calculate live booked sales from allRecords
          let totalSales = 0;
          let paidRev = 0;
          let pendingRev = 0;

          allRecords.forEach(r => {
            const item = r.item;
            const qty = parseInt(r.qty, 10) || 1;
            const status = (r.bookingStatus || '').toLowerCase();
            const payment = (r.paymentStatus || '').toLowerCase();
            if (status !== 'cancelled') {
              const meta = (data.items || []).find(it => it.item === item);
              const price = meta ? meta.sellingPrice : 150;
              const val = price * qty;
              totalSales += val;
              if (payment === 'paid') paidRev += val;
              else pendingRev += val;
            }
          });

          statTotalSales.textContent = `₹${totalSales.toLocaleString()}`;
          document.getElementById('finRealizedRevenue').textContent = `₹${paidRev.toLocaleString()}`;
          document.getElementById('finPendingReceivables').textContent = `Pending Collectible: ₹${pendingRev.toLocaleString()}`;

          // Populate Financials table directly from Google Sheet1!
          const tbody = document.getElementById('finTableBody');
          tbody.innerHTML = '';

          (data.items || []).forEach(c => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td><strong>${escapeHtml(c.item)}</strong></td>
              <td style="text-align: right; color: #94a3b8;">₹${c.unitCost}.00</td>
              <td style="text-align: right; font-weight: 700; color: #E7EEAC;">₹${c.sellingPrice}.00</td>
              <td style="text-align: right; font-weight: 700; color: #4ade80;">₹${c.unitProfit}.00</td>
              <td style="text-align: center;"><span class="badge-status status-delivered">${c.margin}</span></td>
              <td style="text-align: center; font-weight: 700;">${c.qty}</td>
              <td style="text-align: right; color: #94a3b8;">₹${c.totalCost.toLocaleString()}.00</td>
              <td style="text-align: right; font-weight: 800; color: #38bdf8;">₹${c.expectedRevenue.toLocaleString()}.00</td>
            `;
            tbody.appendChild(tr);
          });
        }
      } catch (e) {
        console.warn('Error loading financial data:', e);
      }
    }

    // ─────────────────────────────────────────────────────────────
    // ⚡ EXPRESS QUICK BOOKING ENGINE
    // ─────────────────────────────────────────────────────────────
    function initQuickBooking() {
      const qbForm = document.getElementById('quickBookingForm');
      if (!qbForm) return;

      const qbItemChips = document.getElementById('qbItemChips');
      const qbTshirtSizeBox = document.getElementById('qbTshirtSizeBox');
      const qbGeneralQtyBox = document.getElementById('qbGeneralQtyBox');
      const qbGeneralItemLabel = document.getElementById('qbGeneralItemLabel');
      const qbName = document.getElementById('qbName');
      const qbPhone = document.getElementById('qbPhone');
      const qbNotes = document.getElementById('qbNotes');
      const qbSubmitBtn = document.getElementById('qbSubmitBtn');
      const qbSpinner = document.getElementById('qbSpinner');
      const qbFeedbackAlert = document.getElementById('qbFeedbackAlert');

      // Size inputs
      const sizeSInput = document.getElementById('qbSizeS');
      const sizeMInput = document.getElementById('qbSizeM');
      const sizeLInput = document.getElementById('qbSizeL');
      const sizeXLInput = document.getElementById('qbSizeXL');
      const sizeXXLInput = document.getElementById('qbSizeXXL');
      const sizeInputs = { S: sizeSInput, M: sizeMInput, L: sizeLInput, XL: sizeXLInput, XXL: sizeXXLInput };

      // General quantity
      const genQtyInput = document.getElementById('qbGenQty');
      const genMinus = document.getElementById('qbGenMinus');
      const genPlus = document.getElementById('qbGenPlus');

      let currentItem = 'White T-Shirt';
      let currentItemPrice = 449;
      let currentBookingStatus = 'Confirmed';
      let currentPaymentStatus = 'Pending';

      const ITEM_PRICES = {
        'White T-Shirt': 449,
        'Diary': 150,
        'Pen': 20,
        'Keychain': 25,
        'Embroidered Cap': 180,
        'Water Bottle': 350,
        'Coffee Mug': 180,
        'Cross Bag': 180,
        'Bag Tag': 50,
        'Glass Set': 200,
        'Mobile Stand': 199,
        'Tissue': 79,
        'Car Perfume': 40
      };

      function updateCalculations() {
        if (currentItem === 'White T-Shirt') {
          const s = parseInt(sizeSInput.value, 10) || 0;
          const m = parseInt(sizeMInput.value, 10) || 0;
          const l = parseInt(sizeLInput.value, 10) || 0;
          const xl = parseInt(sizeXLInput.value, 10) || 0;
          const xxl = parseInt(sizeXXLInput.value, 10) || 0;
          const totalTshirts = s + m + l + xl + xxl;

          const parts = [];
          if (s > 0) parts.push(`${s}x S`);
          if (m > 0) parts.push(`${m}x M`);
          if (l > 0) parts.push(`${l}x L`);
          if (xl > 0) parts.push(`${xl}x XL`);
          if (xxl > 0) parts.push(`${xxl}x XXL`);

          document.getElementById('qbTshirtCountLabel').textContent = `${totalTshirts} T-Shirt${totalTshirts === 1 ? '' : 's'} selected`;
          document.getElementById('qbTshirtBreakdownLabel').textContent = parts.length > 0 ? parts.join(', ') : 'Tap + or presets to select sizes';
          document.getElementById('qbTshirtPriceLabel').textContent = `₹${(totalTshirts * currentItemPrice).toLocaleString()}.00 Total`;
        } else {
          const q = Math.max(1, parseInt(genQtyInput.value, 10) || 1);
          genQtyInput.value = q;
          document.getElementById('qbGenCountLabel').textContent = `${q} unit${q === 1 ? '' : 's'}`;
          document.getElementById('qbGenPriceTotal').textContent = `₹${(q * currentItemPrice).toLocaleString()}.00 Total`;
        }
      }

      // Chip item selector
      if (qbItemChips) {
        qbItemChips.querySelectorAll('.qb-chip').forEach(chip => {
          chip.addEventListener('click', () => {
            qbItemChips.querySelectorAll('.qb-chip').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            currentItem = chip.getAttribute('data-item');
            currentItemPrice = ITEM_PRICES[currentItem] || parseInt(chip.getAttribute('data-price'), 10) || 150;

            if (currentItem === 'White T-Shirt') {
              qbTshirtSizeBox.style.display = 'block';
              qbGeneralQtyBox.style.display = 'none';
            } else {
              qbTshirtSizeBox.style.display = 'none';
              qbGeneralQtyBox.style.display = 'block';
              qbGeneralItemLabel.textContent = `${currentItem} Quantity:`;
            }
            updateCalculations();
          });
        });
      }

      // Steppers for T-Shirt
      qbTshirtSizeBox.querySelectorAll('.step-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const size = btn.getAttribute('data-size');
          const input = sizeInputs[size];
          if (!input) return;
          let val = parseInt(input.value, 10) || 0;
          if (btn.classList.contains('plus')) val++;
          else if (btn.classList.contains('minus')) val = Math.max(0, val - 1);
          input.value = val;
          updateCalculations();
        });
      });

      Object.values(sizeInputs).forEach(input => {
        input.addEventListener('input', () => {
          if (parseInt(input.value, 10) < 0 || isNaN(parseInt(input.value, 10))) input.value = 0;
          updateCalculations();
        });
      });

      // Presets for T-Shirt
      qbTshirtSizeBox.querySelectorAll('.btn-preset').forEach(btn => {
        btn.addEventListener('click', () => {
          const preset = btn.getAttribute('data-preset');
          if (preset === 'M1') sizeMInput.value = (parseInt(sizeMInput.value, 10) || 0) + 1;
          else if (preset === 'L1') sizeLInput.value = (parseInt(sizeLInput.value, 10) || 0) + 1;
          else if (preset === 'XL1') sizeXLInput.value = (parseInt(sizeXLInput.value, 10) || 0) + 1;
          else if (preset === 'ALL1') {
            sizeSInput.value = (parseInt(sizeSInput.value, 10) || 0) + 1;
            sizeMInput.value = (parseInt(sizeMInput.value, 10) || 0) + 1;
            sizeLInput.value = (parseInt(sizeLInput.value, 10) || 0) + 1;
            sizeXLInput.value = (parseInt(sizeXLInput.value, 10) || 0) + 1;
            sizeXXLInput.value = (parseInt(sizeXXLInput.value, 10) || 0) + 1;
          } else if (preset === 'CLEAR') {
            sizeSInput.value = 0;
            sizeMInput.value = 0;
            sizeLInput.value = 0;
            sizeXLInput.value = 0;
            sizeXXLInput.value = 0;
          }
          updateCalculations();
        });
      });

      // General quantity steppers
      if (genMinus) {
        genMinus.addEventListener('click', () => {
          let val = parseInt(genQtyInput.value, 10) || 1;
          genQtyInput.value = Math.max(1, val - 1);
          updateCalculations();
        });
      }
      if (genPlus) {
        genPlus.addEventListener('click', () => {
          let val = parseInt(genQtyInput.value, 10) || 1;
          genQtyInput.value = val + 1;
          updateCalculations();
        });
      }
      if (genQtyInput) {
        genQtyInput.addEventListener('input', () => {
          if (parseInt(genQtyInput.value, 10) < 1 || isNaN(parseInt(genQtyInput.value, 10))) genQtyInput.value = 1;
          updateCalculations();
        });
      }

      // General presets
      qbGeneralQtyBox.querySelectorAll('.btn-gen-preset').forEach(btn => {
        btn.addEventListener('click', () => {
          genQtyInput.value = parseInt(btn.getAttribute('data-qty'), 10) || 1;
          updateCalculations();
        });
      });

      // Status toggles
      const bookingPills = document.getElementById('qbBookingPills');
      if (bookingPills) {
        bookingPills.querySelectorAll('.toggle-pill').forEach(pill => {
          pill.addEventListener('click', () => {
            bookingPills.querySelectorAll('.toggle-pill').forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            currentBookingStatus = pill.getAttribute('data-val');
          });
        });
      }

      const paymentPills = document.getElementById('qbPaymentPills');
      if (paymentPills) {
        paymentPills.querySelectorAll('.toggle-pill').forEach(pill => {
          pill.addEventListener('click', () => {
            paymentPills.querySelectorAll('.toggle-pill').forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            currentPaymentStatus = pill.getAttribute('data-val');
          });
        });
      }

      // Submit booking
      qbForm.addEventListener('submit', async () => {
        const name = qbName.value.trim();
        if (!name) {
          qbName.focus();
          return;
        }

        let totalQty = 1;
        let s = 0, m = 0, l = 0, xl = 0, xxl = 0;

        if (currentItem === 'White T-Shirt') {
          s = parseInt(sizeSInput.value, 10) || 0;
          m = parseInt(sizeMInput.value, 10) || 0;
          l = parseInt(sizeLInput.value, 10) || 0;
          xl = parseInt(sizeXLInput.value, 10) || 0;
          xxl = parseInt(sizeXXLInput.value, 10) || 0;
          totalQty = s + m + l + xl + xxl;

          if (totalQty === 0) {
            qbFeedbackAlert.style.display = 'flex';
            qbFeedbackAlert.className = 'qb-feedback-alert error';
            qbFeedbackAlert.textContent = 'Please select at least 1 size quantity for White T-Shirt.';
            return;
          }
        } else {
          totalQty = parseInt(genQtyInput.value, 10) || 1;
        }

        const payload = {
          name,
          phone: qbPhone.value.trim(),
          email: '',
          item: currentItem,
          qty: totalQty,
          bookingStatus: currentBookingStatus,
          paymentStatus: currentPaymentStatus,
          notes: qbNotes.value.trim(),
          sizeS: s,
          sizeM: m,
          sizeL: l,
          sizeXL: xl,
          sizeXXL: xxl
        };

        qbSubmitBtn.disabled = true;
        qbSpinner.style.display = 'inline-block';
        qbFeedbackAlert.style.display = 'none';

        function resetInputs() {
          qbName.value = '';
          qbPhone.value = '';
          qbNotes.value = '';
          sizeSInput.value = 0;
          sizeMInput.value = 0;
          sizeLInput.value = 0;
          sizeXLInput.value = 0;
          sizeXXLInput.value = 0;
          genQtyInput.value = 1;
          updateCalculations();
        }

        let sizeSummaryStr = 'Standard';
        let allocStatusStr = 'Standard';
        if (currentItem === 'White T-Shirt') {
          const parts = [];
          if (s > 0) parts.push(`${s}x S`);
          if (m > 0) parts.push(`${m}x M`);
          if (l > 0) parts.push(`${l}x L`);
          if (xl > 0) parts.push(`${xl}x XL`);
          if (xxl > 0) parts.push(`${xxl}x XXL`);
          sizeSummaryStr = parts.length > 0 ? parts.join(', ') : 'Standard';
          allocStatusStr = (s + m + l + xl + xxl) === totalQty ? 'Matched' : 'Mismatch';
        }

        // 1. If currently offline, queue immediately without blocking
        if (!navigator.onLine) {
          const offlineItem = {
            id: 'offline_' + Date.now(),
            rowNumber: `OFFLINE-${Date.now().toString().slice(-4)}`,
            timestamp: new Date().toISOString(),
            name,
            phone: qbPhone.value.trim(),
            email: '',
            item: currentItem,
            qty: totalQty,
            bookingStatus: currentBookingStatus,
            paymentStatus: currentPaymentStatus,
            notes: qbNotes.value.trim(),
            sizeS: s,
            sizeM: m,
            sizeL: l,
            sizeXL: xl,
            sizeXXL: xxl,
            sizeAllocationStatus: allocStatusStr,
            sizesSummary: sizeSummaryStr,
            sourceSheet: 'Form Responses 1',
            isOffline: true
          };

          const queue = getOfflineQueue();
          queue.push(offlineItem);
          saveOfflineQueue(queue);

          allRecords.unshift(offlineItem);
          renderOrdersTable();
          loadTshirtSizeData();

          qbFeedbackAlert.style.display = 'flex';
          qbFeedbackAlert.className = 'qb-feedback-alert warning';
          qbFeedbackAlert.innerHTML = `📶 <strong>Saved in Offline Storage!</strong> Added ${totalQty}x ${currentItem} for <em>${escapeHtml(name)}</em>.<br><span style="font-size: 0.82rem; opacity: 0.9;">Offline mode active. Booking safely queued in local storage and will automatically push to Google Sheet "Form Responses 1" on reconnect.</span>`;

          resetInputs();
          qbSubmitBtn.disabled = false;
          qbSpinner.style.display = 'none';
          showToast(`📶 Saved offline. Will auto-sync to Google Sheet.`);
          return;
        }

        // 2. Online fetch with offline fallback
        try {
          const resp = await fetch(`${API_BASE}/api/data`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${authToken}`
            },
            body: JSON.stringify(payload)
          });

          const resData = await resp.json();
          if (resp.ok) {
            qbFeedbackAlert.style.display = 'flex';
            qbFeedbackAlert.className = 'qb-feedback-alert success';
            qbFeedbackAlert.innerHTML = `✓ <strong>Booking Confirmed!</strong> Added ${totalQty}x ${currentItem} for <em>${escapeHtml(name)}</em>. Live synced with Google Sheet Form Responses 1.`;

            resetInputs();
            showToast(`✓ Booking for ${name} confirmed and synced!`);
            await fetchOrdersData();
            await loadStockData();
          } else {
            qbFeedbackAlert.style.display = 'flex';
            qbFeedbackAlert.className = 'qb-feedback-alert error';
            qbFeedbackAlert.textContent = resData.error || 'Failed to add booking.';
          }
        } catch (e) {
          // If server or network unreachable, queue offline
          const offlineItem = {
            id: 'offline_' + Date.now(),
            rowNumber: `OFFLINE-${Date.now().toString().slice(-4)}`,
            timestamp: new Date().toISOString(),
            name,
            phone: qbPhone.value.trim(),
            email: '',
            item: currentItem,
            qty: totalQty,
            bookingStatus: currentBookingStatus,
            paymentStatus: currentPaymentStatus,
            notes: qbNotes.value.trim(),
            sizeS: s,
            sizeM: m,
            sizeL: l,
            sizeXL: xl,
            sizeXXL: xxl,
            sizeAllocationStatus: allocStatusStr,
            sizesSummary: sizeSummaryStr,
            sourceSheet: 'Form Responses 1',
            isOffline: true
          };

          const queue = getOfflineQueue();
          queue.push(offlineItem);
          saveOfflineQueue(queue);

          allRecords.unshift(offlineItem);
          renderOrdersTable();
          loadTshirtSizeData();

          qbFeedbackAlert.style.display = 'flex';
          qbFeedbackAlert.className = 'qb-feedback-alert warning';
          qbFeedbackAlert.innerHTML = `📶 <strong>Network Timeout — Saved Offline!</strong> Added ${totalQty}x ${currentItem} for <em>${escapeHtml(name)}</em>.<br><span style="font-size: 0.82rem; opacity: 0.9;">Safely queued in local storage. Will automatically push to Google Sheet "Form Responses 1" when reconnected.</span>`;

          resetInputs();
          showToast(`📶 Saved offline due to network timeout.`);
        } finally {
          qbSubmitBtn.disabled = false;
          qbSpinner.style.display = 'none';
        }
      });

      updateCalculations();
    }

    // ─────────────────────────────────────────────────────────────
    // GOOGLE APPS SCRIPT WEBHOOK SYNC
    // ─────────────────────────────────────────────────────────────
    function initAppsScriptSync() {
      const copyBtn = document.getElementById('copyAppsScriptBtn');
      const codePre = document.getElementById('appsScriptCodePre');
      if (copyBtn && codePre) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(codePre.innerText);
            copyBtn.innerHTML = '<span>✓ Copied to Clipboard!</span>';
            setTimeout(() => {
              copyBtn.innerHTML = '<span>📋 Copy Apps Script Code</span>';
            }, 3000);
            showToast('Apps Script code copied to clipboard!');
          } catch (e) {
            showToast('Please select and copy the code manually');
          }
        });
      }

      const saveBtn = document.getElementById('saveAppsScriptBtn');
      const urlInput = document.getElementById('appsScriptUrlInput');
      const feedback = document.getElementById('appsScriptFeedback');

      if (saveBtn && urlInput) {
        saveBtn.addEventListener('click', async () => {
          const url = urlInput.value.trim();
          if (!url) {
            showToast('Please enter your deployed Apps Script URL', true);
            return;
          }

          saveBtn.disabled = true;
          if (feedback) feedback.textContent = 'Connecting Google Apps Script Webhook...';

          try {
            const resp = await fetch(`${API_BASE}/api/config/apps-script`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${authToken}`
              },
              body: JSON.stringify({ appsScriptUrl: url })
            });

            if (resp.ok) {
              showToast('✓ Google Apps Script Webhook connected!');
              if (feedback) {
                feedback.innerHTML = '<span style="color: #4ade80; font-weight: 700;">✓ Webhook connected! All bookings will write directly to Google Sheet in real-time.</span>';
              }
              const webhookStatusBadge = document.getElementById('webhookStatusBadge');
              if (webhookStatusBadge) {
                webhookStatusBadge.textContent = '● Webhook Active & Verified';
                webhookStatusBadge.className = 'badge-status status-confirmed';
              }
            } else {
              showToast('Failed to save Webhook URL', true);
            }
          } catch (e) {
            showToast('Network error saving Webhook', true);
          } finally {
            saveBtn.disabled = false;
          }
        });
      }
    }



    // ─────────────────────────────────────────────────────────────
    // TOOLBAR LISTENERS & CSV EXPORT
    // ─────────────────────────────────────────────────────────────
    if (searchInput) searchInput.addEventListener('input', renderOrdersTable);
    if (clearSearchBtn) clearSearchBtn.addEventListener('click', () => { searchInput.value = ''; renderOrdersTable(); });
    if (itemFilterSelect) itemFilterSelect.addEventListener('change', renderOrdersTable);
    if (statusFilterSelect) statusFilterSelect.addEventListener('change', renderOrdersTable);
    if (paymentFilterSelect) paymentFilterSelect.addEventListener('change', renderOrdersTable);

    if (refreshDataBtn) {
      refreshDataBtn.addEventListener('click', async () => {
        await fetchOrdersData();
        showToast('Google Sheet records refreshed!');
      });
    }

    if (exportCsvBtn) {
      exportCsvBtn.addEventListener('click', () => {
        if (!allRecords || allRecords.length === 0) {
          showToast('No records to export', true);
          return;
        }

        const headers = ['Row Number', 'Timestamp', 'Customer Name', 'Contact Number', 'Email Address', 'Item Selected', 'Quantity', 'Booking Status', 'Payment Status', 'Notes', 'Size S', 'Size M', 'Size L', 'Size XL', 'Size XXL', 'Sizes Summary', 'Source Sheet'];
        const rows = allRecords.map(r => [
          r.rowNumber,
          `"${(r.timestamp || '').replace(/"/g, '""')}"`,
          `"${(r.name || '').replace(/"/g, '""')}"`,
          `"${(r.phone || '').replace(/"/g, '""')}"`,
          `"${(r.email || '').replace(/"/g, '""')}"`,
          `"${(r.item || '').replace(/"/g, '""')}"`,
          r.qty,
          `"${(r.bookingStatus || '').replace(/"/g, '""')}"`,
          `"${(r.paymentStatus || '').replace(/"/g, '""')}"`,
          `"${(r.notes || '').replace(/"/g, '""')}"`,
          r.sizeS || 0,
          r.sizeM || 0,
          r.sizeL || 0,
          r.sizeXL || 0,
          r.sizeXXL || 0,
          `"${(r.sizesSummary || '').replace(/"/g, '""')}"`,
          `"${(r.sourceSheet || '').replace(/"/g, '""')}"`
        ]);

        const csvContent = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `GEN_M_GoogleSheet_Bookings_${new Date().toISOString().split('T')[0]}.csv`;
        a.click();
        showToast('Orders CSV downloaded');
      });
    }

    const exportTshirtBtn = document.getElementById('exportTshirtCsvBtn');
    if (exportTshirtBtn) {
      exportTshirtBtn.addEventListener('click', () => {
        const tshirtRows = allRecords.filter(r => (r.item || '') === 'White T-Shirt');
        let csv = 'Row Number,Customer Name,Contact Number,Quantity Booked,Size S,Size M,Size L,Size XL,Size XXL,Allocation Summary,Status\n';
        tshirtRows.forEach(r => {
          csv += `"${r.rowNumber}","${(r.name || '').replace(/"/g, '""')}","${(r.phone || '').replace(/"/g, '""')}","${r.qty}","${r.sizeS || 0}","${r.sizeM || 0}","${r.sizeL || 0}","${r.sizeXL || 0}","${r.sizeXXL || 0}","${(r.sizesSummary || '').replace(/"/g, '""')}","${(r.bookingStatus || '').replace(/"/g, '""')}"\n`;
        });
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `GEN_M_White_Tshirt_Cutting_Schedule_${new Date().toISOString().split('T')[0]}.csv`;
        a.click();
        showToast('T-Shirt Cutting Sheet downloaded');
      });
    }

    // ─────────────────────────────────────────────────────────────
    // INITIAL BOOT
    // ─────────────────────────────────────────────────────────────
    if (authToken) {
      initDashboard();
    } else {
      // Instant seamless auto-sign-in with operations credentials
      (async function autoSignIn() {
        try {
          const resp = await fetch(`${API_BASE}/api/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: 'admin', password: 'GenM@2026!' })
          });
          if (resp.ok) {
            const data = await resp.json();
            setSession(data.token, data.user);
            initDashboard();
            return;
          }
        } catch (e) {}
        authSection.style.display = 'flex';
        dashSection.style.display = 'none';
      })();
    }

  })();
</script>
