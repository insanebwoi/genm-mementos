    overflow: hidden;
  }

  .code-box-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 0, 0, 0.5);
    padding: 8px 12px;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .btn-copy {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 0.72rem;
    padding: 4px 10px;
    border-radius: 6px;
    cursor: pointer;
  }

  .code-pre {
    background: #04060a;
    color: #e2e8f0;
    padding: 14px;
    margin: 0;
    font-size: 0.76rem;
    overflow-x: auto;
    line-height: 1.5;
  }

  .url-input-card {
    background: rgba(231, 238, 172, 0.04);
    border: 1px solid rgba(231, 238, 172, 0.2);
    border-radius: 10px;
    padding: 16px;
  }

  .url-input-row {
    display: flex;
    gap: 10px;
    margin-top: 6px;
  }

  .sync-feedback {
    font-size: 0.8rem;
    margin-top: 8px;
    color: var(--accent-emerald);
  }

  /* Toast */
  .toast {
    position: fixed;
    bottom: 24px;
    right: 28px;
    background: #0f172a;
    border: 1px solid var(--accent-cream);
    color: #ffffff;
    font-size: 0.84rem;
    padding: 10px 18px;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    z-index: 9999;
  }
</style>

<script is:inline>
  /**
   * GEN M Swag Operations — Simple, Minimal, Clean Controller
   * Sheet ID: 1foGWm9i_5DhBUjocJDxs84jWCLdc-U1BJaN7r0KuhiA
   */
  (function () {
    const API_BASE = 'http://localhost:5050';
    const TOKEN_KEY = 'genm_dashboard_jwt_token';
    const USER_KEY = 'genm_dashboard_user';

    let authToken = localStorage.getItem(TOKEN_KEY) || sessionStorage.getItem(TOKEN_KEY) || null;
    let currentUser = JSON.parse(localStorage.getItem(USER_KEY) || sessionStorage.getItem(USER_KEY) || 'null');
    let allRecords = [];
    let sseConnection = null;
    let pollInterval = null;

    // Elements
    const authSection = document.getElementById('authSection');
    const dashSection = document.getElementById('dashSection');
    const toast = document.getElementById('toastNotification');

    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 3500);
    }

    function escapeHtml(str) {
      return String(str || '').replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
      }[m]));
    }

    // ─────────────────────────────────────────────────────────────
    // AUTHENTICATION
    // ─────────────────────────────────────────────────────────────
    function setSession(token, user) {
      authToken = token;
      currentUser = user;
      localStorage.setItem(TOKEN_KEY, token);
      localStorage.setItem(USER_KEY, JSON.stringify(user));
    }

    function clearSession() {
      authToken = null;
      currentUser = null;
      localStorage.removeItem(TOKEN_KEY);
      localStorage.removeItem(USER_KEY);
      if (authSection) authSection.style.display = 'flex';
      if (dashSection) dashSection.style.display = 'none';
    }

    const logoutBtn = document.getElementById('logoutBtn');
    if (logoutBtn) logoutBtn.addEventListener('click', clearSession);

    // ─────────────────────────────────────────────────────────────
    // REAL-TIME SERVER-SENT EVENTS (SSE)
    // ─────────────────────────────────────────────────────────────
    function initRealtime() {
      if (typeof EventSource === 'undefined') return;

      try {
        if (sseConnection) sseConnection.close();
        sseConnection = new EventSource(`${API_BASE}/api/realtime/stream`);

        sseConnection.addEventListener('sheet_update', (e) => {
          try {
            const payload = JSON.parse(e.data);
            showToast(`⚡ Real-Time edit from Google Sheet: Row #${payload.rowNumber || 'Live'}`);
            fetchOrders(true);
          } catch (err) {}
        });

        sseConnection.addEventListener('data_changed', () => {
          fetchOrders(true);
        });

        sseConnection.onerror = () => {
          if (!pollInterval) {
            pollInterval = setInterval(() => { if (authToken) fetchOrders(true); }, 5000);
          }
        };

        sseConnection.addEventListener('connected', () => {
          if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
          const statusDot = document.getElementById('statusDot');
          if (statusDot) statusDot.className = 'status-dot dot-live';
        });
      } catch (e) {}
    }

    // ─────────────────────────────────────────────────────────────
    // DATA FETCHING & RENDERING
    // ─────────────────────────────────────────────────────────────
    async function fetchOrders(isSilent = false) {
      const tableRowCount = document.getElementById('tableRowCount');
      if (!isSilent && tableRowCount) tableRowCount.textContent = 'Updating...';

      try {
        const resp = await fetch(`${API_BASE}/api/data`, {
          headers: { 'Authorization': `Bearer ${authToken}` }
        });

        if (resp.status === 401 || resp.status === 403) {
          clearSession();
          return;
        }

        const data = await resp.json();
        if (data.success && Array.isArray(data.records)) {
          allRecords = data.records;
          renderOrdersTable();
          updateMetrics();
        }
      } catch (e) {
        console.warn('Orders fetch error:', e);
      }
    }

    function updateMetrics() {
      const totalBookingsVal = document.getElementById('totalBookingsVal');
      const totalBookingsSub = document.getElementById('totalBookingsSub');
      const tshirtUnitsVal = document.getElementById('tshirtUnitsVal');
      const tshirtSizesBreakdown = document.getElementById('tshirtSizesBreakdown');
      const stockUnitsVal = document.getElementById('stockUnitsVal');
      const stockStatusSub = document.getElementById('stockStatusSub');
      const ordersTabCount = document.getElementById('ordersTabCount');

      const count = allRecords.length;
      if (totalBookingsVal) totalBookingsVal.textContent = count;
      if (ordersTabCount) ordersTabCount.textContent = count;
      if (totalBookingsSub) totalBookingsSub.textContent = `Live from Form Responses 1`;

      let tshirtUnits = 0;
      let s = 0, m = 0, l = 0, xl = 0, xxl = 0;
      let totalBookedAcrossAll = 0;

      allRecords.forEach(r => {
        const q = parseInt(r.qty, 10) || 1;
        totalBookedAcrossAll += q;
        if (r.item === 'White T-Shirt') {
          tshirtUnits += q;
          s += (parseInt(r.sizeS, 10) || 0);
          m += (parseInt(r.sizeM, 10) || 0);
          l += (parseInt(r.sizeL, 10) || 0);
          xl += (parseInt(r.sizeXL, 10) || 0);
          xxl += (parseInt(r.sizeXXL, 10) || 0);
        }
      });

      if (tshirtUnitsVal) tshirtUnitsVal.innerHTML = `${tshirtUnits} <span class="metric-unit">Units</span>`;
      if (tshirtSizesBreakdown) tshirtSizesBreakdown.textContent = `S: ${s} • M: ${m} • L: ${l} • XL: ${xl} • XXL: ${xxl}`;

      const totalStock = 1850;
      const available = Math.max(0, totalStock - totalBookedAcrossAll);
      if (stockUnitsVal) stockUnitsVal.innerHTML = `${available.toLocaleString()} <span class="metric-unit">/ ${totalStock.toLocaleString()}</span>`;
      if (stockStatusSub) {
        const pct = Math.round((available / totalStock) * 100);
        stockStatusSub.textContent = `${pct}% stock available across 13 catalogue products`;
      }
    }

    function renderOrdersTable() {
      const tbody = document.getElementById('ordersTableBody');
      const countEl = document.getElementById('tableRowCount');
      const searchVal = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
      const itemVal = document.getElementById('itemFilter')?.value || '';

      if (!tbody) return;

      let filtered = allRecords.filter(r => {
        if (itemVal && r.item !== itemVal) return false;
        if (searchVal) {
          const hay = `${r.name} ${r.phone} ${r.item} ${r.notes} ${r.sizesSummary}`.toLowerCase();
          return hay.includes(searchVal);
        }
        return true;
      });

      if (countEl) countEl.textContent = `${filtered.length} Orders`;

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="table-empty">No orders found in Form Responses 1.</td></tr>`;
        return;
      }

      tbody.innerHTML = filtered.map((r, idx) => {
        const isOpt = r.isOptimistic;
        const rowNumStr = isOpt ? '⚡' : (r.rowNumber || idx + 1);
        const sizeHtml = r.item === 'White T-Shirt' && r.sizesSummary
          ? `<div style="font-size: 0.74rem; color: #E7EEAC; margin-top: 2px;">${escapeHtml(r.sizesSummary)}</div>`
          : `<div style="font-size: 0.74rem; color: #94a3b8; margin-top: 2px;">Qty: ${escapeHtml(r.qty || '1')}</div>`;

        const paymentPill = r.paymentStatus === 'Paid'
          ? `<span class="table-pill pill-paid">Paid</span>`
          : `<span class="table-pill pill-pending">Pending</span>`;

        const statusPill = isOpt
          ? `<span class="table-pill pill-optimistic">⚡ Syncing</span>`
          : `<span class="table-pill" style="background: rgba(255,255,255,0.06); color: #cbd5e1;">${escapeHtml(r.bookingStatus || 'Confirmed')}</span>`;

        return `
          <tr>
            <td style="font-weight: 700; color: #94a3b8;">${rowNumStr}</td>
            <td>
              <div style="font-weight: 700; color: #ffffff;">${escapeHtml(r.name || 'Anonymous')}</div>
              ${r.notes ? `<div style="font-size: 0.72rem; color: #64748b;">${escapeHtml(r.notes)}</div>` : ''}
            </td>
            <td style="color: #cbd5e1;">${escapeHtml(r.phone || '—')}</td>
            <td>
              <div style="font-weight: 600; color: #ffffff;">${escapeHtml(r.item || 'White T-Shirt')}</div>
              ${sizeHtml}
            </td>
            <td>${paymentPill}</td>
            <td>${statusPill}</td>
            <td style="text-align: right;">
              <button type="button" class="row-btn-action btn-edit-row" data-row="${r.rowNumber}">Edit</button>
              <button type="button" class="row-btn-action row-btn-delete btn-del-row" data-row="${r.rowNumber}">✕</button>
            </td>
          </tr>
        `;
      }).join('');

      // Attach row action listeners
      tbody.querySelectorAll('.btn-edit-row').forEach(btn => {
        btn.addEventListener('click', () => openEditModal(btn.dataset.row));
      });

      tbody.querySelectorAll('.btn-del-row').forEach(btn => {
        btn.addEventListener('click', () => deleteOrder(btn.dataset.row));
      });
    }

    // ─────────────────────────────────────────────────────────────
    // ADD NEW ORDER (REAL-TIME WRITE TO FORM RESPONSES 1)
    // ─────────────────────────────────────────────────────────────
    function initOrderForm() {
      const form = document.getElementById('expressOrderForm');
      const orderItem = document.getElementById('orderItem');
      const sizeMatrixPanel = document.getElementById('sizeMatrixPanel');
      const generalQtyWrap = document.getElementById('generalQtyWrap');
      const sizeTotalBadge = document.getElementById('sizeTotalBadge');
      const submitBtn = document.getElementById('submitOrderBtn');
      const submitText = document.getElementById('submitOrderBtnText');
      const spinner = document.getElementById('orderSpinner');
      const feedback = document.getElementById('orderFeedback');

      const sizeInputs = ['sizeS', 'sizeM', 'sizeL', 'sizeXL', 'sizeXXL'].map(id => document.getElementById(id));
      const generalQtyInput = document.getElementById('orderGeneralQty');

      function updateSizeTotal() {
        const s = parseInt(document.getElementById('sizeS')?.value || '0', 10);
        const m = parseInt(document.getElementById('sizeM')?.value || '0', 10);
        const l = parseInt(document.getElementById('sizeL')?.value || '0', 10);
        const xl = parseInt(document.getElementById('sizeXL')?.value || '0', 10);
        const xxl = parseInt(document.getElementById('sizeXXL')?.value || '0', 10);
        const sum = s + m + l + xl + xxl;
        if (sizeTotalBadge) sizeTotalBadge.textContent = `Total: ${sum} Unit${sum === 1 ? '' : 's'}`;
        return sum;
      }

      // Step +/- buttons
      document.querySelectorAll('.btn-step').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.dataset.target;
          const step = parseInt(btn.dataset.step || '1', 10);
          if (targetId) {
            const input = document.getElementById(targetId);
            if (input) {
              input.value = Math.max(0, (parseInt(input.value || '0', 10) + step));
              updateSizeTotal();
            }
          }
        });
      });

      document.getElementById('btnQtyMinus')?.addEventListener('click', () => {
        if (generalQtyInput) generalQtyInput.value = Math.max(1, (parseInt(generalQtyInput.value || '1', 10) - 1));
      });

      document.getElementById('btnQtyPlus')?.addEventListener('click', () => {
        if (generalQtyInput) generalQtyInput.value = parseInt(generalQtyInput.value || '1', 10) + 1;
      });

      sizeInputs.forEach(inp => {
        if (inp) inp.addEventListener('input', updateSizeTotal);
      });

      if (orderItem) {
        orderItem.addEventListener('change', () => {
          const isTshirt = orderItem.value === 'White T-Shirt';
          if (sizeMatrixPanel) sizeMatrixPanel.style.display = isTshirt ? 'flex' : 'none';
          if (generalQtyWrap) generalQtyWrap.style.display = isTshirt ? 'none' : 'flex';
        });
      }

      if (form) {
        form.addEventListener('submit', async () => {
          const name = document.getElementById('orderName')?.value.trim();
          const phone = document.getElementById('orderPhone')?.value.trim();
          const item = orderItem?.value || 'White T-Shirt';
          const payment = document.getElementById('orderPaymentStatus')?.value || 'Pending';
          const notes = document.getElementById('orderNotes')?.value.trim() || '';

          if (!name || !phone) {
            showToast('Please enter customer name and phone');
            return;
          }

          let s = 0, m = 0, l = 0, xl = 0, xxl = 0;
          let totalQty = 1;

          if (item === 'White T-Shirt') {
            s = parseInt(document.getElementById('sizeS')?.value || '0', 10);
            m = parseInt(document.getElementById('sizeM')?.value || '0', 10);
            l = parseInt(document.getElementById('sizeL')?.value || '0', 10);
            xl = parseInt(document.getElementById('sizeXL')?.value || '0', 10);
            xxl = parseInt(document.getElementById('sizeXXL')?.value || '0', 10);
            totalQty = s + m + l + xl + xxl;
            if (totalQty === 0) {
              showToast('Please select at least 1 size');
              return;
            }
          } else {
            totalQty = parseInt(generalQtyInput?.value || '1', 10) || 1;
          }

          // Build size summary
          const sizeParts = [];
          if (s > 0) sizeParts.push(`${s}x S`);
          if (m > 0) sizeParts.push(`${m}x M`);
          if (l > 0) sizeParts.push(`${l}x L`);
          if (xl > 0) sizeParts.push(`${xl}x XL`);
          if (xxl > 0) sizeParts.push(`${xxl}x XXL`);
          const sizeSummary = sizeParts.join(', ') || (item === 'White T-Shirt' ? 'Standard' : '');

          // 1. OPTIMISTIC UI: Prepend to table instantly (0ms operator latency)
          const optId = 'opt_' + Date.now();
          const optimisticOrder = {
            id: optId,
            rowNumber: '⚡',
            timestamp: new Date().toISOString(),
            name,
            phone,
            item,
            qty: totalQty,
            bookingStatus: 'Confirmed',
            paymentStatus: payment,
            notes,
            sizeS: s,
            sizeM: m,
            sizeL: l,
            sizeXL: xl,
            sizeXXL: xxl,
            sizesSummary: sizeSummary,
            isOptimistic: true
          };

          allRecords.unshift(optimisticOrder);
          renderOrdersTable();
          updateMetrics();

          // Button visual state
          submitBtn.disabled = true;
          spinner.style.display = 'inline-block';
          submitText.textContent = 'Syncing to Google Sheet...';
          if (feedback) feedback.style.display = 'none';

          const payload = {
            name,
            phone,
            item,
            qty: totalQty,
            bookingStatus: 'Confirmed',
            paymentStatus: payment,
            notes,
            sizeS: s,
            sizeM: m,
            sizeL: l,
            sizeXL: xl,
            sizeXXL: xxl
          };

          try {
            // Write via Backend
            const resp = await fetch(`${API_BASE}/api/data`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${authToken}`
              },
              body: JSON.stringify(payload)
            });

            if (resp.ok) {
              allRecords = allRecords.filter(r => r.id !== optId);
              showToast(`✓ Order for ${name} added directly to Form Responses 1!`);
              if (feedback) {
                feedback.className = 'order-feedback success';
                feedback.style.display = 'block';
                feedback.innerHTML = `✓ <strong>Order Confirmed &amp; Pushed!</strong> Added ${totalQty}x ${item} for <em>${escapeHtml(name)}</em> to Form Responses 1.`;
              }
              // Reset form inputs
              document.getElementById('orderName').value = '';
              document.getElementById('orderPhone').value = '';
              document.getElementById('orderNotes').value = '';
              document.getElementById('sizeS').value = '0';
              document.getElementById('sizeM').value = '1';
              document.getElementById('sizeL').value = '0';
              document.getElementById('sizeXL').value = '0';
              document.getElementById('sizeXXL').value = '0';
              updateSizeTotal();
              document.getElementById('orderName').focus();

              await fetchOrders(true);
            } else {
              allRecords = allRecords.filter(r => r.id !== optId);
              renderOrdersTable();
              updateMetrics();
              if (feedback) {
                feedback.className = 'order-feedback error';
                feedback.style.display = 'block';
                feedback.textContent = 'Failed to write to Google Sheet.';
              }
            }
          } catch (err) {
            allRecords = allRecords.filter(r => r.id !== optId);
            renderOrdersTable();
            updateMetrics();
            if (feedback) {
              feedback.className = 'order-feedback error';
              feedback.style.display = 'block';
              feedback.textContent = 'Network error saving order.';
            }
          } finally {
            submitBtn.disabled = false;
            spinner.style.display = 'none';
            submitText.textContent = '⚡ Add Order to Form Responses 1';
          }
        });
      }
    }

    // ─────────────────────────────────────────────────────────────
    // EDIT & DELETE
    // ─────────────────────────────────────────────────────────────
    function openEditModal(rowNum) {
      const record = allRecords.find(r => String(r.rowNumber) === String(rowNum));
      if (!record) return;

      const modal = document.getElementById('editModal');
      document.getElementById('editRowNumber').value = record.rowNumber;
      document.getElementById('editRowBadge').textContent = `#${record.rowNumber}`;
      document.getElementById('editName').value = record.name || '';
      document.getElementById('editPhone').value = record.phone || '';
      document.getElementById('editItem').value = record.item || 'White T-Shirt';
      document.getElementById('editPayment').value = record.paymentStatus || 'Pending';
      document.getElementById('editNotes').value = record.notes || '';
      document.getElementById('editSizeS').value = record.sizeS || 0;
      document.getElementById('editSizeM').value = record.sizeM || 0;
      document.getElementById('editSizeL').value = record.sizeL || 0;
      document.getElementById('editSizeXL').value = record.sizeXL || 0;
      document.getElementById('editSizeXXL').value = record.sizeXXL || 0;

      modal.style.display = 'flex';
    }

    document.getElementById('closeEditModalBtn')?.addEventListener('click', () => {
      document.getElementById('editModal').style.display = 'none';
    });
    document.getElementById('cancelEditBtn')?.addEventListener('click', () => {
      document.getElementById('editModal').style.display = 'none';
    });

    document.getElementById('editForm')?.addEventListener('submit', async () => {
      const rowNumber = document.getElementById('editRowNumber').value;
      const name = document.getElementById('editName').value.trim();
      const phone = document.getElementById('editPhone').value.trim();
      const item = document.getElementById('editItem').value;
      const paymentStatus = document.getElementById('editPayment').value;
      const notes = document.getElementById('editNotes').value.trim();
      const s = parseInt(document.getElementById('editSizeS').value || '0', 10);
      const m = parseInt(document.getElementById('editSizeM').value || '0', 10);
      const l = parseInt(document.getElementById('editSizeL').value || '0', 10);
      const xl = parseInt(document.getElementById('editSizeXL').value || '0', 10);
      const xxl = parseInt(document.getElementById('editSizeXXL').value || '0', 10);
      const qty = item === 'White T-Shirt' ? (s + m + l + xl + xxl) : 1;

      try {
        const resp = await fetch(`${API_BASE}/api/data/${rowNumber}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`
          },
          body: JSON.stringify({ name, phone, item, qty, paymentStatus, notes, sizeS: s, sizeM: m, sizeL: l, sizeXL: xl, sizeXXL: xxl })
        });
        if (resp.ok) {
          showToast(`✓ Booking #${rowNumber} updated in Google Sheet!`);
          document.getElementById('editModal').style.display = 'none';
          await fetchOrders(true);
        } else {
          showToast('Failed to update booking');
        }
      } catch (e) {
        showToast('Error updating booking');
      }
    });

    async function deleteOrder(rowNum) {
      if (!confirm(`Delete row #${rowNum} from Google Sheet Form Responses 1?`)) return;

      try {
        const resp = await fetch(`${API_BASE}/api/data/${rowNum}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${authToken}` }
        });
        if (resp.ok) {
          showToast(`✓ Row #${rowNum} removed from Form Responses 1`);
          await fetchOrders(true);
        } else {
          showToast('Failed to delete row');
        }
      } catch (e) {
        showToast('Error deleting row');
      }
    }

    // ─────────────────────────────────────────────────────────────
    // VIEW SWITCHER (Orders / Stock / Financials)
    // ─────────────────────────────────────────────────────────────
    document.querySelectorAll('.view-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const view = btn.dataset.view;
        document.getElementById('viewOrders').style.display = view === 'orders' ? 'block' : 'none';
        document.getElementById('viewStock').style.display = view === 'stock' ? 'block' : 'none';
        document.getElementById('viewFinancials').style.display = view === 'financials' ? 'block' : 'none';

        if (view === 'stock') loadStock();
        if (view === 'financials') loadFinancials();
      });
    });

    async function loadStock() {
      const tbody = document.getElementById('stockTableBody');
      try {
        const resp = await fetch(`${API_BASE}/api/inventory`, { headers: { 'Authorization': `Bearer ${authToken}` } });
        const data = await resp.json();
        if (data.items) {
          tbody.innerHTML = data.items.map(it => `
            <tr>
              <td style="font-weight: 700; color: #ffffff;">${escapeHtml(it.item)}</td>
              <td style="color: #94a3b8;">${escapeHtml(it.category)}</td>
              <td>${it.totalStock}</td>
              <td style="color: #E7EEAC; font-weight: 700;">${it.bookedUnits}</td>
              <td style="color: #4ade80; font-weight: 800;">${it.availableStock}</td>
              <td><span class="table-pill pill-paid">${escapeHtml(it.status)}</span></td>
            </tr>
          `).join('');
        }
      } catch (e) {}
    }

    async function loadFinancials() {
      const tbody = document.getElementById('financialsTableBody');
      try {
        const resp = await fetch(`${API_BASE}/api/financials`, { headers: { 'Authorization': `Bearer ${authToken}` } });
        const data = await resp.json();
        if (data.items) {
          tbody.innerHTML = data.items.map(it => `
            <tr>
              <td style="font-weight: 700; color: #ffffff;">${escapeHtml(it.item)}</td>
              <td>₹${it.unitCost}</td>
              <td style="color: #E7EEAC; font-weight: 700;">₹${it.sellingPrice}</td>
              <td>${it.qty}</td>
              <td style="color: #4ade80; font-weight: 700;">₹${it.expectedRevenue?.toLocaleString()}</td>
              <td>₹${it.unitProfit}</td>
              <td style="color: #38bdf8;">${escapeHtml(it.margin)}</td>
            </tr>
          `).join('');
        }
      } catch (e) {}
    }

    // ─────────────────────────────────────────────────────────────
    // SYNC SETUP MODAL & APPS SCRIPT WEBHOOK CONFIG
    // ─────────────────────────────────────────────────────────────
    const setupModal = document.getElementById('syncSetupModal');
    const openSyncBtn = document.getElementById('openSyncSetupBtn');
    const closeSyncBtn = document.getElementById('closeSyncSetupModalBtn');
    const bannerOpenBtn = document.getElementById('bannerOpenSetupModalBtn');

    function openSyncModal() { if (setupModal) setupModal.style.display = 'flex'; }
    function closeSyncModal() { if (setupModal) setupModal.style.display = 'none'; }

    if (openSyncBtn) openSyncBtn.addEventListener('click', openSyncModal);
    if (closeSyncBtn) closeSyncBtn.addEventListener('click', closeSyncModal);
    if (bannerOpenBtn) bannerOpenBtn.addEventListener('click', openSyncModal);

    // Copy Apps Script Code
    document.getElementById('copyScriptCodeBtn')?.addEventListener('click', async () => {
      const pre = document.getElementById('scriptCodePre');
      if (pre) {
        await navigator.clipboard.writeText(pre.innerText);
        showToast('15-line Apps Script copied to clipboard!');
      }
    });

    // Save Apps Script URL handler
    async function saveAppsScriptUrl(url) {
      if (!url) {
        showToast('Please enter your deployed Apps Script URL');
        return false;
      }
      try {
        const resp = await fetch(`${API_BASE}/api/config/apps-script`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`
          },
          body: JSON.stringify({ appsScriptUrl: url })
        });
        if (resp.ok) {
          const resData = await resp.json();
          showToast(`✓ Google Apps Script connected! ${resData.flushedCount ? resData.flushedCount + ' pending orders pushed to Google Sheet!' : ''}`);
          checkConfig();
          return true;
        }
      } catch (e) {}
      return false;
    }

    document.getElementById('saveModalAppsScriptBtn')?.addEventListener('click', async () => {
      const input = document.getElementById('modalAppsScriptUrl');
      const feedback = document.getElementById('modalSyncFeedback');
      if (input) {
        const ok = await saveAppsScriptUrl(input.value.trim());
        if (ok) {
          if (feedback) {
            feedback.style.display = 'block';
            feedback.textContent = '✓ Connected! Real-time writeback to Form Responses 1 is now active.';
          }
          setTimeout(closeSyncModal, 1500);
        }
      }
    });

    document.getElementById('quickSaveScriptBtn')?.addEventListener('click', async () => {
      const input = document.getElementById('quickScriptUrlInput');
      if (input) {
        await saveAppsScriptUrl(input.value.trim());
      }
    });

    async function checkConfig() {
      try {
        const resp = await fetch(`${API_BASE}/api/config-status`);
        if (resp.ok) {
          const cfg = await resp.json();
          const hasUrl = Boolean(cfg.appsScriptUrl);
          const banner = document.getElementById('webhookBanner');
          const syncDot = document.getElementById('syncSetupDot');
          const syncLabel = document.getElementById('syncSetupLabel');
          const modalInput = document.getElementById('modalAppsScriptUrl');

          if (modalInput && cfg.appsScriptUrl) modalInput.value = cfg.appsScriptUrl;

          if (hasUrl) {
            if (banner) banner.style.display = 'none';
            if (syncDot) syncDot.style.background = '#4ade80';
            if (syncLabel) syncLabel.textContent = '✓ Real-Time Write Active';
          } else {
            if (banner) banner.style.display = 'flex';
            if (syncDot) syncDot.style.background = '#f59e0b';
            if (syncLabel) syncLabel.textContent = '⚡ Connect Real-Time Write';
          }
        }
      } catch (e) {}
    }

    // Export CSV
    document.getElementById('exportCsvBtn')?.addEventListener('click', () => {
      if (!allRecords.length) { showToast('No records to export'); return; }
      const headers = ['#', 'Timestamp', 'Customer Name', 'Phone', 'Item', 'Quantity', 'Sizes Summary', 'Payment Status', 'Booking Status', 'Notes'];
      const rows = allRecords.map((r, i) => [
        r.rowNumber || i + 1,
        `"${(r.timestamp || '').replace(/"/g, '""')}"`,
        `"${(r.name || '').replace(/"/g, '""')}"`,
        `"${(r.phone || '').replace(/"/g, '""')}"`,
        `"${(r.item || '').replace(/"/g, '""')}"`,
        r.qty || 1,
        `"${(r.sizesSummary || '').replace(/"/g, '""')}"`,
        `"${(r.paymentStatus || '').replace(/"/g, '""')}"`,
        `"${(r.bookingStatus || '').replace(/"/g, '""')}"`,
        `"${(r.notes || '').replace(/"/g, '""')}"`
      ]);
      const csv = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `GEN_M_Form_Responses_1_${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
    });

    // Toolbar Listeners
    document.getElementById('searchInput')?.addEventListener('input', renderOrdersTable);
    document.getElementById('itemFilter')?.addEventListener('change', renderOrdersTable);
    document.getElementById('refreshBtn')?.addEventListener('click', () => {
      fetchOrders();
      showToast('Refreshed from Google Sheet');
    });

    // ─────────────────────────────────────────────────────────────
    // INIT
    // ─────────────────────────────────────────────────────────────
    async function init() {
      // Seamless auto-sign-in
      if (!authToken) {
        try {
          const resp = await fetch(`${API_BASE}/api/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: 'admin', password: 'GenM@2026!' })
          });
          if (resp.ok) {
            const data = await resp.json();
            setSession(data.token, data.user);
          }
        } catch (e) {}
      }

      if (authSection) authSection.style.display = 'none';
      if (dashSection) dashSection.style.display = 'flex';

      initOrderForm();
      initRealtime();
      await checkConfig();
      await fetchOrders();
    }

    init();
  })();
</script>
