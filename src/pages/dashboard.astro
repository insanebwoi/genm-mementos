    function initOfflineSyncEvents() {
      updateOfflineUI();

      const topbarOfflineBtn = document.getElementById('topbarOfflineBtn');
      if (topbarOfflineBtn) {
        topbarOfflineBtn.addEventListener('click', () => flushOfflineBookings());
      }

      const qbOfflinePushBtn = document.getElementById('qbOfflinePushBtn');
      if (qbOfflinePushBtn) {
        qbOfflinePushBtn.addEventListener('click', () => flushOfflineBookings());
      }

      window.addEventListener('online', () => {
        updateOfflineUI();
        showToast('📶 Internet reconnected! Syncing offline queue to Google Sheet Form Responses 1...');
        flushOfflineBookings();
      });

      window.addEventListener('offline', () => {
        updateOfflineUI();
        showToast('📶 Network connection lost. Offline mode active.', true);
      });

      // Background heartbeat every 12 seconds to auto-push when online
      setInterval(() => {
        if (navigator.onLine && getOfflineQueue().length > 0) {
          flushOfflineBookings();
        }
      }, 12000);
    }

    async function checkDiagnostics() {
      try {
        const resp = await fetch(`${API_BASE}/api/config-status`, { signal: AbortSignal.timeout(3000) });
        if (resp.ok) {
          const cfg = await resp.json();
          statusLabel.textContent = cfg.googleApiKeyActive ? 'Google Sheets (Live API Key)' : 'Google Sheet Connected';
          const diagCred = document.getElementById('diagCredFile');
          if (diagCred) {
            diagCred.textContent = cfg.hasServiceAccount ? 'credentials.json detected' : (cfg.appsScriptUrl ? 'Apps Script Webhook Active' : 'API Key Read (Webhook Ready)');
          }
          const webhookStatusBadge = document.getElementById('webhookStatusBadge');
          if (webhookStatusBadge) {
            if (cfg.appsScriptUrl) {
              webhookStatusBadge.textContent = '● Webhook Connected & Active';
              webhookStatusBadge.className = 'badge-status status-confirmed';
            } else {
              webhookStatusBadge.textContent = '● Ready for Webhook URL';
              webhookStatusBadge.className = 'badge-status status-delivered';
            }
          }
          const appsScriptUrlInput = document.getElementById('appsScriptUrlInput');
          if (appsScriptUrlInput && cfg.appsScriptUrl) {
            appsScriptUrlInput.value = cfg.appsScriptUrl;
          }
        }
      } catch (e) {
        statusLabel.textContent = 'Sheet 1foGWm9i... (Live)';
      }
    }

    async function fetchOrdersData() {
      tableRecordCount.textContent = 'Fetching from Sheet...';

      try {
        const resp = await fetch(`${API_BASE}/api/data`, {
          headers: { 'Authorization': `Bearer ${authToken}` }
        });

        if (resp.status === 401 || resp.status === 403) {
          clearSession();
          showAuthError('Session expired. Please log in again.');
          return;
        }

        const data = await resp.json();
        const queue = getOfflineQueue();

        if (data.success && Array.isArray(data.records)) {
          allRecords = queue.length > 0 ? [...queue, ...data.records] : data.records;
          renderOrdersTable();
          loadTshirtSizeData();
          loadFinancialData();
        } else if (data.success && Array.isArray(data.values)) {
          const mapped = data.values.slice(1).map((row, idx) => ({
            rowNumber: idx + 2,
            timestamp: row[0] || '',
            name: cleanCell(row[1] || ''),
            phone: cleanCell(row[2] || ''),
            email: cleanCell(row[3] || ''),
            item: cleanCell(row[4] || ''),
            qty: cleanCell(row[5] || '1'),
            bookingStatus: cleanCell(row[6] || 'Pending'),
            paymentStatus: cleanCell(row[7] || 'Pending'),
            notes: cleanCell(row[8] || ''),
            sizeS: parseInt(row[9], 10) || 0,
            sizeM: parseInt(row[10], 10) || 0,
            sizeL: parseInt(row[11], 10) || 0,
            sizeXL: parseInt(row[12], 10) || 0,
            sizeXXL: parseInt(row[13], 10) || 0,
            sizeAllocationStatus: cleanCell(row[14] || ''),
            sizesSummary: cleanCell(row[15] || 'Standard'),
            sourceSheet: 'Form Responses 1'
          }));
          allRecords = queue.length > 0 ? [...queue, ...mapped] : mapped;
          renderOrdersTable();
          loadTshirtSizeData();
          loadFinancialData();
        }
      } catch (err) {
        console.warn('Fetch error:', err);
        const queue = getOfflineQueue();
        if (queue.length > 0 && allRecords.length === 0) {
          allRecords = [...queue];
          renderOrdersTable();
          loadTshirtSizeData();
        }
      }
    }

