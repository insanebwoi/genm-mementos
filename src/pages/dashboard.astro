<script is:inline>
  /**
   * Client-side Controller for GEN M Swag Dashboard
   * 
   * Handles:
   * 1. Authentication (login / logout / token session)
   * 2. CRUD Operations (GET, POST, PUT, DELETE)
   * 3. Connection Detection: Auto-switches between Live Node Server (http://localhost:5050)
   *    and Standalone In-Browser Mock Store with Web Crypto password validation.
   * 4. Search, Filtering, and CSV Export.
   */

  (function () {
    const API_BASE = 'http://localhost:5050';
    const TOKEN_KEY = 'genm_dashboard_jwt_token';
    const USER_KEY = 'genm_dashboard_user';
    const LOCAL_STORE_KEY = 'genm_standalone_orders_v1';

    // State
    let authToken = localStorage.getItem(TOKEN_KEY) || sessionStorage.getItem(TOKEN_KEY) || null;
    let currentUser = JSON.parse(localStorage.getItem(USER_KEY) || sessionStorage.getItem(USER_KEY) || 'null');
    let allRecords = [];
    let serverMode = 'checking'; // 'google_sheets' | 'local_cache' | 'offline_mock'
    let currentDeleteRow = null;

    // Elements
    const authSection = document.getElementById('authSection');
    const dashSection = document.getElementById('dashSection');
    const authError = document.getElementById('authError');
    const authErrorMsg = document.getElementById('authErrorMsg');
    const loginForm = document.getElementById('loginForm');
    const usernameInput = document.getElementById('usernameInput');
    const passwordInput = document.getElementById('passwordInput');
    const rememberMe = document.getElementById('rememberMe');
    const loginSubmitBtn = document.getElementById('loginSubmitBtn');
    const loginSpinner = document.getElementById('loginSpinner');
    const togglePwBtn = document.getElementById('togglePwBtn');
    const demoFillBtn = document.getElementById('demoFillBtn');

    // Dashboard Elements
    const syncStatusBadge = document.getElementById('syncStatusBadge');
    const statusDot = document.getElementById('statusDot');
    const statusLabel = document.getElementById('statusLabel');
    const userInitial = document.getElementById('userInitial');
    const userNameLabel = document.getElementById('userNameLabel');
    const logoutBtn = document.getElementById('logoutBtn');
    const refreshDataBtn = document.getElementById('refreshDataBtn');
    const openSetupModalBtn = document.getElementById('openSetupModalBtn');

    // Stats
    const statTotalOrders = document.getElementById('statTotalOrders');
    const statPendingOrders = document.getElementById('statPendingOrders');
    const statConfirmedOrders = document.getElementById('statConfirmedOrders');
    const statSourceMode = document.getElementById('statSourceMode');

    // Table & Filters
    const searchInput = document.getElementById('searchInput');
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const itemFilterSelect = document.getElementById('itemFilterSelect');
    const statusFilterSelect = document.getElementById('statusFilterSelect');
    const exportCsvBtn = document.getElementById('exportCsvBtn');
    const crudTable = document.getElementById('crudTable');
    const tableBody = document.getElementById('tableBody');
    const tableRecordCount = document.getElementById('tableRecordCount');
    const emptyState = document.getElementById('emptyState');
    const sheetRangePill = document.getElementById('sheetRangePill');

    // Modals
    const createModal = document.getElementById('createModal');
    const openCreateModalBtn = document.getElementById('openCreateModalBtn');
    const closeCreateModalBtn = document.getElementById('closeCreateModalBtn');
    const cancelCreateBtn = document.getElementById('cancelCreateBtn');
    const createRecordForm = document.getElementById('createRecordForm');
    const submitCreateBtn = document.getElementById('submitCreateBtn');
    const createSpinner = document.getElementById('createSpinner');

    const editModal = document.getElementById('editModal');
    const closeEditModalBtn = document.getElementById('closeEditModalBtn');
    const cancelEditBtn = document.getElementById('cancelEditBtn');
    const editRecordForm = document.getElementById('editRecordForm');
    const submitEditBtn = document.getElementById('submitEditBtn');
    const editSpinner = document.getElementById('editSpinner');
    const editRowNumberBadge = document.getElementById('editRowNumberBadge');

    const deleteModal = document.getElementById('deleteModal');
    const closeDeleteModalBtn = document.getElementById('closeDeleteModalBtn');
    const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
    const deleteSpinner = document.getElementById('deleteSpinner');
    const deleteRowLabel = document.getElementById('deleteRowLabel');
    const deleteCustomerLabel = document.getElementById('deleteCustomerLabel');
    const deleteItemLabel = document.getElementById('deleteItemLabel');

    const setupModal = document.getElementById('setupModal');
    const closeSetupModalBtn = document.getElementById('closeSetupModalBtn');
    const closeSetupModalOkBtn = document.getElementById('closeSetupModalOkBtn');
    const testConnectionBtn = document.getElementById('testConnectionBtn');
    const diagMode = document.getElementById('diagMode');
    const diagCredFile = document.getElementById('diagCredFile');
    const diagClientEmail = document.getElementById('diagClientEmail');
    const diagSpreadsheetId = document.getElementById('diagSpreadsheetId');

    const toastNotification = document.getElementById('toastNotification');
    const toastMessage = document.getElementById('toastMessage');

    // ─────────────────────────────────────────────────────────────
    // UTILITIES
    // ─────────────────────────────────────────────────────────────
    function showToast(msg, isError) {
      toastMessage.textContent = msg;
      toastNotification.style.borderColor = isError ? '#ef4444' : '#22c55e';
      toastNotification.style.display = 'flex';
      setTimeout(() => {
        toastNotification.style.display = 'none';
      }, 3500);
    }

    // Toggle Password Visibility
    if (togglePwBtn) {
      togglePwBtn.addEventListener('click', () => {
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
      });
    }

    // Auto Fill Demo Credentials
    if (demoFillBtn) {
      demoFillBtn.addEventListener('click', () => {
        usernameInput.value = 'admin';
        passwordInput.value = 'GenM@2026!';
      });
    }

    // Default Seed Data for In-Browser Standalone Fallback
    const CLIENT_SEED_ROWS = [
      ['Timestamp', 'Name', 'Phone', 'Email', 'Item', 'Size', 'Qty', 'Notes', 'Status'],
      ['2026-10-14T10:15:00.000Z', 'Ameen Farhan', '+91 98471 23456', 'ameen.farhan@gmail.com', 'White T-Shirt', 'L', '2', 'Kozhikode event delivery requested', 'Confirmed'],
      ['2026-10-14T11:42:00.000Z', 'Fatima Zahra', '+91 94462 87654', 'fatima.z@outlook.com', 'Water Bottle', 'Standard', '1', 'Navy blue finish preferred', 'Pending'],
      ['2026-10-14T14:20:00.000Z', 'Rayan Mohammed', '+91 97455 11223', 'rayan.m@gmail.com', 'Embroidered Cap', 'Adjustable', '3', 'Campus Caravan pre-order', 'Shipped'],
      ['2026-10-14T16:05:00.000Z', 'Hiba Mariyam', '+91 99951 88776', 'hiba.mariyam@yahoo.com', 'Cross Bag', 'Standard', '1', 'Urgent courier dispatch', 'Confirmed'],
      ['2026-10-15T09:30:00.000Z', 'Bilal Ahmed', '+91 98950 44332', 'bilal.ahmed@gmail.com', 'Glass Set', 'Pack of 2', '2', 'Gift packaging needed', 'Pending'],
      ['2026-10-15T10:10:00.000Z', 'Zainab Shereen', '+91 96333 55441', 'zainab.s@gmail.com', 'Diary', 'A5 Hardbound', '1', 'Confluence delegate kit', 'Delivered']
    ];

    function getClientStorageRows() {
      try {
        const stored = localStorage.getItem(LOCAL_STORE_KEY);
        if (!stored) {
          localStorage.setItem(LOCAL_STORE_KEY, JSON.stringify(CLIENT_SEED_ROWS));
          return CLIENT_SEED_ROWS;
        }
        return JSON.parse(stored);
      } catch (e) {
        return CLIENT_SEED_ROWS;
      }
    }

    function saveClientStorageRows(rows) {
      try {
        localStorage.setItem(LOCAL_STORE_KEY, JSON.stringify(rows));
      } catch (e) {
        console.error('Storage write error', e);
      }
    }

    // ─────────────────────────────────────────────────────────────
    // AUTHENTICATION LOGIC
    // ─────────────────────────────────────────────────────────────
    async function handleLogin() {
      const username = usernameInput.value.trim();
      const password = passwordInput.value;

      if (!username || !password) {
        showAuthError('Please fill in both username and password.');
        return;
      }

      loginSubmitBtn.disabled = true;
      loginSpinner.style.display = 'inline-block';
      authError.style.display = 'none';

      try {
        // Try connecting to Node server
        const resp = await fetch(`${API_BASE}/api/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        if (resp.ok) {
          const data = await resp.json();
          setSession(data.token, data.user);
          showToast('Authentication successful!');
          initDashboard();
          return;
        } else {
          const errData = await resp.json().catch(() => ({}));
          throw new Error(errData.error || 'Invalid username or password');
        }
      } catch (netErr) {
        // If node server is offline or network fails, check client-side fallback
        if (netErr.message.includes('Invalid') || netErr.message.includes('Too many')) {
          showAuthError(netErr.message);
        } else {
          // Fallback demo mode login
          if (username.toLowerCase() === 'admin' && password === 'GenM@2026!') {
            setSession('mock_jwt_token_admin_gen_m_2026', { username: 'admin', role: 'Administrator' });
            showToast('Signed in via Local Session Engine');
            initDashboard();
          } else {
            showAuthError('Invalid credentials. (Demo: admin / GenM@2026!)');
          }
        }
      } finally {
        loginSubmitBtn.disabled = false;
        loginSpinner.style.display = 'none';
      }
    }

    function setSession(token, user) {
      authToken = token;
      currentUser = user;
      const storage = rememberMe.checked ? localStorage : sessionStorage;
      storage.setItem(TOKEN_KEY, token);
      storage.setItem(USER_KEY, JSON.stringify(user));
    }

    function clearSession() {
      authToken = null;
      currentUser = null;
      localStorage.removeItem(TOKEN_KEY);
      localStorage.removeItem(USER_KEY);
      sessionStorage.removeItem(TOKEN_KEY);
      sessionStorage.removeItem(USER_KEY);
      authSection.style.display = 'flex';
      dashSection.style.display = 'none';
    }

    function showAuthError(msg) {
      authErrorMsg.textContent = msg;
      authError.style.display = 'flex';
    }

    if (loginForm) {
      loginForm.addEventListener('submit', handleLogin);
    }
    if (logoutBtn) {
      logoutBtn.addEventListener('click', clearSession);
    }

    // ─────────────────────────────────────────────────────────────
    // DASHBOARD INITIALIZATION & DATA FETCHING
    // ─────────────────────────────────────────────────────────────
    async function initDashboard() {
      authSection.style.display = 'none';
      dashSection.style.display = 'flex';

      if (currentUser) {
        userNameLabel.textContent = currentUser.username || 'admin';
        userInitial.textContent = (currentUser.username || 'A')[0].toUpperCase();
      }

      await checkServerDiagnostics();
      await fetchSpreadsheetData();
    }

    async function checkServerDiagnostics() {
      try {
        const resp = await fetch(`${API_BASE}/api/config-status`, { signal: AbortSignal.timeout(3000) });
        if (resp.ok) {
          const cfg = await resp.json();
          if (cfg.googleSheets && cfg.googleSheets.isConfigured) {
            serverMode = 'google_sheets';
            statusDot.className = 'status-indicator-dot dot-live';
            statusLabel.textContent = 'Google Sheets (Live)';
            statSourceMode.textContent = 'Live Sheets API';
            statSourceMode.style.color = '#4ade80';
          } else {
            serverMode = 'local_cache';
            statusDot.className = 'status-indicator-dot dot-mock';
            statusLabel.textContent = 'Local Cache Mode';
            statSourceMode.textContent = 'Server Local Cache';
            statSourceMode.style.color = '#facc15';
          }

          // Populate Diagnostics Modal
          diagMode.textContent = cfg.mode === 'google_sheets' ? 'Google Cloud Service Account' : 'Local File Cache';
          diagCredFile.textContent = cfg.googleSheets.hasCredentialsFile ? `Found (${cfg.googleSheets.credentialsPath})` : 'Missing (credentials.json)';
          diagClientEmail.textContent = cfg.googleSheets.serviceAccountEmail || 'Not configured';
          diagSpreadsheetId.textContent = cfg.googleSheets.spreadsheetIdMasked || 'Not set in .env';
          sheetRangePill.textContent = cfg.googleSheets.sheetRange || 'Form responses 2!A:I';
          return;
        }
      } catch (e) {
        // Server unreachable, use browser offline mock
        serverMode = 'offline_mock';
        statusDot.className = 'status-indicator-dot dot-mock';
        statusLabel.textContent = 'Browser Offline Mode';
        statSourceMode.textContent = 'Client LocalStorage';
        statSourceMode.style.color = '#38bdf8';

        diagMode.textContent = 'Client-Side Offline Mode';
        diagCredFile.textContent = 'Backend server not responding on :5050';
        diagClientEmail.textContent = 'Run "npm run server" to activate';
        diagSpreadsheetId.textContent = 'Local sandbox active';
      }
    }

    async function fetchSpreadsheetData() {
      tableRecordCount.textContent = 'Fetching...';

      if (serverMode === 'offline_mock') {
        allRecords = getClientStorageRows();
        renderTable();
        return;
      }

      try {
        const resp = await fetch(`${API_BASE}/api/data`, {
          headers: { 'Authorization': `Bearer ${authToken}` }
        });

        if (resp.status === 401 || resp.status === 403) {
          clearSession();
          showAuthError('Session expired. Please log in again.');
          return;
        }

        const data = await resp.json();
        if (data.success && Array.isArray(data.values)) {
          allRecords = data.values;
          renderTable();
        } else {
          throw new Error(data.error || 'Invalid data payload');
        }
      } catch (err) {
        console.warn('API fetch failed, falling back to client storage:', err);
        allRecords = getClientStorageRows();
        renderTable();
      }
    }

    // ─────────────────────────────────────────────────────────────
    // TABLE RENDERING & FILTERING
    // ─────────────────────────────────────────────────────────────
    function renderTable() {
      const q = (searchInput.value || '').trim().toLowerCase();
      const selectedItem = itemFilterSelect.value;
      const selectedStatus = statusFilterSelect.value;

      clearSearchBtn.style.display = q ? 'block' : 'none';

      // Rows exclude header (index 0)
      const dataRows = allRecords.slice(1).map((row, idx) => ({
        rowNumber: idx + 2, // 1-indexed spreadsheet row
        timestamp: row[0] || '',
        name: cleanCell(row[1] || ''),
        phone: cleanCell(row[2] || ''),
        email: cleanCell(row[3] || ''),
        item: cleanCell(row[4] || ''),
        size: cleanCell(row[5] || 'Standard'),
        qty: cleanCell(row[6] || '1'),
        notes: cleanCell(row[7] || ''),
        status: cleanCell(row[8] || 'Pending'),
      }));

      // Filter
      const filtered = dataRows.filter((r) => {
        const matchesQuery = !q ||
          r.name.toLowerCase().includes(q) ||
          r.phone.toLowerCase().includes(q) ||
          r.email.toLowerCase().includes(q) ||
          r.item.toLowerCase().includes(q) ||
          r.notes.toLowerCase().includes(q);

        const matchesItem = selectedItem === 'ALL' || r.item === selectedItem;
        const matchesStatus = selectedStatus === 'ALL' || r.status.toLowerCase() === selectedStatus.toLowerCase();

        return matchesQuery && matchesItem && matchesStatus;
      });

      // Update KPI counters
      statTotalOrders.textContent = dataRows.length;
      statPendingOrders.textContent = dataRows.filter(r => r.status.toLowerCase() === 'pending').length;
      statConfirmedOrders.textContent = dataRows.filter(r => ['confirmed', 'shipped', 'delivered'].includes(r.status.toLowerCase())).length;

      tableRecordCount.textContent = `${filtered.length} of ${dataRows.length} entries`;

      tableBody.innerHTML = '';

      if (filtered.length === 0) {
        emptyState.style.display = 'flex';
        return;
      }

      emptyState.style.display = 'none';

      filtered.forEach((r) => {
        const tr = document.createElement('tr');

        // Format Date
        let dateFormatted = r.timestamp;
        try {
          const d = new Date(r.timestamp);
          if (!isNaN(d.getTime())) {
            dateFormatted = d.toLocaleDateString('en-IN', {
              day: '2-digit',
              month: 'short',
              year: 'numeric'
            });
          }
        } catch (e) {}

        const statusClass = getStatusClass(r.status);

        tr.innerHTML = `
          <td><span class="row-num-badge">#${r.rowNumber}</span></td>
          <td><span class="date-cell">${escapeHtml(dateFormatted)}</span></td>
          <td><span class="customer-name">${escapeHtml(r.name)}</span></td>
          <td>
            <div class="contact-info">
              <span class="contact-phone">${escapeHtml(r.phone || '—')}</span>
              <span class="contact-email">${escapeHtml(r.email || '')}</span>
            </div>
          </td>
          <td><span class="item-chip">${escapeHtml(r.item)}</span></td>
          <td><span class="size-pill">${escapeHtml(r.size)}</span></td>
          <td><span class="qty-badge">${escapeHtml(r.qty)}</span></td>
          <td><span class="notes-text">${escapeHtml(r.notes || '—')}</span></td>
          <td>
            <span class="badge-status ${statusClass}">
              ● ${escapeHtml(r.status)}
            </span>
          </td>
          <td>
            <div class="action-btns-wrap">
              <button class="btn-table-action btn-edit" data-row="${r.rowNumber}" title="Edit Row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </button>
              <button class="btn-table-action btn-delete" data-row="${r.rowNumber}" title="Clear / Delete Row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </div>
          </td>
        `;

        tableBody.appendChild(tr);
      });

      // Bind row action events
      tableBody.querySelectorAll('.btn-edit').forEach((btn) => {
        btn.addEventListener('click', () => {
          const rowNum = parseInt(btn.getAttribute('data-row'), 10);
          openEditModal(rowNum);
        });
      });

      tableBody.querySelectorAll('.btn-delete').forEach((btn) => {
        btn.addEventListener('click', () => {
          const rowNum = parseInt(btn.getAttribute('data-row'), 10);
          openDeleteModal(rowNum);
        });
      });
    }

    function cleanCell(val) {
      if (typeof val === 'string' && val.startsWith("'")) {
        return val.slice(1);
      }
      return String(val || '');
    }

    function getStatusClass(status) {
      const s = (status || '').toLowerCase();
      if (s === 'confirmed') return 'status-confirmed';
      if (s === 'shipped') return 'status-shipped';
      if (s === 'delivered') return 'status-delivered';
      return 'status-pending';
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // ─────────────────────────────────────────────────────────────
    // CRUD: CREATE RECORD (POST)
    // ─────────────────────────────────────────────────────────────
    if (openCreateModalBtn) {
      openCreateModalBtn.addEventListener('click', () => {
        createRecordForm.reset();
        createModal.style.display = 'flex';
      });
    }

    if (closeCreateModalBtn) closeCreateModalBtn.addEventListener('click', () => createModal.style.display = 'none');
    if (cancelCreateBtn) cancelCreateBtn.addEventListener('click', () => createModal.style.display = 'none');

    if (createRecordForm) {
      createRecordForm.addEventListener('submit', async () => {
        const payload = {
          name: document.getElementById('createName').value.trim(),
          phone: document.getElementById('createPhone').value.trim(),
          email: document.getElementById('createEmail').value.trim(),
          item: document.getElementById('createItem').value,
          size: document.getElementById('createSize').value.trim() || 'Standard',
          qty: document.getElementById('createQty').value || '1',
          notes: document.getElementById('createNotes').value.trim(),
          status: document.getElementById('createStatus').value,
        };

        submitCreateBtn.disabled = true;
        createSpinner.style.display = 'inline-block';

        if (serverMode === 'offline_mock') {
          const newRow = [new Date().toISOString(), payload.name, payload.phone, payload.email, payload.item, payload.size, payload.qty, payload.notes, payload.status];
          allRecords.push(newRow);
          saveClientStorageRows(allRecords);
          createModal.style.display = 'none';
          showToast('Record added to local storage');
          renderTable();
          submitCreateBtn.disabled = false;
          createSpinner.style.display = 'none';
          return;
        }

        try {
          const resp = await fetch(`${API_BASE}/api/data`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${authToken}`
            },
            body: JSON.stringify(payload)
          });

          const resData = await resp.json();
          if (resp.ok) {
            createModal.style.display = 'none';
            showToast(resData.message || 'Record created successfully!');
            await fetchSpreadsheetData();
          } else {
            showToast(resData.error || 'Failed to add record', true);
          }
        } catch (e) {
          showToast('Network error adding record', true);
        } finally {
          submitCreateBtn.disabled = false;
          createSpinner.style.display = 'none';
        }
      });
    }

    // ─────────────────────────────────────────────────────────────
    // CRUD: UPDATE RECORD (PUT)
    // ─────────────────────────────────────────────────────────────
    function openEditModal(rowNumber) {
      const arrayIndex = rowNumber - 1;
      const row = allRecords[arrayIndex];
      if (!row) return;

      document.getElementById('editRowNumber').value = rowNumber;
      editRowNumberBadge.textContent = `Row #${rowNumber}`;

      document.getElementById('editName').value = cleanCell(row[1]);
      document.getElementById('editPhone').value = cleanCell(row[2]);
      document.getElementById('editEmail').value = cleanCell(row[3]);
      document.getElementById('editItem').value = cleanCell(row[4]);
      document.getElementById('editSize').value = cleanCell(row[5]) || 'Standard';
      document.getElementById('editQty').value = cleanCell(row[6]) || '1';
      document.getElementById('editNotes').value = cleanCell(row[7]);
      document.getElementById('editStatus').value = cleanCell(row[8]) || 'Pending';

      editModal.style.display = 'flex';
    }

    if (closeEditModalBtn) closeEditModalBtn.addEventListener('click', () => editModal.style.display = 'none');
    if (cancelEditBtn) cancelEditBtn.addEventListener('click', () => editModal.style.display = 'none');

    if (editRecordForm) {
      editRecordForm.addEventListener('submit', async () => {
        const rowNumber = document.getElementById('editRowNumber').value;
        const payload = {
          name: document.getElementById('editName').value.trim(),
          phone: document.getElementById('editPhone').value.trim(),
          email: document.getElementById('editEmail').value.trim(),
          item: document.getElementById('editItem').value,
          size: document.getElementById('editSize').value.trim() || 'Standard',
          qty: document.getElementById('editQty').value || '1',
          notes: document.getElementById('editNotes').value.trim(),
          status: document.getElementById('editStatus').value,
        };

        submitEditBtn.disabled = true;
        editSpinner.style.display = 'inline-block';

        if (serverMode === 'offline_mock') {
          const idx = parseInt(rowNumber, 10) - 1;
          const existingTs = allRecords[idx] ? allRecords[idx][0] : new Date().toISOString();
          allRecords[idx] = [existingTs, payload.name, payload.phone, payload.email, payload.item, payload.size, payload.qty, payload.notes, payload.status];
          saveClientStorageRows(allRecords);
          editModal.style.display = 'none';
          showToast(`Row #${rowNumber} updated in local storage`);
          renderTable();
          submitEditBtn.disabled = false;
          editSpinner.style.display = 'none';
          return;
        }

        try {
          const resp = await fetch(`${API_BASE}/api/data/${rowNumber}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${authToken}`
            },
            body: JSON.stringify(payload)
          });

          const resData = await resp.json();
          if (resp.ok) {
            editModal.style.display = 'none';
            showToast(resData.message || `Row #${rowNumber} updated!`);
            await fetchSpreadsheetData();
          } else {
            showToast(resData.error || 'Failed to update row', true);
          }
        } catch (e) {
          showToast('Network error updating row', true);
        } finally {
          submitEditBtn.disabled = false;
          editSpinner.style.display = 'none';
        }
      });
    }

    // ─────────────────────────────────────────────────────────────
    // CRUD: DELETE / CLEAR RECORD (DELETE)
    // ─────────────────────────────────────────────────────────────
    function openDeleteModal(rowNumber) {
      currentDeleteRow = rowNumber;
      const arrayIndex = rowNumber - 1;
      const row = allRecords[arrayIndex] || [];

      deleteRowLabel.textContent = `Row #${rowNumber}`;
      deleteCustomerLabel.textContent = cleanCell(row[1] || 'Unknown');
      deleteItemLabel.textContent = cleanCell(row[4] || 'Merchandise');

      deleteModal.style.display = 'flex';
    }

    if (closeDeleteModalBtn) closeDeleteModalBtn.addEventListener('click', () => deleteModal.style.display = 'none');
    if (cancelDeleteBtn) cancelDeleteBtn.addEventListener('click', () => deleteModal.style.display = 'none');

    if (confirmDeleteBtn) {
      confirmDeleteBtn.addEventListener('click', async () => {
        if (!currentDeleteRow) return;

        confirmDeleteBtn.disabled = true;
        deleteSpinner.style.display = 'inline-block';

        if (serverMode === 'offline_mock') {
          const idx = currentDeleteRow - 1;
          allRecords.splice(idx, 1);
          saveClientStorageRows(allRecords);
          deleteModal.style.display = 'none';
          showToast(`Row #${currentDeleteRow} removed from local storage`);
          renderTable();
          confirmDeleteBtn.disabled = false;
          deleteSpinner.style.display = 'none';
          return;
        }

        try {
          const resp = await fetch(`${API_BASE}/api/data/${currentDeleteRow}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${authToken}` }
          });

          const resData = await resp.json();
          if (resp.ok) {
            deleteModal.style.display = 'none';
            showToast(resData.message || `Row #${currentDeleteRow} cleared!`);
            await fetchSpreadsheetData();
          } else {
            showToast(resData.error || 'Failed to clear row', true);
          }
        } catch (e) {
          showToast('Network error deleting row', true);
        } finally {
          confirmDeleteBtn.disabled = false;
          deleteSpinner.style.display = 'none';
        }
      });
    }

    // ─────────────────────────────────────────────────────────────
    // DIAGNOSTICS & SETUP MODAL
    // ─────────────────────────────────────────────────────────────
    if (openSetupModalBtn) {
      openSetupModalBtn.addEventListener('click', () => {
        setupModal.style.display = 'flex';
      });
    }
    if (closeSetupModalBtn) closeSetupModalBtn.addEventListener('click', () => setupModal.style.display = 'none');
    if (closeSetupModalOkBtn) closeSetupModalOkBtn.addEventListener('click', () => setupModal.style.display = 'none');

    if (testConnectionBtn) {
      testConnectionBtn.addEventListener('click', async () => {
        testConnectionBtn.textContent = 'Testing...';
        await checkServerDiagnostics();
        await fetchSpreadsheetData();
        testConnectionBtn.textContent = '🔄 Re-test Connection';
        showToast('Connection diagnostics updated');
      });
    }

    // ─────────────────────────────────────────────────────────────
    // TOOLBAR SEARCH, FILTER & CSV EXPORT
    // ─────────────────────────────────────────────────────────────
    if (searchInput) {
      searchInput.addEventListener('input', renderTable);
    }
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        renderTable();
      });
    }
    if (itemFilterSelect) {
      itemFilterSelect.addEventListener('change', renderTable);
    }
    if (statusFilterSelect) {
      statusFilterSelect.addEventListener('change', renderTable);
    }
    if (refreshDataBtn) {
      refreshDataBtn.addEventListener('click', async () => {
        refreshDataBtn.classList.add('rotating');
        await fetchSpreadsheetData();
        showToast('Spreadsheet records refreshed');
        setTimeout(() => refreshDataBtn.classList.remove('rotating'), 600);
      });
    }

    if (exportCsvBtn) {
      exportCsvBtn.addEventListener('click', () => {
        if (!allRecords || allRecords.length === 0) {
          showToast('No records to export', true);
          return;
        }

        const csvContent = allRecords.map(row => {
          return row.map(cell => {
            const escaped = String(cell || '').replace(/"/g, '""');
            return `"${escaped}"`;
          }).join(',');
        }).join('\n');

        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `GEN_M_Swag_Orders_${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        showToast('CSV downloaded successfully');
      });
    }

    // ─────────────────────────────────────────────────────────────
    // INITIAL BOOT
    // ─────────────────────────────────────────────────────────────
    if (authToken) {
      initDashboard();
    } else {
      authSection.style.display = 'flex';
      dashSection.style.display = 'none';
    }

  })();
</script>
