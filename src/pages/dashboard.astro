    // ─────────────────────────────────────────────────────────────
    // AUTHENTICATION LOGIC
    // ─────────────────────────────────────────────────────────────
    async function handleLogin(e) {
      if (e && e.preventDefault) e.preventDefault();
      const username = usernameInput.value.trim();
      const password = passwordInput.value;

      if (!username || !password) {
        showAuthError('Please fill in both username and password.');
        return;
      }

      loginSubmitBtn.disabled = true;
      loginSpinner.style.display = 'inline-block';
      authError.style.display = 'none';

      try {
        const resp = await fetch(`${API_BASE}/api/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        if (resp.ok) {
          const data = await resp.json();
          setSession(data.token, data.user);
          showToast('Authentication successful!');
          initDashboard();
          return;
        } else {
          const errData = await resp.json().catch(() => ({}));
          throw new Error(errData.error || 'Invalid username or password');
        }
      } catch (netErr) {
        if (netErr.message.includes('Invalid') || netErr.message.includes('Too many')) {
          showAuthError(netErr.message);
        } else {
          // Fallback login
          if (username.toLowerCase() === 'admin' && password === 'GenM@2026!') {
            setSession('local_session_token_2026', { username: 'admin', role: 'Operations Admin' });
            showToast('Signed in via Local Session');
            initDashboard();
          } else {
            showAuthError('Invalid credentials. (Demo: admin / GenM@2026!)');
          }
        }
      } finally {
        loginSubmitBtn.disabled = false;
        loginSpinner.style.display = 'none';
      }
    }

    function setSession(token, user) {
      authToken = token;
      currentUser = user;
      const storage = rememberMe.checked ? localStorage : sessionStorage;
      storage.setItem(TOKEN_KEY, token);
      storage.setItem(USER_KEY, JSON.stringify(user));
    }

    function clearSession() {
      authToken = null;
      currentUser = null;
      localStorage.removeItem(TOKEN_KEY);
      localStorage.removeItem(USER_KEY);
      sessionStorage.removeItem(TOKEN_KEY);
      sessionStorage.removeItem(USER_KEY);
      authSection.style.display = 'flex';
      dashSection.style.display = 'none';
    }

    function showAuthError(msg) {
      authErrorMsg.textContent = msg;
      authError.style.display = 'flex';
    }

    if (loginForm) loginForm.addEventListener('submit', handleLogin);
    if (loginSubmitBtn) loginSubmitBtn.addEventListener('click', handleLogin);
    if (logoutBtn) logoutBtn.addEventListener('click', clearSession);

