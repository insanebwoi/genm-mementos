        if (statusDot) statusDot.className = 'status-indicator-dot dot-syncing';
      } else {
        if (qbSyncStatusText) qbSyncStatusText.textContent = 'Sheet: Form Responses 1 (Live Real-Time)';
        if (qbSyncDot) qbSyncDot.className = 'status-indicator-dot dot-live';
        if (statusLabel) statusLabel.textContent = 'Form Responses 1 (Live Sync)';
        if (statusDot) statusDot.className = 'status-indicator-dot dot-live';
      }
    }

    async function flushOfflineBookings() {
      if (isFlushingQueue) return;
      const queue = getOfflineQueue();
      if (!queue.length) {
        updateOfflineUI();
        return;
      }
      if (!navigator.onLine) {
        showToast('Device is offline. Will sync once network reconnects.', true);
        return;
      }

      isFlushingQueue = true;
      updateOfflineUI();
      showToast(`⚡ Syncing ${queue.length} offline bookings to Google Sheet...`);

      try {
        const batchResp = await fetch(`${API_BASE}/api/sync/batch`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`
          },
          body: JSON.stringify({ bookings: queue })
        });

        if (batchResp.ok) {
          saveOfflineQueue([]);
          showToast(`✓ All offline bookings pushed to Google Sheet Form Responses 1!`);
          await fetchOrdersData();
          await loadStockData();
          isFlushingQueue = false;
          return;
        }
      } catch (batchErr) {
        // Fallback to individual push
      }

      const remaining = [];
      for (const item of queue) {
        try {
          const resp = await fetch(`${API_BASE}/api/data`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${authToken}`
            },
            body: JSON.stringify(item)
          });
          if (!resp.ok) {
            remaining.push(item);
          }
        } catch (singleErr) {
          remaining.push(item);
        }
      }

      saveOfflineQueue(remaining);
      isFlushingQueue = false;

      if (remaining.length === 0) {
        showToast(`✓ All offline bookings successfully pushed to Google Sheet Form Responses 1!`);
        await fetchOrdersData();
        await loadStockData();
      } else {
        showToast(`Pushed ${queue.length - remaining.length} bookings. ${remaining.length} remaining offline.`, true);
      }
    }

