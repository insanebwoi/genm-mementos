          (r.name || '').toLowerCase().includes(q) ||
          (r.phone || '').toLowerCase().includes(q) ||
          (r.email || '').toLowerCase().includes(q) ||
          (r.item || '').toLowerCase().includes(q) ||
          (r.sizesSummary || '').toLowerCase().includes(q) ||
          (r.notes || '').toLowerCase().includes(q);

        const matchesItem = selectedItem === 'ALL' || r.item === selectedItem;
        const matchesStatus = selectedStatus === 'ALL' || (r.bookingStatus || '').toLowerCase() === selectedStatus.toLowerCase();
        const matchesPayment = selectedPayment === 'ALL' || (r.paymentStatus || '').toLowerCase() === selectedPayment.toLowerCase();

        return matchesQuery && matchesItem && matchesStatus && matchesPayment;
      });

      // Update KPI
      statTotalOrders.textContent = dataRows.length;
      tabOrdersBadge.textContent = dataRows.length;
