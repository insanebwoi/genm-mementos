---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';

const GOOGLE_SHEET_ID = '1foGWm9i_5DhBUjocJDxs84jWCLdc-U1BJaN7r0KuhiA';
const GOOGLE_SHEET_URL = `https://docs.google.com/spreadsheets/d/${GOOGLE_SHEET_ID}/edit`;

// Pre-map catalog products with image and pricing
const CATALOG_ITEMS = [
  { id: 'white-tshirt', name: 'White T-Shirt', category: 'Apparel', price: 449, cost: 260, stock: 250, isTshirt: true, image: '/products/white_tshirt.jpg' },
  { id: 'cap', name: 'Embroidered Cap', category: 'Apparel', price: 180, cost: 100, stock: 100, isTshirt: false, image: '/products/cap.jpg' },
  { id: 'cross-bag', name: 'Cross Bag', category: 'Accessories', price: 180, cost: 120, stock: 150, isTshirt: false, image: '/products/cross_bag.jpg' },
  { id: 'water-bottle', name: 'Water Bottle', category: 'Drinkware', price: 350, cost: 220, stock: 100, isTshirt: false, image: '/products/water_bottle.jpg' },
  { id: 'coffee-mug', name: 'Coffee Mug', category: 'Drinkware', price: 180, cost: 120, stock: 50, isTshirt: false, image: '/products/coffee_mug.jpg' },
  { id: 'diary', name: 'Diary', category: 'Stationery', price: 150, cost: 120, stock: 100, isTshirt: false, image: '/products/diary.jpg' },
  { id: 'pen', name: 'Pen', category: 'Stationery', price: 20, cost: 10, stock: 500, isTshirt: false, image: '/products/pen.jpg' },
  { id: 'keychain', name: 'Keychain', category: 'Accessories', price: 25, cost: 10, stock: 250, isTshirt: false, image: '/products/keychain.jpg' },
  { id: 'bag-tag', name: 'Bag Tag', category: 'Accessories', price: 50, cost: 30, stock: 100, isTshirt: false, image: '/products/bag_tag.jpg' },
  { id: 'glass-set', name: 'Glass Set', category: 'Drinkware', price: 200, cost: 120, stock: 50, isTshirt: false, image: '/products/glass_set.jpg' },
  { id: 'mobile-stand', name: 'Mobile Stand', category: 'Accessories', price: 199, cost: 90, stock: 50, isTshirt: false, image: '/products/mobile_stand.jpg' },
  { id: 'tissue', name: 'Tissue', category: 'Accessories', price: 79, cost: 40, stock: 100, isTshirt: false, image: '/products/tissue.jpg' },
  { id: 'car-perfume', name: 'Car Perfume', category: 'Accessories', price: 40, cost: 10, stock: 50, isTshirt: false, image: '/products/car_perfume.jpg' },
];
---

<Layout
  title="GEN M — POS Billing & Live Operations"
  description="Fast POS Billing, Instant WhatsApp Invoices, and Real-Time Google Sheets Form Responses 1 Sync."
>
  <div class="pos-app" id="posApp">

    <!-- ═══════════════════════════════════════════════════════════
         AUTH SCREEN (Clean Minimal Light)
         ═══════════════════════════════════════════════════════════ -->
    <div class="auth-overlay" id="authSection" style="display: none;">
      <div class="auth-box">
        <div class="auth-badge">GEN M OPERATIONS</div>
        <h2 class="auth-heading">Sign In</h2>
        <p class="auth-sub">POS Billing &amp; Google Sheet Command Center</p>

        <form id="loginForm" class="auth-form" onsubmit="return false;">
          <div class="input-field">
            <label for="authUsername">Username</label>
            <input type="text" id="authUsername" value="admin" required autofocus />
          </div>
          <div class="input-field">
            <label for="authPassword">Password</label>
            <input type="password" id="authPassword" value="GenM@2026!" required />
          </div>
          <button type="submit" id="loginSubmitBtn" class="btn-primary">
            Sign In to Dashboard
          </button>
        </form>
        <div id="authError" class="auth-error" style="display: none;"></div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         MAIN APP (Clean Light Theme)
         ═══════════════════════════════════════════════════════════ -->
    <div class="app-layout" id="mainSection">

      <!-- TOP BAR -->
      <header class="top-nav">
        <div class="nav-brand">
          <a href="/" class="brand-title">GEN M</a>
          <span class="brand-tag">POS &amp; BILLING</span>
          <a
            href={GOOGLE_SHEET_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="sheet-indicator"
            title="Open Form Responses 1 in Google Sheets"
          >
            <span class="pulse-dot"></span>
            <span>Form Responses 1</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
        </div>

        <!-- TABS NAV -->
        <nav class="nav-tabs">
          <button type="button" class="tab-btn active" data-tab="billing">
            <span class="tab-icon">🧾</span>
            <span>Billing &amp; POS</span>
          </button>
          <button type="button" class="tab-btn" data-tab="orders">
            <span class="tab-icon">📋</span>
            <span>Form Responses 1</span>
            <span class="tab-badge" id="tabOrdersCount">0</span>
          </button>
          <button type="button" class="tab-btn" data-tab="stock">
            <span class="tab-icon">📦</span>
            <span>Stock &amp; Catalog</span>
            <span class="tab-pill-light">View Only</span>
          </button>
        </nav>

        <div class="nav-actions">
          <button type="button" id="refreshBtn" class="btn-outline-sm" title="Refresh Live Google Sheet Data">
            <span class="refresh-icon">⟳</span>
            <span>Refresh</span>
          </button>
          <button type="button" id="logoutBtn" class="btn-ghost-sm">
            Sign Out
          </button>
        </div>
      </header>

      <!-- SYNC STATUS BANNER (Alerts user if Apps Script access needs to be changed to Anyone) -->
      <div id="syncAlertBanner" class="sync-alert-banner" style="display: none;">
        <div class="sync-alert-content">
          <span class="sync-alert-icon">⚠️</span>
          <span id="syncAlertMessage">Google Apps Script requires public access. Orders are safely saved in local queue.</span>
        </div>
        <button type="button" id="bannerResolveBtn" class="btn-banner-action">How to Fix (30s)</button>
      </div>

      <!-- MAIN CONTENT VIEW -->
      <main class="main-content">

        <!-- ─────────────────────────────────────────────────────────────
             TAB 1: 🧾 BILLING & POS PANEL
             ───────────────────────────────────────────────────────────── -->
        <div class="tab-pane active" id="paneBilling">
          <div class="pos-grid">
            
            <!-- LEFT: BIG PRODUCT CARDS -->
            <div class="pos-catalog">
              
              <div class="catalog-header">
                <div>
                  <h1 class="pane-title">Create Bill / New Order</h1>
                  <p class="pane-subtitle">Tap big <strong>+</strong> and <strong>−</strong> to add items, generate bill, and push to <strong>Form Responses 1</strong>.</p>
                </div>

                <!-- CATEGORY CHIPS & SEARCH -->
                <div class="filter-row">
                  <div class="category-pills" id="categoryPills">
                    <button type="button" class="cat-pill active" data-cat="all">All Items (13)</button>
                    <button type="button" class="cat-pill" data-cat="Apparel">👕 Apparel</button>
                    <button type="button" class="cat-pill" data-cat="Drinkware">☕ Drinkware</button>
                    <button type="button" class="cat-pill" data-cat="Stationery">📓 Stationery</button>
                    <button type="button" class="cat-pill" data-cat="Accessories">🎒 Accessories</button>
                  </div>
                  <div class="search-box">
                    <input type="text" id="catalogSearch" placeholder="Search product..." />
                  </div>
                </div>
              </div>

              <!-- PRODUCT CARDS GRID -->
              <div class="cards-grid" id="productCardsGrid">
                {CATALOG_ITEMS.map((item) => (
                  <div
                    class={`product-card ${item.isTshirt ? 'card-tshirt' : ''}`}
                    data-id={item.id}
                    data-name={item.name}
                    data-price={item.price}
                    data-category={item.category}
                    data-is-tshirt={item.isTshirt ? 'true' : 'false'}
                  >
                    <div class="card-media">
                      <img src={item.image} alt={item.name} loading="lazy" />
                      <span class="card-badge">{item.category}</span>
                      <span class="card-stock" id={`stock-${item.id}`}>{item.stock} in stock</span>
                    </div>

                    <div class="card-body">
                      <div class="card-title-row">
                        <h3 class="card-title">{item.name}</h3>
                        <span class="card-price">₹{item.price}</span>
                      </div>

                      {/* WHITE T-SHIRT SIZES STEPPER */}
                      {item.isTshirt ? (
                        <div class="tshirt-stepper-box">
                          <div class="sizes-label-row">
                            <span class="sub-label">Select Sizes:</span>
                            <span class="sizes-total-badge" id="tshirtTotalBadge">0 Selected</span>
                          </div>
                          <div class="sizes-row">
                            {(['S', 'M', 'L', 'XL', 'XXL'] as const).map((sz) => (
                              <div class="size-col">
                                <span class="size-tag">{sz}</span>
                                <div class="size-controls">
                                  <button type="button" class="btn-step size-minus" data-size={sz} aria-label={`Decrease ${sz}`}>−</button>
                                  <span class="size-val" id={`val-size-${sz}`}>0</span>
                                  <button type="button" class="btn-step size-plus" data-size={sz} aria-label={`Increase ${sz}`}>+</button>
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      ) : (
                        /* STANDARD ITEM STEPPER */
                        <div class="std-stepper-box">
                          <button type="button" class="btn-big-step item-minus" data-id={item.id} aria-label="Decrease quantity">−</button>
                          <span class="big-qty-display" id={`qty-${item.id}`}>0</span>
                          <button type="button" class="btn-big-step item-plus" data-id={item.id} aria-label="Increase quantity">+</button>
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- RIGHT: STICKY BILLING / CHECKOUT PANEL -->
            <div class="pos-cart-panel">
              <div class="cart-box">
                
                <div class="cart-head">
                  <div class="cart-head-title">
                    <span class="cart-icon">🛒</span>
                    <h2>Current Bill</h2>
                  </div>
                  <button type="button" id="clearCartBtn" class="btn-text-danger" title="Reset current bill">
                    Clear Bill
                  </button>
                </div>

                <!-- CUSTOMER INPUTS -->
                <div class="customer-section">
                  <div class="input-group">
                    <label for="custName">Customer Name <span class="req">*</span></label>
                    <input type="text" id="custName" class="cart-input" placeholder="e.g. Ameen Farhan" required />
                  </div>

                  <div class="input-group">
                    <label for="custPhone">
                      <span>WhatsApp / Mobile <span class="req">*</span></span>
                      <span class="whatsapp-hint">💬 For Instant Bill</span>
                    </label>
                    <div class="phone-input-wrap">
                      <span class="prefix">+91</span>
                      <input type="tel" id="custPhone" class="cart-input" placeholder="9876543210" maxlength="10" required />
                    </div>
                  </div>

                  <div class="input-group">
                    <label for="custNotes">Notes / Campus / Delivery</label>
                    <input type="text" id="custNotes" class="cart-input" placeholder="e.g. Calicut Campus, Room 104" />
                  </div>
                </div>

                <!-- CART ITEMS LIST -->
                <div class="cart-items-wrap">
                  <div class="cart-items-head">
                    <span>Items Added</span>
                    <span id="cartCountLabel">0 items</span>
                  </div>

                  <div class="cart-items-list" id="cartItemsList">
                    <div class="cart-empty-state" id="cartEmptyState">
                      <span class="empty-icon">🛍️</span>
                      <p>No items added yet</p>
                      <small>Tap <strong>+</strong> on any product card to start billing</small>
                    </div>
                  </div>
                </div>

                <!-- TOTALS & PAYMENT -->
                <div class="cart-summary">
                  <div class="summary-row">
                    <span>Subtotal</span>
                    <span id="billSubtotal">₹0</span>
                  </div>
                  <div class="summary-row">
                    <span>Total Units</span>
                    <span id="billTotalUnits">0 units</span>
                  </div>

                  <div class="payment-selector-wrap">
                    <label class="pay-label">Payment Mode</label>
                    <div class="pay-options">
                      <label class="pay-option">
                        <input type="radio" name="payMethod" value="Paid (UPI)" checked />
                        <span class="pay-chip">📱 UPI / GPay</span>
                      </label>
                      <label class="pay-option">
                        <input type="radio" name="payMethod" value="Paid (Cash)" />
                        <span class="pay-chip">💵 Cash</span>
                      </label>
                      <label class="pay-option">
                        <input type="radio" name="payMethod" value="Pending" />
                        <span class="pay-chip">⏳ Pending</span>
                      </label>
                    </div>
                  </div>

                  <!-- GRAND TOTAL BANNER -->
                  <div class="grand-total-banner">
                    <div class="gt-label">Grand Total</div>
                    <div class="gt-val" id="billGrandTotal">₹0</div>
                  </div>

                  <!-- ACTIONS -->
                  <div class="cart-actions">
                    <button type="button" id="generateBillBtn" class="btn-checkout" disabled>
                      <span class="btn-main-text">⚡ Complete Bill &amp; Push to Sheet</span>
                      <span class="btn-sub-text">Updates Form Responses 1 directly</span>
                    </button>

                    <button type="button" id="shareWhatsappDirectBtn" class="btn-whatsapp" disabled>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824z"/></svg>
                      <span>Share Bill to WhatsApp</span>
                    </button>
                  </div>

                  <div id="billFeedback" class="bill-feedback" style="display: none;"></div>
                </div>

              </div>
            </div>

          </div>
        </div>

        <!-- ─────────────────────────────────────────────────────────────
             TAB 2: 📋 FORM RESPONSES 1 (LIVE ORDERS ONLY)
             ───────────────────────────────────────────────────────────── -->
        <div class="tab-pane" id="paneOrders">
          <div class="orders-shell">
            
            <div class="orders-head">
              <div>
                <h2 class="pane-title">Google Sheet: Form Responses 1</h2>
                <p class="pane-subtitle">Live bookings &amp; customer orders. Only this sheet is modified upon billing.</p>
              </div>

              <div class="orders-toolbar">
                <input type="text" id="orderSearchInput" class="filter-input" placeholder="Search by name, phone, item..." />
                <select id="orderStatusFilter" class="filter-select">
                  <option value="all">All Statuses</option>
                  <option value="Confirmed">Confirmed</option>
                  <option value="Pending">Pending</option>
                </select>
                <select id="orderPaymentFilter" class="filter-select">
                  <option value="all">All Payments</option>
                  <option value="Paid">Paid Only</option>
                  <option value="Pending">Payment Pending</option>
                </select>
                <button type="button" id="exportCsvBtn" class="btn-outline-sm">Export CSV</button>
              </div>
            </div>

            <div class="table-card">
              <div class="table-responsive">
                <table class="data-table" id="ordersTable">
                  <thead>
                    <tr>
                      <th style="width: 50px;">#</th>
                      <th>Customer Name</th>
                      <th>WhatsApp / Contact</th>
                      <th>Item Selected</th>
                      <th>Qty</th>
                      <th>Sizes Allocation</th>
                      <th>Payment</th>
                      <th>Status</th>
                      <th>Time</th>
                      <th style="text-align: right;">WhatsApp</th>
                    </tr>
                  </thead>
                  <tbody id="ordersTableBody">
                    <tr>
                      <td colspan="10" class="loading-cell">
                        <div class="table-loader">
                          <span class="spinner"></span>
                          <span>Loading live orders from Google Sheet Form Responses 1...</span>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="table-footer">
                <span id="ordersSummaryCount">Showing 0 orders</span>
                <span class="sync-pill-success">✓ 100% Real-Time Live Sync</span>
              </div>
            </div>

          </div>
        </div>

        <!-- ─────────────────────────────────────────────────────────────
             TAB 3: 📦 STOCK & CATALOG (VIEW ONLY)
             ───────────────────────────────────────────────────────────── -->
        <div class="tab-pane" id="paneStock">
          <div class="stock-shell">
            
            <div class="orders-head">
              <div>
                <h2 class="pane-title">Live Inventory &amp; Catalog (View Only)</h2>
                <p class="pane-subtitle">Read directly from <code>Inventory &amp; Availability</code> and <code>Sheet1</code>. View-only protection enabled.</p>
              </div>
              <div class="metrics-strip">
                <div class="mini-metric">
                  <span class="mm-label">Total Inventory</span>
                  <strong class="mm-val" id="metricTotalStock">1,850 Units</strong>
                </div>
                <div class="mini-metric">
                  <span class="mm-label">Total Booked</span>
                  <strong class="mm-val" id="metricTotalBooked">-- Units</strong>
                </div>
                <div class="mini-metric">
                  <span class="mm-label">Available Stock</span>
                  <strong class="mm-val text-green" id="metricTotalAvailable">-- Units</strong>
                </div>
              </div>
            </div>

            <!-- STOCK TABLE -->
            <div class="table-card">
              <div class="table-responsive">
                <table class="data-table" id="stockTable">
                  <thead>
                    <tr>
                      <th>Product Item</th>
                      <th>Category</th>
                      <th>Total Stock</th>
                      <th>Booked Units</th>
                      <th>Available Stock</th>
                      <th>Selling Price</th>
                      <th>Unit Cost</th>
                      <th>Status</th>
                      <th>Remaining %</th>
                    </tr>
                  </thead>
                  <tbody id="stockTableBody">
                    {CATALOG_ITEMS.map((item) => (
                      <tr>
                        <td>
                          <div class="product-cell">
                            <img src={item.image} alt={item.name} class="table-thumb" />
                            <strong>{item.name}</strong>
                          </div>
                        </td>
                        <td><span class="cat-tag">{item.category}</span></td>
                        <td><strong>{item.stock}</strong></td>
                        <td id={`live-booked-${item.id}`}>0</td>
                        <td><strong class="text-green" id={`live-avail-${item.id}`}>{item.stock}</strong></td>
                        <td><strong>₹{item.price}</strong></td>
                        <td class="text-muted">₹{item.cost}</td>
                        <td><span class="badge-stock in-stock">In Stock</span></td>
                        <td>
                          <div class="progress-bar-wrap">
                            <div class="progress-bar-fill" style="width: 100%;"></div>
                            <span>100%</span>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

          </div>
        </div>

      </main>

    </div>

    <!-- ═══════════════════════════════════════════════════════════
         INVOICE RECEIPT MODAL (View, Print, WhatsApp)
         ═══════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop" id="billModal" style="display: none;">
      <div class="modal-card">
        
        <div class="modal-header">
          <div>
            <h3 class="modal-title">Official Order Invoice</h3>
            <span class="modal-sub" id="modalInvoiceId">#GENM-0000</span>
          </div>
          <button type="button" class="btn-close" id="closeBillModalBtn">✕</button>
        </div>

        <div class="invoice-paper" id="invoicePaper">
          <div class="invoice-brand">
            <h2>GEN M SWAG &amp; MEMENTOS</h2>
            <p>Generational Student Confluence — MSM Kerala</p>
          </div>

          <div class="invoice-meta-grid">
            <div>
              <span class="meta-label">Billed To</span>
              <strong id="invCustName">Ameen Farhan</strong>
              <div id="invCustPhone">+91 9876543210</div>
            </div>
            <div style="text-align: right;">
              <span class="meta-label">Date &amp; Time</span>
              <div id="invDateTime">15 Oct 2026, 06:30 PM</div>
              <div class="inv-pay-badge" id="invPayBadge">Paid (UPI)</div>
            </div>
          </div>

          <hr class="inv-divider" />

          <table class="inv-table">
            <thead>
              <tr>
                <th>Item &amp; Details</th>
                <th style="text-align: center;">Qty</th>
                <th style="text-align: right;">Price</th>
                <th style="text-align: right;">Amount</th>
              </tr>
            </thead>
            <tbody id="invItemsBody">
              <!-- Dynamically rendered -->
            </tbody>
          </table>

          <hr class="inv-divider" />

          <div class="inv-total-row">
            <span>Grand Total</span>
            <strong id="invGrandTotal">₹0</strong>
          </div>

          <div class="inv-notes-box" id="invNotesBox" style="display: none;">
            <strong>Remarks:</strong> <span id="invNotesText"></span>
          </div>

          <div class="inv-footer">
            <p>Thank you for pre-booking with GEN M! Keep this receipt for collection.</p>
            <small>Directly synchronized with Google Sheet Form Responses 1</small>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" id="modalWhatsappBtn" class="btn-whatsapp-full">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824z"/></svg>
            <span>Send to Customer via WhatsApp</span>
          </button>
          <button type="button" id="modalPrintBtn" class="btn-outline">
            🖨️ Print Receipt
          </button>
          <button type="button" id="modalNextOrderBtn" class="btn-secondary">
            + Start Next Bill
          </button>
        </div>

      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         APPS SCRIPT RESOLVE MODAL (Guides user on "Anyone" setting)
         ═══════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop" id="appsScriptModal" style="display: none;">
      <div class="modal-card">
        <div class="modal-header">
          <h3 class="modal-title">⚡ Google Sheet Write Permissions</h3>
          <button type="button" class="btn-close" id="closeAppsScriptModalBtn">✕</button>
        </div>
        <div class="modal-content-pad">
          <p class="modal-desc">
            To allow your billing panel to write directly into <code>Form Responses 1</code>, your Google Apps Script Web App must be set to <strong>"Anyone"</strong> access.
          </p>

          <div class="steps-list">
            <div class="step-item">
              <span class="step-badge">1</span>
              <div>Open your Google Sheet: <a href={GOOGLE_SHEET_URL} target="_blank" class="link-bold">GEN M MEMENTOS 2 ↗</a></div>
            </div>
            <div class="step-item">
              <span class="step-badge">2</span>
              <div>Click <strong>Extensions</strong> &gt; <strong>Apps Script</strong></div>
            </div>
            <div class="step-item">
              <span class="step-badge">3</span>
              <div>Click <strong>Deploy</strong> (top right) &gt; <strong>Manage deployments</strong></div>
            </div>
            <div class="step-item">
              <span class="step-badge">4</span>
              <div>Click <strong>Edit (pencil icon)</strong> &gt; set <strong>Who has access: Anyone</strong> &gt; Click <strong>Deploy</strong></div>
            </div>
          </div>

          <div class="input-field" style="margin-top: 18px;">
            <label for="modalScriptUrl">Apps Script Web App URL</label>
            <input type="url" id="modalScriptUrl" placeholder="https://script.google.com/macros/s/.../exec" />
          </div>

          <div class="modal-row-btn">
            <button type="button" id="testScriptUrlBtn" class="btn-outline">Test Connection</button>
            <button type="button" id="saveScriptUrlBtn" class="btn-primary">Save &amp; Connect</button>
          </div>
          <div id="testScriptFeedback" class="test-feedback" style="display: none;"></div>
        </div>
      </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toast" class="toast"></div>

  </div>
</Layout>

<style>
  /* ─────────────────────────────────────────────────────────────
     LIGHT THEME DESIGN SYSTEM (Clean, Tactile, Modern)
     ───────────────────────────────────────────────────────────── */
  :root {
    --bg-page: #f8fafc;
    --bg-surface: #ffffff;
    --bg-subtle: #f1f5f9;
    --bg-hover: #e2e8f0;
    
    --border-light: #e2e8f0;
    --border-hover: #cbd5e1;
    --border-active: #10b981;

    --text-primary: #0f172a;
    --text-secondary: #475569;
    --text-muted: #94a3b8;

    --brand-emerald: #059669;
    --brand-emerald-hover: #047857;
    --brand-emerald-light: #ecfdf5;

    --brand-blue: #2563eb;
    --brand-indigo: #4f46e5;

    --brand-whatsapp: #25D366;
    --brand-whatsapp-hover: #20bd5a;

    --danger: #ef4444;
    --danger-light: #fef2f2;

    --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
    --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.06);
    --shadow-lg: 0 10px 25px -5px rgba(15, 23, 42, 0.08);

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-full: 9999px;
  }

  body {
    background-color: var(--bg-page);
    color: var(--text-primary);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  * {
    box-sizing: border-box;
  }

  /* ─────────────────────────────────────────────────────────────
     TOP NAVIGATION
     ───────────────────────────────────────────────────────────── */
  .top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-light);
    padding: 12px 24px;
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--shadow-sm);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-title {
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.5px;
  }

  .brand-tag {
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--bg-subtle);
    color: var(--text-secondary);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.5px;
  }

  .sheet-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--brand-emerald-light);
    color: var(--brand-emerald);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    text-decoration: none;
    border: 1px solid rgba(16, 185, 129, 0.2);
    transition: all 0.15s ease;
  }

  .sheet-indicator:hover {
    background: #d1fae5;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background: var(--brand-emerald);
    border-radius: 50%;
    animation: pulseGlow 1.8s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* TABS */
  .nav-tabs {
    display: flex;
    background: var(--bg-subtle);
    padding: 4px;
    border-radius: var(--radius-md);
    gap: 4px;
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tab-btn:hover {
    color: var(--text-primary);
  }

  .tab-btn.active {
    background: var(--bg-surface);
    color: var(--text-primary);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  }

  .tab-badge {
    background: var(--border-light);
    color: var(--text-primary);
    font-size: 0.72rem;
    padding: 2px 7px;
    border-radius: var(--radius-full);
  }

  .tab-pill-light {
    font-size: 0.7rem;
    font-weight: 600;
    background: #e2e8f0;
    color: var(--text-secondary);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-outline-sm {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    font-size: 0.8rem;
    font-weight: 600;
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-outline-sm:hover {
    background: var(--bg-subtle);
    color: var(--text-primary);
  }

  .btn-ghost-sm {
    padding: 7px 12px;
    font-size: 0.8rem;
    font-weight: 500;
    background: transparent;
    color: var(--text-muted);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .btn-ghost-sm:hover {
    color: var(--danger);
  }

  /* ─────────────────────────────────────────────────────────────
     SYNC ALERT BANNER
     ───────────────────────────────────────────────────────────── */
  .sync-alert-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fffbeb;
    border-bottom: 1px solid #fde68a;
    padding: 10px 24px;
    font-size: 0.85rem;
    color: #92400e;
  }

  .sync-alert-content {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-banner-action {
    background: #fef3c7;
    border: 1px solid #f59e0b;
    color: #b45309;
    padding: 4px 12px;
    font-size: 0.78rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .btn-banner-action:hover {
    background: #fde68a;
  }

  /* ─────────────────────────────────────────────────────────────
     MAIN LAYOUT & TABS
     ───────────────────────────────────────────────────────────── */
  .main-content {
    padding: 24px;
    max-width: 1600px;
    margin: 0 auto;
  }

  .tab-pane {
    display: none;
  }

  .tab-pane.active {
    display: block;
  }

  /* ─────────────────────────────────────────────────────────────
     TAB 1: POS BILLING GRID
     ───────────────────────────────────────────────────────────── */
  .pos-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 24px;
    align-items: start;
  }

  .catalog-header {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: var(--shadow-sm);
  }

  .pane-title {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1.35rem;
    margin: 0 0 4px 0;
    color: var(--text-primary);
  }

  .pane-subtitle {
    margin: 0 0 16px 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
  }

  .filter-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .category-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .cat-pill {
    padding: 6px 14px;
    background: var(--bg-subtle);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .cat-pill:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .cat-pill.active {
    background: var(--brand-emerald-light);
    color: var(--brand-emerald);
    border-color: rgba(16, 185, 129, 0.3);
  }

  .search-box input {
    padding: 8px 14px;
    font-size: 0.85rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    outline: none;
    width: 220px;
    transition: border 0.15s ease;
  }

  .search-box input:focus {
    border-color: var(--brand-emerald);
  }

  /* ─────────────────────────────────────────────────────────────
     BIG PRODUCT CARDS GRID
     ───────────────────────────────────────────────────────────── */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 18px;
  }

  .product-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: all 0.18s ease;
  }

  .product-card:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .product-card.has-items {
    border-color: var(--brand-emerald);
    box-shadow: 0 4px 16px rgba(16, 185, 129, 0.12);
  }

  .card-media {
    position: relative;
    height: 160px;
    background: #f1f5f9;
    overflow: hidden;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .card-media img {
    transform: scale(1.03);
  }

  .card-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(4px);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-secondary);
    padding: 3px 8px;
    border-radius: var(--radius-full);
  }

  .card-stock {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(15, 23, 42, 0.75);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: var(--radius-full);
  }

  .card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }

  .card-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .card-title {
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
  }

  .card-price {
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--brand-emerald);
  }

  /* STANDARD ITEM STEPPER (BIG BUTTONS) */
  .std-stepper-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 4px;
    margin-top: 8px;
  }

  .btn-big-step {
    width: 48px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    font-weight: 700;
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    cursor: pointer;
    user-select: none;
    transition: all 0.12s ease;
  }

  .btn-big-step:hover {
    background: var(--text-primary);
    color: #ffffff;
    border-color: var(--text-primary);
  }

  .btn-big-step:active {
    transform: scale(0.94);
  }

  .big-qty-display {
    font-family: 'Poppins', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    min-width: 40px;
    text-align: center;
  }

  .product-card.has-items .big-qty-display {
    color: var(--brand-emerald);
  }

  /* T-SHIRT CARD & SIZES STEPPER */
  .card-tshirt {
    grid-column: span 2;
  }

  @media (max-width: 900px) {
    .card-tshirt {
      grid-column: span 1;
    }
  }

  .tshirt-stepper-box {
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    margin-top: 6px;
  }

  .sizes-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .sub-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .sizes-total-badge {
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--brand-emerald-light);
    color: var(--brand-emerald);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .sizes-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }

  .size-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    padding: 6px 4px;
  }

  .size-tag {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--text-secondary);
    margin-bottom: 4px;
  }

  .size-controls {
    display: flex;
    align-items: center;
    gap: 4px;
    width: 100%;
    justify-content: center;
  }

  .btn-step {
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-radius: 4px;
    cursor: pointer;
    color: var(--text-primary);
    transition: all 0.1s ease;
  }

  .btn-step:hover {
    background: var(--brand-emerald);
    color: #ffffff;
    border-color: var(--brand-emerald);
  }

  .btn-step:active {
    transform: scale(0.9);
  }

  .size-val {
    font-size: 0.9rem;
    font-weight: 800;
    min-width: 18px;
    text-align: center;
    color: var(--text-primary);
  }

  /* ─────────────────────────────────────────────────────────────
     RIGHT: STICKY BILLING / CART PANEL
     ───────────────────────────────────────────────────────────── */
  .pos-cart-panel {
    position: sticky;
    top: 80px;
  }

  .cart-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .cart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border-light);
  }

  .cart-head-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cart-head-title h2 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }

  .btn-text-danger {
    background: transparent;
    border: none;
    color: var(--danger);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-text-danger:hover {
    text-decoration: underline;
  }

  /* CUSTOMER SECTION */
  .customer-section {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .input-group label {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 4px;
  }

  .req {
    color: var(--danger);
  }

  .whatsapp-hint {
    color: var(--brand-emerald);
    font-weight: 600;
  }

  .cart-input {
    width: 100%;
    padding: 9px 12px;
    font-size: 0.88rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    outline: none;
    transition: border 0.15s ease;
  }

  .cart-input:focus {
    border-color: var(--brand-emerald);
  }

  .phone-input-wrap {
    display: flex;
    align-items: center;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .phone-input-wrap:focus-within {
    border-color: var(--brand-emerald);
  }

  .phone-input-wrap .prefix {
    background: var(--bg-subtle);
    padding: 9px 12px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-secondary);
    border-right: 1px solid var(--border-light);
  }

  .phone-input-wrap input {
    border: none;
    padding: 9px 12px;
    font-size: 0.88rem;
    width: 100%;
    outline: none;
  }

  /* CART ITEMS */
  .cart-items-wrap {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border-light);
    max-height: 240px;
    overflow-y: auto;
  }

  .cart-items-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .cart-empty-state {
    text-align: center;
    padding: 24px 10px;
    color: var(--text-muted);
  }

  .empty-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 6px;
  }

  .cart-empty-state p {
    margin: 0;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .cart-empty-state small {
    font-size: 0.78rem;
  }

  .cart-item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px dashed var(--border-light);
  }

  .cart-item-row:last-child {
    border-bottom: none;
  }

  .cir-info strong {
    font-size: 0.88rem;
    display: block;
    color: var(--text-primary);
  }

  .cir-info small {
    font-size: 0.75rem;
    color: var(--brand-emerald);
    font-weight: 600;
  }

  .cir-pricing {
    text-align: right;
  }

  .cir-pricing .cir-line-total {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-primary);
  }

  .cir-pricing small {
    font-size: 0.72rem;
    color: var(--text-muted);
    display: block;
  }

  /* SUMMARY & PAYMENT */
  .cart-summary {
    padding: 16px 20px;
    background: #fafafa;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }

  .pay-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
    display: block;
    margin: 12px 0 6px 0;
    text-transform: uppercase;
  }

  .pay-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-bottom: 14px;
