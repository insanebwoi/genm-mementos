      document.getElementById('editRowNumber').value = record.rowNumber;
      editRowNumberBadge.textContent = `Row #${record.rowNumber}`;

      document.getElementById('editName').value = record.name || '';
      document.getElementById('editPhone').value = record.phone || '';
      document.getElementById('editEmail').value = record.email || '';
      editItem.value = record.item || 'White T-Shirt';
      editQty.value = record.qty || '1';
      document.getElementById('editBookingStatus').value = record.bookingStatus || 'Pending';
      document.getElementById('editPaymentStatus').value = record.paymentStatus || 'Pending';
      document.getElementById('editNotes').value = record.notes || '';

      editSizeS.value = record.sizeS || 0;
      editSizeM.value = record.sizeM || 0;
      editSizeL.value = record.sizeL || 0;
      editSizeXL.value = record.sizeXL || 0;
      editSizeXXL.value = record.sizeXXL || 0;

      editSizeMatrixPanel.style.display = editItem.value === 'White T-Shirt' ? 'flex' : 'none';
      updateEditSizeMatrix();

      editModal.style.display = 'flex';
