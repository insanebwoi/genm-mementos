<script is:inline>
  /**
   * GEN M Swag Operations & Google Sheets Controller
   * Sheet ID: 1foGWm9i_5DhBUjocJDxs84jWCLdc-U1BJaN7r0KuhiA
   */
  (function () {
    const API_BASE = 'http://localhost:5050';
    const TOKEN_KEY = 'genm_dashboard_jwt_token';
    const USER_KEY = 'genm_dashboard_user';

    let authToken = localStorage.getItem(TOKEN_KEY) || sessionStorage.getItem(TOKEN_KEY) || null;
    let currentUser = JSON.parse(localStorage.getItem(USER_KEY) || sessionStorage.getItem(USER_KEY) || 'null');
    let allRecords = [];
    let currentDeleteRow = null;
    let isFlushingQueue = false;
    const OFFLINE_QUEUE_KEY = 'genm_offline_bookings_queue';

    // Offline Storage Queue Helpers
    function getOfflineQueue() {
      try {
        return JSON.parse(localStorage.getItem(OFFLINE_QUEUE_KEY) || '[]');
      } catch (e) {
        return [];
      }
    }

    function saveOfflineQueue(queue) {
      try {
        localStorage.setItem(OFFLINE_QUEUE_KEY, JSON.stringify(queue));
      } catch (e) {}
      updateOfflineUI();
    }

    function updateOfflineUI() {
      const queue = getOfflineQueue();
      const count = queue.length;
      const isOnline = navigator.onLine;

      const qbPushBtn = document.getElementById('qbOfflinePushBtn');
      const qbCountText = document.getElementById('qbOfflineCountText');
      const qbSyncStatusText = document.getElementById('qbSyncStatusText');
      const qbSyncDot = document.getElementById('qbSyncDot');

      const topbarPushBtn = document.getElementById('topbarOfflineBtn');
      const topbarCount = document.getElementById('topbarOfflineCount');
      const statusDot = document.getElementById('statusDot');
      const statusLabel = document.getElementById('statusLabel');

      if (qbCountText) qbCountText.textContent = `${count} Offline Booking${count === 1 ? '' : 's'}`;
      if (topbarCount) topbarCount.textContent = `${count} Offline`;

      if (qbPushBtn) qbPushBtn.style.display = count > 0 ? 'inline-flex' : 'none';
      if (topbarPushBtn) topbarPushBtn.style.display = count > 0 ? 'inline-flex' : 'none';

      if (!isOnline) {
        if (qbSyncStatusText) qbSyncStatusText.textContent = `Form Responses 1 • Offline (${count} queued)`;
        if (qbSyncDot) qbSyncDot.className = 'status-indicator-dot dot-offline';
        if (statusLabel) statusLabel.textContent = `Offline Mode (${count} queued)`;
        if (statusDot) statusDot.className = 'status-indicator-dot dot-offline';
      } else if (count > 0) {
        if (qbSyncStatusText) qbSyncStatusText.textContent = `Form Responses 1 • ${count} syncing to Sheet...`;
