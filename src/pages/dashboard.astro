<script is:inline>
  (function () {
    const API_BASE = 'http://localhost:5050';

    // ─────────────────────────────────────────────────────────────
    // STATE
    // ─────────────────────────────────────────────────────────────
    let authToken = localStorage.getItem('gen_m_auth_token') || '';
    let cart = []; // Array of items: { id, name, price, qty, isTshirt, sizes: { S: 0, M: 0, ... } }
    let allOrders = []; // Rows from Form Responses 1
    let lastGeneratedBill = null; // Store last bill for WhatsApp/Print

    // Products catalog reference
    const CATALOG = [
      { id: 'white-tshirt', name: 'White T-Shirt', category: 'Apparel', price: 449, isTshirt: true },
      { id: 'cap', name: 'Embroidered Cap', category: 'Apparel', price: 180, isTshirt: false },
      { id: 'cross-bag', name: 'Cross Bag', category: 'Accessories', price: 180, isTshirt: false },
      { id: 'water-bottle', name: 'Water Bottle', category: 'Drinkware', price: 350, isTshirt: false },
      { id: 'coffee-mug', name: 'Coffee Mug', category: 'Drinkware', price: 180, isTshirt: false },
      { id: 'diary', name: 'Diary', category: 'Stationery', price: 150, isTshirt: false },
      { id: 'pen', name: 'Pen', category: 'Stationery', price: 20, isTshirt: false },
      { id: 'keychain', name: 'Keychain', category: 'Accessories', price: 25, isTshirt: false },
      { id: 'bag-tag', name: 'Bag Tag', category: 'Accessories', price: 50, isTshirt: false },
      { id: 'glass-set', name: 'Glass Set', category: 'Drinkware', price: 200, isTshirt: false },
      { id: 'mobile-stand', name: 'Mobile Stand', category: 'Accessories', price: 199, isTshirt: false },
      { id: 'tissue', name: 'Tissue', category: 'Accessories', price: 79, isTshirt: false },
      { id: 'car-perfume', name: 'Car Perfume', category: 'Accessories', price: 40, isTshirt: false }
    ];

    // White T-shirt sizes state
    const tshirtSizes = { S: 0, M: 0, L: 0, XL: 0, XXL: 0 };

    // Standard items quantity map
    const stdQuantities = {};
    CATALOG.forEach(c => { if (!c.isTshirt) stdQuantities[c.id] = 0; });

    // ─────────────────────────────────────────────────────────────
    // AUTHENTICATION
    // ─────────────────────────────────────────────────────────────
    const authSection = document.getElementById('authSection');
    const mainSection = document.getElementById('mainSection');
    const loginForm = document.getElementById('loginForm');
    const authError = document.getElementById('authError');
    const logoutBtn = document.getElementById('logoutBtn');

    async function checkAuth() {
      if (!authToken) {
        showLogin();
        return;
      }
      try {
        const resp = await fetch(`${API_BASE}/api/auth/verify`, {
          headers: { Authorization: `Bearer ${authToken}` }
        });
        if (resp.ok) {
          showApp();
          initApp();
        } else {
          showLogin();
        }
      } catch (err) {
        // If server is starting, allow local interface
        showApp();
        initApp();
      }
    }

    function showLogin() {
      if (authSection) authSection.style.display = 'flex';
      if (mainSection) mainSection.style.display = 'none';
    }

    function showApp() {
      if (authSection) authSection.style.display = 'none';
      if (mainSection) mainSection.style.display = 'block';
    }

    loginForm?.addEventListener('submit', async () => {
      const u = document.getElementById('authUsername')?.value.trim();
      const p = document.getElementById('authPassword')?.value.trim();
      if (!u || !p) return;

      try {
        const resp = await fetch(`${API_BASE}/api/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: u, password: p })
        });
        const data = await resp.json();
        if (resp.ok && data.token) {
          authToken = data.token;
          localStorage.setItem('gen_m_auth_token', authToken);
          showApp();
          initApp();
        } else {
          if (authError) {
            authError.style.display = 'block';
            authError.textContent = data.error || 'Invalid username or password.';
          }
        }
      } catch (err) {
        if (authError) {
          authError.style.display = 'block';
          authError.textContent = 'Server offline or error connecting.';
        }
      }
    });

    logoutBtn?.addEventListener('click', () => {
      authToken = '';
      localStorage.removeItem('gen_m_auth_token');
      showLogin();
    });

    // ─────────────────────────────────────────────────────────────
    // TABS SWITCHING
    // ─────────────────────────────────────────────────────────────
    const tabButtons = document.querySelectorAll('.tab-btn');
    const panes = {
      billing: document.getElementById('paneBilling'),
      orders: document.getElementById('paneOrders'),
      stock: document.getElementById('paneStock')
    };

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        tabButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        Object.keys(panes).forEach(k => {
          if (panes[k]) panes[k].classList.remove('active');
        });
        if (panes[tab]) panes[tab].classList.add('active');

        if (tab === 'orders') fetchOrders();
        if (tab === 'stock') fetchStock();
      });
    });

    // ─────────────────────────────────────────────────────────────
    // PRODUCT SELECTION & BIG CARDS LOGIC
    // ─────────────────────────────────────────────────────────────
    
    // T-Shirt Sizes Stepper (+ / -)
    document.querySelectorAll('.btn-step').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const sz = btn.getAttribute('data-size');
        const isPlus = btn.classList.contains('size-plus');

        if (isPlus) {
          tshirtSizes[sz] = (tshirtSizes[sz] || 0) + 1;
        } else {
          tshirtSizes[sz] = Math.max(0, (tshirtSizes[sz] || 0) - 1);
        }

        // Update UI
        const valElem = document.getElementById(`val-size-${sz}`);
        if (valElem) valElem.textContent = String(tshirtSizes[sz]);

        const totalTshirts = Object.values(tshirtSizes).reduce((a, b) => a + b, 0);
        const badge = document.getElementById('tshirtTotalBadge');
        if (badge) badge.textContent = `${totalTshirts} Selected`;

        const tshirtCard = document.querySelector('.card-tshirt');
        if (tshirtCard) {
          if (totalTshirts > 0) tshirtCard.classList.add('has-items');
          else tshirtCard.classList.remove('has-items');
        }

        syncCart();
      });
    });

    // Standard Items Stepper (+ / -)
    document.querySelectorAll('.btn-big-step').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        const isPlus = btn.classList.contains('item-plus');

        if (isPlus) {
          stdQuantities[id] = (stdQuantities[id] || 0) + 1;
        } else {
          stdQuantities[id] = Math.max(0, (stdQuantities[id] || 0) - 1);
        }

        // Update card display
        const display = document.getElementById(`qty-${id}`);
        if (display) display.textContent = String(stdQuantities[id]);

        const card = document.querySelector(`.product-card[data-id="${id}"]`);
        if (card) {
          if (stdQuantities[id] > 0) card.classList.add('has-items');
          else card.classList.remove('has-items');
        }

        syncCart();
      });
    });

    // Category Filtering
    document.querySelectorAll('.cat-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const cat = pill.getAttribute('data-cat');
        filterCards(cat, document.getElementById('catalogSearch')?.value.trim());
      });
    });

    document.getElementById('catalogSearch')?.addEventListener('input', (e) => {
      const activeCat = document.querySelector('.cat-pill.active')?.getAttribute('data-cat') || 'all';
      filterCards(activeCat, e.target.value.trim());
    });

    function filterCards(category, query) {
      const q = (query || '').toLowerCase();
      document.querySelectorAll('.product-card').forEach(card => {
        const itemCat = card.getAttribute('data-category');
        const itemName = card.getAttribute('data-name')?.toLowerCase() || '';

        const catMatch = category === 'all' || itemCat === category;
        const queryMatch = !q || itemName.includes(q);

        if (catMatch && queryMatch) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // ─────────────────────────────────────────────────────────────
    // CART & BILLING ENGINE
    // ─────────────────────────────────────────────────────────────
    function syncCart() {
      cart = [];

      // 1. Check T-Shirt
      const totalTshirts = Object.values(tshirtSizes).reduce((a, b) => a + b, 0);
      if (totalTshirts > 0) {
        cart.push({
          id: 'white-tshirt',
          name: 'White T-Shirt',
          price: 449,
          qty: totalTshirts,
          isTshirt: true,
          sizes: { ...tshirtSizes }
        });
      }

      // 2. Check Standard Items
      CATALOG.forEach(item => {
        if (!item.isTshirt && stdQuantities[item.id] > 0) {
          cart.push({
            id: item.id,
            name: item.name,
            price: item.price,
            qty: stdQuantities[item.id],
            isTshirt: false
          });
        }
      });

      renderCartUI();
    }

    function renderCartUI() {
      const listElem = document.getElementById('cartItemsList');
      const emptyElem = document.getElementById('cartEmptyState');
      const countLabel = document.getElementById('cartCountLabel');
      const subtotalElem = document.getElementById('billSubtotal');
      const unitsElem = document.getElementById('billTotalUnits');
      const grandTotalElem = document.getElementById('billGrandTotal');
      const checkoutBtn = document.getElementById('generateBillBtn');
      const whatsappBtn = document.getElementById('shareWhatsappDirectBtn');

      if (!listElem) return;

      if (cart.length === 0) {
        listElem.innerHTML = '';
        if (emptyElem) listElem.appendChild(emptyElem);
        if (countLabel) countLabel.textContent = '0 items';
        if (subtotalElem) subtotalElem.textContent = '₹0';
        if (unitsElem) unitsElem.textContent = '0 units';
        if (grandTotalElem) grandTotalElem.textContent = '₹0';
        if (checkoutBtn) checkoutBtn.disabled = true;
        if (whatsappBtn) whatsappBtn.disabled = true;
        return;
      }

      let totalUnits = 0;
      let grandTotal = 0;

      let html = '';
      cart.forEach(item => {
        const lineTotal = item.qty * item.price;
        totalUnits += item.qty;
        grandTotal += lineTotal;

        let details = '';
        if (item.isTshirt) {
          const parts = [];
          Object.keys(item.sizes).forEach(sz => {
            if (item.sizes[sz] > 0) parts.push(`${item.sizes[sz]}x ${sz}`);
          });
          details = parts.join(', ');
        }

        html += `
          <div class="cart-item-row">
            <div class="cir-info">
              <strong>${escapeHtml(item.name)}</strong>
              ${details ? `<small>Sizes: ${escapeHtml(details)}</small>` : ''}
            </div>
            <div class="cir-pricing">
              <span class="cir-line-total">₹${lineTotal}</span>
              <small>${item.qty} × ₹${item.price}</small>
            </div>
          </div>
        `;
      });

      listElem.innerHTML = html;
      if (countLabel) countLabel.textContent = `${cart.length} item${cart.length > 1 ? 's' : ''}`;
      if (subtotalElem) subtotalElem.textContent = `₹${grandTotal}`;
      if (unitsElem) unitsElem.textContent = `${totalUnits} unit${totalUnits > 1 ? 's' : ''}`;
      if (grandTotalElem) grandTotalElem.textContent = `₹${grandTotal}`;

      const nameValid = Boolean(document.getElementById('custName')?.value.trim());
      const phoneValid = Boolean(document.getElementById('custPhone')?.value.trim());

      if (checkoutBtn) checkoutBtn.disabled = cart.length === 0;
      if (whatsappBtn) whatsappBtn.disabled = cart.length === 0 || !phoneValid;
    }

    // Reset bill / Clear button
    document.getElementById('clearCartBtn')?.addEventListener('click', () => {
      resetBillingForm();
      showToast('Bill reset to 0');
    });

    function resetBillingForm() {
      // Reset T-shirt sizes
      Object.keys(tshirtSizes).forEach(sz => {
        tshirtSizes[sz] = 0;
        const elem = document.getElementById(`val-size-${sz}`);
        if (elem) elem.textContent = '0';
      });
      const badge = document.getElementById('tshirtTotalBadge');
      if (badge) badge.textContent = '0 Selected';

      // Reset standard items
      CATALOG.forEach(c => {
        if (!c.isTshirt) {
          stdQuantities[c.id] = 0;
          const elem = document.getElementById(`qty-${c.id}`);
          if (elem) elem.textContent = '0';
        }
      });

      document.querySelectorAll('.product-card').forEach(c => c.classList.remove('has-items'));

      // Reset inputs
      const nameInput = document.getElementById('custName');
      const phoneInput = document.getElementById('custPhone');
      const notesInput = document.getElementById('custNotes');
      if (nameInput) nameInput.value = '';
      if (phoneInput) phoneInput.value = '';
      if (notesInput) notesInput.value = '';

      cart = [];
      renderCartUI();
    }

    // Real-time phone check to enable WhatsApp button
    document.getElementById('custPhone')?.addEventListener('input', () => {
      const phoneValid = Boolean(document.getElementById('custPhone')?.value.trim());
      const whatsappBtn = document.getElementById('shareWhatsappDirectBtn');
      if (whatsappBtn) whatsappBtn.disabled = cart.length === 0 || !phoneValid;
    });

    // ─────────────────────────────────────────────────────────────
    // GENERATE BILL & PUSH DIRECTLY TO FORM RESPONSES 1
    // ─────────────────────────────────────────────────────────────
    const generateBillBtn = document.getElementById('generateBillBtn');
    const billFeedback = document.getElementById('billFeedback');

    generateBillBtn?.addEventListener('click', async () => {
      const custName = document.getElementById('custName')?.value.trim();
      const custPhone = document.getElementById('custPhone')?.value.trim();
      const custNotes = document.getElementById('custNotes')?.value.trim() || '';
      const payMethod = document.querySelector('input[name="payMethod"]:checked')?.value || 'Paid (UPI)';

      if (!custName) {
        showToast('⚠️ Please enter Customer Name');
        document.getElementById('custName')?.focus();
        return;
      }

      if (!custPhone) {
        showToast('⚠️ Please enter WhatsApp / Phone Number');
        document.getElementById('custPhone')?.focus();
        return;
      }

      if (cart.length === 0) {
        showToast('⚠️ Please add at least 1 item to the bill');
        return;
      }

      generateBillBtn.disabled = true;
      generateBillBtn.querySelector('.btn-main-text').textContent = '⚡ Pushing to Form Responses 1...';

      // Prepare invoice reference
      const invoiceRef = 'GENM-' + Math.floor(1000 + Math.random() * 9000);
      const nowIso = new Date().toISOString();

      // Collect data to push to Form Responses 1
      // If order has T-Shirt, format row according to Form Responses 1 headers
      // (Timestamp, Customer Name, Contact Number, Email Address, Item Selected, Quantity Booked,
      //  Booking Status, Payment Status, Notes & Remarks, Size S, Size M, Size L, Size XL, Size XXL, Size Allocation Status, Sizes Selected Summary)
      
      const tShirtItem = cart.find(i => i.isTshirt);
      const otherItems = cart.filter(i => !i.isTshirt);

      // We will write the primary item or each item to Form Responses 1
      const writesToPerform = [];

      if (tShirtItem) {
        const s = tShirtItem.sizes.S || 0;
        const m = tShirtItem.sizes.M || 0;
        const l = tShirtItem.sizes.L || 0;
        const xl = tShirtItem.sizes.XL || 0;
        const xxl = tShirtItem.sizes.XXL || 0;
        const sizeSum = s + m + l + xl + xxl;

        const sizeParts = [];
        if (s > 0) sizeParts.push(`${s}x S`);
        if (m > 0) sizeParts.push(`${m}x M`);
        if (l > 0) sizeParts.push(`${l}x L`);
        if (xl > 0) sizeParts.push(`${xl}x XL`);
        if (xxl > 0) sizeParts.push(`${xxl}x XXL`);

        writesToPerform.push({
          name: custName,
          phone: custPhone,
          item: 'White T-Shirt',
          qty: sizeSum,
          bookingStatus: 'Confirmed',
          paymentStatus: payMethod,
          notes: custNotes ? `${custNotes} | Inv: ${invoiceRef}` : `Inv: ${invoiceRef}`,
          sizeS: s,
          sizeM: m,
          sizeL: l,
          sizeXL: xl,
          sizeXXL: xxl
        });
      }

      // Other merchandise items
      otherItems.forEach(oi => {
        writesToPerform.push({
          name: custName,
          phone: custPhone,
          item: oi.name,
          qty: oi.qty,
          bookingStatus: 'Confirmed',
          paymentStatus: payMethod,
          notes: custNotes ? `${custNotes} | Inv: ${invoiceRef}` : `Inv: ${invoiceRef}`,
          sizeS: 0,
          sizeM: 0,
          sizeL: 0,
          sizeXL: 0,
          sizeXXL: 0
        });
      });

      try {
        let allSuccess = true;
        let lastRespData = null;

        for (const payload of writesToPerform) {
          const resp = await fetch(`${API_BASE}/api/data`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${authToken}`
            },
            body: JSON.stringify(payload)
          });
          if (resp.ok) {
            lastRespData = await resp.json();
          } else {
            allSuccess = false;
          }
        }

        // Store invoice state for WhatsApp and Print
        lastGeneratedBill = {
          ref: invoiceRef,
          customerName: custName,
          phone: custPhone,
          notes: custNotes,
          payment: payMethod,
          timestamp: new Date().toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }),
          items: JSON.parse(JSON.stringify(cart)),
          grandTotal: cart.reduce((sum, item) => sum + (item.qty * item.price), 0)
        };

        showToast(`✓ Order for ${custName} saved to Form Responses 1!`);
        openInvoiceModal(lastGeneratedBill);

        // Refresh orders table in background
        fetchOrders(false);

      } catch (err) {
        showToast('⚠️ Network notice: Order queued locally.');
      } finally {
        generateBillBtn.disabled = false;
        generateBillBtn.querySelector('.btn-main-text').textContent = '⚡ Complete Bill & Push to Sheet';
      }
    });

    // ─────────────────────────────────────────────────────────────
    // INVOICE RECEIPT MODAL & WHATSAPP GENERATOR
    // ─────────────────────────────────────────────────────────────
    const billModal = document.getElementById('billModal');
    const closeBillModalBtn = document.getElementById('closeBillModalBtn');
    const modalWhatsappBtn = document.getElementById('modalWhatsappBtn');
    const modalPrintBtn = document.getElementById('modalPrintBtn');
    const modalNextOrderBtn = document.getElementById('modalNextOrderBtn');
    const shareWhatsappDirectBtn = document.getElementById('shareWhatsappDirectBtn');

    function openInvoiceModal(bill) {
      if (!bill) return;

      document.getElementById('modalInvoiceId').textContent = `#${bill.ref}`;
      document.getElementById('invCustName').textContent = bill.customerName;
      document.getElementById('invCustPhone').textContent = `+91 ${bill.phone}`;
      document.getElementById('invDateTime').textContent = bill.timestamp;
      document.getElementById('invPayBadge').textContent = bill.payment;
      document.getElementById('invGrandTotal').textContent = `₹${bill.grandTotal}`;

      const notesBox = document.getElementById('invNotesBox');
      const notesText = document.getElementById('invNotesText');
      if (bill.notes && notesBox && notesText) {
        notesBox.style.display = 'block';
        notesText.textContent = bill.notes;
      } else if (notesBox) {
        notesBox.style.display = 'none';
      }

      // Populate item rows
      const tbody = document.getElementById('invItemsBody');
      if (tbody) {
        let html = '';
        bill.items.forEach(item => {
          let desc = escapeHtml(item.name);
          if (item.isTshirt) {
            const parts = [];
            Object.keys(item.sizes).forEach(sz => {
              if (item.sizes[sz] > 0) parts.push(`${item.sizes[sz]}x ${sz}`);
            });
            desc += `<br><small style="color: #64748b;">${parts.join(', ')}</small>`;
          }
          html += `
            <tr>
              <td>${desc}</td>
              <td style="text-align: center;">${item.qty}</td>
              <td style="text-align: right;">₹${item.price}</td>
              <td style="text-align: right; font-weight: 700;">₹${item.qty * item.price}</td>
            </tr>
          `;
        });
        tbody.innerHTML = html;
      }

      if (billModal) billModal.style.display = 'flex';
    }

    closeBillModalBtn?.addEventListener('click', () => {
      if (billModal) billModal.style.display = 'none';
    });

    modalNextOrderBtn?.addEventListener('click', () => {
      if (billModal) billModal.style.display = 'none';
      resetBillingForm();
      document.getElementById('custName')?.focus();
    });

    modalPrintBtn?.addEventListener('click', () => {
      window.print();
    });

    // WHATSAPP SHARE GENERATOR
    function generateWhatsAppMessage(bill) {
      const cleanPhone = (bill.phone || '').replace(/[^0-9]/g, '');
      const targetPhone = cleanPhone.length === 10 ? `91${cleanPhone}` : cleanPhone;

      let msg = `✨ *GEN M MEMENTOS 2026 — OFFICIAL INVOICE* ✨\n`;
      msg += `━━━━━━━━━━━━━━━━━━━━━\n`;
      msg += `👤 *Customer:* ${bill.customerName}\n`;
      msg += `📱 *Phone:* +91 ${bill.phone}\n`;
      msg += `📅 *Date:* ${bill.timestamp}\n`;
      msg += `🔖 *Invoice #:* ${bill.ref}\n`;
      msg += `━━━━━━━━━━━━━━━━━━━━━\n`;
      msg += `📦 *ITEMS ORDERED:*\n`;

      bill.items.forEach(item => {
        let line = `• ${item.qty}x *${item.name}*`;
        if (item.isTshirt) {
          const parts = [];
          Object.keys(item.sizes).forEach(sz => {
            if (item.sizes[sz] > 0) parts.push(`${item.sizes[sz]}x ${sz}`);
          });
          line += ` (${parts.join(', ')})`;
        }
        line += ` @ ₹${item.price} = ₹${item.qty * item.price}`;
        msg += `${line}\n`;
      });

      msg += `━━━━━━━━━━━━━━━━━━━━━\n`;
      msg += `💰 *GRAND TOTAL:* *₹${bill.grandTotal}*\n`;
      msg += `💳 *PAYMENT STATUS:* ${bill.payment}\n`;
      if (bill.notes) {
        msg += `📝 *Remarks:* ${bill.notes}\n`;
      }
      msg += `━━━━━━━━━━━━━━━━━━━━━\n`;
      msg += `🌟 *Thank you for celebrating with Gen M!*\n`;
      msg += `📍 *Collect at:* Gen M Swag Counter, Kozhikode Campus\n`;
      msg += `_This receipt is backed by Google Sheets Form Responses 1._`;

      return {
        url: `https://api.whatsapp.com/send?phone=${targetPhone}&text=${encodeURIComponent(msg)}`,
        phone: targetPhone
      };
    }

    modalWhatsappBtn?.addEventListener('click', () => {
      if (!lastGeneratedBill) return;
      const { url } = generateWhatsAppMessage(lastGeneratedBill);
      window.open(url, '_blank');
    });

    shareWhatsappDirectBtn?.addEventListener('click', () => {
      const custName = document.getElementById('custName')?.value.trim() || 'Customer';
      const custPhone = document.getElementById('custPhone')?.value.trim() || '';
      const payMethod = document.querySelector('input[name="payMethod"]:checked')?.value || 'Paid (UPI)';
      const custNotes = document.getElementById('custNotes')?.value.trim() || '';

      const draftBill = {
        ref: 'GENM-' + Math.floor(1000 + Math.random() * 9000),
        customerName: custName,
        phone: custPhone,
        notes: custNotes,
        payment: payMethod,
        timestamp: new Date().toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }),
        items: JSON.parse(JSON.stringify(cart)),
        grandTotal: cart.reduce((sum, item) => sum + (item.qty * item.price), 0)
      };

      const { url } = generateWhatsAppMessage(draftBill);
      window.open(url, '_blank');
    });

    // ─────────────────────────────────────────────────────────────
    // TAB 2: LIVE ORDERS FROM FORM RESPONSES 1
    // ─────────────────────────────────────────────────────────────
    async function fetchOrders(showToastNotice = false) {
      const tbody = document.getElementById('ordersTableBody');
      const countElem = document.getElementById('tabOrdersCount');
      const summaryElem = document.getElementById('ordersSummaryCount');

      try {
        const resp = await fetch(`${API_BASE}/api/data`, {
          headers: { Authorization: `Bearer ${authToken}` }
        });
        if (!resp.ok) return;

        const data = await resp.json();
        const records = data.records || [];
        allOrders = records;

        if (countElem) countElem.textContent = String(records.length);
        if (summaryElem) summaryElem.textContent = `Showing ${records.length} orders in Form Responses 1`;

        renderOrdersTable(records);
        if (showToastNotice) showToast(`✓ Live Google Sheet updated: ${records.length} orders loaded!`);
      } catch (err) {
        console.warn('Orders fetch note:', err);
      }
    }

    function renderOrdersTable(records) {
      const tbody = document.getElementById('ordersTableBody');
      if (!tbody) return;

      if (records.length === 0) {
        tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; padding: 24px; color: #94a3b8;">No orders recorded yet in Form Responses 1.</td></tr>`;
        return;
      }

      let html = '';
      records.forEach((r, idx) => {
        const isPaid = (r.paymentStatus || '').toLowerCase().includes('paid');
        const phone = (r.phone || '').trim();
        const timeFormatted = r.timestamp ? new Date(r.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '—';
        
        // Build whatsapp share url for individual row
        const waText = encodeURIComponent(
          `✨ *GEN M MEMENTOS INVOICE* ✨\n` +
          `Hello ${r.name}! Your order for ${r.qty}x ${r.item} (${r.sizesSummary || 'Standard'}) is confirmed!\n` +
          `Payment: ${r.paymentStatus || 'Pending'}\n` +
          `Thank you for pre-booking with Gen M!`
        );
        const waUrl = phone ? `https://api.whatsapp.com/send?phone=91${phone.replace(/[^0-9]/g, '')}&text=${waText}` : '#';

        html += `
          <tr>
            <td><strong>#${idx + 1}</strong></td>
            <td><strong>${escapeHtml(r.name || 'Unknown')}</strong></td>
            <td><code>${escapeHtml(phone || '—')}</code></td>
            <td>${escapeHtml(r.item || 'Merchandise')}</td>
            <td><strong>${r.qty || 1}</strong></td>
            <td><span class="sub-label">${escapeHtml(r.sizesSummary || 'Standard')}</span></td>
            <td>
              <span class="status-badge ${isPaid ? 'confirmed' : 'pending'}">
                ${escapeHtml(r.paymentStatus || 'Pending')}
              </span>
            </td>
            <td>
              <span class="status-badge confirmed">${escapeHtml(r.bookingStatus || 'Confirmed')}</span>
            </td>
            <td><small class="text-muted">${timeFormatted}</small></td>
            <td style="text-align: right;">
              ${phone ? `
                <a href="${waUrl}" target="_blank" class="btn-wa-icon" title="Share Invoice to WhatsApp">
                  <span>💬 WhatsApp</span>
                </a>
              ` : '—'}
            </td>
          </tr>
        `;
      });

      tbody.innerHTML = html;
    }

    // Filter orders
    document.getElementById('orderSearchInput')?.addEventListener('input', applyOrderFilters);
    document.getElementById('orderStatusFilter')?.addEventListener('change', applyOrderFilters);
    document.getElementById('orderPaymentFilter')?.addEventListener('change', applyOrderFilters);

    function applyOrderFilters() {
      const q = (document.getElementById('orderSearchInput')?.value || '').toLowerCase();
      const statusFilter = document.getElementById('orderStatusFilter')?.value || 'all';
      const payFilter = document.getElementById('orderPaymentFilter')?.value || 'all';

      const filtered = allOrders.filter(r => {
        const matchesQ = !q || (
          (r.name && r.name.toLowerCase().includes(q)) ||
          (r.phone && r.phone.includes(q)) ||
          (r.item && r.item.toLowerCase().includes(q)) ||
          (r.sizesSummary && r.sizesSummary.toLowerCase().includes(q))
        );

        const matchesStatus = statusFilter === 'all' || r.bookingStatus === statusFilter;
        const matchesPay = payFilter === 'all' || 
          (payFilter === 'Paid' && (r.paymentStatus || '').toLowerCase().includes('paid')) ||
          (payFilter === 'Pending' && !(r.paymentStatus || '').toLowerCase().includes('paid'));

        return matchesQ && matchesStatus && matchesPay;
      });

      renderOrdersTable(filtered);
    }

    // Export CSV
    document.getElementById('exportCsvBtn')?.addEventListener('click', () => {
      if (allOrders.length === 0) {
        showToast('No orders to export.');
        return;
      }
      const headers = ['Row', 'Timestamp', 'Customer Name', 'Contact', 'Item', 'Qty', 'Sizes Summary', 'Payment Status', 'Booking Status', 'Notes'];
      const rows = allOrders.map((r, i) => [
        i + 1,
        `"${r.timestamp || ''}"`,
        `"${(r.name || '').replace(/"/g, '""')}"`,
        `"${r.phone || ''}"`,
        `"${r.item || ''}"`,
        r.qty || 1,
        `"${r.sizesSummary || ''}"`,
        `"${r.paymentStatus || ''}"`,
        `"${r.bookingStatus || ''}"`,
        `"${(r.notes || '').replace(/"/g, '""')}"`
      ]);

      const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement('a');
      link.setAttribute('href', encodedUri);
      link.setAttribute('download', `GEN_M_Form_Responses_1_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('CSV Export downloaded!');
    });

    // ─────────────────────────────────────────────────────────────
    // TAB 3: STOCK & INVENTORY (VIEW ONLY)
    // ─────────────────────────────────────────────────────────────
    async function fetchStock() {
      try {
        const resp = await fetch(`${API_BASE}/api/inventory`, {
          headers: { Authorization: `Bearer ${authToken}` }
        });
        if (!resp.ok) return;

        const data = await resp.json();
        const items = data.items || [];

        let bookedTotal = 0;
        let availableTotal = 0;
        let stockTotal = 0;

        items.forEach(it => {
          stockTotal += it.totalStock || 0;
          bookedTotal += it.bookedUnits || 0;
          availableTotal += it.availableStock || 0;

          // Update card stock badge
          const cardStockBadge = document.getElementById(`stock-${it.item.toLowerCase().replace(/[^a-z0-9]/g, '-')}`);
          if (cardStockBadge) {
            cardStockBadge.textContent = `${it.availableStock} in stock`;
          }

          // Update table row
          const bookedElem = document.getElementById(`live-booked-${it.item.toLowerCase().replace(/[^a-z0-9]/g, '-')}`);
          const availElem = document.getElementById(`live-avail-${it.item.toLowerCase().replace(/[^a-z0-9]/g, '-')}`);
          if (bookedElem) bookedElem.textContent = String(it.bookedUnits);
          if (availElem) availElem.textContent = String(it.availableStock);
        });

        document.getElementById('metricTotalStock').textContent = `${stockTotal.toLocaleString()} Units`;
        document.getElementById('metricTotalBooked').textContent = `${bookedTotal.toLocaleString()} Units`;
        document.getElementById('metricTotalAvailable').textContent = `${availableTotal.toLocaleString()} Units`;

      } catch (err) {
        console.warn('Stock fetch note:', err);
      }
    }

    // ─────────────────────────────────────────────────────────────
    // CONFIG CHECK & PERMISSION NOTICES
    // ─────────────────────────────────────────────────────────────
    async function checkSystemHealth() {
      try {
        const resp = await fetch(`${API_BASE}/api/config-status`);
        if (!resp.ok) return;
        const cfg = await resp.json();

        const banner = document.getElementById('syncAlertBanner');
        const bannerMsg = document.getElementById('syncAlertMessage');

        if (cfg.appsScriptHealth && cfg.appsScriptHealth.status === 403) {
          if (banner) banner.style.display = 'flex';
          if (bannerMsg) {
            bannerMsg.innerHTML = `<strong>Google Permission Notice:</strong> Apps Script "Who has access" is set to "Only myself". Change to <strong>"Anyone"</strong> to allow direct writing to Form Responses 1. <em>(${cfg.pendingQueueCount || 0} orders queued safely)</em>`;
          }
        } else {
          if (banner) banner.style.display = 'none';
        }
      } catch (e) {}
    }

    // Modal for Apps Script permissions
    const appsScriptModal = document.getElementById('appsScriptModal');
    const bannerResolveBtn = document.getElementById('bannerResolveBtn');
    const closeAppsScriptModalBtn = document.getElementById('closeAppsScriptModalBtn');
    const testScriptUrlBtn = document.getElementById('testScriptUrlBtn');
    const saveScriptUrlBtn = document.getElementById('saveScriptUrlBtn');

    bannerResolveBtn?.addEventListener('click', () => {
      if (appsScriptModal) appsScriptModal.style.display = 'flex';
    });

    closeAppsScriptModalBtn?.addEventListener('click', () => {
      if (appsScriptModal) appsScriptModal.style.display = 'none';
    });

    testScriptUrlBtn?.addEventListener('click', async () => {
      const input = document.getElementById('modalScriptUrl');
      const fb = document.getElementById('testScriptFeedback');
      if (!input || !fb) return;

      fb.style.display = 'block';
      fb.className = 'test-feedback';
      fb.textContent = 'Testing connection...';

      try {
        const resp = await fetch(`${API_BASE}/api/config/test-apps-script`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`
          },
          body: JSON.stringify({ appsScriptUrl: input.value.trim() })
        });
        const res = await resp.json();
        if (res.ok) {
          fb.style.background = '#ecfdf5';
          fb.style.color = '#065f46';
          fb.textContent = '✓ Google Apps Script is accessible and ready to write!';
        } else {
          fb.style.background = '#fef2f2';
          fb.style.color = '#991b1b';
          fb.textContent = `❌ ${res.error || 'Connection failed.'}`;
        }
      } catch (err) {
        fb.style.background = '#fef2f2';
        fb.style.color = '#991b1b';
        fb.textContent = 'Connection test failed.';
      }
    });

    saveScriptUrlBtn?.addEventListener('click', async () => {
      const input = document.getElementById('modalScriptUrl');
      const url = input?.value.trim();
      if (!url) return;

      try {
        const resp = await fetch(`${API_BASE}/api/config/apps-script`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`
          },
          body: JSON.stringify({ appsScriptUrl: url })
        });
        if (resp.ok) {
          showToast('✓ Apps Script URL saved!');
          setTimeout(() => {
            if (appsScriptModal) appsScriptModal.style.display = 'none';
          }, 1000);
        }
      } catch (e) {}
    });

    // ─────────────────────────────────────────────────────────────
    // REFRESH & SSE STREAM
    // ─────────────────────────────────────────────────────────────
    document.getElementById('refreshBtn')?.addEventListener('click', async () => {
      showToast('Refreshing live Google Sheet data...');
      await Promise.all([fetchOrders(true), fetchStock(), checkSystemHealth()]);
    });

    function initSse() {
      try {
        const sse = new EventSource(`${API_BASE}/api/realtime/stream`);
        sse.addEventListener('data_changed', () => {
          fetchOrders();
          fetchStock();
        });
        sse.addEventListener('sheet_update', () => {
          fetchOrders();
          fetchStock();
        });
      } catch (e) {}
    }

    // ─────────────────────────────────────────────────────────────
    // UTILITIES
    // ─────────────────────────────────────────────────────────────
    function showToast(msg) {
      const toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = msg;
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 3500);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function initApp() {
      fetchOrders();
      fetchStock();
      checkSystemHealth();
      initSse();
    }

    // Boot
    checkAuth();
  })();
</script>
