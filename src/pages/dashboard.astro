---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';

const productNames = PRODUCTS.map((p) => p.name);
const GOOGLE_SHEET_ID = '1foGWm9i_5DhBUjocJDxs84jWCLdc-U1BJaN7r0KuhiA';
const GOOGLE_SHEET_URL = `https://docs.google.com/spreadsheets/d/${GOOGLE_SHEET_ID}/edit`;
---

<Layout
  title="GEN M Swag — Minimal Operations Dashboard"
  description="Clean, real-time operations dashboard for GEN M Swag. Live sync with Google Sheets Form Responses 1."
>
  <div class="dash-shell" id="dashApp">
    
    <!-- ═══════════════════════════════════════════════════════════
         AUTH VIEW (Minimal login)
         ═══════════════════════════════════════════════════════════ -->
    <div class="auth-wrapper" id="authSection" style="display: none;">
      <div class="auth-card">
        <div class="auth-header">
          <span class="auth-badge">GEN M OPERATIONS</span>
          <h1 class="auth-title">Sign In</h1>
          <p class="auth-subtitle">Command Center for Google Sheet <code>Form Responses 1</code></p>
        </div>

        <form id="loginForm" class="auth-form" onsubmit="return false;">
          <div class="form-group">
            <label class="form-label" for="authUsername">Username</label>
            <input type="text" id="authUsername" class="form-input" value="admin" required autofocus />
          </div>
          <div class="form-group">
            <label class="form-label" for="authPassword">Password</label>
            <input type="password" id="authPassword" class="form-input" value="GenM@2026!" required />
          </div>
          <div class="form-row-remember">
            <label class="checkbox-label">
              <input type="checkbox" id="authRemember" checked />
              <span>Keep me signed in</span>
            </label>
          </div>
          <button type="submit" id="loginSubmitBtn" class="btn-primary-action" style="width: 100%; margin-top: 12px;">
            <span>Sign In to Operations</span>
          </button>
        </form>
        <div id="authError" class="auth-error-alert" style="display: none;"></div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         DASHBOARD VIEW (Simple, Minimal, Clean)
         ═══════════════════════════════════════════════════════════ -->
    <div class="dash-container" id="dashSection">
      
      <!-- Minimal Header -->
      <header class="dash-header">
        <div class="header-left">
          <a href="/" class="brand-link" title="Back to Merch Showcase">
            <span class="brand-title">GEN M</span>
            <span class="brand-sep">/</span>
            <span class="brand-sub">OPERATIONS</span>
          </a>
          <a href={GOOGLE_SHEET_URL} target="_blank" rel="noopener noreferrer" class="sheet-pill" id="sheetPill" title="Open Google Sheet in new tab">
            <span class="status-dot dot-live" id="statusDot"></span>
            <span class="sheet-pill-label" id="statusLabel">Form Responses 1 (Live Real-Time)</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>

        <div class="header-right">
          <button type="button" class="btn-sync-setup" id="openSyncSetupBtn" title="Setup Real-Time Google Sheet Writeback">
            <span class="sync-setup-dot" id="syncSetupDot"></span>
            <span id="syncSetupLabel">⚡ Real-Time Write Setup</span>
          </button>
          
          <button type="button" class="btn-icon" id="refreshBtn" title="Refresh from Google Sheet">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            <span>Refresh</span>
          </button>

          <button type="button" class="btn-logout-minimal" id="logoutBtn" title="Sign Out">
            <span>Sign Out</span>
          </button>
        </div>
      </header>

      <!-- Webhook Alert Banner (Shows only if Webhook URL is not connected yet) -->
      <div class="webhook-banner" id="webhookBanner" style="display: none;">
        <div class="banner-content">
          <span class="banner-badge">SETUP REQUIRED</span>
          <span class="banner-text">
            To write new bookings directly into <strong>Form Responses 1</strong> in real-time, connect your deployed Google Apps Script Web App URL.
          </span>
        </div>
        <div class="banner-actions">
          <input type="url" id="quickScriptUrlInput" class="banner-input" placeholder="https://script.google.com/macros/s/.../exec" />
          <button type="button" id="quickSaveScriptBtn" class="btn-banner-action">Save & Connect</button>
          <button type="button" id="bannerOpenSetupModalBtn" class="btn-banner-link">View 15-Line Script →</button>
        </div>
      </div>

      <!-- Minimal Metrics Strip -->
      <section class="metrics-strip">
        <div class="metric-card">
          <div class="metric-top">
            <span class="metric-label">TOTAL BOOKINGS</span>
            <span class="metric-pill">Form Responses 1</span>
          </div>
          <div class="metric-val" id="totalBookingsVal">0</div>
          <div class="metric-sub" id="totalBookingsSub">Syncing with Google Sheet...</div>
        </div>

        <div class="metric-card">
          <div class="metric-top">
            <span class="metric-label">WHITE T-SHIRT ALLOCATION</span>
            <span class="metric-pill pill-accent">250 Target</span>
          </div>
          <div class="metric-val" id="tshirtUnitsVal">0 <span class="metric-unit">Units</span></div>
          <div class="metric-sub" id="tshirtSizesBreakdown">S: 0 • M: 0 • L: 0 • XL: 0 • XXL: 0</div>
        </div>

        <div class="metric-card">
          <div class="metric-top">
            <span class="metric-label">TOTAL STOCK REMAINING</span>
            <span class="metric-pill">13 Catalogue Items</span>
          </div>
          <div class="metric-val" id="stockUnitsVal">1,850 <span class="metric-unit">Units</span></div>
          <div class="metric-sub" id="stockStatusSub">100% Units Available</div>
        </div>
      </section>

      <!-- Minimal View Switcher (Orders / Stock / Financials) -->
      <nav class="view-switcher">
        <button type="button" class="view-btn is-active" data-view="orders">
          <span>Orders & Bookings</span>
          <span class="view-count" id="ordersTabCount">0</span>
        </button>
        <button type="button" class="view-btn" data-view="stock">
          <span>Stock & Inventory (1,850)</span>
        </button>
        <button type="button" class="view-btn" data-view="financials">
          <span>Sales & Revenue Tracker</span>
        </button>
      </nav>

      <!-- ═════════════════════════════════════════════════════════
           MAIN WORK AREA: ORDERS VIEW (2 Clean Columns)
           ═════════════════════════════════════════════════════════ -->
      <main class="main-content" id="viewOrders">
        <div class="two-column-grid">
          
          <!-- Column 1: Minimal Express Order Form -->
          <div class="clean-card form-card">
            <div class="card-header">
              <h2 class="card-title">+ New Order / Booking</h2>
              <span class="card-tag">Real-Time Write</span>
            </div>

            <form id="expressOrderForm" class="order-form" onsubmit="return false;">
              
              <div class="form-row-2">
                <div class="form-group">
                  <label class="form-label" for="orderName">Customer Name <span class="req">*</span></label>
                  <input type="text" id="orderName" class="form-input" placeholder="e.g. Ameen Farhan" required />
                </div>
                <div class="form-group">
                  <label class="form-label" for="orderPhone">Contact Number <span class="req">*</span></label>
                  <input type="tel" id="orderPhone" class="form-input" placeholder="e.g. 9876543210" required />
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="orderItem">Merchandise Item</label>
                <select id="orderItem" class="form-select">
                  <option value="White T-Shirt" selected>White T-Shirt (Multi-Size S, M, L, XL, XXL)</option>
                  <option value="Diary">Diary</option>
                  <option value="Pen">Pen</option>
                  <option value="Keychain">Keychain</option>
                  <option value="Bag Tag">Bag Tag</option>
                  <option value="Glass Set">Glass Set</option>
                  <option value="Water Bottle">Water Bottle</option>
                  <option value="Coffee Mug">Coffee Mug</option>
                  <option value="Cross Bag">Cross Bag</option>
                  <option value="Embroidered Cap">Embroidered Cap</option>
                  <option value="Mobile Stand">Mobile Stand</option>
                  <option value="Tissue">Tissue</option>
                  <option value="Car Perfume">Car Perfume</option>
                </select>
              </div>

              <!-- White T-Shirt Multi-Size Row -->
              <div class="size-allocation-panel" id="sizeMatrixPanel">
                <div class="size-header">
                  <span class="size-label">Select T-Shirt Sizes</span>
                  <span class="size-total-badge" id="sizeTotalBadge">Total: 1 Unit</span>
                </div>
                <div class="size-counters-row">
                  <div class="size-counter-item">
                    <span class="counter-size-name">S</span>
                    <div class="counter-input-wrap">
                      <button type="button" class="btn-step" data-target="sizeS" data-step="-1">−</button>
                      <input type="number" id="sizeS" class="counter-input" min="0" value="0" />
                      <button type="button" class="btn-step" data-target="sizeS" data-step="1">+</button>
                    </div>
                  </div>

                  <div class="size-counter-item">
                    <span class="counter-size-name">M</span>
                    <div class="counter-input-wrap">
                      <button type="button" class="btn-step" data-target="sizeM" data-step="-1">−</button>
                      <input type="number" id="sizeM" class="counter-input" min="0" value="1" />
                      <button type="button" class="btn-step" data-target="sizeM" data-step="1">+</button>
                    </div>
                  </div>

                  <div class="size-counter-item">
                    <span class="counter-size-name">L</span>
                    <div class="counter-input-wrap">
                      <button type="button" class="btn-step" data-target="sizeL" data-step="-1">−</button>
                      <input type="number" id="sizeL" class="counter-input" min="0" value="0" />
                      <button type="button" class="btn-step" data-target="sizeL" data-step="1">+</button>
                    </div>
                  </div>

                  <div class="size-counter-item">
                    <span class="counter-size-name">XL</span>
                    <div class="counter-input-wrap">
                      <button type="button" class="btn-step" data-target="sizeXL" data-step="-1">−</button>
                      <input type="number" id="sizeXL" class="counter-input" min="0" value="0" />
                      <button type="button" class="btn-step" data-target="sizeXL" data-step="1">+</button>
                    </div>
                  </div>

                  <div class="size-counter-item">
                    <span class="counter-size-name">XXL</span>
                    <div class="counter-input-wrap">
                      <button type="button" class="btn-step" data-target="sizeXXL" data-step="-1">−</button>
                      <input type="number" id="sizeXXL" class="counter-input" min="0" value="0" />
                      <button type="button" class="btn-step" data-target="sizeXXL" data-step="1">+</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- General Item Quantity (Shown when item is not White T-Shirt) -->
              <div class="form-group" id="generalQtyWrap" style="display: none;">
                <label class="form-label" for="orderGeneralQty">Quantity</label>
                <div class="qty-stepper-wrap">
                  <button type="button" class="btn-step" id="btnQtyMinus">−</button>
                  <input type="number" id="orderGeneralQty" class="form-input qty-input" min="1" value="1" />
                  <button type="button" class="btn-step" id="btnQtyPlus">+</button>
                </div>
              </div>

              <div class="form-row-2">
                <div class="form-group">
                  <label class="form-label" for="orderPaymentStatus">Payment Status</label>
                  <select id="orderPaymentStatus" class="form-select">
                    <option value="Pending" selected>Pending</option>
                    <option value="Paid">Paid / Advance</option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label" for="orderNotes">Notes / Location (Optional)</label>
                  <input type="text" id="orderNotes" class="form-input" placeholder="e.g. Kozhikode campus" />
                </div>
              </div>

              <button type="submit" id="submitOrderBtn" class="btn-submit-order">
                <span class="btn-spinner" id="orderSpinner" style="display: none;"></span>
                <span id="submitOrderBtnText">⚡ Add Order to Form Responses 1</span>
              </button>

              <div id="orderFeedback" class="order-feedback" style="display: none;"></div>
            </form>
          </div>

          <!-- Column 2: Minimal Orders Table -->
          <div class="clean-card table-card">
            <div class="card-header table-toolbar">
              <div class="toolbar-left">
                <h2 class="card-title">Live Orders in Form Responses 1</h2>
                <span class="row-count-pill" id="tableRowCount">Loading...</span>
              </div>
              <div class="toolbar-right">
                <input type="search" id="searchInput" class="search-input" placeholder="Search orders..." />
                <select id="itemFilter" class="filter-select">
                  <option value="">All Items</option>
                  <option value="White T-Shirt">White T-Shirt</option>
                  <option value="Diary">Diary</option>
                  <option value="Pen">Pen</option>
                  <option value="Keychain">Keychain</option>
                  <option value="Bag Tag">Bag Tag</option>
                  <option value="Glass Set">Glass Set</option>
                  <option value="Water Bottle">Water Bottle</option>
                  <option value="Coffee Mug">Coffee Mug</option>
                  <option value="Cross Bag">Cross Bag</option>
                  <option value="Embroidered Cap">Embroidered Cap</option>
                  <option value="Mobile Stand">Mobile Stand</option>
                  <option value="Tissue">Tissue</option>
                  <option value="Car Perfume">Car Perfume</option>
                </select>
                <button type="button" id="exportCsvBtn" class="btn-icon" title="Export CSV">
                  <span>Export CSV</span>
                </button>
              </div>
            </div>

            <div class="table-container">
              <table class="minimal-table">
                <thead>
                  <tr>
                    <th style="width: 50px;">#</th>
                    <th>Customer</th>
                    <th>Contact</th>
                    <th>Item & Sizes</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                  </tr>
                </thead>
                <tbody id="ordersTableBody">
                  <tr>
                    <td colspan="7" class="table-empty">Fetching live records from Google Sheet...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </main>

      <!-- ═════════════════════════════════════════════════════════
           VIEW 2: STOCK & INVENTORY
           ═════════════════════════════════════════════════════════ -->
      <section class="main-content" id="viewStock" style="display: none;">
        <div class="clean-card">
          <div class="card-header">
            <div>
              <h2 class="card-title">Stock & Inventory (1,850 Units)</h2>
              <p class="card-sub">Live stock levels linked with Sheet tab <code>Inventory & Availability</code></p>
            </div>
          </div>
          <div class="table-container">
            <table class="minimal-table">
              <thead>
                <tr>
                  <th>Product Name</th>
                  <th>Category</th>
                  <th>Total Stock</th>
                  <th>Booked</th>
                  <th>Available</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="stockTableBody">
                <tr><td colspan="6" class="table-empty">Loading inventory...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ═════════════════════════════════════════════════════════
           VIEW 3: SALES & FINANCIALS
           ═════════════════════════════════════════════════════════ -->
      <section class="main-content" id="viewFinancials" style="display: none;">
        <div class="clean-card">
          <div class="card-header">
            <div>
              <h2 class="card-title">Catalogue Pricing & Projections</h2>
              <p class="card-sub">Real-time revenue, unit costs, and profit projections from <code>Sheet1</code></p>
            </div>
          </div>
          <div class="table-container">
            <table class="minimal-table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Unit Cost</th>
                  <th>Selling Price</th>
                  <th>Units</th>
                  <th>Projected Revenue</th>
                  <th>Unit Profit</th>
                  <th>Margin</th>
                </tr>
              </thead>
              <tbody id="financialsTableBody">
                <tr><td colspan="7" class="table-empty">Loading catalogue financials...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

    </div>

    <!-- ═══════════════════════════════════════════════════════════
         MODAL: EDIT BOOKING
         ═══════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop" id="editModal" style="display: none;">
      <div class="modal-box">
        <div class="modal-header">
          <h3 class="modal-title">Edit Booking <span id="editRowBadge" class="modal-pill">#0</span></h3>
          <button type="button" class="modal-close" id="closeEditModalBtn">✕</button>
        </div>
        <form id="editForm" class="modal-body" onsubmit="return false;">
          <input type="hidden" id="editRowNumber" />
          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label" for="editName">Customer Name</label>
              <input type="text" id="editName" class="form-input" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="editPhone">Contact Number</label>
              <input type="tel" id="editPhone" class="form-input" />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="editItem">Item Selected</label>
            <select id="editItem" class="form-select">
              <option value="White T-Shirt">White T-Shirt</option>
              <option value="Diary">Diary</option>
              <option value="Pen">Pen</option>
              <option value="Keychain">Keychain</option>
              <option value="Bag Tag">Bag Tag</option>
              <option value="Glass Set">Glass Set</option>
              <option value="Water Bottle">Water Bottle</option>
              <option value="Coffee Mug">Coffee Mug</option>
              <option value="Cross Bag">Cross Bag</option>
              <option value="Embroidered Cap">Embroidered Cap</option>
              <option value="Mobile Stand">Mobile Stand</option>
              <option value="Tissue">Tissue</option>
              <option value="Car Perfume">Car Perfume</option>
            </select>
          </div>
          <div class="form-group" id="editSizeWrap">
            <label class="form-label">T-Shirt Sizes (S, M, L, XL, XXL)</label>
            <div class="size-counters-row">
              <div class="size-counter-item">
                <span class="counter-size-name">S</span>
                <input type="number" id="editSizeS" class="counter-input" min="0" value="0" />
              </div>
              <div class="size-counter-item">
                <span class="counter-size-name">M</span>
                <input type="number" id="editSizeM" class="counter-input" min="0" value="0" />
              </div>
              <div class="size-counter-item">
                <span class="counter-size-name">L</span>
                <input type="number" id="editSizeL" class="counter-input" min="0" value="0" />
              </div>
              <div class="size-counter-item">
                <span class="counter-size-name">XL</span>
                <input type="number" id="editSizeXL" class="counter-input" min="0" value="0" />
              </div>
              <div class="size-counter-item">
                <span class="counter-size-name">XXL</span>
                <input type="number" id="editSizeXXL" class="counter-input" min="0" value="0" />
              </div>
            </div>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label" for="editPayment">Payment Status</label>
              <select id="editPayment" class="form-select">
                <option value="Pending">Pending</option>
                <option value="Paid">Paid</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="editNotes">Notes</label>
              <input type="text" id="editNotes" class="form-input" />
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-cancel" id="cancelEditBtn">Cancel</button>
            <button type="submit" class="btn-primary-action" id="saveEditBtn">Update in Google Sheet</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         MODAL: REAL-TIME WRITE SETUP (Simple & Clean)
         ═══════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop" id="syncSetupModal" style="display: none;">
      <div class="modal-box modal-box-large">
        <div class="modal-header">
          <div>
            <h3 class="modal-title">⚡ Google Sheet Real-Time Write Setup</h3>
            <p class="modal-sub">Target Worksheet: <code>Form Responses 1</code> (ID: <code>1foGWm9i...0KuhiA</code>)</p>
          </div>
          <button type="button" class="modal-close" id="closeSyncSetupModalBtn">✕</button>
        </div>

        <div class="modal-body">
          <div class="setup-steps-strip">
            <div class="setup-step">
              <span class="step-num">1</span>
              <span>Open Sheet &gt; <strong>Extensions</strong> &gt; <strong>Apps Script</strong></span>
            </div>
            <div class="setup-step">
              <span class="step-num">2</span>
              <span>Paste script into <code>Code.gs</code> and click <strong>Save</strong></span>
            </div>
            <div class="setup-step">
              <span class="step-num">3</span>
              <span>Click <strong>Deploy</strong> &gt; <strong>New Deployment</strong> &gt; <strong>Web app</strong> (Access: <strong>Anyone</strong>)</span>
            </div>
          </div>

          <div class="code-box-wrap">
            <div class="code-box-head">
              <span>Code.gs (15 Lines • Ready to Paste)</span>
              <button type="button" id="copyScriptCodeBtn" class="btn-copy">📋 Copy Code</button>
            </div>
            <pre class="code-pre" id="scriptCodePre"><code>{`function doPost(e) {
  try {
    var data = JSON.parse(e.postData.contents);
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName("Form Responses 1") || ss.getSheets()[0];
    
    if (data.action === "create" && data.row) {
      sheet.appendRow(data.row);
      return ContentService.createTextOutput(JSON.stringify({ status: "success", rowNumber: sheet.getLastRow() }))
        .setMimeType(ContentService.MimeType.JSON);
    }
    if (data.action === "update" && data.rowNumber && data.row) {
      sheet.getRange(parseInt(data.rowNumber), 1, 1, data.row.length).setValues([data.row]);
      return ContentService.createTextOutput(JSON.stringify({ status: "success" }))
        .setMimeType(ContentService.MimeType.JSON);
    }
    if (data.action === "delete" && data.rowNumber) {
      sheet.deleteRow(parseInt(data.rowNumber));
      return ContentService.createTextOutput(JSON.stringify({ status: "success" }))
        .setMimeType(ContentService.MimeType.JSON);
    }
    return ContentService.createTextOutput(JSON.stringify({ status: "ok" })).setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ status: "error", error: err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

function doGet(e) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("Form Responses 1") || ss.getSheets()[0];
  var data = sheet.getDataRange().getValues();
  return ContentService.createTextOutput(JSON.stringify({ status: "success", rows: data.slice(1) }))
    .setMimeType(ContentService.MimeType.JSON);
}`}</code></pre>
          </div>

          <div class="url-input-card">
            <label class="form-label" for="modalAppsScriptUrl">Paste Deployed Web App URL:</label>
            <div class="url-input-row">
              <input
                type="url"
                id="modalAppsScriptUrl"
                class="form-input"
                placeholder="https://script.google.com/macros/s/AKfycbx.../exec"
              />
              <button type="button" id="saveModalAppsScriptBtn" class="btn-primary-action">
                <span>Save & Connect</span>
              </button>
            </div>
            <div id="modalSyncFeedback" class="sync-feedback" style="display: none;"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Micro Toast Notification -->
    <div id="toastNotification" class="toast" style="display: none;"></div>

  </div>
</Layout>

<style>
