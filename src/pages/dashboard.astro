---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';

const productNames = PRODUCTS.map((p) => p.name);
const GOOGLE_SHEET_ID = '1foGWm9i_5DhBUjocJDxs84jWCLdc-U1BJaN7r0KuhiA';
const GOOGLE_SHEET_URL = `https://docs.google.com/spreadsheets/d/${GOOGLE_SHEET_ID}/edit`;
---

<Layout
  title="GEN M Swag — Operations & Google Sheets Command Center"
  description="All-in-one operations dashboard for GEN M Swag. Live sync with Google Sheets (1foGWm9i_5DhBUjocJDxs84jWCLdc-U1BJaN7r0KuhiA). Order CRUD, T-Shirt multi-size allocation, 1,850-unit inventory tracking, and sales analytics."
>
  <div class="dash-root" id="dashApp">
    
    <!-- ═══════════════════════════════════════════════════════════
         VIEW 1: SECURE AUTHENTICATION SCREEN
         ═══════════════════════════════════════════════════════════ -->
    <div class="auth-wrapper" id="authSection">
      <div class="auth-card">
        
        <!-- Brand Header Lockup -->
        <div class="auth-header">
          <div class="auth-badge">
            <span class="auth-badge-dot"></span>
            GEN M MERCH OPERATIONS
          </div>
          <h1 class="auth-title">Command Center</h1>
          <p class="auth-subtitle">
            Secure Google Sheets Operations & Inventory Portal
          </p>
          <div class="sheet-id-badge">
            <span>Connected Sheet: <code>1foGWm9i...0KuhiA</code></span>
          </div>
        </div>

        <!-- Security Architecture Banner -->
        <div class="auth-security-pills">
          <span class="sec-pill" title="Server-side bcrypt hash verification">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            bcrypt 10-Salt
          </span>
          <span class="sec-pill" title="Cryptographically signed JWT sessions">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            JWT Bearer
          </span>
          <span class="sec-pill" title="Multi-tab Google Sheets sync">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            Google Cloud Sheets
          </span>
        </div>

        <!-- Error Message Alert -->
        <div class="auth-alert" id="authError" style="display: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="authErrorMsg">Invalid username or password</span>
        </div>

        <!-- Login Form -->
        <form class="auth-form" id="loginForm">
          <div class="form-group">
            <label for="usernameInput" class="form-label">Username</label>
            <div class="input-wrap">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <input
                type="text"
                id="usernameInput"
                class="form-input"
                placeholder="e.g. admin"
                autocomplete="username"
                value="admin"
                required
              />
            </div>
          </div>

          <div class="form-group">
            <div class="label-row">
              <label for="passwordInput" class="form-label">Password</label>
            </div>
            <div class="input-wrap">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <input
                type="password"
                id="passwordInput"
                class="form-input"
                placeholder="Enter admin password"
                autocomplete="current-password"
                value="GenM@2026!"
                required
              />
              <button type="button" class="btn-toggle-pw" id="togglePwBtn" aria-label="Toggle password visibility">
                <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="form-meta-row">
            <label class="remember-label">
              <input type="checkbox" id="rememberMe" checked />
              <span>Keep session active</span>
            </label>
            <button type="button" class="demo-fill-btn" id="demoFillBtn">
              Auto-fill Demo
            </button>
          </div>

          <button type="submit" class="btn-auth-submit" id="loginSubmitBtn">
            <span class="btn-text">Sign In to Dashboard</span>
            <span class="btn-spinner" id="loginSpinner" style="display: none;"></span>
          </button>
        </form>

        <!-- Default Credentials Quick Note -->
        <div class="auth-footnote">
          <span>Demo credentials: <strong>admin</strong> / <strong>GenM@2026!</strong></span>
        </div>

      </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         VIEW 2: AUTHENTICATED MANAGEMENT DASHBOARD
         ═══════════════════════════════════════════════════════════ -->
    <div class="dash-shell" id="dashSection" style="display: none;">
      
      <!-- Top Navigation Header -->
      <header class="dash-topbar">
        <div class="topbar-left">
          <a href="/" class="topbar-brand" title="Return to Merchandise Website">
            <span class="brand-text">GEN M</span>
            <span class="brand-divider">/</span>
            <span class="brand-sub">OPERATIONS</span>
          </a>

          <!-- Real-Time Sync Indicator Pill -->
          <a
            href={GOOGLE_SHEET_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="sync-status-badge"
            id="syncStatusBadge"
            title="Open connected Google Sheet in new tab"
          >
            <span class="status-indicator-dot dot-live" id="statusDot"></span>
            <span class="status-indicator-label" id="statusLabel">Form Responses 1 (Live Sync)</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
          <button type="button" class="btn-offline-sync" id="topbarOfflineBtn" style="display: none;" title="Push pending offline bookings to Google Sheet">
            <span class="pulse-dot-amber"></span>
            <span id="topbarOfflineCount">0 Offline</span>
            <span class="push-action-arrow">⚡ Push</span>
          </button>
        </div>

        <div class="topbar-right">
          <!-- Refresh Data -->
          <button class="topbar-action-btn" id="refreshDataBtn" title="Reload from source">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            <span>Refresh</span>
          </button>

          <!-- Add New Order Button (3D Brand Yellow) -->
          <button class="btn-create-record" id="openCreateModalBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>+ New Booking / Order</span>
          </button>

          <!-- User Menu / Logout -->
          <div class="user-chip">
            <div class="user-avatar" id="userInitial">A</div>
            <span class="user-name" id="userNameLabel">admin</span>
            <button class="btn-logout" id="logoutBtn" title="Sign Out">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </button>
          </div>
        </div>
      </header>


      <!-- Navigation Tabs (Orders, T-Shirt Sizes, Stock/Inventory, Sales/Financials, Sheet Sync) -->
      <nav class="dash-tabs-nav" aria-label="Operations sections">
        <div class="tabs-shell">
          <button class="tab-btn is-active" data-tab="tabOrders">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>Orders & Bookings</span>
            <span class="tab-badge" id="tabOrdersBadge">0</span>
          </button>

          <button class="tab-btn" data-tab="tabTshirt">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
            <span>T-Shirt Size Allocation</span>
            <span class="tab-badge badge-accent" id="tabTshirtBadge">250 Target</span>
          </button>

          <button class="tab-btn" data-tab="tabStock">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            <span>Stock & Inventory (1,850)</span>
          </button>

          <button class="tab-btn" data-tab="tabFinancials">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span>Sales & Revenue Tracker</span>
          </button>

          <button class="tab-btn" data-tab="tabSync">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span>Google Sheet Sync Status</span>
          </button>
        </div>
      </nav>


      <!-- Main Content Container -->
      <main class="dash-main-body">
        
        <!-- ═════════════════════════════════════════════════════════
             TAB 1: ORDERS & BOOKINGS (FULL CRUD)
             ═════════════════════════════════════════════════════════ -->
        <div class="tab-panel is-active" id="tabOrders">
          
          <!-- Metrics Stats Cards Row -->
          <section class="stats-row">
            <div class="stat-card">
              <div class="stat-icon-wrap icon-blue">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              </div>
              <div class="stat-content">
                <div class="stat-label">Total Bookings</div>
                <div class="stat-val" id="statTotalOrders">0</div>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-icon-wrap icon-yellow">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div class="stat-content">
                <div class="stat-label">Pending Fulfilment</div>
                <div class="stat-val" id="statPendingOrders">0</div>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-icon-wrap icon-green">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div class="stat-content">
                <div class="stat-label">T-Shirts Booked</div>
                <div class="stat-val" id="statTshirtBooked">0 / 250</div>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-icon-wrap icon-purple">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <div class="stat-content">
                <div class="stat-label">Booked Sales Revenue</div>
                <div class="stat-val" id="statTotalSales">₹0</div>
              </div>
            </div>
          </section>

          <!-- ═════════════════════════════════════════════════════════
               ⚡ EXPRESS QUICK BOOKING CONSOLE (SIMPLE & REAL-TIME)
               ═════════════════════════════════════════════════════════ -->
          <section class="quick-booking-card" id="quickBookingCard">
            <div class="quick-booking-header">
              <div class="qb-header-left">
                <div class="qb-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                </div>
                <div>
                  <h3 class="qb-title">Express Booking & Real-Time Sync</h3>
                  <p class="qb-sub">Instant 1-click booking directly to Google Sheet • Multi-size allocation for White T-Shirts</p>
                </div>
              </div>
              <div class="qb-header-right" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                <span class="qb-live-pill" id="qbSyncStatusPill"><span class="status-indicator-dot dot-live" id="qbSyncDot"></span> <span id="qbSyncStatusText">Sheet: Form Responses 1 (Live Real-Time)</span></span>
                <button type="button" class="btn-offline-sync" id="qbOfflinePushBtn" style="display: none;" title="Push pending offline bookings to Google Sheet Form Responses 1">
                  <span class="pulse-dot-amber"></span>
                  <span id="qbOfflineCountText">0 Offline Bookings</span>
                  <span class="push-action-arrow">⚡ Push to Sheet</span>
                </button>
              </div>
            </div>

            <form class="quick-booking-form" id="quickBookingForm" onsubmit="return false;">
              <!-- Customer Info Row -->
              <div class="qb-row qb-customer-row">
                <div class="qb-field qb-field-name">
                  <label for="qbName">Customer Name <span class="req">*</span></label>
                  <div class="qb-input-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <input type="text" id="qbName" placeholder="e.g. Muhammed Rashid" required autocomplete="off" />
                  </div>
                </div>

                <div class="qb-field qb-field-phone">
                  <label for="qbPhone">WhatsApp / Mobile Number</label>
                  <div class="qb-input-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <input type="tel" id="qbPhone" placeholder="e.g. 9846012345" autocomplete="off" />
                  </div>
                </div>

                <div class="qb-field qb-field-notes">
                  <label for="qbNotes">Remarks / Delegate ID (Optional)</label>
                  <div class="qb-input-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    <input type="text" id="qbNotes" placeholder="e.g. Kozhikode Delegate / Paid cash" autocomplete="off" />
                  </div>
                </div>
              </div>

              <!-- Product Selector Chips -->
              <div class="qb-product-row">
                <div class="qb-section-label">Select Merchandise Item:</div>
                <div class="qb-item-chips" id="qbItemChips">
                  <button type="button" class="qb-chip active" data-item="White T-Shirt" data-price="449">
                    <span class="chip-icon">👕</span> White T-Shirt <span class="chip-sub-badge">Multi-Size</span>
                  </button>
                  <button type="button" class="qb-chip" data-item="Diary" data-price="150">
                    <span class="chip-icon">📓</span> Diary
                  </button>
                  <button type="button" class="qb-chip" data-item="Pen" data-price="20">
                    <span class="chip-icon">🖊️</span> Pen
                  </button>
                  <button type="button" class="qb-chip" data-item="Keychain" data-price="25">
                    <span class="chip-icon">🔑</span> Keychain
                  </button>
                  <button type="button" class="qb-chip" data-item="Embroidered Cap" data-price="180">
                    <span class="chip-icon">🧢</span> Embroidered Cap
                  </button>
                  <button type="button" class="qb-chip" data-item="Water Bottle" data-price="350">
                    <span class="chip-icon">🍾</span> Water Bottle
                  </button>
                  <button type="button" class="qb-chip" data-item="Coffee Mug" data-price="180">
                    <span class="chip-icon">☕</span> Coffee Mug
                  </button>
                  <button type="button" class="qb-chip" data-item="Cross Bag" data-price="180">
                    <span class="chip-icon">👜</span> Cross Bag
                  </button>
                  <button type="button" class="qb-chip" data-item="Bag Tag" data-price="50">
                    <span class="chip-icon">🏷️</span> Bag Tag
                  </button>
                  <button type="button" class="qb-chip" data-item="Glass Set" data-price="200">
                    <span class="chip-icon">🥂</span> Glass Set
                  </button>
                  <button type="button" class="qb-chip" data-item="Mobile Stand" data-price="199">
                    <span class="chip-icon">📱</span> Mobile Stand
                  </button>
                  <button type="button" class="qb-chip" data-item="Tissue" data-price="79">
                    <span class="chip-icon">🧻</span> Tissue
                  </button>
                  <button type="button" class="qb-chip" data-item="Car Perfume" data-price="40">
                    <span class="chip-icon">🌸</span> Car Perfume
                  </button>
                </div>
              </div>

              <!-- White T-Shirt Multi-Size Stepper Matrix -->
              <div class="qb-size-stepper-box" id="qbTshirtSizeBox">
                <div class="qb-size-title-row">
                  <div class="qb-size-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                    <span>Allocate T-Shirt Sizes (S, M, L, XL, XXL):</span>
                  </div>
                  <div class="qb-size-presets">
                    <span class="preset-label">Quick Add:</span>
                    <button type="button" class="btn-preset" data-preset="M1">+1 M</button>
                    <button type="button" class="btn-preset" data-preset="L1">+1 L</button>
                    <button type="button" class="btn-preset" data-preset="XL1">+1 XL</button>
                    <button type="button" class="btn-preset" data-preset="ALL1">+1 All Sizes</button>
                    <button type="button" class="btn-preset btn-preset-clear" data-preset="CLEAR">Reset</button>
                  </div>
                </div>

                <div class="qb-steppers-grid">
                  <!-- S -->
                  <div class="qb-stepper-unit">
                    <div class="size-tag">Size S</div>
                    <div class="stepper-controls">
                      <button type="button" class="step-btn minus" data-size="S">−</button>
                      <input type="number" id="qbSizeS" class="step-val" min="0" value="0" />
                      <button type="button" class="step-btn plus" data-size="S">+</button>
                    </div>
                  </div>

                  <!-- M -->
                  <div class="qb-stepper-unit highlight-stepper">
                    <div class="size-tag">Size M</div>
                    <div class="stepper-controls">
                      <button type="button" class="step-btn minus" data-size="M">−</button>
                      <input type="number" id="qbSizeM" class="step-val" min="0" value="0" />
                      <button type="button" class="step-btn plus" data-size="M">+</button>
                    </div>
                  </div>

                  <!-- L -->
                  <div class="qb-stepper-unit highlight-stepper">
                    <div class="size-tag">Size L</div>
