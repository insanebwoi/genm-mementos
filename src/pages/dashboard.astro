---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';

const productNames = PRODUCTS.map((p) => p.name);
---

<Layout
  title="GEN M Swag — Admin Command Center & Google Sheets CRUD"
  description="Secure dashboard for GEN M Swag merchandise orders. Protected with username/password authentication, JWT authorization, and Google Cloud Service Account integration."
>
  <div class="dash-root" id="dashApp">
    
    <!-- ═══════════════════════════════════════════════════════════
         VIEW 1: SECURE AUTHENTICATION SCREEN
         ═══════════════════════════════════════════════════════════ -->
    <div class="auth-wrapper" id="authSection">
      <div class="auth-card">
        
        <!-- Brand Header Lockup -->
        <div class="auth-header">
          <div class="auth-badge">
            <span class="auth-badge-dot"></span>
            GEN M MERCH OPERATIONS
          </div>
          <h1 class="auth-title">Command Center</h1>
          <p class="auth-subtitle">
            Secure Google Sheets CRUD Management Portal
          </p>
        </div>

        <!-- Security Architecture Banner -->
        <div class="auth-security-pills">
          <span class="sec-pill" title="Server-side bcrypt hash verification">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            bcrypt 10-Salt
          </span>
          <span class="sec-pill" title="Cryptographically signed JWT sessions">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            JWT Bearer
          </span>
          <span class="sec-pill" title="Zero API Key exposure via Service Account">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            GCP Service Account
          </span>
        </div>

        <!-- Error Message Alert -->
        <div class="auth-alert" id="authError" style="display: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="authErrorMsg">Invalid username or password</span>
        </div>

        <!-- Login Form -->
        <form class="auth-form" id="loginForm" onsubmit="return false;">
          <div class="form-group">
            <label for="usernameInput" class="form-label">Username</label>
            <div class="input-wrap">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <input
                type="text"
                id="usernameInput"
                class="form-input"
                placeholder="e.g. admin"
                autocomplete="username"
                required
              />
            </div>
          </div>

          <div class="form-group">
            <div class="label-row">
              <label for="passwordInput" class="form-label">Password</label>
            </div>
            <div class="input-wrap">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <input
                type="password"
                id="passwordInput"
                class="form-input"
                placeholder="Enter admin password"
                autocomplete="current-password"
                required
              />
              <button type="button" class="btn-toggle-pw" id="togglePwBtn" aria-label="Toggle password visibility">
                <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="form-meta-row">
            <label class="remember-label">
              <input type="checkbox" id="rememberMe" checked />
              <span>Keep session active</span>
            </label>
            <button type="button" class="demo-fill-btn" id="demoFillBtn">
              Auto-fill Demo
            </button>
          </div>

          <button type="submit" class="btn-auth-submit" id="loginSubmitBtn">
            <span class="btn-text">Sign In to Dashboard</span>
            <span class="btn-spinner" id="loginSpinner" style="display: none;"></span>
          </button>
        </form>

        <!-- Default Credentials Quick Note -->
        <div class="auth-footnote">
          <span>Demo credentials: <strong>admin</strong> / <strong>GenM@2026!</strong></span>
        </div>

      </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         VIEW 2: AUTHENTICATED MANAGEMENT DASHBOARD
         ═══════════════════════════════════════════════════════════ -->
    <div class="dash-shell" id="dashSection" style="display: none;">
      
      <!-- Top Navigation Header -->
      <header class="dash-topbar">
        <div class="topbar-left">
          <a href="/" class="topbar-brand" title="Return to Website">
            <span class="brand-text">GEN M</span>
            <span class="brand-divider">/</span>
            <span class="brand-sub">OPERATIONS</span>
          </a>

          <!-- Real-Time Sync Indicator Pill -->
          <div class="sync-status-badge" id="syncStatusBadge">
            <span class="status-indicator-dot dot-live" id="statusDot"></span>
            <span class="status-indicator-label" id="statusLabel">Connecting...</span>
          </div>
        </div>

        <div class="topbar-right">
          <!-- Diagnostics / Google Setup Trigger -->
          <button class="topbar-action-btn" id="openSetupModalBtn" title="Google Sheets API & Service Account Setup">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span>Google Sheets Config</span>
          </button>

          <!-- Refresh Data -->
          <button class="topbar-action-btn" id="refreshDataBtn" title="Reload from source">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            <span>Refresh</span>
          </button>

          <!-- Add New Record Button (3D Brand Yellow) -->
          <button class="btn-create-record" id="openCreateModalBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>New Order / Entry</span>
          </button>

          <!-- User Menu / Logout -->
          <div class="user-chip">
            <div class="user-avatar" id="userInitial">A</div>
            <span class="user-name" id="userNameLabel">admin</span>
            <button class="btn-logout" id="logoutBtn" title="Sign Out">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </button>
          </div>
        </div>
      </header>

      <!-- Main Content Container -->
      <main class="dash-main-body">
        
        <!-- Metrics Stats Cards Row -->
        <section class="stats-row">
          <div class="stat-card">
            <div class="stat-icon-wrap icon-blue">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <div class="stat-content">
              <div class="stat-label">Total Merchandise Entries</div>
              <div class="stat-val" id="statTotalOrders">0</div>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon-wrap icon-yellow">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="stat-content">
              <div class="stat-label">Pending Fulfilment</div>
              <div class="stat-val" id="statPendingOrders">0</div>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon-wrap icon-green">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div class="stat-content">
              <div class="stat-label">Confirmed / Shipped</div>
              <div class="stat-val" id="statConfirmedOrders">0</div>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon-wrap icon-purple">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
            </div>
            <div class="stat-content">
              <div class="stat-label">Data Engine Source</div>
              <div class="stat-val-text" id="statSourceMode">Google Sheets</div>
            </div>
          </div>
        </section>

        <!-- Search, Filter & Toolbar -->
        <section class="toolbar-section">
          <div class="toolbar-search-wrap">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input
              type="text"
              id="searchInput"
              class="search-input"
              placeholder="Search by customer name, phone, email, or item..."
            />
            <button class="clear-search-btn" id="clearSearchBtn" style="display: none;" title="Clear search">×</button>
          </div>

          <div class="toolbar-filters-wrap">
            <!-- Filter by Product Item -->
            <select class="filter-select" id="itemFilterSelect">
              <option value="ALL">All 13 Swag Items</option>
              {productNames.map((name) => (
                <option value={name}>{name}</option>
              ))}
            </select>

            <!-- Filter by Status -->
            <select class="filter-select" id="statusFilterSelect">
              <option value="ALL">All Statuses</option>
              <option value="Pending">Pending</option>
              <option value="Confirmed">Confirmed</option>
              <option value="Shipped">Shipped</option>
              <option value="Delivered">Delivered</option>
            </select>

            <!-- Export to CSV Button -->
            <button class="btn-export-csv" id="exportCsvBtn" title="Export current filtered table to CSV file">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Export CSV</span>
            </button>
          </div>
        </section>

        <!-- Interactive CRUD Data Table Card -->
        <div class="table-card">
          <div class="table-card-header">
            <div class="table-header-left">
              <h2 class="table-title">Order Records & Google Sheet Responses</h2>
              <span class="table-count-badge" id="tableRecordCount">Loading...</span>
            </div>
            <div class="table-header-right">
              <span class="range-pill" id="sheetRangePill">Form responses 2!A:I</span>
            </div>
          </div>

          <div class="table-responsive">
            <table class="crud-table" id="crudTable">
              <thead>
                <tr>
                  <th style="width: 50px;">#</th>
                  <th style="width: 130px;">Timestamp</th>
                  <th style="width: 170px;">Customer Name</th>
                  <th style="width: 180px;">Contact</th>
                  <th style="width: 160px;">Merchandise Item</th>
                  <th style="width: 90px;">Size</th>
                  <th style="width: 70px;">Qty</th>
                  <th>Notes</th>
                  <th style="width: 120px;">Status</th>
                  <th style="width: 110px; text-align: center;">Actions</th>
                </tr>
              </thead>
              <tbody id="tableBody">
                <!-- Dynamically populated rows -->
              </tbody>
            </table>

            <!-- Empty / Loading / Error State -->
            <div class="table-empty-state" id="emptyState" style="display: none;">
              <div class="empty-icon-wrap">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              </div>
              <h3 class="empty-title" id="emptyStateTitle">No records found</h3>
              <p class="empty-desc" id="emptyStateDesc">Try adjusting your search terms or filters.</p>
            </div>
          </div>
        </div>

      </main>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         MODAL 1: CREATE NEW RECORD (POST)
         ═══════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop" id="createModal" style="display: none;">
      <div class="modal-card">
        <div class="modal-header">
          <div class="modal-header-icon icon-add">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </div>
          <div class="modal-header-text">
            <h3 class="modal-title">New Merchandise Entry</h3>
            <p class="modal-sub">Append a new order row to Google Sheets via Service Account</p>
          </div>
          <button class="modal-close-btn" id="closeCreateModalBtn">×</button>
        </div>

        <form id="createRecordForm" class="modal-form" onsubmit="return false;">
          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label" for="createName">Customer Name *</label>
              <input type="text" id="createName" class="form-input" placeholder="e.g. Ameen Farhan" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="createPhone">WhatsApp / Phone</label>
              <input type="text" id="createPhone" class="form-input" placeholder="+91 98471 23456" />
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label" for="createEmail">Email Address</label>
              <input type="email" id="createEmail" class="form-input" placeholder="ameen@example.com" />
            </div>
            <div class="form-group">
              <label class="form-label" for="createItem">Merchandise Item *</label>
              <select id="createItem" class="form-input" required>
                {productNames.map((name) => (
                  <option value={name}>{name}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="form-grid-3">
            <div class="form-group">
              <label class="form-label" for="createSize">Size / Variant</label>
              <input type="text" id="createSize" class="form-input" placeholder="e.g. L, M, Standard" />
            </div>
            <div class="form-group">
              <label class="form-label" for="createQty">Quantity</label>
              <input type="number" id="createQty" class="form-input" min="1" value="1" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="createStatus">Order Status</label>
              <select id="createStatus" class="form-input">
                <option value="Pending">Pending</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Shipped">Shipped</option>
                <option value="Delivered">Delivered</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="createNotes">Delivery / Packaging Notes</label>
            <textarea id="createNotes" class="form-input" rows="2" placeholder="e.g. Kozhikode campus pickup / gift box requested"></textarea>
          </div>

          <div class="modal-actions-row">
            <button type="button" class="btn-cancel" id="cancelCreateBtn">Cancel</button>
            <button type="submit" class="btn-primary-action" id="submitCreateBtn">
              <span class="btn-text">Add to Google Sheet</span>
              <span class="btn-spinner" id="createSpinner" style="display: none;"></span>
            </button>
          </div>
        </form>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         MODAL 2: EDIT RECORD (PUT)
         ═══════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop" id="editModal" style="display: none;">
      <div class="modal-card">
        <div class="modal-header">
          <div class="modal-header-icon icon-edit">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
          <div class="modal-header-text">
            <h3 class="modal-title">Edit Record <span class="modal-row-badge" id="editRowNumberBadge">Row #2</span></h3>
            <p class="modal-sub">Update fields in Google Sheets via Service Account</p>
          </div>
          <button class="modal-close-btn" id="closeEditModalBtn">×</button>
        </div>

        <form id="editRecordForm" class="modal-form" onsubmit="return false;">
          <input type="hidden" id="editRowNumber" />

          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label" for="editName">Customer Name *</label>
              <input type="text" id="editName" class="form-input" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="editPhone">WhatsApp / Phone</label>
              <input type="text" id="editPhone" class="form-input" />
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label" for="editEmail">Email Address</label>
              <input type="email" id="editEmail" class="form-input" />
            </div>
            <div class="form-group">
              <label class="form-label" for="editItem">Merchandise Item *</label>
              <select id="editItem" class="form-input" required>
                {productNames.map((name) => (
                  <option value={name}>{name}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="form-grid-3">
            <div class="form-group">
              <label class="form-label" for="editSize">Size / Variant</label>
              <input type="text" id="editSize" class="form-input" />
            </div>
            <div class="form-group">
              <label class="form-label" for="editQty">Quantity</label>
              <input type="number" id="editQty" class="form-input" min="1" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="editStatus">Order Status</label>
              <select id="editStatus" class="form-input">
                <option value="Pending">Pending</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Shipped">Shipped</option>
                <option value="Delivered">Delivered</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="editNotes">Delivery / Packaging Notes</label>
            <textarea id="editNotes" class="form-input" rows="2"></textarea>
          </div>

          <div class="modal-actions-row">
            <button type="button" class="btn-cancel" id="cancelEditBtn">Cancel</button>
            <button type="submit" class="btn-primary-action" id="submitEditBtn">
              <span class="btn-text">Save Changes</span>
              <span class="btn-spinner" id="editSpinner" style="display: none;"></span>
            </button>
          </div>
        </form>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         MODAL 3: DELETE CONFIRMATION (DELETE)
         ═══════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop" id="deleteModal" style="display: none;">
      <div class="modal-card modal-card-sm">
        <div class="modal-header">
          <div class="modal-header-icon icon-danger">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          </div>
          <div class="modal-header-text">
            <h3 class="modal-title">Clear Row from Sheet?</h3>
            <p class="modal-sub">This action will clear the row data in Google Sheets.</p>
          </div>
          <button class="modal-close-btn" id="closeDeleteModalBtn">×</button>
        </div>

        <div class="delete-summary-box">
          <p><strong>Row:</strong> <span id="deleteRowLabel">Row #2</span></p>
          <p><strong>Customer:</strong> <span id="deleteCustomerLabel">Ameen Farhan</span></p>
          <p><strong>Item:</strong> <span id="deleteItemLabel">White T-Shirt</span></p>
        </div>

        <div class="modal-actions-row">
          <button type="button" class="btn-cancel" id="cancelDeleteBtn">Cancel</button>
          <button type="button" class="btn-danger-action" id="confirmDeleteBtn">
            <span class="btn-text">Yes, Clear Row</span>
            <span class="btn-spinner" id="deleteSpinner" style="display: none;"></span>
          </button>
        </div>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         MODAL 4: GOOGLE SHEETS SETUP & DIAGNOSTICS MODAL
         ═══════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop" id="setupModal" style="display: none;">
      <div class="modal-card modal-card-lg">
        <div class="modal-header">
          <div class="modal-header-icon icon-blue">
