    function cleanCell(val) {
      if (typeof val === 'string' && val.startsWith("'")) return val.slice(1);
      return String(val || '');
    }

    function getStatusClass(status) {
      const s = (status || '').toLowerCase();
      if (s === 'confirmed') return 'status-confirmed';
      if (s === 'shipped') return 'status-shipped';
      if (s === 'delivered') return 'status-delivered';
      if (s === 'cancelled') return 'status-cancelled';
      return 'status-pending';
    }

    function getPaymentClass(payment) {
      const p = (payment || '').toLowerCase();
      if (p === 'paid') return 'payment-paid';
      if (p === 'partial') return 'payment-partial';
      return 'payment-pending';
    }

    function escapeHtml(str) {
      return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ─────────────────────────────────────────────────────────────
    // T-SHIRT SIZE MATRIX DYNAMICS (CREATE FORM)
    // ─────────────────────────────────────────────────────────────
    function updateCreateSizeMatrix() {
      const s = parseInt(createSizeS.value, 10) || 0;
      const m = parseInt(createSizeM.value, 10) || 0;
      const l = parseInt(createSizeL.value, 10) || 0;
      const xl = parseInt(createSizeXL.value, 10) || 0;
      const xxl = parseInt(createSizeXXL.value, 10) || 0;

      const sum = s + m + l + xl + xxl;
      createMatrixTotalBadge.textContent = `${sum} pcs selected`;

      const parts = [];
      if (s > 0) parts.push(`${s}x S`);
      if (m > 0) parts.push(`${m}x M`);
      if (l > 0) parts.push(`${l}x L`);
      if (xl > 0) parts.push(`${xl}x XL`);
      if (xxl > 0) parts.push(`${xxl}x XXL`);

      if (parts.length > 0) {
        createMatrixSummary.textContent = `Selected: ${parts.join(', ')}`;
        createQty.value = sum;
      } else {
        createMatrixSummary.textContent = 'Enter quantities for each size.';
      }
    }

    [createSizeS, createSizeM, createSizeL, createSizeXL, createSizeXXL].forEach(input => {
      input.addEventListener('input', updateCreateSizeMatrix);
    });

    createItem.addEventListener('change', () => {
      if (createItem.value === 'White T-Shirt') {
        createSizeMatrixPanel.style.display = 'flex';
      } else {
        createSizeMatrixPanel.style.display = 'none';
      }
    });

    // ─────────────────────────────────────────────────────────────
    // T-SHIRT SIZE MATRIX DYNAMICS (EDIT FORM)
    // ─────────────────────────────────────────────────────────────
    function updateEditSizeMatrix() {
      const s = parseInt(editSizeS.value, 10) || 0;
      const m = parseInt(editSizeM.value, 10) || 0;
      const l = parseInt(editSizeL.value, 10) || 0;
      const xl = parseInt(editSizeXL.value, 10) || 0;
      const xxl = parseInt(editSizeXXL.value, 10) || 0;

      const sum = s + m + l + xl + xxl;
      editMatrixTotalBadge.textContent = `${sum} pcs`;

      const parts = [];
      if (s > 0) parts.push(`${s}x S`);
      if (m > 0) parts.push(`${m}x M`);
      if (l > 0) parts.push(`${l}x L`);
      if (xl > 0) parts.push(`${xl}x XL`);
      if (xxl > 0) parts.push(`${xxl}x XXL`);

      if (parts.length > 0) {
        editMatrixSummary.textContent = `Allocation: ${parts.join(', ')}`;
        editQty.value = sum;
      } else {
        editMatrixSummary.textContent = 'No size allocations entered.';
      }
    }

    [editSizeS, editSizeM, editSizeL, editSizeXL, editSizeXXL].forEach(input => {
      input.addEventListener('input', updateEditSizeMatrix);
    });

    editItem.addEventListener('change', () => {
      editSizeMatrixPanel.style.display = editItem.value === 'White T-Shirt' ? 'flex' : 'none';
    });

    // ─────────────────────────────────────────────────────────────
    // CRUD: CREATE (POST)
    // ─────────────────────────────────────────────────────────────
    if (openCreateModalBtn) {
      openCreateModalBtn.addEventListener('click', () => {
        const qbCard = document.getElementById('quickBookingCard');
        if (qbCard) {
          const tabOrdersBtn = document.querySelector('[data-tab="tabOrders"]');
          if (tabOrdersBtn) tabOrdersBtn.click();
          qbCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          const qbName = document.getElementById('qbName');
          if (qbName) {
            setTimeout(() => qbName.focus(), 300);
          }
        } else {
          createRecordForm.reset();
          createItem.value = 'White T-Shirt';
          createSizeMatrixPanel.style.display = 'flex';
          updateCreateSizeMatrix();
          createModal.style.display = 'flex';
        }
      });
    }

    if (closeCreateModalBtn) closeCreateModalBtn.addEventListener('click', () => createModal.style.display = 'none');
    if (cancelCreateBtn) cancelCreateBtn.addEventListener('click', () => createModal.style.display = 'none');

    if (createRecordForm) {
      createRecordForm.addEventListener('submit', async () => {
        const payload = {
          name: document.getElementById('createName').value.trim(),
          phone: document.getElementById('createPhone').value.trim(),
          email: document.getElementById('createEmail').value.trim(),
          item: createItem.value,
          qty: createQty.value || '1',
          bookingStatus: document.getElementById('createBookingStatus').value,
          paymentStatus: document.getElementById('createPaymentStatus').value,
          notes: document.getElementById('createNotes').value.trim(),
          sizeS: createSizeS.value || '0',
          sizeM: createSizeM.value || '0',
          sizeL: createSizeL.value || '0',
          sizeXL: createSizeXL.value || '0',
          sizeXXL: createSizeXXL.value || '0',
        };

        submitCreateBtn.disabled = true;
        createSpinner.style.display = 'inline-block';

        try {
          const resp = await fetch(`${API_BASE}/api/data`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${authToken}`
            },
            body: JSON.stringify(payload)
          });

          const resData = await resp.json();
          if (resp.ok) {
            createModal.style.display = 'none';
            showToast(resData.message || 'Booking added successfully!');
            await fetchOrdersData();
          } else {
            showToast(resData.error || 'Failed to add booking', true);
          }
        } catch (e) {
          showToast('Network error adding booking', true);
        } finally {
          submitCreateBtn.disabled = false;
          createSpinner.style.display = 'none';
        }
      });
    }

