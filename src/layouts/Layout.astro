---
import '../styles/global.css';
const { title, description = 'GEN M 2026 — Kerala\'s Generational Student Confluence at Kozhikode Beach, November 13–15, 2026. Theme: മാറ്റം (Transformation).' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} | GEN M 2026` : 'GEN M 2026 — Kerala Generational Student Confluence'}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href="/ylogo.png" />
    <meta property="og:title" content={title ? `${title} | GEN M 2026` : 'GEN M 2026'} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/ylogo.png" />
  </head>
  <body>
    <slot />
  </body>
</html>